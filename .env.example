# 统一 LLM 配置（必需用于 AI 功能；协议仅 OpenAI 兼容或 Anthropic 兼容）
# 判定规则：base_url 含 "anthropic" → Anthropic Messages；否则 → OpenAI Chat Completions
LLM_API_KEY=your_api_key_here
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# Anthropic 官方示例：
# LLM_BASE_URL=https://api.anthropic.com
# LLM_MODEL=claude-sonnet-4-6

# 兼容旧变量名（可选，会被映射到 LLM_*）：
# MIMO_API_KEY / OPENAI_API_KEY / ANTHROPIC_API_KEY
# MIMO_BASE_URL / OPENAI_BASE_URL / ANTHROPIC_BASE_URL
# MIMO_MODEL / OPENAI_MODEL / ANTHROPIC_MODEL

# 数据库路径（可选）
# DATABASE_URL=sqlite:///./data/essay_read.db

# 上传目录（可选）
# UPLOAD_DIR=./uploads

# 服务器配置（可选）
# HOST=0.0.0.0
# PORT=8000

# 前端地址（CORS 用，可选）
# FRONTEND_ORIGIN=http://localhost:5173
