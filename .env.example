# 统一 LLM 配置（必需用于 AI 功能；所有文本生成共用这一套）
LLM_PROVIDER=openai
LLM_API_FORMAT=openai_chat
LLM_API_KEY=your_api_key_here
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# 默认问题驱动研究执行器；关闭时默认新建返回错误，历史查询与显式 legacy 创建保留。
# RESEARCH_LOOP_ENABLED=false

# Research Agent goal planner（可选，默认关闭；开启后每次 workflow 使用一次小型 LLM 调用）
# RESEARCH_AGENT_PLANNER_ENABLED=true
# RESEARCH_AGENT_PLANNER_MAX_TOKENS=320
# RESEARCH_AGENT_PLANNER_TIMEOUT_SECONDS=30

# Anthropic 官方示例：
# LLM_PROVIDER=anthropic
# LLM_API_FORMAT=anthropic_messages
# LLM_BASE_URL=https://api.anthropic.com
# LLM_MODEL=claude-sonnet-4-6

# 兼容旧变量名（可选，会被映射到 LLM_*）：
# MIMO_API_KEY / OPENAI_API_KEY / ANTHROPIC_API_KEY
# MIMO_BASE_URL / OPENAI_BASE_URL / ANTHROPIC_BASE_URL
# MIMO_MODEL / OPENAI_MODEL / ANTHROPIC_MODEL

# 数据库路径（可选）
# DATABASE_URL=sqlite:///./data/essay_read.db

# 上传目录（可选）
# UPLOAD_DIR=./uploads

# 服务器配置（可选）
# HOST=0.0.0.0
# PORT=8000

# 前端地址（CORS 用，可选）
# FRONTEND_ORIGIN=http://localhost:5173
