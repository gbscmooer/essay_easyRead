# MiMo API 配置（必需）
MIMO_API_KEY=your_api_key_here

# API 地址（可选，有默认值）
# MIMO_BASE_URL=https://api.xiaomimimo.com/v1
# MIMO_MODEL=mimo-v2.5-pro

# 数据库路径（可选）
# DATABASE_URL=sqlite:///./data/essay_read.db

# 上传目录（可选）
# UPLOAD_DIR=./uploads

# 服务器配置（可选）
# HOST=0.0.0.0
# PORT=8000

# 前端地址（CORS 用，可选）
# FRONTEND_ORIGIN=http://localhost:5173
