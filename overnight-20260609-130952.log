{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call_25e795d0198241fc88e2b710","type":"tool_result","content":"1\timport { useState, useEffect } from 'react'\n2\timport { get } from '@/api/client'\n3\timport { toast } from '@/hooks/useToast'\n4\timport type { Theme } from '@/theme/themes'\n5\timport { DEFAULT_THEME_ID } from '@/theme/themes'\n6\t\n7\t\n8\texport interface UIConfig {\n9\t  highlight_duration: number\n10\t  zoom_step: number\n11\t  zoom_min: number\n12\t  zoom_max: number\n13\t  pinch_zoom_step: number\n14\t  theme: string\n15\t  font: string\n16\t  custom_font: string\n17\t  custom_themes?: Theme[]\n18\t}\n19\t\n20\tinterface AppConfig {\n21\t  translate: { temperature: number; max_tokens: number; [key: string]: unknown }\n22\t  analysis: { temperature: number; max_tokens: number; [key: string]: unknown }\n23\t  ui: UIConfig\n24\t}\n25\t\n26\t\n27\tconst DEFAULT_UI: UIConfig = {\n28\t  highlight_duration: 3000,\n29\t  zoom_step: 0.2,\n30\t  zoom_min: 0.4,\n31\t  zoom_max: 3.0,\n32\t  pinch_zoom_step: 0.02,\n33\t  theme: DEFAULT_THEME_ID,\n34\t  font: 'sans',\n35\t  custom_font: '',\n36\t  custom_themes: [],\n37\t}\n38\t\n39\t\n40\tlet cachedConfig: AppConfig | null = null\n41\tlet fetchPromise: Promise<AppConfig> | null = null\n42\tconst listeners = new Set<() => void>()\n43\t\n44\t// 预览配置（点击按钮立即生效，保存后才持久化）\n45\tlet previewOverrides: Partial<UIConfig> | null = null\n46\tlet dirtyListeners = new Set<() => void>()\n47\t\n48\t\n49\t/** 从 localStorage 读取保存的主题 key，用于首屏渲染避免闪白 */\n50\tfunction getSavedThemeKey(): string | null {\n51\t  try { return localStorage.getItem('essay_theme') } catch { return null }\n52\t}\n53\t\n54\t/**\n55\t * 把后端已保存的主题写入 localStorage，供 index.html 内联脚本首屏读取。\n56\t * 只持久化后端真实配置（不含预览覆盖），避免未保存的预览污染首屏。\n57\t */\n58\tfunction persistThemeToStorage(ui: UIConfig): void {\n59\t  try {\n60\t    localStorage.setItem('essay_theme', ui.theme)\n61\t    localStorage.setItem('essay_custom_themes', JSON.stringify(ui.custom_themes ?? []))\n62\t  } catch { /* localStorage 不可用时忽略 */ }\n63\t}\n64\t\n65\tasync function fetchConfig(): Promise<AppConfig> {\n66\t  if (cachedConfig) return cachedConfig\n67\t  if (fetchPromise) return fetchPromise\n68\t\n69\t  fetchPromise = get<AppConfig>('/analysis/config')\n70\t    .then(cfg => {\n71\t      cachedConfig = cfg\n72\t      fetchPromise = null\n73\t      return cfg\n74\t    })\n75\t    .catch(() => {\n76\t      fetchPromise = null\n77\t      toast({ type: 'warning', message: '配置加载失败，使用默认值' })\n78\t      return { translate: { temperature: 0, max_tokens: 0 }, analysis: { temperature: 0, max_tokens: 0 }, ui: DEFAULT_UI }\n79\t    })\n80\t\n81\t  return fetchPromise\n82\t}\n83\t\n84\t\n85\texport function useUIConfig(): UIConfig {\n86\t  // 初始化时从 localStorage 读取保存的主题，避免等待 fetch 导致首屏闪白\n87\t  const savedTheme = getSavedThemeKey()\n88\t  const initialUI = savedTheme ? { ...DEFAULT_UI, theme: savedTheme } : DEFAULT_UI\n89\t  const [ui, setUI] = useState<UIConfig>(initialUI)\n90\t\n91\t  useEffect(() => {\n92\t    const update = () => {\n93\t      fetchConfig().then(cfg => {\n94\t        const saved = cfg.ui || DEFAULT_UI\n95\t        persistThemeToStorage(saved)\n96\t        setUI({ ...saved, ...previewOverrides })\n97\t      }).catch(() => {})\n98\t    }\n99\t    update()\n100\t    listeners.add(update)\n101\t    return () => { listeners.delete(update) }\n102\t  }, [])\n103\t\n104\t  return ui\n105\t}\n106\t\n107\t\n108\t/**\n109\t * 设置预览配置（立即生效，不持久化）\n110\t */\n111\texport function setUIPreview(overrides: Partial<UIConfig>): void {\n112\t  previewOverrides = { ...previewOverrides, ...overrides }\n113\t  listeners.forEach(fn => fn())\n114\t  dirtyListeners.forEach(fn => fn())\n115\t}\n116\t\n117\t\n118\t/**\n119\t * 清除预览，恢复到已保存的配置\n120\t */\n121\texport function clearUIPreview(): void {\n122\t  previewOverrides = null\n123\t  listeners.forEach(fn => fn())\n124\t  dirtyListeners.forEach(fn => fn())\n125\t}\n126\t\n127\texport function useConfigDirty(): boolean {\n128\t  const [dirty, setDirty] = useState(!!previewOverrides)\n129\t  useEffect(() => {\n130\t    const update = () => setDirty(!!previewOverrides)\n131\t    dirtyListeners.add(update)\n132\t    return () => { dirtyListeners.delete(update) }\n133\t  }, [])\n134\t  return dirty\n135\t}\n136\t\n137\texport function hasUnsavedConfig(): boolean {\n138\t  return !!previewOverrides\n139\t}\n140\t\n141\t\n142\texport function refreshConfig(): void {\n143\t  cachedConfig = null\n144\t  fetchPromise = null\n145\t  previewOverrides = null\n146\t  listeners.forEach(fn => fn())\n147\t}\n148\t"}]},"parent_tool_use_id":null,"session_id":"29257b8f-ede7-46a4-8e0f-a743591d296a","uuid":"cef221ee-135c-4d63-93c3-d61f85438e07","timestamp":"2026-06-09T05:13:12.767Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/katisarrow/essay_read/frontend/src/hooks/useConfig.ts","content":"import { useState, useEffect } from 'react'\nimport { get } from '@/api/client'\nimport { toast } from '@/hooks/useToast'\nimport type { Theme } from '@/theme/themes'\nimport { DEFAULT_THEME_ID } from '@/theme/themes'\n\n\nexport interface UIConfig {\n  highlight_duration: number\n  zoom_step: number\n  zoom_min: number\n  zoom_max: number\n  pinch_zoom_step: number\n  theme: string\n  font: string\n  custom_font: string\n  custom_themes?: Theme[]\n}\n\ninterface AppConfig {\n  translate: { temperature: number; max_tokens: number; [key: string]: unknown }\n  analysis: { temperature: number; max_tokens: number; [key: string]: unknown }\n  ui: UIConfig\n}\n\n\nconst DEFAULT_UI: UIConfig = {\n  highlight_duration: 3000,\n  zoom_step: 0.2,\n  zoom_min: 0.4,\n  zoom_max: 3.0,\n  pinch_zoom_step: 0.02,\n  theme: DEFAULT_THEME_ID,\n  font: 'sans',\n  custom_font: '',\n  custom_themes: [],\n}\n\n\nlet cachedConfig: AppConfig | null = null\nlet fetchPromise: Promise<AppConfig> | null = null\nconst listeners = new Set<() => void>()\n\n// 预览配置（点击按钮立即生效，保存后才持久化）\nlet previewOverrides: Partial<UIConfig> | null = null\nlet dirtyListeners = new Set<() => void>()\n\n\n/** 从 localStorage 读取保存的主题 key，用于首屏渲染避免闪白 */\nfunction getSavedThemeKey(): string | null {\n  try { return localStorage.getItem('essay_theme') } catch { return null }\n}\n\n/**\n * 把后端已保存的主题写入 localStorage，供 index.html 内联脚本首屏读取。\n * 只持久化后端真实配置（不含预览覆盖），避免未保存的预览污染首屏。\n */\nfunction persistThemeToStorage(ui: UIConfig): void {\n  try {\n    localStorage.setItem('essay_theme', ui.theme)\n    localStorage.setItem('essay_custom_themes', JSON.stringify(ui.custom_themes ?? []))\n  } catch { /* localStorage 不可用时忽略 */ }\n}\n\nasync function fetchConfig(): Promise<AppConfig> {\n  if (cachedConfig) return cachedConfig\n  if (fetchPromise) return fetchPromise\n\n  fetchPromise = get<AppConfig>('/analysis/config')\n    .then(cfg => {\n      cachedConfig = cfg\n      fetchPromise = null\n      return cfg\n    })\n    .catch(() => {\n      fetchPromise = null\n      toast({ type: 'warning', message: '配置加载失败，使用默认值' })\n      return { translate: { temperature: 0, max_tokens: 0 }, analysis: { temperature: 0, max_tokens: 0 }, ui: DEFAULT_UI }\n    })\n\n  return fetchPromise\n}\n\n\nexport function useUIConfig(): UIConfig {\n  // 初始化时从 localStorage 读取保存的主题，避免等待 fetch 导致首屏闪白\n  const savedTheme = getSavedThemeKey()\n  const initialUI = savedTheme ? { ...DEFAULT_UI, theme: savedTheme } : DEFAULT_UI\n  const [ui, setUI] = useState<UIConfig>(initialUI)\n\n  useEffect(() => {\n    const update = () => {\n      fetchConfig().then(cfg => {\n        const saved = cfg.ui || DEFAULT_UI\n        persistThemeToStorage(saved)\n        setUI({ ...saved, ...previewOverrides })\n      }).catch(() => {})\n    }\n    update()\n    listeners.add(update)\n    return () => { listeners.delete(update) }\n  }, [])\n\n  return ui\n}\n\n\n/**\n * 设置预览配置（立即生效，不持久化）\n */\nexport function setUIPreview(overrides: Partial<UIConfig>): void {\n  previewOverrides = { ...previewOverrides, ...overrides }\n  listeners.forEach(fn => fn())\n  dirtyListeners.forEach(fn => fn())\n}\n\n\n/**\n * 清除预览，恢复到已保存的配置\n */\nexport function clearUIPreview(): void {\n  previewOverrides = null\n  listeners.forEach(fn => fn())\n  dirtyListeners.forEach(fn => fn())\n}\n\nexport function useConfigDirty(): boolean {\n  const [dirty, setDirty] = useState(!!previewOverrides)\n  useEffect(() => {\n    const update = () => setDirty(!!previewOverrides)\n    dirtyListeners.add(update)\n    return () => { dirtyListeners.delete(update) }\n  }, [])\n  return dirty\n}\n\nexport function hasUnsavedConfig(): boolean {\n  return !!previewOverrides\n}\n\n\nexport function refreshConfig(): void {\n  cachedConfig = null\n  fetchPromise = null\n  previewOverrides = null\n  listeners.forEach(fn => fn())\n}\n","numLines":148,"startLine":1,"totalLines":148}}}
