{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call_9d52ce6e0ee44370957ee573","type":"tool_result","content":"1\timport { useMemo, useState } from 'react'\n2\timport {\n3\t  BarChart, Bar, LineChart, Line, ScatterChart, Scatter,\n4\t  XAxis, YAxis, Tooltip, Legend, ResponsiveContainer, CartesianGrid,\n5\t} from 'recharts'\n6\timport type { AnalysisResult, FigureAnalysis } from '@/types'\n7\timport { useUIConfig } from '@/hooks/useConfig'\n8\t\n9\t\n10\tinterface ExperimentsTabProps {\n11\t  result: AnalysisResult\n12\t  onJumpToPage?: (page: number) => void\n13\t}\n14\t\n15\t\n16\tconst CHART_COLORS = [\n17\t  '#3b82f6', '#10b981', '#f59e0b', '#ef4444', '#8b5cf6',\n18\t  '#ec4899', '#06b6d4', '#84cc16', '#f97316', '#6366f1',\n19\t]\n20\t\n21\t\n22\t/** 读取当前主题的 CSS 变量，主题切换时随 useUIConfig 重新计算，保证图表与主题一致 */\n23\tfunction useThemeColors() {\n24\t  const ui = useUIConfig()\n25\t  return useMemo(() => {\n26\t    const cs = getComputedStyle(document.documentElement)\n27\t    const v = (name: string, fallback: string) => cs.getPropertyValue(name).trim() || fallback\n28\t    return {\n29\t      grid: v('--border', '#374151'),\n30\t      tick: v('--text-secondary', '#9ca3af'),\n31\t      surface: v('--bg-elevated', '#1f2937'),\n32\t      border: v('--border', '#374151'),\n33\t      text: v('--text-primary', '#e5e7eb'),\n34\t      accent: v('--accent', '#3b82f6'),\n35\t    }\n36\t    // eslint-disable-next-line react-hooks/exhaustive-deps\n37\t  }, [ui.theme])\n38\t}\n39\t\n40\t\n41\t/** 将 FigureAnalysis 的 rows 转换为 Recharts 数据 */\n42\tfunction buildRechartsData(fig: FigureAnalysis) {\n43\t  if (!fig.columns || !fig.rows || fig.rows.length === 0) return null\n44\t  const cols = fig.columns\n45\t  // 第一列作为 x 轴分类\n46\t  return fig.rows.map(row => {\n47\t    const entry: Record<string, unknown> = {}\n48\t    cols.forEach((col, i) => {\n49\t      const val = row[i] ?? ''\n50\t      const num = parseFloat(val)\n51\t      entry[col] = isNaN(num) ? val : num\n52\t    })\n53\t    return entry\n54\t  })\n55\t}\n56\t\n57\t\n58\t/**\n59\t * 计算自适应坐标轴范围：不强制从 0 开始，按数据实际范围 + 10% 余量取整，\n60\t * 避免数值集中在高位（如 99~100）时因总尺度过大而看不出差异。\n61\t */\n62\tfunction computeDomain(\n63\t  data: Record<string, unknown>[],\n64\t  keys: string[],\n65\t): [number, number] | undefined {\n66\t  let min = Infinity\n67\t  let max = -Infinity\n68\t  for (const row of data) {\n69\t    for (const k of keys) {\n70\t      const val = row[k]\n71\t      if (typeof val === 'number' && isFinite(val)) {\n72\t        if (val < min) min = val\n73\t        if (val > max) max = val\n74\t      }\n75\t    }\n76\t  }\n77\t  if (!isFinite(min) || !isFinite(max)) return undefined\n78\t  if (min === max) {\n79\t    const pad = Math.abs(min) * 0.1 || 1\n80\t    return [min - pad, max + pad]\n81\t  }\n82\t  const pad = (max - min) * 0.12\n83\t  let lo = min - pad\n84\t  const hi = max + pad\n85\t  // 数据非负且不太靠近 0 时，下界不要越过 0\n86\t  if (min >= 0 && lo < 0) lo = 0\n87\t  return [lo, hi]\n88\t}\n89\t\n90\t\n91\tfunction FigureChart({ fig }: { fig: FigureAnalysis }) {\n92\t  const data = useMemo(() => buildRechartsData(fig), [fig])\n93\t  const colors = useThemeColors()\n94\t  const cols = fig.columns || []\n95\t\n96\t  if (!data || cols.length < 2) {\n97\t    return (\n98\t      <div className=\"text-xs py-4 text-center\" style={{ color: 'var(--text-muted)' }}>\n99\t        数据不足以生成图表\n100\t      </div>\n101\t    )\n102\t  }\n103\t\n104\t  const xKey = cols[0]\n105\t  const valueKeys = cols.slice(1)\n106\t\n107\t  const tooltipStyle = {\n108\t    backgroundColor: colors.surface,\n109\t    border: `1px solid ${colors.border}`,\n110\t    borderRadius: '0.5rem',\n111\t    color: colors.text,\n112\t    fontSize: 12,\n113\t  }\n114\t  const tooltipItemStyle = { color: colors.text }\n115\t  const tooltipLabelStyle = { color: colors.text }\n116\t  const axisTick = { fill: colors.tick, fontSize: 11 }\n117\t\n118\t  const yDomain = computeDomain(data, valueKeys)\n119\t\n120\t  if (fig.chart_type === 'line') {\n121\t    return (\n122\t      <ResponsiveContainer width=\"100%\" height={280}>\n123\t        <LineChart data={data}>\n124\t          <CartesianGrid strokeDasharray=\"3 3\" stroke={colors.grid} />\n125\t          <XAxis dataKey={xKey} tick={axisTick} stroke={colors.grid} />\n126\t          <YAxis domain={yDomain ?? ['auto', 'auto']} tick={axisTick} stroke={colors.grid} allowDecimals />\n127\t          <Tooltip contentStyle={tooltipStyle} itemStyle={tooltipItemStyle} labelStyle={tooltipLabelStyle} />\n128\t          <Legend wrapperStyle={{ fontSize: 12, color: colors.text }} />\n129\t          {valueKeys.map((key, idx) => (\n130\t            <Line\n131\t              key={key}\n132\t              type=\"monotone\"\n133\t              dataKey={key}\n134\t              stroke={CHART_COLORS[idx % CHART_COLORS.length]}\n135\t              strokeWidth={2}\n136\t              dot={{ r: 3 }}\n137\t            />\n138\t          ))}\n139\t        </LineChart>\n140\t      </ResponsiveContainer>\n141\t    )\n142\t  }\n143\t\n144\t  if (fig.chart_type === 'scatter') {\n145\t    // 散点图用前两个数值列\n146\t    const xVal = valueKeys[0]\n147\t    const yVal = valueKeys[1] || valueKeys[0]\n148\t    const xDomain = computeDomain(data, [xVal])\n149\t    const scatterYDomain = computeDomain(data, [yVal])\n150\t    return (\n151\t      <ResponsiveContainer width=\"100%\" height={280}>\n152\t        <ScatterChart>\n153\t          <CartesianGrid strokeDasharray=\"3 3\" stroke={colors.grid} />\n154\t          <XAxis dataKey={xVal} name={xVal} type=\"number\" domain={xDomain ?? ['auto', 'auto']} tick={axisTick} stroke={colors.grid} />\n155\t          <YAxis dataKey={yVal} name={yVal} type=\"number\" domain={scatterYDomain ?? ['auto', 'auto']} tick={axisTick} stroke={colors.grid} />\n156\t          <Tooltip contentStyle={tooltipStyle} itemStyle={tooltipItemStyle} labelStyle={tooltipLabelStyle} cursor={{ strokeDasharray: '3 3' }} />\n157\t          <Scatter name=\"数据\" data={data} fill={colors.accent} />\n158\t        </ScatterChart>\n159\t      </ResponsiveContainer>\n160\t    )\n161\t  }\n162\t\n163\t  // 默认柱状图\n164\t  return (\n165\t    <ResponsiveContainer width=\"100%\" height={280}>\n166\t      <BarChart data={data}>\n167\t        <CartesianGrid strokeDasharray=\"3 3\" stroke={colors.grid} />\n168\t        <XAxis dataKey={xKey} tick={axisTick} stroke={colors.grid} />\n169\t        <YAxis domain={yDomain ?? [0, 'auto']} tick={axisTick} stroke={colors.grid} allowDecimals />\n170\t        <Tooltip contentStyle={tooltipStyle} itemStyle={tooltipItemStyle} labelStyle={tooltipLabelStyle} cursor={{ fill: colors.accent, fillOpacity: 0.08 }} />\n171\t        <Legend wrapperStyle={{ fontSize: 12, color: colors.text }} />\n172\t        {valueKeys.map((key, idx) => (\n173\t          <Bar\n174\t            key={key}\n175\t            dataKey={key}\n176\t            fill={CHART_COLORS[idx % CHART_COLORS.length]}\n177\t            radius={[2, 2, 0, 0]}\n178\t          />\n179\t        ))}\n180\t      </BarChart>\n181\t    </ResponsiveContainer>\n182\t  )\n183\t}\n184\t\n185\t\n186\tfunction FigureCard({ fig, onJumpToPage }: { fig: FigureAnalysis; onJumpToPage?: (page: number) => void }) {\n187\t  const [showTable, setShowTable] = useState(false)\n188\t  const cols = fig.columns || []\n189\t\n190\t  const pageNum = useMemo(() => {\n191\t    if (!fig.page) return null\n192\t    const m = String(fig.page).match(/\\d+/)\n193\t    return m ? parseInt(m[0], 10) : null\n194\t  }, [fig.page])\n195\t  const clickable = !!pageNum && !!onJumpToPage\n196\t\n197\t  return (\n198\t    <div className=\"rounded-lg overflow-hidden\" style={{ backgroundColor: 'var(--bg-surface)', border: '1px solid var(--border)' }}>\n199\t      {/* 图表标题 */}\n200\t      <div className=\"px-4 py-3\" style={{ borderBottom: '1px solid var(--border)' }}>\n201\t        <div className=\"flex items-center justify-between\">\n202\t          {clickable ? (\n203\t            <button\n204\t              onClick={() => pageNum && onJumpToPage?.(pageNum)}\n205\t              className=\"group flex items-center gap-1.5 text-sm font-medium transition-colors\"\n206\t              style={{ color: 'var(--accent)' }}\n207\t              title={`跳转到第 ${pageNum} 页`}\n208\t            >\n209\t              <span className=\"group-hover:underline\">{fig.name}</span>\n210\t              <svg className=\"w-3.5 h-3.5 opacity-60 group-hover:opacity-100\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\">\n211\t                <path strokeLinecap=\"round\" strokeLinejoin=\"round\" strokeWidth={2}\n212\t                  d=\"M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14\" />\n213\t              </svg>\n214\t            </button>\n215\t          ) : (\n216\t            <h3 className=\"text-sm font-medium\" style={{ color: 'var(--accent)' }}>{fig.name}</h3>\n217\t          )}\n218\t          <span className=\"text-xs px-2 py-0.5 rounded\" style={{ color: 'var(--text-muted)', backgroundColor: 'var(--bg-elevated)' }}>\n219\t            {fig.chart_type === 'bar' ? '柱状图' : fig.chart_type === 'line' ? '折线图' : fig.chart_type === 'scatter' ? '散点图' : '表格'}\n220\t          </span>\n221\t        </div>\n222\t        {fig.caption && (\n223\t          <p className=\"text-xs mt-1\" style={{ color: 'var(--text-secondary)' }}>{fig.caption}</p>\n224\t        )}\n225\t      </div>\n226\t\n227\t      {/* 图表 */}\n228\t      {fig.chart_type !== 'table' && cols.length >= 2 && (\n229\t        <div className=\"px-4 pt-4\">\n230\t          <FigureChart fig={fig} />\n231\t        </div>\n232\t      )}\n233\t\n234\t      {/* 数据表格（可折叠） */}\n235\t      {fig.rows && fig.rows.length > 0 && (\n236\t        <div className=\"px-4 py-2\">\n237\t          <button\n238\t            onClick={() => setShowTable(v => !v)}\n239\t            className=\"text-xs transition-colors\"\n240\t            style={{ color: 'var(--text-muted)' }}\n241\t          >\n242\t            {showTable ? '收起数据 ▲' : '查看数据 ▼'}\n243\t          </button>\n244\t\n245\t          {showTable && (\n246\t            <div className=\"mt-2 overflow-x-auto\">\n247\t              <table className=\"w-full text-xs\">\n248\t                <thead>\n249\t                  <tr style={{ borderBottom: '1px solid var(--border)' }}>\n250\t                    {cols.map((col, i) => (\n251\t                      <th key={i} className=\"text-left py-1.5 px-2 font-medium\" style={{ color: 'var(--text-secondary)' }}>\n252\t                        {col}\n253\t                      </th>\n254\t                    ))}\n255\t                  </tr>\n256\t                </thead>\n257\t                <tbody>\n258\t                  {fig.rows.map((row, ri) => (\n259\t                    <tr key={ri} style={ri % 2 === 0 ? { backgroundColor: 'var(--bg-elevated)' } : undefined}>\n260\t                      {row.map((cell, ci) => (\n261\t                        <td key={ci} className=\"py-1.5 px-2\" style={{ color: 'var(--text-primary)' }}>\n262\t                          {cell}\n263\t                        </td>\n264\t                      ))}\n265\t                    </tr>\n266\t                  ))}\n267\t                </tbody>\n268\t              </table>\n269\t            </div>\n270\t          )}\n271\t        </div>\n272\t      )}\n273\t\n274\t      {/* 解读 */}\n275\t      {fig.interpretation && (\n276\t        <div className=\"px-4 py-3\" style={{ backgroundColor: 'var(--accent-subtle)', borderTop: '1px solid var(--border)' }}>\n277\t          <p className=\"text-xs mb-1 font-medium\" style={{ color: 'var(--text-secondary)' }}>解读</p>\n278\t          <p className=\"text-xs leading-relaxed\" style={{ color: 'var(--text-primary)' }}>{fig.interpretation}</p>\n279\t        </div>\n280\t      )}\n281\t    </div>\n282\t  )\n283\t}\n284\t\n285\t\n286\texport function ExperimentsTab({ result, onJumpToPage }: ExperimentsTabProps) {\n287\t  const { experiments } = result\n288\t  if (!experiments) {\n289\t    return <div className=\"text-sm text-center py-8\" style={{ color: 'var(--text-muted)' }}>暂无实验分析</div>\n290\t  }\n291\t\n292\t  const figures = experiments.figures || []\n293\t\n294\t  return (\n295\t    <div className=\"space-y-6\">\n296\t      {/* 数据集标签 */}\n297\t      {experiments.datasets && experiments.datasets.length > 0 && (\n298\t        <section>\n299\t          <h2 className=\"text-lg font-semibold mb-3\" style={{ color: 'var(--text-primary)' }}>数据集</h2>\n300\t          <div className=\"flex flex-wrap gap-2\">\n301\t            {experiments.datasets.map((ds, idx) => (\n302\t              <span key={idx} className=\"px-3 py-1 text-sm rounded-full\" style={{ backgroundColor: 'var(--bg-elevated)', color: 'var(--text-secondary)' }}>\n303\t                {ds}\n304\t              </span>\n305\t            ))}\n306\t          </div>\n307\t        </section>\n308\t      )}\n309\t\n310\t      {/* 基线方法 */}\n311\t      {experiments.baselines && experiments.baselines.length > 0 && (\n312\t        <section>\n313\t          <h2 className=\"text-lg font-semibold mb-3\" style={{ color: 'var(--text-primary)' }}>基线方法</h2>\n314\t          <div className=\"flex flex-wrap gap-2\">\n315\t            {experiments.baselines.map((bl, idx) => (\n316\t              <span key={idx} className=\"px-3 py-1 text-sm rounded-full\" style={{ backgroundColor: 'var(--bg-elevated)', color: 'var(--text-secondary)' }}>\n317\t                {bl}\n318\t              </span>\n319\t            ))}\n320\t          </div>\n321\t        </section>\n322\t      )}\n323\t\n324\t      {/* 主要结论 */}\n325\t      {experiments.main_results && (\n326\t        <section>\n327\t          <h2 className=\"text-lg font-semibold mb-2\" style={{ color: 'var(--text-primary)' }}>主要结论</h2>\n328\t          <p className=\"text-sm leading-relaxed\" style={{ color: 'var(--text-primary)' }}>{experiments.main_results}</p>\n329\t        </section>\n330\t      )}\n331\t\n332\t      {/* 逐图表分析 */}\n333\t      {figures.length > 0 && (\n334\t        <section>\n335\t          <h2 className=\"text-lg font-semibold mb-3\" style={{ color: 'var(--text-primary)' }}>\n336\t            图表分析\n337\t            <span className=\"text-xs font-normal ml-2\" style={{ color: 'var(--text-muted)' }}>共 {figures.length} 项</span>\n338\t          </h2>\n339\t          <div className=\"space-y-4\">\n340\t            {figures.map((fig, idx) => (\n341\t              <FigureCard key={idx} fig={fig} onJumpToPage={onJumpToPage} />\n342\t            ))}\n343\t          </div>\n344\t        </section>\n345\t      )}\n346\t\n347\t      {/* 消融实验 */}\n348\t      {experiments.ablation && (\n349\t        <section>\n350\t          <h2 className=\"text-lg font-semibold mb-2\" style={{ color: 'var(--text-primary)' }}>消融实验</h2>\n351\t          <div className=\"rounded-lg p-4\" style={{ backgroundColor: 'var(--bg-surface)', border: '1px solid var(--border)' }}>\n352\t            <p className=\"text-sm leading-relaxed\" style={{ color: 'var(--text-primary)' }}>{experiments.ablation}</p>\n353\t          </div>\n354\t        </section>\n355\t      )}\n356\t    </div>\n357\t  )\n358\t}\n359\t"}]},"parent_tool_use_id":"call_bddd82a75f2e46b98e4517cc","session_id":"29257b8f-ede7-46a4-8e0f-a743591d296a","uuid":"65cafef0-5b5f-4f74-8ea9-86bea5d5ee32","timestamp":"2026-06-09T05:10:38.258Z","subagent_type":"Explore","task_description":"Explore frontend performance"}
