{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call_aad1726326b54482b8ff63fc","type":"tool_result","content":"1\t/**\n2\t * AnalysisPanel 组件\n3\t *\n4\t * 解析结果展示的主面板，包含 Tab 切换。\n5\t * 清新学术风格：简洁 Tab 栏 + 清晰内容区。\n6\t */\n7\t\n8\timport { useState, useEffect, useRef, useCallback } from 'react'\n9\timport type { AnalysisResult, AnalysisStatus } from '@/types'\n10\timport { LoadingState } from '@/components/LoadingState'\n11\timport { OverviewTab } from './tabs/OverviewTab'\n12\timport { OutlineTab } from './tabs/OutlineTab'\n13\timport { MethodTab } from './tabs/MethodTab'\n14\timport { ExperimentsTab } from './tabs/ExperimentsTab'\n15\timport { CodeTab } from './tabs/CodeTab'\n16\timport { InterviewTab } from './tabs/InterviewTab'\n17\timport { NotesPanel } from './NotesPanel'\n18\t\n19\t\n20\tinterface AnalysisPanelProps {\n21\t  result: AnalysisResult | null\n22\t  partialResult: Partial<AnalysisResult>\n23\t  status: AnalysisStatus\n24\t  progressMessage: string\n25\t  progress?: number\n26\t  relatedStatus?: 'idle' | 'loading' | 'ok' | 'failed'\n27\t  onJumpToPage?: (page: number) => void\n28\t  paperId?: number\n29\t  onStartAnalysis?: () => void\n30\t  onReanalyze?: () => void\n31\t}\n32\t\n33\tconst tabs = [\n34\t  { key: 'overview', label: '概览' },\n35\t  { key: 'outline', label: '大纲' },\n36\t  { key: 'method', label: '方法' },\n37\t  { key: 'experiments', label: '实验' },\n38\t  { key: 'code', label: '代码' },\n39\t  { key: 'interview', label: 'Q&A' },\n40\t  { key: 'notes', label: '笔记' },\n41\t] as const\n42\t\n43\ttype TabKey = typeof tabs[number]['key']\n44\t\n45\texport function AnalysisPanel({ result, partialResult, status, progressMessage, progress, relatedStatus, onJumpToPage, paperId, onStartAnalysis, onReanalyze }: AnalysisPanelProps) {\n46\t  const [activeTab, setActiveTab] = useState<TabKey>('overview')\n47\t  const [showReanalyzeConfirm, setShowReanalyzeConfirm] = useState(false)\n48\t  const tabRefs = useRef<Map<TabKey, HTMLButtonElement>>(new Map())\n49\t\n50\t  const registerTabRef = useCallback((key: TabKey, el: HTMLButtonElement | null) => {\n51\t    if (el) tabRefs.current.set(key, el)\n52\t    else tabRefs.current.delete(key)\n53\t  }, [])\n54\t\n55\t  const handleTabKeyDown = useCallback((e: React.KeyboardEvent) => {\n56\t    const idx = tabs.findIndex(t => t.key === activeTab)\n57\t    if (e.key === 'ArrowRight') {\n58\t      e.preventDefault()\n59\t      const next = tabs[(idx + 1) % tabs.length]\n60\t      setActiveTab(next.key)\n61\t      tabRefs.current.get(next.key)?.focus()\n62\t    } else if (e.key === 'ArrowLeft') {\n63\t      e.preventDefault()\n64\t      const prev = tabs[(idx - 1 + tabs.length) % tabs.length]\n65\t      setActiveTab(prev.key)\n66\t      tabRefs.current.get(prev.key)?.focus()\n67\t    }\n68\t  }, [activeTab])\n69\t\n70\t  // Keyboard shortcuts: 1-7 to switch tabs\n71\t  useEffect(() => {\n72\t    const handler = (e: KeyboardEvent) => {\n73\t      const target = e.target as HTMLElement\n74\t      if (target.tagName === 'INPUT' || target.tagName === 'TEXTAREA' || target.isContentEditable) return\n75\t      if (e.metaKey || e.ctrlKey || e.altKey) return\n76\t      const num = parseInt(e.key)\n77\t      if (num >= 1 && num <= tabs.length) {\n78\t        e.preventDefault()\n79\t        setActiveTab(tabs[num - 1].key)\n80\t      }\n81\t    }\n82\t    document.addEventListener('keydown', handler)\n83\t    return () => document.removeEventListener('keydown', handler)\n84\t  }, [])\n85\t\n86\t  // 空闲状态：显示\"开始分析\"按钮\n87\t  if (status === 'idle' && !result) {\n88\t    return (\n89\t      <div className=\"flex flex-col items-center justify-center h-full gap-6 p-8\">\n90\t        <div className=\"w-16 h-16 rounded-full flex items-center justify-center\" style={{ backgroundColor: 'var(--bg-surface)', border: '1px solid var(--border)' }}>\n91\t          <svg className=\"w-7 h-7\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\" style={{ color: 'var(--text-muted)' }}>\n92\t            <path strokeLinecap=\"round\" strokeLinejoin=\"round\" strokeWidth={1.5}\n93\t              d=\"M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z\"\n94\t            />\n95\t          </svg>\n96\t        </div>\n97\t        <div className=\"text-center\">\n98\t          <h3 className=\"text-lg font-medium mb-2\" style={{ color: 'var(--text-primary)' }}>尚未分析</h3>\n99\t          <p className=\"text-sm mb-6\" style={{ color: 'var(--text-muted)' }}>点击下方按钮开始分析这篇论文</p>\n100\t          <button\n101\t            onClick={onStartAnalysis}\n102\t            className=\"px-6 py-2.5 text-sm font-medium rounded-lg transition-colors\"\n103\t            style={{ backgroundColor: 'var(--accent)', color: 'var(--bg-base)' }}\n104\t          >\n105\t            开始分析\n106\t          </button>\n107\t        </div>\n108\t      </div>\n109\t    )\n110\t  }\n111\t\n112\t  // 如果正在解析中，显示 LoadingState\n113\t  if (status !== 'done' || !result) {\n114\t    return (\n115\t      <div className=\"flex flex-col h-full\">\n116\t        <LoadingState status={status} message={progressMessage} partialResult={partialResult} progress={progress} />\n117\t      </div>\n118\t    )\n119\t  }\n120\t\n121\t  return (\n122\t    <div className=\"flex flex-col h-full\">\n123\t      {/* Tab 栏 */}\n124\t      <div role=\"tablist\" className=\"flex items-center gap-0 sticky top-0 z-10 shrink-0\" style={{\n125\t        backgroundColor: 'var(--bg-surface)',\n126\t        borderBottom: '1px solid var(--border)',\n127\t      }}>\n128\t        {tabs.map((tab, i) => (\n129\t          <button\n130\t            key={tab.key}\n131\t            ref={el => registerTabRef(tab.key, el)}\n132\t            role=\"tab\"\n133\t            aria-selected={activeTab === tab.key}\n134\t            aria-controls={`panel-${tab.key}`}\n135\t            tabIndex={activeTab === tab.key ? 0 : -1}\n136\t            onClick={() => setActiveTab(tab.key)}\n137\t            onKeyDown={handleTabKeyDown}\n138\t            className=\"px-4 py-2.5 text-sm font-medium transition-colors relative\"\n139\t            title={`${tab.label} (${i + 1})`}\n140\t            style={\n141\t              activeTab === tab.key\n142\t                ? { color: 'var(--accent)' }\n143\t                : { color: 'var(--text-muted)' }\n144\t            }\n145\t          >\n146\t            {tab.label}\n147\t            {activeTab === tab.key && (\n148\t              <span className=\"absolute bottom-0 left-2 right-2 h-0.5 rounded-full\" style={{ backgroundColor: 'var(--accent)', transition: 'left 0.2s ease' }} />\n149\t            )}\n150\t          </button>\n151\t        ))}\n152\t        <div className=\"flex-1\" />\n153\t        {onReanalyze && (\n154\t          <>\n155\t            <button\n156\t              onClick={() => setShowReanalyzeConfirm(true)}\n157\t              aria-label=\"重新分析\"\n158\t              className=\"px-3 py-1.5 mr-2 text-xs rounded-md transition-colors\"\n159\t              style={{ color: 'var(--text-muted)' }}\n160\t              title=\"全部重新分析\"\n161\t            >\n162\t              <svg className=\"w-3.5 h-3.5 inline-block mr-1\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\">\n163\t                <path strokeLinecap=\"round\" strokeLinejoin=\"round\" strokeWidth={2} d=\"M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15\" />\n164\t              </svg>\n165\t              重新分析\n166\t            </button>\n167\t            {showReanalyzeConfirm && (\n168\t              <div\n169\t                className=\"fixed inset-0 z-[200] flex items-center justify-center\"\n170\t                style={{ backgroundColor: 'rgba(0,0,0,0.45)' }}\n171\t                onMouseDown={() => setShowReanalyzeConfirm(false)}\n172\t              >\n173\t                <div\n174\t                  className=\"w-80 rounded-xl border p-5 shadow-2xl\"\n175\t                  style={{ backgroundColor: 'var(--bg-elevated)', borderColor: 'var(--border)' }}\n176\t                  onMouseDown={e => e.stopPropagation()}\n177\t                >\n178\t                  <div className=\"flex items-start gap-3 mb-4\">\n179\t                    <span className=\"mt-0.5 text-amber-400 shrink-0\">\n180\t                      <svg className=\"w-5 h-5\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\">\n181\t                        <path strokeLinecap=\"round\" strokeLinejoin=\"round\" strokeWidth={2} d=\"M12 9v2m0 4h.01M10.29 3.86L1.82 18a2 2 0 001.71 3h16.94a2 2 0 001.71-3L13.71 3.86a2 2 0 00-3.42 0z\" />\n182\t                      </svg>\n183\t                    </span>\n184\t                    <div>\n185\t                      <p className=\"text-sm font-medium mb-1\" style={{ color: 'var(--text-primary)' }}>确认重新分析？</p>\n186\t                      <p className=\"text-xs leading-relaxed\" style={{ color: 'var(--text-secondary)' }}>\n187\t                        将消耗大量 Token 重新对整篇论文进行 AI 解析，原有分析结果将被覆盖。\n188\t                      </p>\n189\t                    </div>\n190\t                  </div>\n191\t                  <div className=\"flex justify-end gap-2\">\n192\t                    <button\n193\t                      aria-label=\"取消重新分析\"\n194\t                      onClick={() => setShowReanalyzeConfirm(false)}\n195\t                      className=\"px-3 py-1.5 text-xs rounded-md border transition-colors hover:opacity-80\"\n196\t                      style={{ borderColor: 'var(--border)', color: 'var(--text-secondary)' }}\n197\t                    >\n198\t                      取消\n199\t                    </button>\n200\t                    <button\n201\t                      aria-label=\"确认重新分析\"\n202\t                      onClick={() => { setShowReanalyzeConfirm(false); onReanalyze() }}\n203\t                      className=\"px-3 py-1.5 text-xs rounded-md transition-colors\"\n204\t                      style={{ backgroundColor: 'var(--accent)', color: 'var(--bg-base)' }}\n205\t                    >\n206\t                      确认重新分析\n207\t                    </button>\n208\t                  </div>\n209\t                </div>\n210\t              </div>\n211\t            )}\n212\t          </>\n213\t        )}\n214\t      </div>\n215\t\n216\t      {/* 内容区 */}\n217\t      <div role=\"tabpanel\" id={`panel-${activeTab}`} className=\"flex-1 overflow-auto p-6\">\n218\t        {activeTab === 'overview' && <OverviewTab result={result} paperId={paperId} relatedStatus={relatedStatus} />}\n219\t        {activeTab === 'outline' && <OutlineTab result={result} onJumpToPage={onJumpToPage} />}\n220\t        {activeTab === 'method' && <MethodTab result={result} />}\n221\t        {activeTab === 'experiments' && <ExperimentsTab result={result} onJumpToPage={onJumpToPage} />}\n222\t        {activeTab === 'code' && <CodeTab paperId={paperId} />}\n223\t        {activeTab === 'interview' && <InterviewTab result={result} />}\n224\t        {activeTab === 'notes' && paperId && <NotesPanel paperId={paperId} />}\n225\t      </div>\n226\t    </div>\n227\t  )\n228\t}\n229\t"}]},"parent_tool_use_id":"call_bddd82a75f2e46b98e4517cc","session_id":"29257b8f-ede7-46a4-8e0f-a743591d296a","uuid":"4a3d9a81-ba8c-440c-b3bd-1d16ca04fdb2","timestamp":"2026-06-09T05:10:27.945Z","subagent_type":"Explore","task_description":"Explore frontend performance"}
