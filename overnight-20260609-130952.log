{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call_ceeb642aa5fe4fb589d32509","type":"tool_result","content":"1\t/**\n2\t * ConfirmDialog 通用确认弹窗\n3\t *\n4\t * 可复用的确认对话框组件，支持 danger/warning 两种变体，\n5\t * 包含焦点捕获、Escape 关闭、点击背景关闭等无障碍功能。\n6\t */\n7\t\n8\timport { useEffect, useRef } from 'react'\n9\t\n10\tinterface ConfirmDialogProps {\n11\t  open: boolean\n12\t  title: string\n13\t  message: string\n14\t  confirmLabel?: string  // default \"确认\"\n15\t  cancelLabel?: string   // default \"取消\"\n16\t  variant?: 'danger' | 'warning'  // default 'danger'\n17\t  onConfirm: () => void\n18\t  onCancel: () => void\n19\t}\n20\t\n21\tconst ICONS = {\n22\t  danger: (\n23\t    <svg className=\"w-5 h-5\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\">\n24\t      <path strokeLinecap=\"round\" strokeLinejoin=\"round\" strokeWidth={2}\n25\t        d=\"M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16\"\n26\t      />\n27\t    </svg>\n28\t  ),\n29\t  warning: (\n30\t    <svg className=\"w-5 h-5\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\">\n31\t      <path strokeLinecap=\"round\" strokeLinejoin=\"round\" strokeWidth={2}\n32\t        d=\"M12 9v2m0 4h.01M10.29 3.86L1.82 18a2 2 0 001.71 3h16.94a2 2 0 001.71-3L13.71 3.86a2 2 0 00-3.42 0z\"\n33\t      />\n34\t    </svg>\n35\t  ),\n36\t}\n37\t\n38\tconst ICON_COLORS = {\n39\t  danger: 'var(--error)',\n40\t  warning: 'text-amber-400',\n41\t}\n42\t\n43\texport function ConfirmDialog({\n44\t  open,\n45\t  title,\n46\t  message,\n47\t  confirmLabel = '确认',\n48\t  cancelLabel = '取消',\n49\t  variant = 'danger',\n50\t  onConfirm,\n51\t  onCancel,\n52\t}: ConfirmDialogProps) {\n53\t  const cancelRef = useRef<HTMLButtonElement>(null)\n54\t  const cardRef = useRef<HTMLDivElement>(null)\n55\t\n56\t  // Focus trap: focus cancel button on open, Tab cycles within dialog\n57\t  useEffect(() => {\n58\t    if (!open) return\n59\t    cancelRef.current?.focus()\n60\t\n61\t    const handleKeyDown = (e: KeyboardEvent) => {\n62\t      if (e.key === 'Escape') {\n63\t        e.preventDefault()\n64\t        onCancel()\n65\t        return\n66\t      }\n67\t      if (e.key === 'Tab' && cardRef.current) {\n68\t        const focusable = cardRef.current.querySelectorAll<HTMLElement>(\n69\t          'button, [href], input, select, textarea, [tabindex]:not([tabindex=\"-1\"])'\n70\t        )\n71\t        if (focusable.length === 0) return\n72\t        const first = focusable[0]\n73\t        const last = focusable[focusable.length - 1]\n74\t        if (e.shiftKey) {\n75\t          if (document.activeElement === first) {\n76\t            e.preventDefault()\n77\t            last.focus()\n78\t          }\n79\t        } else {\n80\t          if (document.activeElement === last) {\n81\t            e.preventDefault()\n82\t            first.focus()\n83\t          }\n84\t        }\n85\t      }\n86\t    }\n87\t\n88\t    document.addEventListener('keydown', handleKeyDown)\n89\t    return () => document.removeEventListener('keydown', handleKeyDown)\n90\t  }, [open, onCancel])\n91\t\n92\t  if (!open) return null\n93\t\n94\t  return (\n95\t    <div\n96\t      className=\"fixed inset-0 z-[200] flex items-center justify-center\"\n97\t      style={{ backgroundColor: 'rgba(0,0,0,0.45)' }}\n98\t      onMouseDown={onCancel}\n99\t      role=\"dialog\"\n100\t      aria-modal=\"true\"\n101\t      aria-labelledby=\"confirm-dialog-title\"\n102\t    >\n103\t      <div\n104\t        ref={cardRef}\n105\t        className=\"w-80 rounded-xl border p-5 shadow-2xl\"\n106\t        style={{ backgroundColor: 'var(--bg-elevated)', borderColor: 'var(--border)' }}\n107\t        onMouseDown={e => e.stopPropagation()}\n108\t      >\n109\t        <div className=\"flex items-start gap-3 mb-4\">\n110\t          <span className={`mt-0.5 shrink-0 ${variant === 'warning' ? ICON_COLORS.warning : ''}`}\n111\t            style={variant === 'danger' ? { color: ICON_COLORS.danger } : undefined}\n112\t          >\n113\t            {ICONS[variant]}\n114\t          </span>\n115\t          <div>\n116\t            <p id=\"confirm-dialog-title\" className=\"text-sm font-medium mb-1\" style={{ color: 'var(--text-primary)' }}>\n117\t              {title}\n118\t            </p>\n119\t            <p className=\"text-xs leading-relaxed\" style={{ color: 'var(--text-secondary)' }}>\n120\t              {message}\n121\t            </p>\n122\t          </div>\n123\t        </div>\n124\t        <div className=\"flex justify-end gap-2\">\n125\t          <button\n126\t            ref={cancelRef}\n127\t            onClick={onCancel}\n128\t            className=\"px-3 py-1.5 text-xs rounded-md border transition-colors hover:opacity-80\"\n129\t            style={{ borderColor: 'var(--border)', color: 'var(--text-secondary)' }}\n130\t          >\n131\t            {cancelLabel}\n132\t          </button>\n133\t          <button\n134\t            onClick={onConfirm}\n135\t            className=\"px-3 py-1.5 text-xs rounded-md transition-colors\"\n136\t            style={\n137\t              variant === 'danger'\n138\t                ? { backgroundColor: 'var(--error)', color: '#fff' }\n139\t                : { backgroundColor: 'var(--accent)', color: 'var(--bg-base)' }\n140\t            }\n141\t          >\n142\t            {confirmLabel}\n143\t          </button>\n144\t        </div>\n145\t      </div>\n146\t    </div>\n147\t  )\n148\t}\n149\t"}]},"parent_tool_use_id":"call_bddd82a75f2e46b98e4517cc","session_id":"29257b8f-ede7-46a4-8e0f-a743591d296a","uuid":"0d62f4d9-566d-4e4f-84ff-0c6ed328e9ed","timestamp":"2026-06-09T05:10:53.452Z","subagent_type":"Explore","task_description":"Explore frontend performance"}
