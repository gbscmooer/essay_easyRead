{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call_edc516c213ce438fa23e62c0","type":"tool_result","content":"1\timport { useState, useEffect, useRef, useMemo, useCallback } from 'react'\n2\timport ReactMarkdown from 'react-markdown'\n3\timport remarkGfm from 'remark-gfm'\n4\timport mermaid from 'mermaid'\n5\timport type { CodeAnalysisResult, DependencyEdge, PaperCodeMapping } from '@/types'\n6\timport { getCodeFile } from '@/api/code'\n7\timport { useThemeMode } from '@/theme/useTheme'\n8\t\n9\t\n10\tinterface CodeAnalysisPanelProps {\n11\t  analysis: CodeAnalysisResult | null\n12\t  isAnalyzing: boolean\n13\t  paperId?: number\n14\t  onFileClick?: (path: string, line?: number) => void\n15\t  onCollapse?: () => void\n16\t}\n17\t\n18\t\n19\tconst tabs = [\n20\t  { key: 'dataflow', label: '数据流' },\n21\t  { key: 'deps', label: '依赖图' },\n22\t  { key: 'mapping', label: '论文映射' },\n23\t] as const\n24\t\n25\ttype TabKey = typeof tabs[number]['key']\n26\t\n27\t\n28\tfunction DataFlowTab({ dataFlow }: { dataFlow: string | null }) {\n29\t  if (!dataFlow) {\n30\t    return <div className=\"text-sm text-center py-8\" style={{ color: 'var(--text-muted)' }}>暂无数据流分析</div>\n31\t  }\n32\t  return (\n33\t    <div className=\"prose prose-invert prose-sm max-w-none text-sm leading-relaxed\">\n34\t      <ReactMarkdown remarkPlugins={[remarkGfm]}>{dataFlow}</ReactMarkdown>\n35\t    </div>\n36\t  )\n37\t}\n38\t\n39\t\n40\tfunction nodeIdHash(path: string): string {\n41\t  let h = 0\n42\t  for (let i = 0; i < path.length; i++) {\n43\t    h = ((h << 5) - h + path.charCodeAt(i)) | 0\n44\t  }\n45\t  return 'n_' + Math.abs(h).toString(36)\n46\t}\n47\t\n48\tfunction sanitizeLabel(path: string): string {\n49\t  return path.replace(/[\\[\\]{}()#\"']/g, '')\n50\t}\n51\t\n52\tfunction edgesToMermaid(edges: DependencyEdge[]): string {\n53\t  const lines = ['graph LR']\n54\t  const seen = new Set<string>()\n55\t  for (const edge of edges) {\n56\t    const srcId = nodeIdHash(edge.source)\n57\t    const tgtId = nodeIdHash(edge.target)\n58\t    if (!seen.has(srcId)) {\n59\t      lines.push(`  ${srcId}[\"${sanitizeLabel(edge.source)}\"]`)\n60\t      seen.add(srcId)\n61\t    }\n62\t    if (!seen.has(tgtId)) {\n63\t      lines.push(`  ${tgtId}[\"${sanitizeLabel(edge.target)}\"]`)\n64\t      seen.add(tgtId)\n65\t    }\n66\t    const label = edge.imports.length > 0 ? sanitizeLabel(edge.imports.join(', ')) : ''\n67\t    const arrow = edge.circular ? '-.->' : '-->'\n68\t    if (label) {\n69\t      lines.push(`  ${srcId} ${arrow}|\"${label}\"| ${tgtId}`)\n70\t    } else {\n71\t      lines.push(`  ${srcId} ${arrow} ${tgtId}`)\n72\t    }\n73\t  }\n74\t  return lines.join('\\n')\n75\t}\n76\t\n77\tlet mermaidMode: 'light' | 'dark' | null = null\n78\tfunction ensureMermaid(mode: 'light' | 'dark') {\n79\t  if (mermaidMode === mode) return\n80\t  const cs = getComputedStyle(document.documentElement)\n81\t  const v = (name: string, fallback: string) => cs.getPropertyValue(name).trim() || fallback\n82\t  mermaid.initialize({\n83\t    startOnLoad: false,\n84\t    theme: mode === 'dark' ? 'dark' : 'default',\n85\t    themeVariables: {\n86\t      primaryColor: v('--bg-elevated', '#1f2937'),\n87\t      primaryTextColor: v('--text-primary', '#e5e7eb'),\n88\t      primaryBorderColor: v('--border-light', '#6b7280'),\n89\t      lineColor: v('--text-muted', '#6b7280'),\n90\t      secondaryColor: v('--bg-surface', '#1f2937'),\n91\t      tertiaryColor: v('--bg-base', '#111827'),\n92\t      background: v('--bg-surface', '#1f2937'),\n93\t      mainBkg: v('--bg-elevated', '#1f2937'),\n94\t      nodeBorder: v('--border-light', '#6b7280'),\n95\t      nodeTextColor: v('--text-primary', '#e5e7eb'),\n96\t      clusterBkg: v('--bg-base', '#111827'),\n97\t      clusterBorder: v('--border', '#374151'),\n98\t      edgeLabelBackground: v('--bg-elevated', '#1f2937'),\n99\t    },\n100\t  })\n101\t  mermaidMode = mode\n102\t}\n103\t\n104\tfunction stripEventHandlers(svg: string): string {\n105\t  return svg\n106\t    .replace(/\\bon\\w+\\s*=\\s*[\"'][^\"']*[\"']/gi, '')\n107\t    .replace(/\\bon\\w+\\s*=\\s*\\{[^}]*\\}/gi, '')\n108\t}\n109\t\n110\t\n111\tfunction buildLabelToPathMap(edges: DependencyEdge[]): Map<string, string> {\n112\t  const map = new Map<string, string>()\n113\t  for (const edge of edges) {\n114\t    const srcLabel = sanitizeLabel(edge.source)\n115\t    const tgtLabel = sanitizeLabel(edge.target)\n116\t    if (!map.has(srcLabel)) map.set(srcLabel, edge.source)\n117\t    if (!map.has(tgtLabel)) map.set(tgtLabel, edge.target)\n118\t  }\n119\t  return map\n120\t}\n121\t\n122\tfunction DependencyGraph({\n123\t  edges,\n124\t  onFileClick,\n125\t  onFullscreen,\n126\t}: {\n127\t  edges: DependencyEdge[]\n128\t  onFileClick?: (path: string) => void\n129\t  onFullscreen?: () => void\n130\t}) {\n131\t  const containerRef = useRef<HTMLDivElement>(null)\n132\t  const [svg, setSvg] = useState<string>('')\n133\t  const [error, setError] = useState<string | null>(null)\n134\t\n135\t  const mode = useThemeMode()\n136\t  const chart = useMemo(() => edgesToMermaid(edges), [edges])\n137\t  const labelToPath = useMemo(() => buildLabelToPathMap(edges), [edges])\n138\t\n139\t  useEffect(() => {\n140\t    if (!chart) return\n141\t    ensureMermaid(mode)\n142\t    const id = `dep-${Date.now()}-${Math.random().toString(36).slice(2, 8)}`\n143\t    mermaid.render(id, chart).then(\n144\t      ({ svg: rendered }) => { setSvg(stripEventHandlers(rendered)); setError(null) },\n145\t      (err) => { setError(err?.message || '渲染失败'); setSvg('') },\n146\t    )\n147\t  }, [chart, mode])\n148\t\n149\t  useEffect(() => {\n150\t    if (!svg || !containerRef.current) return\n151\t    const container = containerRef.current\n152\t    const nodes = container.querySelectorAll('g.node')\n153\t    const cleanups: Array<() => void> = []\n154\t    nodes.forEach((node) => {\n155\t      const text = node.textContent?.trim()\n156\t      if (!text) return\n157\t      const filePath = labelToPath.get(text)\n158\t      if (filePath && onFileClick) {\n159\t        (node as HTMLElement).style.cursor = 'pointer'\n160\t        const handler = () => onFileClick(filePath)\n161\t        node.addEventListener('click', handler)\n162\t        cleanups.push(() => node.removeEventListener('click', handler))\n163\t      }\n164\t    })\n165\t    return () => { cleanups.forEach(fn => fn()) }\n166\t  }, [svg, labelToPath, onFileClick])\n167\t\n168\t  if (error) {\n169\t    return (\n170\t      <div className=\"rounded-lg p-4 border\" style={{ backgroundColor: 'var(--bg-elevated)', borderColor: 'var(--border-light)' }}>\n171\t        <p className=\"text-xs mb-2\" style={{ color: 'var(--error)' }}>依赖图渲染失败</p>\n172\t        <pre className=\"text-xs whitespace-pre-wrap\" style={{ color: 'var(--text-muted)' }}>{chart}</pre>\n173\t      </div>\n174\t    )\n175\t  }\n176\t\n177\t  return (\n178\t    <div className=\"relative\">\n179\t      <div ref={containerRef} className=\"mermaid rounded-lg p-4 overflow-auto flex justify-center\" style={{ backgroundColor: 'var(--bg-elevated)' }}>\n180\t        {svg ? (\n181\t          <div dangerouslySetInnerHTML={{ __html: svg }} />\n182\t        ) : (\n183\t          <div className=\"flex items-center justify-center py-8\">\n184\t            <div className=\"w-5 h-5 border-2 rounded-full animate-spin\" style={{ borderColor: 'var(--border-light)', borderTopColor: 'var(--accent)' }} />\n185\t          </div>\n186\t        )}\n187\t      </div>\n188\t      {svg && onFullscreen && (\n189\t        <button\n190\t          onClick={onFullscreen}\n191\t          className=\"absolute top-2 right-2 p-1.5 rounded transition-colors\"\n192\t          style={{ backgroundColor: 'var(--bg-elevated)', opacity: 0.8, color: 'var(--text-secondary)' }}\n193\t          onMouseEnter={e => { (e.currentTarget as HTMLElement).style.color = 'var(--text-primary)'; (e.currentTarget as HTMLElement).style.opacity = '1' }}\n194\t          onMouseLeave={e => { (e.currentTarget as HTMLElement).style.color = 'var(--text-secondary)'; (e.currentTarget as HTMLElement).style.opacity = '0.8' }}\n195\t          title=\"全屏查看\"\n196\t        >\n197\t          <svg width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" strokeWidth=\"2\" strokeLinecap=\"round\" strokeLinejoin=\"round\">\n198\t            <path d=\"M8 3H5a2 2 0 0 0-2 2v3\" /><path d=\"M21 8V5a2 2 0 0 0-2-2h-3\" />\n199\t            <path d=\"M3 16v3a2 2 0 0 0 2 2h3\" /><path d=\"M16 21h3a2 2 0 0 0 2-2v-3\" />\n200\t          </svg>\n201\t        </button>\n202\t      )}\n203\t    </div>\n204\t  )\n205\t}\n206\t\n207\t\n208\tfunction FullscreenGraph({\n209\t  edges,\n210\t  onFileClick,\n211\t  onClose,\n212\t}: {\n213\t  edges: DependencyEdge[]\n214\t  onFileClick?: (path: string) => void\n215\t  onClose: () => void\n216\t}) {\n217\t  const containerRef = useRef<HTMLDivElement>(null)\n218\t  const [svg, setSvg] = useState<string>('')\n219\t  const [zoom, setZoom] = useState(3)\n220\t  const [error, setError] = useState<string | null>(null)\n221\t\n222\t  const mode = useThemeMode()\n223\t  const chart = useMemo(() => edgesToMermaid(edges), [edges])\n224\t  const labelToPath = useMemo(() => buildLabelToPathMap(edges), [edges])\n225\t\n226\t  useEffect(() => {\n227\t    if (!chart) return\n228\t    ensureMermaid(mode)\n229\t    const id = `dep-fs-${Date.now()}-${Math.random().toString(36).slice(2, 8)}`\n230\t    mermaid.render(id, chart).then(\n231\t      ({ svg: rendered }) => { setSvg(stripEventHandlers(rendered)); setError(null) },\n232\t      (err) => { setError(err?.message || '渲染失败'); setSvg('') },\n233\t    )\n234\t  }, [chart, mode])\n235\t\n236\t  useEffect(() => {\n237\t    if (!svg || !containerRef.current) return\n238\t    const container = containerRef.current\n239\t    const nodes = container.querySelectorAll('g.node')\n240\t    const cleanups: Array<() => void> = []\n241\t    nodes.forEach((node) => {\n242\t      const text = node.textContent?.trim()\n243\t      if (!text) return\n244\t      const filePath = labelToPath.get(text)\n245\t      if (filePath && onFileClick) {\n246\t        (node as HTMLElement).style.cursor = 'pointer'\n247\t        const handler = () => onFileClick(filePath)\n248\t        node.addEventListener('click', handler)\n249\t        cleanups.push(() => node.removeEventListener('click', handler))\n250\t      }\n251\t    })\n252\t    return () => { cleanups.forEach(fn => fn()) }\n253\t  }, [svg, labelToPath, onFileClick])\n254\t\n255\t  useEffect(() => {\n256\t    const handleKey = (e: KeyboardEvent) => {\n257\t      if (e.key === 'Escape') onClose()\n258\t    }\n259\t    window.addEventListener('keydown', handleKey)\n260\t    return () => window.removeEventListener('keydown', handleKey)\n261\t  }, [onClose])\n262\t\n263\t  const zoomIn = useCallback(() => setZoom((z) => Math.min(3, +(z + 0.2).toFixed(1))), [])\n264\t  const zoomOut = useCallback(() => setZoom((z) => Math.max(0.5, +(z - 0.2).toFixed(1))), [])\n265\t  const zoomReset = useCallback(() => setZoom(3), [])\n266\t\n267\t  return (\n268\t    <div className=\"fixed inset-0 z-50 flex items-center justify-center\">\n269\t      <div className=\"absolute inset-0 bg-black/50\" onClick={onClose} />\n270\t      <div className=\"relative w-[85vw] h-[80vh] rounded-xl shadow-2xl border flex flex-col overflow-hidden\"\n271\t        style={{ backgroundColor: 'var(--bg-surface)', borderColor: 'var(--border-light)' }}>\n272\t        <div className=\"flex items-center justify-between px-4 py-2 border-b shrink-0\" style={{ backgroundColor: 'var(--bg-surface)', borderColor: 'var(--border-light)' }}>\n273\t          <span className=\"text-sm font-medium\" style={{ color: 'var(--text-primary)' }}>依赖图</span>\n274\t          <div className=\"flex items-center gap-2\">\n275\t            <button onClick={zoomOut} className=\"px-2 py-1 text-xs rounded transition-colors\" style={{ backgroundColor: 'var(--bg-elevated)', color: 'var(--text-secondary)' }} onMouseEnter={e => { (e.currentTarget as HTMLElement).style.backgroundColor = 'var(--bg-surface)' }} onMouseLeave={e => { (e.currentTarget as HTMLElement).style.backgroundColor = 'var(--bg-elevated)' }}>缩小</button>\n276\t            <span className=\"text-xs w-10 text-center\" style={{ color: 'var(--text-secondary)' }}>{Math.round(zoom * 100)}%</span>\n277\t            <button onClick={zoomIn} className=\"px-2 py-1 text-xs rounded transition-colors\" style={{ backgroundColor: 'var(--bg-elevated)', color: 'var(--text-secondary)' }} onMouseEnter={e => { (e.currentTarget as HTMLElement).style.backgroundColor = 'var(--bg-surface)' }} onMouseLeave={e => { (e.currentTarget as HTMLElement).style.backgroundColor = 'var(--bg-elevated)' }}>放大</button>\n278\t            <button onClick={zoomReset} className=\"px-2 py-1 text-xs rounded transition-colors\" style={{ backgroundColor: 'var(--bg-elevated)', color: 'var(--text-secondary)' }} onMouseEnter={e => { (e.currentTarget as HTMLElement).style.backgroundColor = 'var(--bg-surface)' }} onMouseLeave={e => { (e.currentTarget as HTMLElement).style.backgroundColor = 'var(--bg-elevated)' }}>重置</button>\n279\t            <button onClick={onClose} className=\"ml-2 p-1 rounded transition-colors\"\n280\t              style={{ color: 'var(--text-secondary)' }}\n281\t              onMouseEnter={e => { (e.currentTarget as HTMLElement).style.backgroundColor = 'var(--bg-elevated)'; (e.currentTarget as HTMLElement).style.color = 'var(--text-primary)' }}\n282\t              onMouseLeave={e => { (e.currentTarget as HTMLElement).style.backgroundColor = ''; (e.currentTarget as HTMLElement).style.color = 'var(--text-secondary)' }}>\n283\t              <svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" strokeWidth=\"2\" strokeLinecap=\"round\" strokeLinejoin=\"round\">\n284\t                <line x1=\"18\" y1=\"6\" x2=\"6\" y2=\"18\" /><line x1=\"6\" y1=\"6\" x2=\"18\" y2=\"18\" />\n285\t              </svg>\n286\t            </button>\n287\t          </div>\n288\t        </div>\n289\t        <div className=\"flex-1 overflow-auto flex items-center justify-center p-8\">\n290\t          {error ? (\n291\t            <p className=\"text-red-400 text-sm\">{error}</p>\n292\t          ) : svg ? (\n293\t            <div ref={containerRef} style={{ transform: `scale(${zoom})`, transformOrigin: 'center center' }}>\n294\t              <div dangerouslySetInnerHTML={{ __html: svg }} />\n295\t            </div>\n296\t          ) : (\n297\t            <div className=\"w-6 h-6 border-2 rounded-full animate-spin\" style={{ borderColor: 'var(--border-light)', borderTopColor: 'var(--accent)' }} />\n298\t          )}\n299\t        </div>\n300\t      </div>\n301\t    </div>\n302\t  )\n303\t}\n304\t\n305\tfunction DependencyTab({ edges, onFileClick }: { edges: DependencyEdge[]; onFileClick?: (path: string) => void }) {\n306\t  const [showFullscreen, setShowFullscreen] = useState(false)\n307\t\n308\t  if (!edges || edges.length === 0) {\n309\t    return <div className=\"text-sm text-center py-8\" style={{ color: 'var(--text-muted)' }}>暂无依赖分析</div>\n310\t  }\n311\t\n312\t  const grouped = new Map<string, DependencyEdge[]>()\n313\t  for (const edge of edges) {\n314\t    const list = grouped.get(edge.source) || []\n315\t    list.push(edge)\n316\t    grouped.set(edge.source, list)\n317\t  }\n318\t\n319\t  return (\n320\t    <div className=\"space-y-4\">\n321\t      <DependencyGraph\n322\t        edges={edges}\n323\t        onFileClick={onFileClick}\n324\t        onFullscreen={() => setShowFullscreen(true)}\n325\t      />\n326\t\n327\t      <div className=\"space-y-3\">\n328\t        {Array.from(grouped.entries()).map(([source, deps]) => (\n329\t          <div key={source} className=\"rounded-lg p-3 border\" style={{ backgroundColor: 'var(--bg-elevated)', borderColor: 'var(--border-light)' }}>\n330\t            <button\n331\t              onClick={() => onFileClick?.(source)}\n332\t              className=\"text-xs font-mono text-blue-400 hover:text-blue-300 transition-colors\"\n333\t            >\n334\t              {source}\n335\t            </button>\n336\t            <div className=\"mt-1.5 space-y-1\">\n337\t              {deps.map((dep, idx) => (\n338\t                <div key={idx} className=\"flex items-center gap-2 text-xs\">\n339\t                  <span style={{ color: 'var(--text-muted)' }}>→</span>\n340\t                  <button\n341\t                    onClick={() => onFileClick?.(dep.target)}\n342\t                    className=\"font-mono transition-colors\" style={{ color: 'var(--text-secondary)' }} onMouseEnter={e => { (e.currentTarget as HTMLElement).style.color = 'var(--text-primary)' }} onMouseLeave={e => { (e.currentTarget as HTMLElement).style.color = 'var(--text-secondary)' }}\n343\t                  >\n344\t                    {dep.target}\n345\t                  </button>\n346\t                  {dep.imports.length > 0 && (\n347\t                    <span style={{ color: 'var(--text-muted)' }}>\n348\t                      ({dep.imports.join(', ')})\n349\t                    </span>\n350\t                  )}\n351\t                </div>\n352\t              ))}\n353\t            </div>\n354\t          </div>\n355\t        ))}\n356\t      </div>\n357\t\n358\t      {showFullscreen && (\n359\t        <FullscreenGraph\n360\t          edges={edges}\n361\t          onFileClick={onFileClick}\n362\t          onClose={() => setShowFullscreen(false)}\n363\t        />\n364\t      )}\n365\t    </div>\n366\t  )\n367\t}\n368\t\n369\t\n370\tfunction findFunctionLine(content: string, funcName: string): number | null {\n371\t  const name = funcName.includes('.') ? funcName.split('.').pop()! : funcName\n372\t  const escaped = name.replace(/[.*+?^${}()|[\\]\\\\]/g, '\\\\$&')\n373\t  const patterns = [\n374\t    new RegExp(`^\\\\s*def\\\\s+${escaped}\\\\b`),\n375\t    new RegExp(`^\\\\s*function\\\\s+${escaped}\\\\b`),\n376\t    new RegExp(`^\\\\s*func\\\\s+${escaped}\\\\b`),\n377\t    new RegExp(`^\\\\s*class\\\\s+${escaped}\\\\b`),\n378\t    new RegExp(`^\\\\s*${escaped}\\\\s*=`),\n379\t    new RegExp(`^\\\\s*${escaped}\\\\s*:`),\n380\t  ]\n381\t  const lines = content.split('\\n')\n382\t  for (let i = 0; i < lines.length; i++) {\n383\t    for (const pat of patterns) {\n384\t      if (pat.test(lines[i])) return i + 1\n385\t    }\n386\t  }\n387\t  return null\n388\t}\n389\t\n390\tfunction FunctionNameButton({\n391\t  funcName,\n392\t  paperId,\n393\t  filePath,\n394\t  onFileClick,\n395\t}: {\n396\t  funcName: string\n397\t  paperId: number\n398\t  filePath: string\n399\t  onFileClick: (path: string, line?: number) => void\n400\t}) {\n401\t  const [loading, setLoading] = useState(false)\n402\t\n403\t  const handleClick = async () => {\n404\t    setLoading(true)\n405\t    try {\n406\t      const res = await getCodeFile(paperId, filePath)\n407\t      if (res.content) {\n408\t        const line = findFunctionLine(res.content, funcName)\n409\t        if (line != null) {\n410\t          onFileClick(filePath, line)\n411\t        } else {\n412\t          onFileClick(filePath)\n413\t        }\n414\t      } else {\n415\t        onFileClick(filePath)\n416\t      }\n417\t    } catch {\n418\t      onFileClick(filePath)\n419\t    } finally {\n420\t      setLoading(false)\n421\t    }\n422\t  }\n423\t\n424\t  return (\n425\t    <button\n426\t      onClick={handleClick}\n427\t      disabled={loading}\n428\t      className=\"text-xs font-mono text-blue-400 hover:text-blue-300 transition-colors cursor-pointer disabled:opacity-50\"\n429\t    >\n430\t      {loading ? '...' : funcName}\n431\t    </button>\n432\t  )\n433\t}\n434\t\n435\tfunction PaperMappingTab({\n436\t  mappings,\n437\t  onFileClick,\n438\t  paperId,\n439\t}: {\n440\t  mappings: PaperCodeMapping[]\n441\t  onFileClick?: (path: string, line?: number) => void\n442\t  paperId?: number\n443\t}) {\n444\t  if (!mappings || mappings.length === 0) {\n445\t    return <div className=\"text-sm text-center py-8\" style={{ color: 'var(--text-muted)' }}>暂无论文-代码映射</div>\n446\t  }\n447\t\n448\t  return (\n449\t    <div className=\"space-y-3\">\n450\t      {mappings.map((m, idx) => (\n451\t        <div key={idx} className=\"rounded-lg p-3 border\" style={{ backgroundColor: 'var(--bg-elevated)', borderColor: 'var(--border-light)' }}>\n452\t          <div className=\"flex items-start gap-2 mb-2\">\n453\t            <span className=\"flex-shrink-0 w-5 h-5 flex items-center justify-center bg-blue-500/20 text-blue-400 rounded-full text-xs font-medium\">\n454\t              {idx + 1}\n455\t            </span>\n456\t            <span className=\"text-sm font-medium\" style={{ color: 'var(--text-primary)' }}>{m.concept}</span>\n457\t          </div>\n458\t          <div className=\"pl-7 space-y-1.5\">\n459\t            <div className=\"flex items-center gap-2\">\n460\t              <span className=\"text-xs\" style={{ color: 'var(--text-muted)' }}>文件:</span>\n461\t              <button\n462\t                onClick={() => onFileClick?.(m.file)}\n463\t                className=\"text-xs font-mono text-blue-400 hover:text-blue-300 transition-colors\"\n464\t              >\n465\t                {m.file}\n466\t              </button>\n467\t            </div>\n468\t            <div className=\"flex items-center gap-2\">\n469\t              <span className=\"text-xs\" style={{ color: 'var(--text-muted)' }}>函数:</span>\n470\t              {paperId != null && onFileClick ? (\n471\t                <FunctionNameButton\n472\t                  funcName={m.function}\n473\t                  paperId={paperId}\n474\t                  filePath={m.file}\n475\t                  onFileClick={onFileClick}\n476\t                />\n477\t              ) : (\n478\t                <span className=\"text-xs font-mono\" style={{ color: 'var(--text-secondary)' }}>{m.function}</span>\n479\t              )}\n480\t            </div>\n481\t            <p className=\"text-xs leading-relaxed\" style={{ color: 'var(--text-secondary)' }}>{m.explanation}</p>\n482\t          </div>\n483\t        </div>\n484\t      ))}\n485\t    </div>\n486\t  )\n487\t}\n488\t\n489\t\n490\texport function CodeAnalysisPanel({ analysis, isAnalyzing, paperId, onFileClick, onCollapse: _onCollapse }: CodeAnalysisPanelProps) {\n491\t  const [activeTab, setActiveTab] = useState<TabKey>('dataflow')\n492\t\n493\t  return (\n494\t    <div className=\"flex flex-col h-full\">\n495\t      {/* Tab 栏 */}\n496\t      <div className=\"flex items-center gap-0 shrink-0 border-b\" style={{ borderColor: 'var(--border)' }}>\n497\t        {tabs.map(tab => (\n498\t          <button\n499\t            key={tab.key}\n500\t            onClick={() => setActiveTab(tab.key)}\n501\t            className=\"px-3 py-2 text-xs font-medium transition-colors relative\"\n502\t              style={activeTab === tab.key ? { color: 'var(--accent)' } : { color: 'var(--text-muted)' }}\n503\t              onMouseEnter={e => { if (activeTab !== tab.key) (e.currentTarget as HTMLElement).style.color = 'var(--text-secondary)' }}\n504\t              onMouseLeave={e => { if (activeTab !== tab.key) (e.currentTarget as HTMLElement).style.color = 'var(--text-muted)' }}\n505\t          >\n506\t            {tab.label}\n507\t            {activeTab === tab.key && (\n508\t              <span className=\"absolute bottom-0 left-0 right-0 h-0.5 bg-blue-400\" />\n509\t            )}\n510\t          </button>\n511\t        ))}\n512\t      </div>\n513\t\n514\t      {/* 内容区 */}\n515\t      <div className=\"flex-1 overflow-auto p-4\">\n516\t        {isAnalyzing && !analysis ? (\n517\t          <div className=\"flex flex-col items-center justify-center h-full gap-3\">\n518\t            <div className=\"w-6 h-6 border-2 rounded-full animate-spin\" style={{ borderColor: 'var(--border-light)', borderTopColor: 'var(--accent)' }} />\n519\t            <p className=\"text-sm\" style={{ color: 'var(--text-muted)' }}>正在分析代码...</p>\n520\t          </div>\n521\t        ) : (\n522\t          <>\n523\t            {activeTab === 'dataflow' && <DataFlowTab dataFlow={analysis?.data_flow || null} />}\n524\t            {activeTab === 'deps' && <DependencyTab edges={analysis?.dependency_graph || []} onFileClick={onFileClick} />}\n525\t            {activeTab === 'mapping' && <PaperMappingTab mappings={analysis?.paper_code_mapping || []} onFileClick={onFileClick} paperId={paperId} />}\n526\t          </>\n527\t        )}\n528\t      </div>\n529\t    </div>\n530\t  )\n531\t}\n532\t"}]},"parent_tool_use_id":"call_bddd82a75f2e46b98e4517cc","session_id":"29257b8f-ede7-46a4-8e0f-a743591d296a","uuid":"ddd33e3f-1127-430b-a08b-018ec428b435","timestamp":"2026-06-09T05:10:58.691Z","subagent_type":"Explore","task_description":"Explore frontend performance"}
