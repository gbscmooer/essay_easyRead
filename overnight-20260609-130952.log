{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call_ca5b04eec8e543128fe54249","type":"tool_result","content":"1\timport { useState, useMemo } from 'react'\n2\timport type { Paper } from '@/types'\n3\timport { ConfirmDialog } from '@/components/ConfirmDialog'\n4\t\n5\t\n6\tinterface SidebarProps {\n7\t  papers: Paper[]\n8\t  activeId: number | null\n9\t  onSelect: (id: number) => void\n10\t  onDelete: (id: number) => void\n11\t}\n12\t\n13\tfunction statusDotColor(status: Paper['status']): string {\n14\t  switch (status) {\n15\t    case 'done': return '#22c55e'\n16\t    case 'extracting':\n17\t    case 'analyzing': return '#eab308'\n18\t    case 'failed': return '#ef4444'\n19\t    default: return 'var(--text-muted)'\n20\t  }\n21\t}\n22\t\n23\texport function Sidebar({ papers, activeId, onSelect, onDelete }: SidebarProps) {\n24\t  const [search, setSearch] = useState('')\n25\t  const [deleteTarget, setDeleteTarget] = useState<number | null>(null)\n26\t\n27\t  const filtered = useMemo(() => {\n28\t    if (!search.trim()) return papers\n29\t    const q = search.toLowerCase()\n30\t    return papers.filter(p =>\n31\t      (p.title || p.filename).toLowerCase().includes(q)\n32\t    )\n33\t  }, [papers, search])\n34\t\n35\t  return (\n36\t    <div className=\"flex flex-col w-64 h-full\" style={{\n37\t      backgroundColor: 'var(--bg-surface)',\n38\t      borderRight: '1px solid var(--border)',\n39\t    }}>\n40\t      <div className=\"p-3\" style={{ borderBottom: '1px solid var(--border)' }}>\n41\t        <input\n42\t          type=\"text\"\n43\t          placeholder=\"搜索论文...\"\n44\t          value={search}\n45\t          onChange={e => setSearch(e.target.value)}\n46\t          data-shortcut-search\n47\t          className=\"w-full px-3 py-1.5 text-sm rounded-md focus:outline-none\"\n48\t          style={{\n49\t            backgroundColor: 'var(--bg-surface)',\n50\t            border: '1px solid var(--border)',\n51\t            color: 'var(--text-primary)',\n52\t          }}\n53\t        />\n54\t      </div>\n55\t\n56\t      <div className=\"flex-1 overflow-auto\">\n57\t        {filtered.length === 0 ? (\n58\t          <p className=\"text-sm text-center mt-8\" style={{ color: 'var(--text-muted)' }}>\n59\t            {search.trim() ? '无匹配论文' : '暂无论文'}\n60\t          </p>\n61\t        ) : (\n62\t          filtered.map(paper => (\n63\t            <div\n64\t              key={paper.id}\n65\t              role=\"button\"\n66\t              tabIndex={0}\n67\t              onClick={() => onSelect(paper.id)}\n68\t              onKeyDown={e => { if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); onSelect(paper.id) } }}\n69\t              className=\"group flex items-start gap-2 px-3 py-2.5 cursor-pointer transition-colors\"\n70\t              style={{\n71\t                borderLeft: activeId === paper.id ? '2px solid var(--accent)' : '2px solid transparent',\n72\t                backgroundColor: activeId === paper.id ? 'var(--accent-subtle)' : 'transparent',\n73\t              }}\n74\t            >\n75\t              <span className=\"w-2 h-2 mt-1.5 rounded-full shrink-0\" style={{ backgroundColor: statusDotColor(paper.status) }} />\n76\t              <div className=\"flex-1 min-w-0\">\n77\t                <p className=\"text-sm truncate\" style={{ color: 'var(--text-primary)' }}>\n78\t                  {paper.title || paper.filename}\n79\t                </p>\n80\t                <div className=\"flex items-center gap-2 mt-0.5\">\n81\t                  {paper.venue && (\n82\t                    <span className=\"text-xs\" style={{ color: 'var(--text-muted)' }}>{paper.venue}</span>\n83\t                  )}\n84\t                  {paper.year && (\n85\t                    <span className=\"text-xs\" style={{ color: 'var(--text-muted)' }}>{paper.year}</span>\n86\t                  )}\n87\t                </div>\n88\t              </div>\n89\t              <button\n90\t                onClick={e => {\n91\t                  e.stopPropagation()\n92\t                  setDeleteTarget(paper.id)\n93\t                }}\n94\t                className=\"shrink-0 mt-0.5 opacity-0 group-hover:opacity-100 focus:opacity-100 transition-opacity text-xs\"\n95\t                style={{ color: 'var(--text-muted)' }}\n96\t                title=\"删除\"\n97\t              >\n98\t                &times;\n99\t              </button>\n100\t            </div>\n101\t          ))\n102\t        )}\n103\t      </div>\n104\t\n105\t      <ConfirmDialog\n106\t        open={deleteTarget !== null}\n107\t        title=\"确认删除\"\n108\t        message=\"确定删除这篇论文？删除后不可恢复。\"\n109\t        variant=\"danger\"\n110\t        onConfirm={() => { if (deleteTarget !== null) onDelete(deleteTarget); setDeleteTarget(null) }}\n111\t        onCancel={() => setDeleteTarget(null)}\n112\t      />\n113\t    </div>\n114\t  )\n115\t}\n116\t"}]},"parent_tool_use_id":"call_bddd82a75f2e46b98e4517cc","session_id":"29257b8f-ede7-46a4-8e0f-a743591d296a","uuid":"a4902f28-d7c1-4bab-ba55-1e0246e8b8a3","timestamp":"2026-06-09T05:10:16.733Z","subagent_type":"Explore","task_description":"Explore frontend performance"}
