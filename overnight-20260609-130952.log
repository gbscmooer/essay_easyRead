{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call_7c23d78f77b14f4a9effd8e0","type":"tool_result","content":"1\timport { useState, useEffect, useCallback, useRef } from 'react'\n2\timport { useParams } from 'react-router-dom'\n3\timport type { FileNode, CodeAnalysisResult } from '@/types'\n4\timport { getCodeTree, getCodeAnalysis, getCodeAnalysisSSEUrl, cloneRepository, openInVSCode } from '@/api/code'\n5\timport { getPaper } from '@/api/papers'\n6\timport type { Paper } from '@/types'\n7\timport { FileBrowser } from '@/features/code/FileBrowser'\n8\timport { CodeViewer } from '@/features/code/CodeViewer'\n9\timport { CodeAnalysisPanel } from '@/features/code/CodeAnalysisPanel'\n10\timport { toast } from '@/hooks/useToast'\n11\t\n12\t\n13\texport default function CodePage() {\n14\t  const { id } = useParams<{ id: string }>()\n15\t  const paperId = Number(id)\n16\t\n17\t  const [paper, setPaper] = useState<Paper | null>(null)\n18\t  const [fileTree, setFileTree] = useState<FileNode | null>(null)\n19\t  const [selectedFile, setSelectedFile] = useState<string | null>(null)\n20\t  const [analysis, setAnalysis] = useState<CodeAnalysisResult | null>(null)\n21\t  const [isAnalyzing, setIsAnalyzing] = useState(false)\n22\t  const [cloneStatus, setCloneStatus] = useState<string | null>(null)\n23\t  const [loading, setLoading] = useState(true)\n24\t  const [error, setError] = useState<string | null>(null)\n25\t  const [scrollToLine, setScrollToLine] = useState<number | null>(null)\n26\t\n27\t  // 可拖拽面板宽度\n28\t  const [leftWidth, setLeftWidth] = useState(240)\n29\t  const [rightWidth, setRightWidth] = useState(320)\n30\t  const [leftCollapsed, setLeftCollapsed] = useState(false)\n31\t  const [rightCollapsed, setRightCollapsed] = useState(false)\n32\t  const containerRef = useRef<HTMLDivElement>(null)\n33\t  const dragType = useRef<'left' | 'right' | null>(null)\n34\t  const eventSourceRef = useRef<EventSource | null>(null)\n35\t\n36\t  // 清理 EventSource\n37\t  useEffect(() => {\n38\t    return () => {\n39\t      if (eventSourceRef.current) {\n40\t        eventSourceRef.current.close()\n41\t        eventSourceRef.current = null\n42\t      }\n43\t    }\n44\t  }, [])\n45\t\n46\t  // 加载数据\n47\t  useEffect(() => {\n48\t    if (!paperId) return\n49\t\n50\t    setLoading(true)\n51\t    Promise.all([\n52\t      getPaper(paperId).then(setPaper),\n53\t      getCodeTree(paperId).then(setFileTree).catch(() => { toast({ type: 'error', message: '加载文件树失败' }) }),\n54\t      getCodeAnalysis(paperId).then(setAnalysis).catch(() => { toast({ type: 'error', message: '加载代码分析失败' }) }),\n55\t    ])\n56\t      .catch(() => setError('加载失败'))\n57\t      .finally(() => setLoading(false))\n58\t  }, [paperId])\n59\t\n60\t  // 触发代码分析（自动先 clone）\n61\t  const handleAnalyze = useCallback(async () => {\n62\t    if (!paperId) return\n63\t    setIsAnalyzing(true)\n64\t    setError(null)\n65\t\n66\t    try {\n67\t      // 如果仓库还没 clone，先 clone\n68\t      if (!paper || paper.code_status !== 'ready') {\n69\t        setCloneStatus('正在克隆仓库...')\n70\t        await cloneRepository(paperId)\n71\t        // 刷新 paper 信息和文件树\n72\t        const [updatedPaper, tree] = await Promise.all([\n73\t          getPaper(paperId),\n74\t          getCodeTree(paperId),\n75\t        ])\n76\t        setPaper(updatedPaper)\n77\t        setFileTree(tree)\n78\t        setCloneStatus(null)\n79\t      }\n80\t\n81\t      // 开始分析\n82\t      const eventSource = new EventSource(getCodeAnalysisSSEUrl(paperId))\n83\t      eventSourceRef.current = eventSource\n84\t\n85\t      eventSource.onmessage = () => {}\n86\t\n87\t      eventSource.addEventListener('done', () => {\n88\t        eventSource.close()\n89\t        setIsAnalyzing(false)\n90\t        getCodeAnalysis(paperId).then(setAnalysis).catch(() => { toast({ type: 'error', message: '加载代码分析失败' }) })\n91\t      })\n92\t\n93\t      eventSource.addEventListener('error', () => {\n94\t        eventSource.close()\n95\t        setIsAnalyzing(false)\n96\t      })\n97\t\n98\t      eventSource.onerror = () => {\n99\t        eventSource.close()\n100\t        setIsAnalyzing(false)\n101\t      }\n102\t    } catch (e) {\n103\t      setIsAnalyzing(false)\n104\t      setCloneStatus(null)\n105\t      setError('克隆失败，请检查仓库地址是否正确')\n106\t    }\n107\t  }, [paperId, paper])\n108\t\n109\t  // 点击依赖图/映射中的文件\n110\t  const handleFileClick = useCallback((path: string, line?: number) => {\n111\t    setSelectedFile(path)\n112\t    setScrollToLine(line ?? null)\n113\t  }, [])\n114\t\n115\t  // 拖拽分割条\n116\t  useEffect(() => {\n117\t    const handleMouseMove = (e: MouseEvent) => {\n118\t      if (!dragType.current || !containerRef.current) return\n119\t      const rect = containerRef.current.getBoundingClientRect()\n120\t      if (dragType.current === 'left') {\n121\t        const w = Math.max(150, Math.min(400, e.clientX - rect.left))\n122\t        setLeftWidth(w)\n123\t      } else {\n124\t        const w = Math.max(200, Math.min(500, rect.right - e.clientX))\n125\t        setRightWidth(w)\n126\t      }\n127\t    }\n128\t    const handleMouseUp = () => {\n129\t      dragType.current = null\n130\t      document.body.style.cursor = ''\n131\t      document.body.style.userSelect = ''\n132\t    }\n133\t    document.addEventListener('mousemove', handleMouseMove)\n134\t    document.addEventListener('mouseup', handleMouseUp)\n135\t    return () => {\n136\t      document.removeEventListener('mousemove', handleMouseMove)\n137\t      document.removeEventListener('mouseup', handleMouseUp)\n138\t    }\n139\t  }, [])\n140\t\n141\t  if (loading) {\n142\t    return (\n143\t      <div className=\"flex items-center justify-center h-full\">\n144\t        <div className=\"w-8 h-8 border-2 rounded-full animate-spin\" style={{ borderColor: 'var(--border-light)', borderTopColor: 'var(--accent)' }} />\n145\t      </div>\n146\t    )\n147\t  }\n148\t\n149\t  if (error || !paper) {\n150\t    return (\n151\t      <div className=\"flex items-center justify-center h-full\">\n152\t        <p className=\"text-red-400\">{error || '论文不存在'}</p>\n153\t      </div>\n154\t    )\n155\t  }\n156\t\n157\t  return (\n158\t    <div className=\"flex flex-col h-full\">\n159\t      {/* 顶部工具栏 */}\n160\t      <div className=\"flex items-center justify-end px-4 py-1.5 border-b shrink-0\"\n161\t        style={{ backgroundColor: 'var(--bg-surface)', opacity: 0.8, borderColor: 'var(--border)' }}>\n162\t        <div className=\"flex items-center gap-2\">\n163\t          {paper.code_url && (\n164\t            <a\n165\t              href={paper.code_url.startsWith('http') ? paper.code_url : `https://${paper.code_url}`}\n166\t              target=\"_blank\"\n167\t              rel=\"noopener noreferrer\"\n168\t              className=\"text-xs transition-colors\"\n169\t              style={{ color: 'var(--text-muted)' }}\n170\t              onMouseEnter={e => { e.currentTarget.style.color = 'var(--text-secondary)' }}\n171\t              onMouseLeave={e => { e.currentTarget.style.color = 'var(--text-muted)' }}\n172\t            >\n173\t              原始仓库 ↗\n174\t            </a>\n175\t          )}\n176\t          {paper.code_status === 'ready' && (\n177\t            <button\n178\t              onClick={() => {\n179\t                if (paper?.code_path) openInVSCode(paper.code_path)\n180\t              }}\n181\t              className=\"text-xs transition-colors\"\n182\t              style={{ color: 'var(--text-muted)' }}\n183\t              onMouseEnter={e => { e.currentTarget.style.color = 'var(--accent)' }}\n184\t              onMouseLeave={e => { e.currentTarget.style.color = 'var(--text-muted)' }}\n185\t              title=\"在 VSCode 中打开\"\n186\t            >\n187\t              转到 VSCode ↗\n188\t            </button>\n189\t          )}\n190\t          {cloneStatus && (\n191\t            <span className=\"flex items-center gap-1.5 px-3 py-1.5 text-xs rounded\"\n192\t              style={{ color: 'var(--text-secondary)', backgroundColor: 'var(--bg-elevated)' }}\n193\t            >\n194\t              <div className=\"w-3 h-3 border rounded-full animate-spin\"\n195\t                style={{ borderColor: 'var(--text-muted)', borderTopColor: 'var(--accent)' }} />\n196\t              {cloneStatus}\n197\t            </span>\n198\t          )}\n199\t          {!analysis && !isAnalyzing && !cloneStatus && (\n200\t            <button\n201\t              onClick={handleAnalyze}\n202\t              className=\"px-3 py-1.5 text-xs rounded transition-colors\"\n203\t              style={{ backgroundColor: 'var(--accent)', color: 'var(--bg-base)' }}\n204\t              onMouseEnter={e => { e.currentTarget.style.opacity = '0.85' }}\n205\t              onMouseLeave={e => { e.currentTarget.style.opacity = '1' }}\n206\t            >\n207\t              开始分析\n208\t            </button>\n209\t          )}\n210\t          {isAnalyzing && !cloneStatus && (\n211\t            <span className=\"flex items-center gap-1.5 px-3 py-1.5 text-xs rounded\"\n212\t              style={{ color: 'var(--text-secondary)', backgroundColor: 'var(--bg-elevated)' }}\n213\t            >\n214\t              <div className=\"w-3 h-3 border rounded-full animate-spin\"\n215\t                style={{ borderColor: 'var(--text-muted)', borderTopColor: 'var(--accent)' }} />\n216\t              正在分析...\n217\t            </span>\n218\t          )}\n219\t        </div>\n220\t      </div>\n221\t\n222\t      {/* 三栏布局 */}\n223\t      <div ref={containerRef} className=\"flex-1 flex overflow-hidden relative\">\n224\t        {/* 左侧：文件浏览器 */}\n225\t        {!leftCollapsed && (\n226\t          <div className=\"shrink-0 overflow-auto border-r\" style={{ width: leftWidth, borderColor: 'var(--border)' }}>\n227\t            <div className=\"px-3 py-2 border-b flex items-center justify-between\" style={{ borderColor: 'var(--border)' }}>\n228\t              <h3 className=\"text-xs font-medium uppercase tracking-wider\" style={{ color: 'var(--text-muted)' }}>文件</h3>\n229\t              <button\n230\t                onClick={() => setLeftCollapsed(true)}\n231\t                className=\"transition-colors\"\n232\t                style={{ color: 'var(--text-muted)' }}\n233\t                onMouseEnter={e => { e.currentTarget.style.color = 'var(--text-secondary)' }}\n234\t                onMouseLeave={e => { e.currentTarget.style.color = 'var(--text-muted)' }}\n235\t                title=\"收起文件栏\"\n236\t              >\n237\t                <svg className=\"w-3.5 h-3.5\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\">\n238\t                  <path strokeLinecap=\"round\" strokeLinejoin=\"round\" strokeWidth={2} d=\"M15 19l-7-7 7-7\" />\n239\t                </svg>\n240\t              </button>\n241\t            </div>\n242\t            <FileBrowser\n243\t              tree={fileTree}\n244\t              selected={selectedFile}\n245\t              onSelect={setSelectedFile}\n246\t            />\n247\t          </div>\n248\t        )}\n249\t\n250\t        {/* 左侧展开按钮 */}\n251\t        {leftCollapsed && (\n252\t          <button\n253\t            onClick={() => setLeftCollapsed(false)}\n254\t            className=\"absolute left-0 top-0 bottom-0 z-10 w-6 flex items-center justify-center border-r transition-colors\"\n255\t            style={{ backgroundColor: 'var(--bg-surface)', opacity: 0.8, borderColor: 'var(--border)' }}\n256\t            onMouseEnter={e => { e.currentTarget.style.backgroundColor = 'var(--bg-elevated)' }}\n257\t            onMouseLeave={e => { e.currentTarget.style.backgroundColor = 'var(--bg-surface)'; e.currentTarget.style.opacity = '0.8' }}\n258\t            title=\"展开文件栏\"\n259\t          >\n260\t            <svg className=\"w-3.5 h-3.5\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\" style={{ color: 'var(--text-muted)' }}>\n261\t              <path strokeLinecap=\"round\" strokeLinejoin=\"round\" strokeWidth={2} d=\"M9 5l7 7-7 7\" />\n262\t            </svg>\n263\t          </button>\n264\t        )}\n265\t\n266\t        {/* 左侧拖拽条 */}\n267\t        {!leftCollapsed && (\n268\t          <div\n269\t            className=\"w-1 shrink-0 cursor-col-resize transition-colors\"\n270\t            style={{ backgroundColor: 'var(--bg-elevated)' }}\n271\t            onMouseEnter={e => { e.currentTarget.style.backgroundColor = 'var(--accent)'; e.currentTarget.style.opacity = '0.5' }}\n272\t            onMouseLeave={e => { e.currentTarget.style.backgroundColor = 'var(--bg-elevated)'; e.currentTarget.style.opacity = '1' }}\n273\t            onMouseDown={(e) => {\n274\t              e.preventDefault()\n275\t              dragType.current = 'left'\n276\t              document.body.style.cursor = 'col-resize'\n277\t              document.body.style.userSelect = 'none'\n278\t            }}\n279\t          />\n280\t        )}\n281\t\n282\t        {/* 中间：代码查看器 */}\n283\t        <div className=\"flex-1 overflow-hidden\">\n284\t          <CodeViewer paperId={paperId} filePath={selectedFile} scrollToLine={scrollToLine} />\n285\t        </div>\n286\t\n287\t        {/* 右侧拖拽条 */}\n288\t        {!rightCollapsed && (\n289\t          <div\n290\t            className=\"w-1 shrink-0 cursor-col-resize transition-colors\"\n291\t            style={{ backgroundColor: 'var(--bg-elevated)' }}\n292\t            onMouseEnter={e => { e.currentTarget.style.backgroundColor = 'var(--accent)'; e.currentTarget.style.opacity = '0.5' }}\n293\t            onMouseLeave={e => { e.currentTarget.style.backgroundColor = 'var(--bg-elevated)'; e.currentTarget.style.opacity = '1' }}\n294\t            onMouseDown={(e) => {\n295\t              e.preventDefault()\n296\t              dragType.current = 'right'\n297\t              document.body.style.cursor = 'col-resize'\n298\t              document.body.style.userSelect = 'none'\n299\t            }}\n300\t          />\n301\t        )}\n302\t\n303\t        {/* 右侧展开按钮 */}\n304\t        {rightCollapsed && (\n305\t          <button\n306\t            onClick={() => setRightCollapsed(false)}\n307\t            className=\"absolute right-0 top-0 bottom-0 z-10 w-6 flex items-center justify-center border-l transition-colors\"\n308\t            style={{ backgroundColor: 'var(--bg-surface)', opacity: 0.8, borderColor: 'var(--border)' }}\n309\t            onMouseEnter={e => { e.currentTarget.style.backgroundColor = 'var(--bg-elevated)' }}\n310\t            onMouseLeave={e => { e.currentTarget.style.backgroundColor = 'var(--bg-surface)'; e.currentTarget.style.opacity = '0.8' }}\n311\t            title=\"展开分析栏\"\n312\t          >\n313\t            <svg className=\"w-3.5 h-3.5\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\" style={{ color: 'var(--text-muted)' }}>\n314\t              <path strokeLinecap=\"round\" strokeLinejoin=\"round\" strokeWidth={2} d=\"M15 19l-7-7 7-7\" />\n315\t            </svg>\n316\t          </button>\n317\t        )}\n318\t\n319\t        {/* 右侧：分析面板 */}\n320\t        {!rightCollapsed && (\n321\t          <div className=\"shrink-0 overflow-hidden\" style={{ width: rightWidth }}>\n322\t            <CodeAnalysisPanel\n323\t              analysis={analysis}\n324\t              isAnalyzing={isAnalyzing}\n325\t              paperId={paperId}\n326\t              onFileClick={handleFileClick}\n327\t              onCollapse={() => setRightCollapsed(true)}\n328\t            />\n329\t          </div>\n330\t        )}\n331\t      </div>\n332\t    </div>\n333\t  )\n334\t}\n335\t"}]},"parent_tool_use_id":"call_bddd82a75f2e46b98e4517cc","session_id":"29257b8f-ede7-46a4-8e0f-a743591d296a","uuid":"65105435-e1f7-4bba-b49b-ab34d5e2d7e9","timestamp":"2026-06-09T05:10:21.950Z","subagent_type":"Explore","task_description":"Explore frontend performance"}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call_045a9f0f1d7e445e8933065c","type":"tool_result","content":"1\t\"\"\"\n2\tCode 路由\n3\t\n4\t处理代码仓库的 clone、文件浏览和代码分析。\n5\t\"\"\"\n6\t\n7\timport logging\n8\tfrom fastapi import APIRouter, HTTPException, Query\n9\tfrom fastapi.responses import StreamingResponse\n10\tfrom sqlmodel import Session, create_engine\n11\t\n12\tfrom ..config import settings\n13\tfrom ..models.schemas import StreamEvent, CodeAnalysisResponse, CodeSummaryResponse\n14\tfrom ..utils.streaming import format_sse\n15\t\n16\tlogger = logging.getLogger(__name__)\n17\t\n18\trouter = APIRouter(prefix=\"/api/code\", tags=[\"code\"])\n19\t\n20\t\n21\t_engine = None\n22\t\n23\t\n24\tdef _get_engine():\n25\t    global _engine\n26\t    if _engine is None:\n27\t        _engine = create_engine(settings.resolved_database_url, connect_args={\"check_same_thread\": False})\n28\t    return _engine\n29\t\n30\t\n31\t# ============================================================\n32\t# POST /api/code/{paper_id}/extract-url\n33\t# ============================================================\n34\t@router.post(\"/{paper_id}/extract-url\")\n35\tasync def extract_url(paper_id: int):\n36\t    \"\"\"重新从论文中提取代码仓库 URL\"\"\"\n37\t    engine = _get_engine()\n38\t\n39\t    from ..services.database import get_paper\n40\t    try:\n41\t        with Session(engine) as session:\n42\t            paper = get_paper(session, paper_id)\n43\t    except ValueError:\n44\t        raise HTTPException(status_code=404, detail=\"论文不存在\")\n45\t\n46\t    # 获取 PDF 文件路径\n47\t    from ..models.paper import Paper as PaperModel\n48\t    with Session(engine) as session:\n49\t        db_paper = session.get(PaperModel, paper_id)\n50\t        if not db_paper:\n51\t            raise HTTPException(status_code=404, detail=\"论文不存在\")\n52\t        pdf_path = db_paper.pdf_path\n53\t\n54\t    # 提取 PDF 文本并用正则搜索代码 URL\n55\t    from ..services.pdf_parser import extract_pdf_content\n56\t    from ..services.ai_analyzer import extract_code_url\n57\t\n58\t    try:\n59\t        content = extract_pdf_content(pdf_path)\n60\t    except Exception as e:\n61\t        logger.warning(f\"PDF extraction failed for {paper_id}: {e}\")\n62\t        return {\"code_url\": None}\n63\t    code_url = extract_code_url(content.full_text)\n64\t\n65\t    # 更新数据库\n66\t    from ..services.database import update_paper_code_url\n67\t    with Session(engine) as session:\n68\t        update_paper_code_url(session, paper_id, code_url)\n69\t\n70\t    return {\"code_url\": code_url or None}\n71\t\n72\t\n73\t# ============================================================\n74\t# POST /api/code/{paper_id}/clone\n75\t# ============================================================\n76\t@router.post(\"/{paper_id}/clone\")\n77\tasync def clone_repo(paper_id: int):\n78\t    \"\"\"Clone 论文的代码仓库\"\"\"\n79\t    engine = _get_engine()\n80\t\n81\t    # 获取论文信息\n82\t    from ..services.database import get_paper\n83\t    try:\n84\t        with Session(engine) as session:\n85\t            paper = get_paper(session, paper_id)\n86\t    except ValueError:\n87\t        raise HTTPException(status_code=404, detail=\"论文不存在\")\n88\t\n89\t    code_url = paper.get(\"code_url\")\n90\t    if not code_url:\n91\t        raise HTTPException(status_code=400, detail=\"该论文未找到代码仓库 URL\")\n92\t\n93\t    # 更新状态为 cloning\n94\t    from ..services.database import update_paper_status\n95\t    with Session(engine) as session:\n96\t        from ..models.paper import Paper\n97\t        db_paper = session.get(Paper, paper_id)\n98\t        if db_paper:\n99\t            db_paper.code_status = \"cloning\"\n100\t            session.add(db_paper)\n101\t            session.commit()\n102\t\n103\t    try:\n104\t        from ..services.code_analyzer import clone_repository\n105\t        clone_path = await clone_repository(code_url, paper_id)\n106\t\n107\t        # 更新状态为 ready\n108\t        with Session(engine) as session:\n109\t            db_paper = session.get(Paper, paper_id)\n110\t            if db_paper:\n111\t                db_paper.code_status = \"ready\"\n112\t                db_paper.code_path = clone_path\n113\t                session.add(db_paper)\n114\t                session.commit()\n115\t\n116\t        return {\"message\": \"克隆成功\", \"path\": clone_path}\n117\t\n118\t    except Exception as e:\n119\t        logger.error(f\"Clone failed: {e}\")\n120\t        with Session(engine) as session:\n121\t            db_paper = session.get(Paper, paper_id)\n122\t            if db_paper:\n123\t                db_paper.code_status = \"failed\"\n124\t                session.add(db_paper)\n125\t                session.commit()\n126\t        raise HTTPException(status_code=500, detail=f\"克隆失败: {str(e)}\")\n127\t\n128\t\n129\t# ============================================================\n130\t# GET /api/code/{paper_id}/tree\n131\t# ============================================================\n132\t@router.get(\"/{paper_id}/tree\")\n133\tasync def get_file_tree(paper_id: int):\n134\t    \"\"\"获取代码仓库的文件树\"\"\"\n135\t    engine = _get_engine()\n136\t\n137\t    from ..services.database import get_paper\n138\t    try:\n139\t        with Session(engine) as session:\n140\t            paper = get_paper(session, paper_id)\n141\t    except ValueError:\n142\t        raise HTTPException(status_code=404, detail=\"论文不存在\")\n143\t\n144\t    code_status = paper.get(\"code_status\", \"none\")\n145\t    if code_status != \"ready\":\n146\t        raise HTTPException(status_code=400, detail=f\"代码仓库状态: {code_status}\")\n147\t\n148\t    code_path = paper.get(\"code_path\")\n149\t    if not code_path:\n150\t        raise HTTPException(status_code=400, detail=\"代码路径不存在\")\n151\t\n152\t    from ..services.code_analyzer import build_file_tree\n153\t    tree = build_file_tree(code_path)\n154\t    return tree\n155\t\n156\t\n157\t# ============================================================\n158\t# GET /api/code/{paper_id}/file\n159\t# ============================================================\n160\t@router.get(\"/{paper_id}/file\")\n161\tasync def get_file_content(paper_id: int, path: str = Query(..., description=\"文件相对路径\")):\n162\t    \"\"\"获取代码文件内容\"\"\"\n163\t    engine = _get_engine()\n164\t\n165\t    from ..services.database import get_paper\n166\t    try:\n167\t        with Session(engine) as session:\n168\t            paper = get_paper(session, paper_id)\n169\t    except ValueError:\n170\t        raise HTTPException(status_code=404, detail=\"论文不存在\")\n171\t\n172\t    code_path = paper.get(\"code_path\")\n173\t    if not code_path:\n174\t        raise HTTPException(status_code=400, detail=\"代码路径不存在\")\n175\t\n176\t    from ..services.code_analyzer import read_file_content, read_notebook_content\n177\t    try:\n178\t        if path.endswith(\".ipynb\"):\n179\t            cells = read_notebook_content(code_path, path)\n180\t            return {\"path\": path, \"content\": None, \"cells\": cells}\n181\t        content = read_file_content(code_path, path)\n182\t        return {\"path\": path, \"content\": content}\n183\t    except FileNotFoundError:\n184\t        raise HTTPException(status_code=404, detail=\"文件不存在\")\n185\t    except ValueError as e:\n186\t        raise HTTPException(status_code=400, detail=str(e))\n187\t\n188\t\n189\t# ============================================================\n190\t# GET /api/code/{paper_id}/analyze\n191\t# ============================================================\n192\t@router.get(\"/{paper_id}/analyze\")\n193\tasync def analyze_code(paper_id: int):\n194\t    \"\"\"触发代码分析（SSE 流式）\"\"\"\n195\t    engine = _get_engine()\n196\t\n197\t    from ..services.database import get_paper\n198\t    try:\n199\t        with Session(engine) as session:\n200\t            paper = get_paper(session, paper_id)\n201\t    except ValueError:\n202\t        raise HTTPException(status_code=404, detail=\"论文不存在\")\n203\t\n204\t    code_status = paper.get(\"code_status\", \"none\")\n205\t    if code_status != \"ready\":\n206\t        raise HTTPException(status_code=400, detail=\"代码仓库未就绪\")\n207\t\n208\t    code_path = paper.get(\"code_path\")\n209\t    if not code_path:\n210\t        raise HTTPException(status_code=400, detail=\"代码路径不存在\")\n211\t\n212\t    async def event_generator():\n213\t        from ..services.code_analyzer import build_file_tree, select_core_files, read_file_content, analyze_imports\n214\t        from ..services.ai_config import get_analysis_config\n215\t        from ..services.database import get_analysis\n216\t\n217\t        ai_cfg = get_analysis_config()\n218\t\n219\t        # 1. 构建文件树\n220\t        yield format_sse(StreamEvent(event=\"status\", data={\"message\": \"正在分析文件结构...\"}))\n221\t        tree = build_file_tree(code_path)\n222\t\n223\t        # 2. 静态分析：依赖图\n224\t        yield format_sse(StreamEvent(event=\"status\", data={\"message\": \"正在分析模块依赖...\"}))\n225\t        core_files = select_core_files(tree, code_path)\n226\t        deps, node_metrics = analyze_imports(code_path, core_files)\n227\t\n228\t        # 3. 读取核心文件内容\n229\t        yield format_sse(StreamEvent(event=\"status\", data={\"message\": \"正在读取核心文件...\"}))\n230\t        file_contents = {}\n231\t        for f in core_files:\n232\t            try:\n233\t                content = read_file_content(code_path, f, max_lines=200)\n234\t                if content and not content.startswith(\"[\"):\n235\t                    file_contents[f] = content\n236\t            except Exception:\n237\t                continue\n238\t\n239\t        # 4. AI 分析\n240\t        data_flow = \"\"\n241\t        paper_code_mapping = []\n242\t\n243\t        if file_contents and ai_cfg.get(\"api_key\"):\n244\t            # 数据流分析\n245\t            yield format_sse(StreamEvent(event=\"status\", data={\"message\": \"AI 正在分析数据流...\"}))\n246\t            try:\n247\t                from ..services.code_analyzer import ai_analyze_data_flow\n248\t                data_flow = await ai_analyze_data_flow(\n249\t                    file_contents,\n250\t                    paper.get(\"title\", \"\"),\n251\t                    ai_cfg[\"api_key\"],\n252\t                    ai_cfg[\"base_url\"],\n253\t                    ai_cfg[\"model\"],\n254\t                )\n255\t            except Exception as e:\n256\t                logger.warning(f\"Data flow analysis failed: {e}\")\n257\t                data_flow = \"分析失败\"\n258\t\n259\t            # 论文-代码映射\n260\t            yield format_sse(StreamEvent(event=\"status\", data={\"message\": \"AI 正在映射论文与代码...\"}))\n261\t            try:\n262\t                from ..services.code_analyzer import ai_analyze_paper_code_mapping\n263\t                # 获取已有的 code_mapping\n264\t                existing_mapping = []\n265\t                analysis = None\n266\t                existing_mapping = []\n267\t                try:\n268\t                    with Session(engine) as session:\n269\t                        analysis = get_analysis(session, paper_id)\n270\t                        existing_mapping = analysis.get(\"code_mapping\", [])\n271\t                except Exception:\n272\t                    pass\n273\t\n274\t                paper_code_mapping = await ai_analyze_paper_code_mapping(\n275\t                    file_contents,\n276\t                    paper.get(\"title\", \"\"),\n277\t                    analysis.get(\"one_sentence\", \"\") if analysis else \"\",\n278\t                    existing_mapping,\n279\t                    ai_cfg[\"api_key\"],\n280\t                    ai_cfg[\"base_url\"],\n281\t                    ai_cfg[\"model\"],\n282\t                )\n283\t            except Exception as e:\n284\t                logger.warning(f\"Paper-code mapping failed: {e}\")\n285\t\n286\t        # 5. 保存结果\n287\t        yield format_sse(StreamEvent(event=\"status\", data={\"message\": \"正在保存分析结果...\"}))\n288\t        try:\n289\t            from ..models.code_analysis import CodeAnalysis\n290\t            with Session(engine) as session:\n291\t                from sqlmodel import select\n292\t                statement = select(CodeAnalysis).where(CodeAnalysis.paper_id == paper_id)\n293\t                existing = session.exec(statement).first()\n294\t\n295\t                if existing:\n296\t                    existing.file_tree = tree\n297\t                    existing.data_flow = data_flow\n298\t                    existing.dependency_graph = deps\n299\t                    existing.paper_code_mapping = paper_code_mapping\n300\t                    existing.node_metrics = node_metrics\n301\t                    existing.status = \"done\"\n302\t                    session.add(existing)\n303\t                else:\n304\t                    analysis = CodeAnalysis(\n305\t                        paper_id=paper_id,\n306\t                        file_tree=tree,\n307\t                        data_flow=data_flow,\n308\t                        dependency_graph=deps,\n309\t                        paper_code_mapping=paper_code_mapping,\n310\t                        node_metrics=node_metrics,\n311\t                        status=\"done\",\n312\t                    )\n313\t                    session.add(analysis)\n314\t                session.commit()\n315\t        except Exception as e:\n316\t            logger.error(f\"Failed to save code analysis: {e}\")\n317\t            yield format_sse(StreamEvent(event=\"error\", data={\"message\": f\"保存失败: {str(e)}\"}))\n318\t            return\n319\t\n320\t        # 6. 生成 README 摘要\n321\t        try:\n322\t            from ..services.code_analyzer import ai_summarize_readme\n323\t            readme_files = [f for f in file_contents if \"readme\" in f.lower()]\n324\t            if readme_files and ai_cfg.get(\"api_key\"):\n325\t                summary = await ai_summarize_readme(\n326\t                    file_contents[readme_files[0]],\n327\t                    ai_cfg[\"api_key\"],\n328\t                    ai_cfg[\"base_url\"],\n329\t                    ai_cfg[\"model\"],\n330\t                )\n331\t                with Session(engine) as session:\n332\t                    from ..models.paper import Paper as PaperModel\n333\t                    db_paper = session.get(PaperModel, paper_id)\n334\t                    if db_paper:\n335\t                        db_paper.code_summary = summary\n336\t                        session.add(db_paper)\n337\t                        session.commit()\n338\t        except Exception as e:\n339\t            logger.warning(f\"README summary failed: {e}\")\n340\t\n341\t        yield format_sse(StreamEvent(event=\"done\", data={\"message\": \"代码分析完成\"}))\n342\t\n343\t    return StreamingResponse(\n344\t        event_generator(),\n345\t        media_type=\"text/event-stream\",\n346\t        headers={\n347\t            \"Cache-Control\": \"no-cache\",\n348\t            \"Connection\": \"keep-alive\",\n349\t            \"X-Accel-Buffering\": \"no\",\n350\t        },\n351\t    )\n352\t\n353\t\n354\t# ============================================================\n355\t# GET /api/code/{paper_id}/analysis\n356\t# ============================================================\n357\t@router.get(\"/{paper_id}/analysis\", response_model=CodeAnalysisResponse)\n358\tasync def get_code_analysis(paper_id: int):\n359\t    \"\"\"获取代码分析结果\"\"\"\n360\t    engine = _get_engine()\n361\t\n362\t    from ..models.code_analysis import CodeAnalysis\n363\t    from sqlmodel import select\n364\t\n365\t    with Session(engine) as session:\n366\t        statement = select(CodeAnalysis).where(CodeAnalysis.paper_id == paper_id)\n367\t        analysis = session.exec(statement).first()\n368\t\n369\t    if not analysis:\n370\t        raise HTTPException(status_code=404, detail=\"代码分析结果不存在\")\n371\t\n372\t    return CodeAnalysisResponse(\n373\t        paper_id=analysis.paper_id,\n374\t        file_tree=analysis.file_tree,\n375\t        data_flow=analysis.data_flow,\n376\t        dependency_graph=analysis.dependency_graph,\n377\t        paper_code_mapping=analysis.paper_code_mapping,\n378\t        node_metrics=getattr(analysis, 'node_metrics', []) or [],\n379\t        status=analysis.status,\n380\t        error_message=analysis.error_message,\n381\t    )\n382\t\n383\t\n384\t# ============================================================\n385\t# GET /api/code/{paper_id}/summary\n386\t# ============================================================\n387\t@router.get(\"/{paper_id}/summary\", response_model=CodeSummaryResponse)\n388\tasync def get_code_summary(paper_id: int):\n389\t    \"\"\"获取代码摘要（侧边栏用）\"\"\"\n390\t    engine = _get_engine()\n391\t\n392\t    from ..services.database import get_paper\n393\t    try:\n394\t        with Session(engine) as session:\n395\t            paper = get_paper(session, paper_id)\n396\t    except ValueError:\n397\t        raise HTTPException(status_code=404, detail=\"论文不存在\")\n398\t\n399\t    return CodeSummaryResponse(\n400\t        code_url=paper.get(\"code_url\"),\n401\t        code_status=paper.get(\"code_status\", \"none\"),\n402\t        code_summary=paper.get(\"code_summary\"),\n403\t    )\n404\t"}]},"parent_tool_use_id":"call_14fbefec6f4c427bbf12da10","session_id":"29257b8f-ede7-46a4-8e0f-a743591d296a","uuid":"953f446d-400f-47cf-81c8-4be6089217f6","timestamp":"2026-06-09T05:10:21.950Z","subagent_type":"Explore","task_description":"Explore backend performance"}
