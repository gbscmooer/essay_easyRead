{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call_64a4aae6b21849a69aab6c8c","type":"tool_result","content":"1\t\"\"\"\n2\t终端服务\n3\t\n4\t通过 WebSocket 提供真实的 PTY 终端。\n5\t使用 Python 内置的 pty 模块（仅支持 Unix/macOS）。\n6\t\"\"\"\n7\t\n8\timport asyncio\n9\timport os\n10\timport pty\n11\timport select\n12\timport signal\n13\timport struct\n14\timport fcntl\n15\timport termios\n16\timport logging\n17\tfrom typing import Optional\n18\t\n19\tlogger = logging.getLogger(__name__)\n20\t\n21\t\n22\tclass TerminalSession:\n23\t    \"\"\"一个 PTY 终端会话\"\"\"\n24\t\n25\t    def __init__(self, cwd: str = None):\n26\t        self.cwd = cwd or os.path.expanduser(\"~\")\n27\t        self.pid: Optional[int] = None\n28\t        self.master_fd: Optional[int] = None\n29\t        self._running = False\n30\t\n31\t    async def spawn(self):\n32\t        \"\"\"启动 shell 进程\"\"\"\n33\t        master_fd, slave_fd = pty.openpty()\n34\t\n35\t        env = os.environ.copy()\n36\t        env[\"TERM\"] = \"xterm-256color\"\n37\t        env[\"COLUMNS\"] = \"120\"\n38\t        env[\"LINES\"] = \"30\"\n39\t\n40\t        shell = os.environ.get(\"SHELL\", \"/bin/zsh\")\n41\t\n42\t        def _preexec():\n43\t            os.setsid()\n44\t            fcntl.ioctl(slave_fd, termios.TIOCSCTTY, 0)\n45\t\n46\t        proc = await asyncio.create_subprocess_exec(\n47\t            shell, \"--login\",\n48\t            stdin=slave_fd,\n49\t            stdout=slave_fd,\n50\t            stderr=slave_fd,\n51\t            env=env,\n52\t            cwd=self.cwd,\n53\t            preexec_fn=_preexec,\n54\t        )\n55\t\n56\t        # 父进程关闭 slave fd\n57\t        os.close(slave_fd)\n58\t        self.pid = proc.pid\n59\t        self.master_fd = master_fd\n60\t        self._running = True\n61\t\n62\t        # 设置非阻塞\n63\t        import fcntl as fcntl_mod\n64\t        flags = fcntl_mod.fcntl(master_fd, fcntl_mod.F_GETFL)\n65\t        fcntl_mod.fcntl(master_fd, fcntl_mod.F_SETFL, flags | os.O_NONBLOCK)\n66\t\n67\t    def resize(self, cols: int, rows: int):\n68\t        \"\"\"调整终端大小\"\"\"\n69\t        if self.master_fd is not None:\n70\t            winsize = struct.pack(\"HHHH\", rows, cols, 0, 0)\n71\t            fcntl.ioctl(self.master_fd, termios.TIOCSWINSZ, winsize)\n72\t\n73\t    def write(self, data: bytes):\n74\t        \"\"\"向终端写入数据\"\"\"\n75\t        if self.master_fd is not None and self._running:\n76\t            try:\n77\t                os.write(self.master_fd, data)\n78\t            except OSError:\n79\t                self._running = False\n80\t\n81\t    def read(self) -> bytes:\n82\t        \"\"\"从终端读取数据（非阻塞）\"\"\"\n83\t        if self.master_fd is None or not self._running:\n84\t            return b\"\"\n85\t\n86\t        try:\n87\t            ready, _, _ = select.select([self.master_fd], [], [], 0.05)\n88\t            if ready:\n89\t                return os.read(self.master_fd, 4096)\n90\t        except OSError:\n91\t            self._running = False\n92\t        return b\"\"\n93\t\n94\t    def close(self):\n95\t        \"\"\"关闭终端\"\"\"\n96\t        self._running = False\n97\t        if self.master_fd is not None:\n98\t            try:\n99\t                os.close(self.master_fd)\n100\t            except OSError:\n101\t                pass\n102\t            self.master_fd = None\n103\t\n104\t        if self.pid is not None:\n105\t            try:\n106\t                os.kill(self.pid, signal.SIGTERM)\n107\t                os.waitpid(self.pid, os.WNOHANG)\n108\t            except (OSError, ChildProcessError):\n109\t                pass\n110\t            self.pid = None\n111\t\n112\t    @property\n113\t    def is_alive(self) -> bool:\n114\t        if self.pid is None:\n115\t            return False\n116\t        try:\n117\t            pid, status = os.waitpid(self.pid, os.WNOHANG)\n118\t            return pid == 0\n119\t        except ChildProcessError:\n120\t            return False\n121\t\n122\t\n123\tasync def handle_terminal_websocket(websocket, cwd: str = None):\n124\t    \"\"\"处理 WebSocket 终端连接\"\"\"\n125\t    session = TerminalSession(cwd)\n126\t    await session.spawn()\n127\t\n128\t    read_task = None\n129\t\n130\t    async def read_from_pty():\n131\t        \"\"\"从 PTY 读取数据并发送到 WebSocket\"\"\"\n132\t        loop = asyncio.get_event_loop()\n133\t        while session.is_alive:\n134\t            try:\n135\t                data = await loop.run_in_executor(None, session.read)\n136\t                if data:\n137\t                    await websocket.send_bytes(data)\n138\t                else:\n139\t                    await asyncio.sleep(0.01)\n140\t            except Exception:\n141\t                break\n142\t\n143\t    try:\n144\t        read_task = asyncio.create_task(read_from_pty())\n145\t\n146\t        async for message in websocket:\n147\t            if message.type == \"websocket.receive\":\n148\t                if message.text:\n149\t                    if message.text == \"ping\":\n150\t                        await websocket.send_text(\"pong\")\n151\t                        continue\n152\t                    if message.text.startswith(\"\\x1b[8;\"):\n153\t                        try:\n154\t                            parts = message.text[4:].rstrip(\"t\").split(\";\")\n155\t                            rows, cols = int(parts[0]), int(parts[1])\n156\t                            session.resize(cols, rows)\n157\t                        except (ValueError, IndexError):\n158\t                            pass\n159\t                    else:\n160\t                        session.write(message.text.encode(\"utf-8\"))\n161\t                elif message.bytes:\n162\t                    session.write(message.bytes)\n163\t    except Exception as e:\n164\t        logger.debug(f\"Terminal WebSocket closed: {e}\")\n165\t    finally:\n166\t        if read_task:\n167\t            read_task.cancel()\n168\t            try:\n169\t                await read_task\n170\t            except asyncio.CancelledError:\n171\t                pass\n172\t        session.close()\n173\t"}]},"parent_tool_use_id":"call_14fbefec6f4c427bbf12da10","session_id":"29257b8f-ede7-46a4-8e0f-a743591d296a","uuid":"adad6f6f-2764-401e-b0d6-93aaa4ad85e2","timestamp":"2026-06-09T05:10:29.812Z","subagent_type":"Explore","task_description":"Explore backend performance"}
