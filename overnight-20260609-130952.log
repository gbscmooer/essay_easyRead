{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call_a4babb1fd6614ec2a0169e42","type":"tool_result","content":"1\timport { useEffect, useState, useCallback } from 'react'\n2\timport { useNavigate } from 'react-router-dom'\n3\timport type { Paper, SearchResult } from '@/types'\n4\timport { listPapers, deletePaper, promoteExpandedPaper, smartSearch, reindexLibrary } from '@/api/papers'\n5\timport { toast } from '@/hooks/useToast'\n6\timport { PaperList } from '@/features/library/PaperList'\n7\timport { Tooltip } from '@/components/Tooltip'\n8\t\n9\tconst STATUS_LABEL: Record<string, string> = {\n10\t  done:       '已解析',\n11\t  indexed:    '已索引',\n12\t  pending:    '待解析',\n13\t  failed:     '解析失败',\n14\t  extracting: '提取中',\n15\t  analyzing:  '分析中',\n16\t}\n17\t\n18\tfunction ExpandedPaperRow({\n19\t  paper,\n20\t  onPromote,\n21\t  onSelect,\n22\t}: {\n23\t  paper: Paper\n24\t  onPromote: (id: number) => void\n25\t  onSelect: (id: number) => void\n26\t}) {\n27\t  const [promoting, setPromoting] = useState(false)\n28\t\n29\t  const handlePromote = async (e: React.MouseEvent) => {\n30\t    e.stopPropagation()\n31\t    setPromoting(true)\n32\t    try {\n33\t      await promoteExpandedPaper(paper.id)\n34\t      onPromote(paper.id)\n35\t    } catch {\n36\t      setPromoting(false)\n37\t    }\n38\t  }\n39\t\n40\t  const statusText = STATUS_LABEL[paper.status] ?? paper.status\n41\t\n42\t  return (\n43\t    <div\n44\t      className=\"flex items-center gap-3 px-4 py-2.5 rounded-lg cursor-pointer transition-colors group\"\n45\t      style={{ backgroundColor: 'var(--bg-base)' }}\n46\t      role=\"button\"\n47\t      tabIndex={0}\n48\t      onClick={() => onSelect(paper.id)}\n49\t      onKeyDown={e => { if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); onSelect(paper.id) } }}\n50\t    >\n51\t      <div className=\"flex-1 min-w-0\">\n52\t        <p className=\"text-sm truncate\" style={{ color: 'var(--text-primary)' }}>\n53\t          {paper.title || paper.filename}\n54\t        </p>\n55\t        <div className=\"flex items-center gap-2 mt-0.5 text-xs\" style={{ color: 'var(--text-muted)' }}>\n56\t          {paper.year && <span>{paper.year}</span>}\n57\t          {paper.category && (\n58\t            <span className=\"px-1.5 py-0.5 rounded\" style={{ backgroundColor: 'var(--accent-subtle)', color: 'var(--accent)' }}>\n59\t              {paper.category}\n60\t            </span>\n61\t          )}\n62\t          {paper.venue && <span>{paper.venue}</span>}\n63\t          {paper.index_status === 'indexed' && !paper.year && !paper.category && <span>已索引</span>}\n64\t        </div>\n65\t      </div>\n66\t      <span\n67\t        className=\"shrink-0 text-[10px] px-1.5 py-0.5 rounded-full\"\n68\t        style={{\n69\t          backgroundColor: paper.status === 'failed' ? 'var(--error-subtle)' : 'var(--bg-surface)',\n70\t          color: paper.status === 'failed' ? 'var(--error)' : 'var(--text-muted)',\n71\t        }}\n72\t      >\n73\t        {statusText}\n74\t      </span>\n75\t      <button\n76\t        onClick={handlePromote}\n77\t        disabled={promoting}\n78\t        className=\"shrink-0 text-xs px-2.5 py-1 rounded-md border transition-colors disabled:opacity-50\"\n79\t        style={{\n80\t          borderColor: 'var(--accent)',\n81\t          color: 'var(--accent)',\n82\t          backgroundColor: 'transparent',\n83\t        }}\n84\t      >\n85\t        {promoting ? '移动中…' : '加入论文库'}\n86\t      </button>\n87\t    </div>\n88\t  )\n89\t}\n90\t\n91\texport default function LibraryPage() {\n92\t  const navigate = useNavigate()\n93\t  const [papers, setPapers] = useState<Paper[]>([])\n94\t  const [total, setTotal] = useState(0)\n95\t  const [page, setPage] = useState(1)\n96\t  const [search, setSearch] = useState('')\n97\t  const [category, setCategory] = useState('')\n98\t  const [year, setYear] = useState<number | undefined>()\n99\t  const [dateAdded, setDateAdded] = useState('')\n100\t  const perPage = 20\n101\t\n102\t  const [expandedPapers, setExpandedPapers] = useState<Paper[]>([])\n103\t  const [expandedTotal, setExpandedTotal] = useState(0)\n104\t  const [showExpanded, setShowExpanded] = useState(false)\n105\t\n106\t  // 重新索引：用 GROBID 重提元数据缺失/索引失败的论文，轮询观察进度\n107\t  const [reindexing, setReindexing] = useState(false)\n108\t  const [reindexNote, setReindexNote] = useState<string | null>(null)\n109\t\n110\t  // 智能搜索：searchResults 为 null = 浏览模式；非 null = 搜索结果模式\n111\t  const [globalSearch, setGlobalSearch] = useState(false)\n112\t  const [includeExpanded, setIncludeExpanded] = useState(false)\n113\t  const [searchResults, setSearchResults] = useState<SearchResult[] | null>(null)\n114\t  const [searchTotal, setSearchTotal] = useState(0)\n115\t  const [searchLoading, setSearchLoading] = useState(false)\n116\t\n117\t  // 浏览：仅在无搜索词时拉取分页论文（同时为筛选下拉提供 venue/year 选项）\n118\t  const fetchPapers = useCallback(() => {\n119\t    listPapers({\n120\t      category: category || undefined,\n121\t      year,\n122\t      date_added: dateAdded || undefined,\n123\t      page,\n124\t      per_page: perPage,\n125\t      source: 'uploaded',\n126\t    })\n127\t      .then(res => {\n128\t        setPapers(res.papers)\n129\t        setTotal(res.total)\n130\t      })\n131\t      .catch(() => { toast({ type: 'error', message: '加载论文列表失败' }) })\n132\t  }, [category, year, dateAdded, page])\n133\t\n134\t  // 智能搜索：搜索词非空时调 smart-search（元数据 + 解读内容 + 可选全局正文）\n135\t  useEffect(() => {\n136\t    const q = search.trim()\n137\t    if (!q) {\n138\t      setSearchResults(null)\n139\t      return\n140\t    }\n141\t    setSearchLoading(true)\n142\t    smartSearch(q, { category: category || undefined, year, dateAdded: dateAdded || undefined, global: globalSearch, includeExpanded, page, perPage })\n143\t      .then(res => {\n144\t        setSearchResults(res.results)\n145\t        setSearchTotal(res.total)\n146\t      })\n147\t      .catch(() => { setSearchResults([]); setSearchTotal(0) })\n148\t      .finally(() => setSearchLoading(false))\n149\t  }, [search, category, year, dateAdded, globalSearch, includeExpanded, page])\n150\t\n151\t  const fetchExpandedPapers = useCallback(() => {\n152\t    listPapers({ source: 'expanded', per_page: 100 })\n153\t      .then(res => {\n154\t        setExpandedPapers(res.papers)\n155\t        setExpandedTotal(res.total)\n156\t      })\n157\t      .catch(() => { toast({ type: 'error', message: '加载扩展论文失败' }) })\n158\t  }, [])\n159\t\n160\t  useEffect(() => { fetchPapers() }, [fetchPapers])\n161\t  useEffect(() => { fetchExpandedPapers() }, [fetchExpandedPapers])\n162\t\n163\t  const handleSelect = useCallback((id: number) => {\n164\t    navigate(`/reader/${id}`)\n165\t  }, [navigate])\n166\t\n167\t  const handleDelete = useCallback(async (id: number) => {\n168\t    try {\n169\t      await deletePaper(id)\n170\t      fetchPapers()\n171\t    } catch (e: any) {\n172\t      toast({ type: 'error', message: e?.message || '删除论文失败' })\n173\t    }\n174\t  }, [fetchPapers])\n175\t\n176\t  const handleSearch = useCallback((query: string) => {\n177\t    setSearch(query)\n178\t    setPage(1)\n179\t  }, [])\n180\t\n181\t  const handleFilter = useCallback((filters: { category?: string; year?: number; dateAdded?: string }) => {\n182\t    setCategory(filters.category || '')\n183\t    setYear(filters.year)\n184\t    setDateAdded(filters.dateAdded || '')\n185\t    setPage(1)\n186\t  }, [])\n187\t\n188\t  const handlePageChange = useCallback((newPage: number) => {\n189\t    setPage(newPage)\n190\t  }, [])\n191\t\n192\t  const handlePromote = useCallback((id: number) => {\n193\t    setExpandedPapers(prev => prev.filter(p => p.id !== id))\n194\t    setExpandedTotal(prev => prev - 1)\n195\t    fetchPapers()\n196\t  }, [fetchPapers])\n197\t\n198\t  const handleToggleGlobal = useCallback((v: boolean) => {\n199\t    setGlobalSearch(v)\n200\t    setPage(1)\n201\t  }, [])\n202\t\n203\t  const handleToggleExpanded = useCallback((v: boolean) => {\n204\t    setIncludeExpanded(v)\n205\t    setPage(1)\n206\t  }, [])\n207\t\n208\t  const handleReindex = useCallback(async () => {\n209\t    if (reindexing) return\n210\t    setReindexNote(null)\n211\t    setReindexing(true)\n212\t    try {\n213\t      const { queued } = await reindexLibrary(includeExpanded)\n214\t      if (queued === 0) {\n215\t        setReindexing(false)\n216\t        setReindexNote('没有可重新索引的论文')\n217\t        setTimeout(() => setReindexNote(null), 4000)\n218\t        return\n219\t      }\n220\t      setReindexNote(`正在重新索引 ${queued} 篇论文${includeExpanded ? '（含联网扩展）' : ''}…`)\n221\t      // 轮询：当不再有论文处于 indexing（且已过启动窗口）即视为完成\n222\t      const pollSource = includeExpanded ? 'all' : 'uploaded'\n223\t      const started = Date.now()\n224\t      const poll = async () => {\n225\t        const res = await listPapers({ source: pollSource, per_page: 200 }).catch(() => null)\n226\t        const indexing = res ? res.papers.filter(p => p.index_status === 'indexing').length : 0\n227\t        fetchPapers()\n228\t        if (includeExpanded) fetchExpandedPapers()  // 同步刷新「深度研究发现的论文」区块\n229\t        const elapsed = Date.now() - started\n230\t        if (indexing === 0 && elapsed > 4000) {\n231\t          setReindexing(false)\n232\t          setReindexNote('重新索引完成')\n233\t          setTimeout(() => setReindexNote(null), 4000)\n234\t          return\n235\t        }\n236\t        if (elapsed > 180000) {  // 兜底超时\n237\t          setReindexing(false)\n238\t          setReindexNote(null)\n239\t          return\n240\t        }\n241\t        setTimeout(poll, 3000)\n242\t      }\n243\t      setTimeout(poll, 3000)\n244\t    } catch {\n245\t      setReindexing(false)\n246\t      setReindexNote('重新索引失败，请重试')\n247\t      setTimeout(() => setReindexNote(null), 4000)\n248\t    }\n249\t  }, [reindexing, fetchPapers, fetchExpandedPapers, includeExpanded])\n250\t\n251\t  return (\n252\t    <div className=\"max-w-5xl mx-auto h-[calc(100vh-3.5rem)] flex flex-col\">\n253\t      <div className=\"px-6 pt-6 pb-2 flex items-center justify-between gap-3\">\n254\t        <h1 className=\"text-xl font-bold\" style={{ color: 'var(--text-primary)' }}>论文库</h1>\n255\t        <div className=\"flex items-center gap-3\">\n256\t          {reindexNote && (\n257\t            <span className=\"text-xs\" style={{ color: 'var(--text-muted)' }}>{reindexNote}</span>\n258\t          )}\n259\t          <Tooltip\n260\t            content=\"重新索引会对每篇论文清空旧索引、用 GROBID 重新提取元数据并覆盖写回（不跳过已索引的论文）。默认处理论文库里的所有论文；勾选「含联网扩展论文」后会一并重做深度研究发现的论文。需后台 GROBID 服务在运行。\"\n261\t            delay={600}\n262\t            placement=\"bottom\"\n263\t          >\n264\t            <button\n265\t              onClick={handleReindex}\n266\t              disabled={reindexing}\n267\t              className=\"flex items-center gap-1.5 px-3 py-1.5 text-sm rounded-lg transition-colors disabled:opacity-60 disabled:cursor-not-allowed\"\n268\t              style={{ color: 'var(--accent)', border: '1px solid var(--border)' }}\n269\t            >\n270\t              <svg\n271\t                className={`w-4 h-4 ${reindexing ? 'animate-spin' : ''}`}\n272\t                fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\" strokeWidth={2}\n273\t              >\n274\t                <path strokeLinecap=\"round\" strokeLinejoin=\"round\"\n275\t                  d=\"M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15\" />\n276\t              </svg>\n277\t              {reindexing ? '索引中…' : '重新索引'}\n278\t            </button>\n279\t          </Tooltip>\n280\t        </div>\n281\t      </div>\n282\t\n283\t      <PaperList\n284\t        papers={papers}\n285\t        total={searchResults !== null ? searchTotal : total}\n286\t        onSelect={handleSelect}\n287\t        onDelete={handleDelete}\n288\t        onSearch={handleSearch}\n289\t        onFilter={handleFilter}\n290\t        onPageChange={handlePageChange}\n291\t        page={page}\n292\t        perPage={perPage}\n293\t        globalSearch={globalSearch}\n294\t        onToggleGlobal={handleToggleGlobal}\n295\t        includeExpanded={includeExpanded}\n296\t        onToggleExpanded={handleToggleExpanded}\n297\t        searchResults={searchResults}\n298\t        searchLoading={searchLoading}\n299\t        searchQuery={search}\n300\t      />\n301\t\n302\t      {/* 深度研究发现区块 */}\n303\t      {expandedTotal > 0 && (\n304\t        <div className=\"px-6 pb-6 shrink-0\">\n305\t          <button\n306\t            className=\"w-full flex items-center justify-between px-4 py-3 rounded-xl border transition-colors\"\n307\t            style={{\n308\t              borderColor: 'var(--border)',\n309\t              backgroundColor: showExpanded ? 'var(--bg-surface)' : 'transparent',\n310\t            }}\n311\t            onClick={() => setShowExpanded(v => !v)}\n312\t          >\n313\t            <div className=\"flex items-center gap-2\">\n314\t              <svg className=\"w-4 h-4 shrink-0\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\"\n315\t                style={{ color: 'var(--accent)' }}>\n316\t                <path strokeLinecap=\"round\" strokeLinejoin=\"round\" strokeWidth={2}\n317\t                  d=\"M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z\" />\n318\t              </svg>\n319\t              <span className=\"text-sm font-medium\" style={{ color: 'var(--text-secondary)' }}>\n320\t                深度研究发现的论文\n321\t              </span>\n322\t              <span\n323\t                className=\"text-xs px-1.5 py-0.5 rounded-full\"\n324\t                style={{ backgroundColor: 'var(--accent-subtle)', color: 'var(--accent)' }}\n325\t              >\n326\t                {expandedTotal}\n327\t              </span>\n328\t            </div>\n329\t            <svg\n330\t              className={`w-4 h-4 transition-transform ${showExpanded ? 'rotate-180' : ''}`}\n331\t              fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\"\n332\t              style={{ color: 'var(--text-muted)' }}\n333\t            >\n334\t              <path strokeLinecap=\"round\" strokeLinejoin=\"round\" strokeWidth={2} d=\"M19 9l-7 7-7-7\" />\n335\t            </svg>\n336\t          </button>\n337\t\n338\t          {showExpanded && (\n339\t            <div\n340\t              className=\"mt-2 rounded-xl border overflow-hidden\"\n341\t              style={{ borderColor: 'var(--border)' }}\n342\t            >\n343\t              <div className=\"px-4 py-2 border-b\" style={{ borderColor: 'var(--border)', backgroundColor: 'var(--bg-surface)' }}>\n344\t                <p className=\"text-xs\" style={{ color: 'var(--text-muted)' }}>\n345\t                  通过深度研究联网扩展下载的论文。点击「加入论文库」可将其移入主论文库并在首页显示。\n346\t                </p>\n347\t              </div>\n348\t              <div className=\"divide-y\" style={{ borderColor: 'var(--border)' }}>\n349\t                {expandedPapers.map(p => (\n350\t                  <ExpandedPaperRow\n351\t                    key={p.id}\n352\t                    paper={p}\n353\t                    onPromote={handlePromote}\n354\t                    onSelect={handleSelect}\n355\t                  />\n356\t                ))}\n357\t              </div>\n358\t            </div>\n359\t          )}\n360\t        </div>\n361\t      )}\n362\t    </div>\n363\t  )\n364\t}\n365\t"}]},"parent_tool_use_id":"call_bddd82a75f2e46b98e4517cc","session_id":"29257b8f-ede7-46a4-8e0f-a743591d296a","uuid":"632c56e6-d5f4-4a21-909b-a1df78cee31b","timestamp":"2026-06-09T05:10:19.715Z","subagent_type":"Explore","task_description":"Explore frontend performance"}
