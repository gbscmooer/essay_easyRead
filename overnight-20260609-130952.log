{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call_b5864d948e7d41b2965853a5","type":"tool_result","content":"1\t\"\"\"\n2\tFastAPI 应用入口\n3\t\n4\t配置中间件、挂载路由、启动事件。\n5\t\"\"\"\n6\t\n7\timport os\n8\timport shutil\n9\timport subprocess\n10\tfrom contextlib import asynccontextmanager\n11\tfrom fastapi import FastAPI, Request, WebSocket, WebSocketDisconnect\n12\tfrom fastapi.middleware.cors import CORSMiddleware\n13\tfrom fastapi.responses import StreamingResponse\n14\t\n15\tfrom .config import settings\n16\tfrom .services.database import init_db\n17\tfrom .routers.papers import router as papers_router\n18\tfrom .routers.analysis import router as analysis_router\n19\tfrom .routers.code import router as code_router\n20\tfrom .routers.workspaces import router as workspaces_router\n21\tfrom .routers.research import router as research_router\n22\tfrom .routers.tags import router as tags_router\n23\tfrom .routers.notes import router as notes_router\n24\tfrom .routers.annotations import router as annotations_router\n25\t\n26\t\n27\t@asynccontextmanager\n28\tasync def lifespan(app: FastAPI):\n29\t    \"\"\"应用生命周期管理\"\"\"\n30\t    # startup - 先初始化日志流，这样后续初始化日志都能被捕获\n31\t    from .services.log_stream import setup_log_streaming\n32\t    setup_log_streaming()\n33\t\n34\t    import logging\n35\t    logger = logging.getLogger(\"startup\")\n36\t    logger.info(\"正在初始化应用...\")\n37\t\n38\t    # 确保数据目录存在\n39\t    db_url = settings.resolved_database_url\n40\t    db_dir = os.path.dirname(db_url.replace(\"sqlite:///\", \"\"))\n41\t    os.makedirs(db_dir, exist_ok=True)\n42\t    logger.info(f\"数据库目录: {db_dir}\")\n43\t\n44\t    # 确保上传目录存在\n45\t    upload_dir = settings.resolved_upload_dir\n46\t    os.makedirs(upload_dir, exist_ok=True)\n47\t    logger.info(f\"上传目录: {upload_dir}\")\n48\t\n49\t    # 确保 ChromaDB 目录存在\n50\t    chroma_dir = settings.resolved_chroma_dir\n51\t    os.makedirs(chroma_dir, exist_ok=True)\n52\t    logger.info(f\"ChromaDB 目录: {chroma_dir}\")\n53\t\n54\t    # 初始化数据库\n55\t    init_db(db_url)\n56\t    logger.info(\"数据库初始化完成\")\n57\t\n58\t    # 存量论文自动索引补跑（全文 + 元数据），后台进行不阻塞启动\n59\t    import asyncio\n60\t    from .services.auto_indexer import reindex_missing\n61\t    asyncio.create_task(reindex_missing())\n62\t\n63\t    logger.info(\"应用初始化完成，服务就绪\")\n64\t\n65\t    yield\n66\t\n67\t    # shutdown (如有需要)\n68\t\n69\t\n70\t# 创建 FastAPI 实例\n71\tapp = FastAPI(\n72\t    title=\"Essay Read API\",\n73\t    description=\"AI-powered academic paper reading and analysis platform\",\n74\t    version=\"1.8.1\",\n75\t    lifespan=lifespan,\n76\t)\n77\t\n78\t# 配置 CORS\n79\tapp.add_middleware(\n80\t    CORSMiddleware,\n81\t    allow_origins=[settings.frontend_origin],\n82\t    allow_credentials=True,\n83\t    allow_methods=[\"*\"],\n84\t    allow_headers=[\"*\"],\n85\t)\n86\t\n87\t# 挂载路由\n88\tapp.include_router(papers_router)\n89\tapp.include_router(analysis_router)\n90\tapp.include_router(code_router)\n91\tapp.include_router(workspaces_router)\n92\tapp.include_router(research_router)\n93\tapp.include_router(tags_router)\n94\tapp.include_router(notes_router)\n95\tapp.include_router(annotations_router)\n96\t\n97\t\n98\t@app.get(\"/\")\n99\tasync def root():\n100\t    \"\"\"健康检查端点\"\"\"\n101\t    return {\"message\": \"Essay Read API is running\", \"version\": \"1.8.1\"}\n102\t\n103\t\n104\t@app.get(\"/api/logs/stream\")\n105\tasync def stream_logs():\n106\t    \"\"\"SSE 端点：实时推送后端日志\"\"\"\n107\t    from .services.log_stream import log_event_generator\n108\t    return StreamingResponse(\n109\t        log_event_generator(),\n110\t        media_type=\"text/event-stream\",\n111\t        headers={\n112\t            \"Cache-Control\": \"no-cache\",\n113\t            \"Connection\": \"keep-alive\",\n114\t            \"X-Accel-Buffering\": \"no\",\n115\t        },\n116\t    )\n117\t\n118\t\n119\tdef _is_localhost(websocket: WebSocket) -> bool:\n120\t    host = websocket.client.host if websocket.client else \"\"\n121\t    return host in (\"127.0.0.1\", \"::1\", \"localhost\")\n122\t\n123\t\n124\tdef _is_safe_cwd(path: str) -> bool:\n125\t    real = os.path.realpath(path)\n126\t    project_root = os.path.realpath(os.path.dirname(os.path.dirname(__file__)))\n127\t    return real.startswith(project_root + os.sep) or real == project_root\n128\t\n129\t\n130\t@app.websocket(\"/api/terminal/ws\")\n131\tasync def terminal_websocket(websocket: WebSocket):\n132\t    \"\"\"WebSocket 端点：真实 PTY 终端（仅限 localhost）\"\"\"\n133\t    if not _is_localhost(websocket):\n134\t        await websocket.close(code=4003, reason=\"Terminal access restricted to localhost\")\n135\t        return\n136\t    await websocket.accept()\n137\t    cwd = websocket.query_params.get(\"cwd\") or os.getcwd()\n138\t    if not _is_safe_cwd(cwd):\n139\t        cwd = os.getcwd()\n140\t    from .services.terminal import handle_terminal_websocket\n141\t    try:\n142\t        await handle_terminal_websocket(websocket, cwd)\n143\t    except WebSocketDisconnect:\n144\t        pass\n145\t    except Exception as e:\n146\t        import logging\n147\t        logging.getLogger(__name__).error(f\"Terminal error: {e}\")\n148\t    finally:\n149\t        try:\n150\t            await websocket.close()\n151\t        except Exception:\n152\t            pass\n153\t\n154\t\n155\t@app.post(\"/api/system/open-vscode\")\n156\tasync def open_vscode(request: Request, req: dict):\n157\t    \"\"\"打开 VSCode（仅限 localhost）\"\"\"\n158\t    if request.client and request.client.host not in (\"127.0.0.1\", \"::1\", \"localhost\"):\n159\t        return {\"error\": \"仅限本地访问\"}\n160\t\n161\t    path = req.get(\"path\", \"\")\n162\t    if not path or not os.path.exists(path):\n163\t        return {\"error\": \"路径不存在\"}\n164\t\n165\t    real_path = os.path.realpath(path)\n166\t    project_root = os.path.realpath(os.path.dirname(os.path.dirname(__file__)))\n167\t    if not real_path.startswith(project_root + os.sep) and real_path != project_root:\n168\t        return {\"error\": \"路径不在项目目录内\"}\n169\t\n170\t    code_cmd = shutil.which(\"code\")\n171\t    if not code_cmd:\n172\t        mac_path = \"/usr/local/bin/code\"\n173\t        if os.path.exists(mac_path):\n174\t            code_cmd = mac_path\n175\t\n176\t    if not code_cmd:\n177\t        return {\"error\": \"未找到 VSCode，请确保已安装并将 'code' 命令添加到 PATH\"}\n178\t\n179\t    try:\n180\t        subprocess.Popen([code_cmd, real_path], start_new_session=True)\n181\t        return {\"message\": f\"已打开 VSCode: {real_path}\"}\n182\t    except Exception as e:\n183\t        return {\"error\": f\"打开失败: {str(e)}\"}\n184\t\n185\t"}]},"parent_tool_use_id":"call_14fbefec6f4c427bbf12da10","session_id":"29257b8f-ede7-46a4-8e0f-a743591d296a","uuid":"0eb12d11-9f0e-45fd-a3be-e01c190a643d","timestamp":"2026-06-09T05:10:15.990Z","subagent_type":"Explore","task_description":"Explore backend performance"}
