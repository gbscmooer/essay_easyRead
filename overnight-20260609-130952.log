{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call_34cf357f7355419b9399ea46","type":"tool_result","content":"1\t\"\"\"\n2\t论文分析后台任务管理器\n3\t\n4\t将 AI 分析流程从 HTTP SSE 连接中解耦：分析在 asyncio 后台任务里运行，\n5\t即使前端断开（切换页面、刷新）也会继续执行。SSE 端点退化为「订阅者」，\n6\t连接时回放已产生的事件 + 实时接收新事件；断开只是取消订阅，不会终止分析。\n7\t\n8\t每个 paper_id 对应一个 AnalysisJob，保存：\n9\t- events: 事件回放缓冲（新订阅者用它补齐已发生的进度）\n10\t- subscribers: 当前所有 SSE 订阅队列\n11\t- percent / status: 最新进度，用于无连接时通过 GET 查询\n12\t\n13\t断点续传：AI 解析出的字段会增量写入 data/analysis_cache/{paper_id}.json。\n14\t若进程意外退出后重新分析，会读取缓存——AI 字段已全部完成则跳过昂贵的 AI 调用，\n15\t相关论文已完成则跳过搜索，直接从断点继续。成功落库后清除缓存。\n16\t\"\"\"\n17\t\n18\timport asyncio\n19\timport json\n20\timport logging\n21\timport os\n22\tfrom typing import Optional\n23\t\n24\tfrom sqlmodel import Session, create_engine\n25\t\n26\tfrom ..config import settings\n27\tfrom ..models.schemas import StreamEvent\n28\t\n29\tlogger = logging.getLogger(__name__)\n30\t\n31\t\n32\t_engine = None\n33\t\n34\t\n35\tdef _get_engine():\n36\t    global _engine\n37\t    if _engine is None:\n38\t        _engine = create_engine(\n39\t            settings.resolved_database_url,\n40\t            connect_args={\"check_same_thread\": False},\n41\t        )\n42\t    return _engine\n43\t\n44\t\n45\t# 用于进度百分比计算的字段（按典型到达顺序），与前端 LoadingState 对齐\n46\t_PROGRESS_FIELDS = [\n47\t    \"title\", \"authors\", \"venue\", \"year\", \"one_sentence\", \"problem\",\n48\t    \"key_contributions\", \"outline\", \"method\", \"experiments\",\n49\t    \"code_mapping\", \"interview_qa\", \"limitations\", \"mermaid_chart\",\n50\t]\n51\t_TOTAL_FIELDS = len(_PROGRESS_FIELDS)\n52\t\n53\t# 相关论文搜索超时（秒）：findpapers 多源 + 网络重试可能卡很久，超时则跳过。\n54\t# 主体结果在此步之前已落库并标记完成，故超时只影响「相关论文」模块，不影响其余字段展示。\n55\tRELATED_PAPERS_TIMEOUT = 45.0\n56\t\n57\t# 判定「AI 分析阶段已完成」所需的核心字段（用于断点续传时决定是否跳过 AI 调用）\n58\t_AI_REQUIRED_FIELDS = [\n59\t    \"title\", \"one_sentence\", \"problem\", \"key_contributions\",\n60\t    \"outline\", \"method\", \"experiments\", \"code_mapping\",\n61\t    \"interview_qa\", \"limitations\",\n62\t]\n63\t\n64\t# 断点续传缓存目录：<project_root>/data/analysis_cache\n65\t_CACHE_DIR = os.path.join(\n66\t    os.path.dirname(os.path.dirname(os.path.dirname(__file__))),\n67\t    \"data\", \"analysis_cache\",\n68\t)\n69\t\n70\t\n71\tdef _cache_path(paper_id: int) -> str:\n72\t    return os.path.join(_CACHE_DIR, f\"{paper_id}.json\")\n73\t\n74\t\n75\tdef load_cache(paper_id: int) -> dict:\n76\t    \"\"\"读取断点缓存；不存在或损坏时返回空 dict。\"\"\"\n77\t    try:\n78\t        with open(_cache_path(paper_id), \"r\", encoding=\"utf-8\") as f:\n79\t            data = json.load(f)\n80\t            return data if isinstance(data, dict) else {}\n81\t    except (FileNotFoundError, json.JSONDecodeError, OSError):\n82\t        return {}\n83\t\n84\t\n85\tdef save_cache(paper_id: int, result: dict) -> None:\n86\t    \"\"\"原子写入断点缓存（临时文件 + rename）。\"\"\"\n87\t    try:\n88\t        os.makedirs(_CACHE_DIR, exist_ok=True)\n89\t        path = _cache_path(paper_id)\n90\t        tmp = path + \".tmp\"\n91\t        with open(tmp, \"w\", encoding=\"utf-8\") as f:\n92\t            json.dump(result, f, ensure_ascii=False)\n93\t        os.replace(tmp, path)\n94\t    except Exception as e:\n95\t        logger.warning(f\"Failed to write analysis cache for paper {paper_id}: {e}\")\n96\t\n97\t\n98\tdef clear_cache(paper_id: int) -> None:\n99\t    \"\"\"删除断点缓存（落库成功或显式重新解析时调用）。\"\"\"\n100\t    try:\n101\t        os.remove(_cache_path(paper_id))\n102\t    except OSError:\n103\t        pass\n104\t\n105\t\n106\tclass AnalysisJob:\n107\t    \"\"\"单篇论文的后台分析任务状态。\"\"\"\n108\t\n109\t    def __init__(self, paper_id: int):\n110\t        self.paper_id = paper_id\n111\t        self.events: list[StreamEvent] = []          # 回放缓冲\n112\t        self.subscribers: set[asyncio.Queue] = set()  # 实时订阅队列\n113\t        self.done = False\n114\t        self.task: Optional[asyncio.Task] = None\n115\t        self.percent = 0\n116\t        self.status = \"pending\"\n117\t        self.message = \"\"\n118\t\n119\t    def emit(self, event: StreamEvent) -> None:\n120\t        \"\"\"记录事件并广播给所有订阅者。\"\"\"\n121\t        self.events.append(event)\n122\t        for q in list(self.subscribers):\n123\t            try:\n124\t                q.put_nowait(event)\n125\t            except Exception:\n126\t                pass\n127\t\n128\t    def subscribe(self) -> asyncio.Queue:\n129\t        \"\"\"新建订阅队列，先灌入已发生的全部事件（回放）。\"\"\"\n130\t        q: asyncio.Queue = asyncio.Queue()\n131\t        for ev in self.events:\n132\t            q.put_nowait(ev)\n133\t        self.subscribers.add(q)\n134\t        return q\n135\t\n136\t    def unsubscribe(self, q: asyncio.Queue) -> None:\n137\t        self.subscribers.discard(q)\n138\t\n139\t\n140\tdef _json_safe(obj):\n141\t    \"\"\"递归地将对象转换为 JSON 可序列化的纯结构。\n142\t\n143\t    防止第三方库（如 findpapers 的 Source/Author 对象）混入字段，\n144\t    导致 SSE 序列化或数据库写入崩溃。无法识别的对象退化为 str()。\n145\t    \"\"\"\n146\t    if obj is None or isinstance(obj, (str, int, float, bool)):\n147\t        return obj\n148\t    if isinstance(obj, dict):\n149\t        return {str(k): _json_safe(v) for k, v in obj.items()}\n150\t    if isinstance(obj, (list, tuple, set)):\n151\t        return [_json_safe(v) for v in obj]\n152\t    # 优先用对象自带的字典化方法\n153\t    for attr in (\"model_dump\", \"to_dict\", \"dict\"):\n154\t        fn = getattr(obj, attr, None)\n155\t        if callable(fn):\n156\t            try:\n157\t                return _json_safe(fn())\n158\t            except Exception:\n159\t                break\n160\t    return str(obj)\n161\t\n162\t\n163\t_jobs: dict[int, AnalysisJob] = {}\n164\t\n165\t\n166\tdef get_job(paper_id: int) -> Optional[AnalysisJob]:\n167\t    return _jobs.get(paper_id)\n168\t\n169\t\n170\tdef ensure_job(paper_id: int, pdf_path: str) -> AnalysisJob:\n171\t    \"\"\"获取正在运行的任务；若不存在或已结束，则启动一个新的后台任务。\"\"\"\n172\t    job = _jobs.get(paper_id)\n173\t    if job is not None and not job.done:\n174\t        return job\n175\t\n176\t    job = AnalysisJob(paper_id)\n177\t    _jobs[paper_id] = job\n178\t    job.task = asyncio.create_task(_run_analysis(job, pdf_path))\n179\t    return job\n180\t\n181\t\n182\tasync def _run_analysis(job: AnalysisJob, pdf_path: str) -> None:\n183\t    \"\"\"后台执行完整分析流程，向 job 发射 SSE 事件。\"\"\"\n184\t    paper_id = job.paper_id\n185\t    engine = _get_engine()\n186\t\n187\t    from .database import (\n188\t        update_paper_status,\n189\t        save_analysis_result, update_paper_code_url, update_related_papers,\n190\t    )\n191\t\n192\t    def emit_progress(percent: int, message: str, status: str) -> None:\n193\t        job.percent = percent\n194\t        job.status = status\n195\t        job.message = message\n196\t        job.emit(StreamEvent(\n197\t            event=\"progress\",\n198\t            data={\"percent\": percent, \"message\": message, \"status\": status},\n199\t        ))\n200\t\n201\t    def emit_cached_fields(res: dict) -> None:\n202\t        \"\"\"把缓存里已完成的字段推给前端，实现断点恢复时瞬间显示。\"\"\"\n203\t        for fname, value in res.items():\n204\t            job.emit(StreamEvent(event=\"field\", field_name=fname, data={\"value\": value}))\n205\t        method = res.get(\"method\")\n206\t        if isinstance(method, dict) and method.get(\"mermaid_chart\"):\n207\t            job.emit(StreamEvent(event=\"field\", field_name=\"mermaid_chart\", data={\"value\": method[\"mermaid_chart\"]}))\n208\t\n209\t    from .ai_analyzer import analyze_paper_stream, extract_code_url\n210\t    from .ai_config import get_analysis_config\n211\t\n212\t    # ---- 0. 读取断点缓存 ----\n213\t    result: dict = load_cache(paper_id)\n214\t    ai_done = bool(result) and all(f in result for f in _AI_REQUIRED_FIELDS)\n215\t    related_done = \"related_papers\" in result\n216\t\n217\t    try:\n218\t        ai_cfg = get_analysis_config()\n219\t\n220\t        # 有缓存：先把已完成字段推给前端（断点恢复）\n221\t        if result:\n222\t            job.emit(StreamEvent(event=\"status\", data={\"status\": \"analyzing\", \"message\": \"检测到断点缓存，正在恢复已完成的分析...\"}))\n223\t            emit_cached_fields(result)\n224\t\n225\t        # ---- 1. 提取 PDF 文本（用于代码仓库提取，廉价，始终执行）----\n226\t        with Session(engine) as session:\n227\t            update_paper_status(session, paper_id, \"extracting\")\n228\t        job.emit(StreamEvent(event=\"status\", data={\"status\": \"extracting\", \"message\": \"正在提取 PDF 文本...\"}))\n229\t        emit_progress(3, \"正在提取 PDF 文本...\", \"extracting\")\n230\t\n231\t        from .pdf_parser import extract_pdf_content\n232\t        content = await asyncio.to_thread(extract_pdf_content, pdf_path)\n233\t        emit_progress(10, \"PDF 文本提取完成，准备分析\", \"extracting\")\n234\t\n235\t        # ---- 2. AI 流式分析（缓存已完成则跳过昂贵的 AI 调用）----\n236\t        with Session(engine) as session:\n237\t            update_paper_status(session, paper_id, \"analyzing\")\n238\t\n239\t        if ai_done:\n240\t            emit_progress(85, \"已从缓存恢复 AI 分析结果，跳过重新分析\", \"analyzing\")\n241\t        else:\n242\t            job.emit(StreamEvent(event=\"status\", data={\"status\": \"analyzing\", \"message\": \"正在调用 AI 分析...\"}))\n243\t            from .ai_config import get_active_analysis_prompt\n244\t            received = 0\n245\t            async for event in analyze_paper_stream(\n246\t                content.full_text,\n247\t                ai_cfg[\"api_key\"],\n248\t                ai_cfg[\"base_url\"],\n249\t                ai_cfg[\"model\"],\n250\t                temperature=ai_cfg.get(\"temperature\", 0.1),\n251\t                max_tokens=ai_cfg.get(\"max_tokens\", 16384),\n252\t                system_prompt=get_active_analysis_prompt(),\n253\t            ):\n254\t                # analyze_paper_stream 自己会发 error 事件，但我们用异常路径统一处理，\n255\t                # 这里仅转发 status / field，done 留给最终阶段统一发。\n256\t                if event.event == \"error\":\n257\t                    raise RuntimeError(event.data.get(\"message\", \"AI 分析失败\"))\n258\t                if event.event == \"done\":\n259\t                    continue\n260\t                job.emit(event)\n261\t\n262\t                if event.event == \"field\" and event.field_name:\n263\t                    if event.field_name == \"mermaid_chart\":\n264\t                        result.setdefault(\"method\", {})\n265\t                        result[\"method\"][\"mermaid_chart\"] = event.data.get(\"value\")\n266\t                    else:\n267\t                        result[event.field_name] = event.data.get(\"value\")\n268\t                    received += 1\n269\t                    pct = min(85, 10 + round(received / _TOTAL_FIELDS * 75))\n270\t                    emit_progress(pct, f\"已解析 {received}/{_TOTAL_FIELDS} 个字段\", \"analyzing\")\n271\t                    # 增量持久化：每完成一个字段就写入缓存，供断点续传\n272\t                    save_cache(paper_id, result)\n273\t\n274\t        # ---- 3. 提取代码仓库 URL ----\n275\t        code_url = extract_code_url(content.full_text)\n276\t        if code_url:\n277\t            job.emit(StreamEvent(event=\"status\", data={\"status\": \"analyzing\", \"message\": f\"找到代码仓库: {code_url}\"}))\n278\t\n279\t        # ---- 4. 先保存「主体结果」并标记完成（相关论文搜索之前）----\n280\t        # 关键：把除相关论文以外的全部字段先落库 + 标记 done，前端据此立即展示。\n281\t        # 这样即使后续相关论文搜索超时、失败甚至进程退出，主体内容也不受影响。\n282\t        emit_progress(90, \"正在保存主体分析结果...\", \"analyzing\")\n283\t        result.setdefault(\"related_papers\", [])\n284\t        for key, default in [\n285\t            (\"title\", \"\"), (\"venue\", \"Unknown\"), (\"year\", 0),\n286\t            (\"one_sentence\", \"\"), (\"problem\", \"\"),\n287\t            (\"key_contributions\", []), (\"outline\", []),\n288\t            (\"method\", {\"overview\": \"\", \"pipeline\": \"\", \"key_modules\": []}),\n289\t            (\"experiments\", {\"datasets\": [], \"baselines\": [], \"main_results\": \"\", \"ablation\": \"\", \"result_table\": [], \"figures\": []}),\n290\t            (\"code_mapping\", []), (\"interview_qa\", []),\n291\t            (\"limitations\", \"\"), (\"related_papers\", []),\n292\t        ]:\n293\t            result.setdefault(key, default)\n294\t        result = _json_safe(result)\n295\t\n296\t        with Session(engine) as session:\n297\t            # 注意：不再由 LLM 解读结果回写 Paper 的 title/venue/year。\n298\t            # 论文库索引（Paper 元数据）统一以 GROBID 自动索引为唯一来源，\n299\t            # 解读结果只存进 AnalysisResult 供阅读页展示。\n300\t            save_analysis_result(session, paper_id, result)\n301\t            if code_url:\n302\t                update_paper_code_url(session, paper_id, code_url)\n303\t            update_paper_status(session, paper_id, \"done\")\n304\t\n305\t        # 主体已落库，断点缓存不再需要\n306\t        clear_cache(paper_id)\n307\t        # main_done：通知前端立即渲染全部主体字段（不等待相关论文）\n308\t        job.emit(StreamEvent(event=\"main_done\", data={\"message\": \"主体分析完成\"}))\n309\t\n310\t        # ---- 4.5 LLM 自动分类标签 ----\n311\t        try:\n312\t            from .auto_tagger import auto_tag_paper\n313\t            from ..models.tag import Tag, PaperTag\n314\t            from sqlmodel import select as _sel\n315\t\n316\t            tag_result = await auto_tag_paper(\n317\t                title=result.get(\"title\", \"\"),\n318\t                one_sentence=result.get(\"one_sentence\", \"\"),\n319\t                method_overview=(result.get(\"method\") or {}).get(\"overview\", \"\"),\n320\t                venue=result.get(\"venue\", \"\"),\n321\t                api_key=ai_cfg[\"api_key\"],\n322\t                base_url=ai_cfg[\"base_url\"],\n323\t                model=ai_cfg[\"model\"],\n324\t            )\n325\t            if tag_result:\n326\t                with Session(engine) as session:\n327\t                    for tag_name in tag_result:\n328\t                        tag = session.exec(_sel(Tag).where(Tag.name == tag_name)).first()\n329\t                        if not tag:\n330\t                            tag = Tag(name=tag_name)\n331\t                            session.add(tag)\n332\t                            session.commit()\n333\t                            session.refresh(tag)\n334\t                        existing = session.exec(\n335\t                            _sel(PaperTag).where(PaperTag.paper_id == paper_id, PaperTag.tag_id == tag.id)\n336\t                        ).first()\n337\t                        if not existing:\n338\t                            session.add(PaperTag(paper_id=paper_id, tag_id=tag.id))\n339\t                    session.commit()\n340\t                job.emit(StreamEvent(event=\"tags\", data={\"tags\": tag_result}))\n341\t        except Exception as e:\n342\t            logger.warning(f\"Auto-tagging skipped: {e}\")\n343\t\n344\t        # ---- 5. 相关论文搜索（最佳努力；超时/失败仅影响此模块）----\n345\t        if related_done and result.get(\"related_papers\"):\n346\t            emit_progress(96, \"已从缓存恢复相关论文\", \"analyzing\")\n347\t            job.emit(StreamEvent(event=\"related_status\", data={\"status\": \"ok\"}))\n348\t            job.emit(StreamEvent(event=\"field\", field_name=\"related_papers\", data={\"value\": result[\"related_papers\"]}))\n349\t        else:\n350\t            paper_title = result.get(\"title\", \"\")\n351\t            if paper_title:\n352\t                emit_progress(92, \"正在后台搜索相关论文...\", \"analyzing\")\n353\t                job.emit(StreamEvent(event=\"related_status\", data={\"status\": \"loading\"}))\n354\t\n355\t                async def _fetch_related() -> list:\n356\t                    from .ai_config import get_findpapers_config\n357\t                    from .semantic_scholar import generate_relevance_descriptions\n358\t                    fp_cfg = get_findpapers_config()\n359\t                    if fp_cfg.get(\"enabled\"):\n360\t                        from .findpapers_service import search_related_papers as _fp_search\n361\t                        found = await _fp_search(paper_title, fp_cfg)\n362\t                    else:\n363\t                        from .semantic_scholar import search_related_papers\n364\t                        found = await search_related_papers(paper_title)\n365\t                    if found:\n366\t                        found = await generate_relevance_descriptions(\n367\t                            paper_title,\n368\t                            result.get(\"one_sentence\", \"\"),\n369\t                            found,\n370\t                            ai_cfg[\"api_key\"],\n371\t                            ai_cfg[\"base_url\"],\n372\t                            ai_cfg[\"model\"],\n373\t                        )\n374\t                    return found or []\n375\t\n376\t                related_ok = False\n377\t                try:\n378\t                    related = await asyncio.wait_for(_fetch_related(), timeout=RELATED_PAPERS_TIMEOUT)\n379\t                    result[\"related_papers\"] = _json_safe(related)\n380\t                    related_ok = True\n381\t                except asyncio.TimeoutError:\n382\t                    logger.warning(f\"Related papers lookup timed out after {RELATED_PAPERS_TIMEOUT}s, skipping\")\n383\t                except Exception as e:\n384\t                    logger.warning(f\"Related papers lookup failed: {e}\")\n385\t\n386\t                if related_ok:\n387\t                    with Session(engine) as session:\n388\t                        update_related_papers(session, paper_id, result[\"related_papers\"])\n389\t                    job.emit(StreamEvent(event=\"related_status\", data={\"status\": \"ok\"}))\n390\t                    job.emit(StreamEvent(event=\"field\", field_name=\"related_papers\", data={\"value\": result[\"related_papers\"]}))\n391\t                else:\n392\t                    # 仅此模块标记失败，主体结果不受影响\n393\t                    job.emit(StreamEvent(event=\"related_status\", data={\"status\": \"failed\"}))\n394\t\n395\t        # ---- 6. 完成 ----\n396\t        emit_progress(100, \"解析完成\", \"done\")\n397\t        job.emit(StreamEvent(event=\"done\", data={\"message\": \"解析完成\"}))\n398\t\n399\t    except Exception as e:\n400\t        logger.error(f\"Background analysis failed for paper {paper_id}: {e}\")\n401\t        with Session(engine) as session:\n402\t            update_paper_status(session, paper_id, \"failed\", str(e))\n403\t        job.emit(StreamEvent(event=\"error\", data={\"message\": f\"解析失败: {str(e)}\"}))\n404\t    finally:\n405\t        job.done = True\n406\t"}]},"parent_tool_use_id":"call_14fbefec6f4c427bbf12da10","session_id":"29257b8f-ede7-46a4-8e0f-a743591d296a","uuid":"ecdd8e7e-6869-456a-9565-31a34967cb3c","timestamp":"2026-06-09T05:10:23.652Z","subagent_type":"Explore","task_description":"Explore backend performance"}
