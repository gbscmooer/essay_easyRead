{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call_cf277833c15e4a4697ee4ecc","type":"tool_result","content":"1\timport { useState } from 'react'\n2\timport type { RagQueryResponse } from '@/types'\n3\timport { queryRag } from '@/api/research'\n4\timport { CitationChip } from './CitationChip'\n5\t\n6\tinterface RagQueryBoxProps {\n7\t  wsId: number\n8\t}\n9\t\n10\texport function RagQueryBox({ wsId }: RagQueryBoxProps) {\n11\t  const [question, setQuestion] = useState('')\n12\t  const [loading, setLoading] = useState(false)\n13\t  const [result, setResult] = useState<RagQueryResponse | null>(null)\n14\t  const [error, setError] = useState<string | null>(null)\n15\t\n16\t  const handleQuery = async () => {\n17\t    if (!question.trim()) return\n18\t    setLoading(true)\n19\t    setError(null)\n20\t    setResult(null)\n21\t    try {\n22\t      const res = await queryRag(wsId, question.trim())\n23\t      setResult(res)\n24\t    } catch (e: any) {\n25\t      setError(e.message || '查询失败')\n26\t    } finally {\n27\t      setLoading(false)\n28\t    }\n29\t  }\n30\t\n31\t  return (\n32\t    <div className=\"w-full md:w-80 shrink-0 flex flex-col rounded-xl border overflow-hidden\" style={{ borderColor: 'var(--border)', backgroundColor: 'var(--bg-surface)' }}>\n33\t      {/* 标题 */}\n34\t      <div className=\"px-4 py-2.5 border-b\" style={{ borderColor: 'var(--border)' }}>\n35\t        <h3 className=\"text-xs font-semibold\" style={{ color: 'var(--text-primary)' }}>跨论文问答</h3>\n36\t      </div>\n37\t\n38\t      {/* 输入区 */}\n39\t      <div className=\"p-3 border-b\" style={{ borderColor: 'var(--border)' }}>\n40\t        <div className=\"flex gap-2\">\n41\t          <input\n42\t            type=\"text\"\n43\t            value={question}\n44\t            onChange={e => setQuestion(e.target.value)}\n45\t            onKeyDown={e => e.key === 'Enter' && !e.shiftKey && handleQuery()}\n46\t            placeholder=\"输入你的问题...\"\n47\t            className=\"flex-1 px-3 py-1.5 text-xs rounded-lg border\"\n48\t            style={{\n49\t              backgroundColor: 'var(--bg-base)',\n50\t              borderColor: 'var(--border)',\n51\t              color: 'var(--text-primary)',\n52\t            }}\n53\t          />\n54\t          <button\n55\t            onClick={handleQuery}\n56\t            disabled={loading || !question.trim()}\n57\t            className=\"px-3 py-1.5 text-xs font-medium rounded-lg transition-colors disabled:opacity-50\"\n58\t            style={{ backgroundColor: 'var(--accent)', color: 'var(--bg-base)' }}\n59\t          >\n60\t            {loading ? '...' : '提问'}\n61\t          </button>\n62\t        </div>\n63\t      </div>\n64\t\n65\t      {/* 结果区 */}\n66\t      <div className=\"flex-1 overflow-y-auto p-3 space-y-3\">\n67\t        {error && (\n68\t          <p className=\"text-xs text-red-400\">{error}</p>\n69\t        )}\n70\t\n71\t        {loading && (\n72\t          <div className=\"flex items-center gap-2\">\n73\t            <div className=\"w-3 h-3 border rounded-full animate-spin\" style={{ borderColor: 'var(--border)', borderTopColor: 'var(--accent)' }} />\n74\t            <span className=\"text-xs\" style={{ color: 'var(--text-muted)' }}>检索中...</span>\n75\t          </div>\n76\t        )}\n77\t\n78\t        {result && (\n79\t          <>\n80\t            <p className=\"text-xs leading-relaxed\" style={{ color: 'var(--text-primary)' }}>\n81\t              {result.answer}\n82\t            </p>\n83\t            {result.citations.length > 0 && (\n84\t              <div className=\"space-y-1.5\">\n85\t                <span className=\"text-[10px]\" style={{ color: 'var(--text-muted)' }}>引用来源</span>\n86\t                {result.citations.map((c, i) => (\n87\t                  <CitationChip key={i} citation={c} index={i + 1} />\n88\t                ))}\n89\t              </div>\n90\t            )}\n91\t          </>\n92\t        )}\n93\t\n94\t        {!result && !loading && !error && (\n95\t          <p className=\"text-xs text-center mt-8\" style={{ color: 'var(--text-muted)', opacity: 0.5 }}>\n96\t            构建图谱后可进行跨论文语义检索\n97\t          </p>\n98\t        )}\n99\t      </div>\n100\t    </div>\n101\t  )\n102\t}\n103\t"}]},"parent_tool_use_id":"call_bddd82a75f2e46b98e4517cc","session_id":"29257b8f-ede7-46a4-8e0f-a743591d296a","uuid":"3029149a-f384-4d38-bceb-c00cfa4d7f15","timestamp":"2026-06-09T05:10:55.095Z","subagent_type":"Explore","task_description":"Explore frontend performance"}
