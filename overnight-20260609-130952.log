{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call_39ab66580d0948b08c2b76e3","type":"tool_result","content":"1\timport { Link } from 'react-router-dom'\n2\t\n3\texport default function NotFoundPage() {\n4\t  return (\n5\t    <div className=\"flex flex-col items-center justify-center h-full gap-4\">\n6\t      <p className=\"text-6xl font-bold\" style={{ color: 'var(--text-muted)', opacity: 0.3 }}>404</p>\n7\t      <p className=\"text-sm\" style={{ color: 'var(--text-muted)' }}>页面不存在</p>\n8\t      <Link\n9\t        to=\"/\"\n10\t        className=\"px-4 py-2 text-sm rounded-lg transition-colors\"\n11\t        style={{ backgroundColor: 'var(--accent)', color: 'var(--bg-base)' }}\n12\t      >\n13\t        返回首页\n14\t      </Link>\n15\t    </div>\n16\t  )\n17\t}\n18\t"}]},"parent_tool_use_id":"call_bddd82a75f2e46b98e4517cc","session_id":"29257b8f-ede7-46a4-8e0f-a743591d296a","uuid":"dbe36dda-2ee8-425d-bab2-f69a5963587a","timestamp":"2026-06-09T05:10:22.286Z","subagent_type":"Explore","task_description":"Explore frontend performance"}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call_cc5ee35bcd164f36af40a40a","type":"tool_result","content":"1\t\"\"\"\n2\t工作区路由\n3\t\n4\t管理工作区的 CRUD 和论文关联。\n5\t\"\"\"\n6\t\n7\timport logging\n8\tfrom fastapi import APIRouter, HTTPException\n9\tfrom pydantic import BaseModel, Field\n10\tfrom sqlmodel import Session, create_engine, select\n11\tfrom sqlalchemy import desc\n12\tfrom datetime import datetime, timezone\n13\t\n14\tfrom ..models.workspace import Workspace, WorkspacePaper\n15\tfrom ..models.paper import Paper\n16\tfrom ..config import settings\n17\t\n18\tlogger = logging.getLogger(__name__)\n19\t\n20\trouter = APIRouter(prefix=\"/api/workspaces\", tags=[\"workspaces\"])\n21\t\n22\t_engine = None\n23\t\n24\t\n25\tdef _get_engine():\n26\t    global _engine\n27\t    if _engine is None:\n28\t        _engine = create_engine(settings.resolved_database_url, connect_args={\"check_same_thread\": False})\n29\t    return _engine\n30\t\n31\t\n32\tclass WorkspaceCreate(BaseModel):\n33\t    name: str = Field(\"未命名工作区\", max_length=100)\n34\t\n35\t\n36\tclass WorkspaceResponse(BaseModel):\n37\t    id: int\n38\t    name: str\n39\t    paper_count: int = 0\n40\t    created_at: datetime\n41\t    updated_at: datetime\n42\t\n43\t\n44\tclass WorkspaceDetailResponse(BaseModel):\n45\t    id: int\n46\t    name: str\n47\t    papers: list[dict] = []\n48\t    created_at: datetime\n49\t    updated_at: datetime\n50\t\n51\t\n52\tclass AddPaperRequest(BaseModel):\n53\t    paper_id: int\n54\t\n55\t\n56\t# ============================================================\n57\t# GET /api/workspaces\n58\t# ============================================================\n59\t@router.get(\"\", response_model=list[WorkspaceResponse])\n60\tasync def list_workspaces():\n61\t    \"\"\"获取所有工作区\"\"\"\n62\t    engine = _get_engine()\n63\t    with Session(engine) as session:\n64\t        workspaces = session.exec(select(Workspace).order_by(desc(Workspace.updated_at))).all()\n65\t        result = []\n66\t        for ws in workspaces:\n67\t            count_statement = select(WorkspacePaper).where(WorkspacePaper.workspace_id == ws.id)\n68\t            paper_count = len(session.exec(count_statement).all())\n69\t            result.append(WorkspaceResponse(\n70\t                id=ws.id, name=ws.name, paper_count=paper_count,\n71\t                created_at=ws.created_at, updated_at=ws.updated_at,\n72\t            ))\n73\t        return result\n74\t\n75\t\n76\t# ============================================================\n77\t# POST /api/workspaces\n78\t# ============================================================\n79\t@router.post(\"\", response_model=WorkspaceResponse)\n80\tasync def create_workspace(req: WorkspaceCreate):\n81\t    \"\"\"创建工作区\"\"\"\n82\t    engine = _get_engine()\n83\t    with Session(engine) as session:\n84\t        ws = Workspace(name=req.name)\n85\t        session.add(ws)\n86\t        session.commit()\n87\t        session.refresh(ws)\n88\t        return WorkspaceResponse(\n89\t            id=ws.id, name=ws.name, paper_count=0,\n90\t            created_at=ws.created_at, updated_at=ws.updated_at,\n91\t        )\n92\t\n93\t\n94\t# ============================================================\n95\t# GET /api/workspaces/{workspace_id}\n96\t# ============================================================\n97\t@router.get(\"/{workspace_id}\", response_model=WorkspaceDetailResponse)\n98\tasync def get_workspace(workspace_id: int):\n99\t    \"\"\"获取工作区详情（含论文列表）\"\"\"\n100\t    engine = _get_engine()\n101\t    with Session(engine) as session:\n102\t        ws = session.get(Workspace, workspace_id)\n103\t        if not ws:\n104\t            raise HTTPException(status_code=404, detail=\"工作区不存在\")\n105\t\n106\t        # 获取关联的论文\n107\t        stmt = (\n108\t            select(Paper, WorkspacePaper.added_at)\n109\t            .join(WorkspacePaper, WorkspacePaper.paper_id == Paper.id)\n110\t            .where(WorkspacePaper.workspace_id == workspace_id)\n111\t            .order_by(desc(WorkspacePaper.added_at))\n112\t        )\n113\t        rows = session.exec(stmt).all()\n114\t        papers = []\n115\t        for paper, added_at in rows:\n116\t            papers.append({\n117\t                \"id\": paper.id,\n118\t                \"filename\": paper.filename,\n119\t                \"title\": paper.title,\n120\t                \"venue\": paper.venue,\n121\t                \"year\": paper.year,\n122\t                \"status\": paper.status,\n123\t                \"code_url\": paper.code_url,\n124\t                \"code_status\": paper.code_status,\n125\t                \"source\": getattr(paper, \"source\", \"uploaded\"),\n126\t                \"level\": getattr(paper, \"level\", 1),\n127\t                \"parent_paper_id\": getattr(paper, \"parent_paper_id\", None),\n128\t                \"created_at\": paper.created_at.isoformat() if paper.created_at else None,\n129\t                \"added_at\": added_at.isoformat() if added_at else None,\n130\t            })\n131\t\n132\t        return WorkspaceDetailResponse(\n133\t            id=ws.id, name=ws.name, papers=papers,\n134\t            created_at=ws.created_at, updated_at=ws.updated_at,\n135\t        )\n136\t\n137\t\n138\t# ============================================================\n139\t# PUT /api/workspaces/{workspace_id}\n140\t# ============================================================\n141\t@router.put(\"/{workspace_id}\", response_model=WorkspaceResponse)\n142\tasync def update_workspace(workspace_id: int, req: WorkspaceCreate):\n143\t    \"\"\"更新工作区名称\"\"\"\n144\t    engine = _get_engine()\n145\t    with Session(engine) as session:\n146\t        ws = session.get(Workspace, workspace_id)\n147\t        if not ws:\n148\t            raise HTTPException(status_code=404, detail=\"工作区不存在\")\n149\t        ws.name = req.name\n150\t        ws.updated_at = datetime.now(timezone.utc)\n151\t        session.add(ws)\n152\t        session.commit()\n153\t        session.refresh(ws)\n154\t        count_statement = select(WorkspacePaper).where(WorkspacePaper.workspace_id == ws.id)\n155\t        paper_count = len(session.exec(count_statement).all())\n156\t        return WorkspaceResponse(\n157\t            id=ws.id, name=ws.name, paper_count=paper_count,\n158\t            created_at=ws.created_at, updated_at=ws.updated_at,\n159\t        )\n160\t\n161\t\n162\t# ============================================================\n163\t# DELETE /api/workspaces/{workspace_id}\n164\t# ============================================================\n165\t@router.delete(\"/{workspace_id}\")\n166\tasync def delete_workspace(workspace_id: int):\n167\t    \"\"\"删除工作区\"\"\"\n168\t    engine = _get_engine()\n169\t    with Session(engine) as session:\n170\t        ws = session.get(Workspace, workspace_id)\n171\t        if not ws:\n172\t            raise HTTPException(status_code=404, detail=\"工作区不存在\")\n173\t        # 删除关联记录\n174\t        stmt = select(WorkspacePaper).where(WorkspacePaper.workspace_id == workspace_id)\n175\t        for wp in session.exec(stmt).all():\n176\t            session.delete(wp)\n177\t        session.delete(ws)\n178\t        session.commit()\n179\t        return {\"message\": \"工作区已删除\"}\n180\t\n181\t\n182\t# ============================================================\n183\t# POST /api/workspaces/{workspace_id}/papers\n184\t# ============================================================\n185\t@router.post(\"/{workspace_id}/papers\")\n186\tasync def add_paper_to_workspace(workspace_id: int, req: AddPaperRequest):\n187\t    \"\"\"添加论文到工作区\"\"\"\n188\t    engine = _get_engine()\n189\t    with Session(engine) as session:\n190\t        ws = session.get(Workspace, workspace_id)\n191\t        if not ws:\n192\t            raise HTTPException(status_code=404, detail=\"工作区不存在\")\n193\t        paper = session.get(Paper, req.paper_id)\n194\t        if not paper:\n195\t            raise HTTPException(status_code=404, detail=\"论文不存在\")\n196\t        # 检查是否已存在\n197\t        existing = session.exec(\n198\t            select(WorkspacePaper)\n199\t            .where(WorkspacePaper.workspace_id == workspace_id)\n200\t            .where(WorkspacePaper.paper_id == req.paper_id)\n201\t        ).first()\n202\t        if existing:\n203\t            raise HTTPException(status_code=400, detail=\"论文已在工作区中\")\n204\t        wp = WorkspacePaper(workspace_id=workspace_id, paper_id=req.paper_id)\n205\t        session.add(wp)\n206\t        ws.updated_at = datetime.now(timezone.utc)\n207\t        session.add(ws)\n208\t        session.commit()\n209\t        return {\"message\": \"已添加\"}\n210\t\n211\t\n212\t# ============================================================\n213\t# POST /api/workspaces/{workspace_id}/papers/{paper_id}/promote\n214\t# ============================================================\n215\t@router.post(\"/{workspace_id}/papers/{paper_id}/promote\")\n216\tasync def promote_paper(workspace_id: int, paper_id: int):\n217\t    \"\"\"把\"深度研究发现\"中的论文（L2+）提升为工作区正式论文（L1）。\n218\t\n219\t    - level 设为 1\n220\t    - source 改为 'promoted'（保留 parent_paper_id 作为发现来源溯源）\n221\t    - 仍保留 status（pending / indexed / done）不变\n222\t    \"\"\"\n223\t    engine = _get_engine()\n224\t    with Session(engine) as session:\n225\t        wp = session.exec(\n226\t            select(WorkspacePaper)\n227\t            .where(WorkspacePaper.workspace_id == workspace_id)\n228\t            .where(WorkspacePaper.paper_id == paper_id)\n229\t        ).first()\n230\t        if not wp:\n231\t            raise HTTPException(status_code=404, detail=\"论文不在该工作区中\")\n232\t        paper = session.get(Paper, paper_id)\n233\t        if not paper:\n234\t            raise HTTPException(status_code=404, detail=\"论文不存在\")\n235\t        paper.level = 1\n236\t        paper.source = \"promoted\"\n237\t        session.add(paper)\n238\t        ws = session.get(Workspace, workspace_id)\n239\t        if ws:\n240\t            ws.updated_at = datetime.now(timezone.utc)\n241\t            session.add(ws)\n242\t        session.commit()\n243\t        return {\"message\": \"已移入工作区\", \"paper_id\": paper_id}\n244\t\n245\t\n246\t# ============================================================\n247\t# DELETE /api/workspaces/{workspace_id}/papers/{paper_id}\n248\t# ============================================================\n249\t@router.delete(\"/{workspace_id}/papers/{paper_id}\")\n250\tasync def remove_paper_from_workspace(workspace_id: int, paper_id: int):\n251\t    \"\"\"从工作区移除论文\"\"\"\n252\t    engine = _get_engine()\n253\t    with Session(engine) as session:\n254\t        stmt = (\n255\t            select(WorkspacePaper)\n256\t            .where(WorkspacePaper.workspace_id == workspace_id)\n257\t            .where(WorkspacePaper.paper_id == paper_id)\n258\t        )\n259\t        wp = session.exec(stmt).first()\n260\t        if not wp:\n261\t            raise HTTPException(status_code=404, detail=\"论文不在该工作区中\")\n262\t        session.delete(wp)\n263\t        ws = session.get(Workspace, workspace_id)\n264\t        if ws:\n265\t            ws.updated_at = datetime.now(timezone.utc)\n266\t            session.add(ws)\n267\t        session.commit()\n268\t        return {\"message\": \"已移除\"}\n269\t"}]},"parent_tool_use_id":"call_14fbefec6f4c427bbf12da10","session_id":"29257b8f-ede7-46a4-8e0f-a743591d296a","uuid":"4e54f423-4197-476c-adbe-305086a3554e","timestamp":"2026-06-09T05:10:22.244Z","subagent_type":"Explore","task_description":"Explore backend performance"}
