{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call_78afd20a76af43179a3a38aa","type":"tool_result","content":"1\timport { useState, useEffect, useCallback, useRef } from 'react'\n2\timport type { AnalysisResult, RelatedPaper } from '@/types'\n3\timport { refreshRelatedPapers, importRelatedPapers, exportBibtex } from '@/api/papers'\n4\timport type { ImportPaperResult } from '@/api/papers'\n5\timport { listWorkspaces } from '@/api/workspaces'\n6\timport { toast } from '@/hooks/useToast'\n7\timport type { WorkspaceItem } from '@/api/workspaces'\n8\timport { TagManager } from '../TagManager'\n9\t\n10\t\n11\tinterface OverviewTabProps {\n12\t  result: AnalysisResult\n13\t  paperId?: number\n14\t  /** 相关论文模块独立状态：loading 搜索中 / failed 超时或失败 */\n15\t  relatedStatus?: 'idle' | 'loading' | 'ok' | 'failed'\n16\t}\n17\t\n18\texport function OverviewTab({ result, paperId, relatedStatus }: OverviewTabProps) {\n19\t  const [relatedPapers, setRelatedPapers] = useState<RelatedPaper[]>(result.related_papers || [])\n20\t  const [isRefreshing, setIsRefreshing] = useState(false)\n21\t  const [bibtexLoading, setBibtexLoading] = useState(false)\n22\t\n23\t  // Import mode state\n24\t  const [importMode, setImportMode] = useState(false)\n25\t  const [selectedIndices, setSelectedIndices] = useState<Set<number>>(new Set())\n26\t  const [isImporting, setIsImporting] = useState(false)\n27\t  const [importProgress, setImportProgress] = useState<{ done: number; total: number } | null>(null)\n28\t  const [importResults, setImportResults] = useState<ImportPaperResult[] | null>(null)\n29\t\n30\t  // Workspace selector state\n31\t  const [showWsSelector, setShowWsSelector] = useState(false)\n32\t  const [workspaces, setWorkspaces] = useState<WorkspaceItem[]>([])\n33\t  const [wsLoading, setWsLoading] = useState(false)\n34\t  const wsModalRef = useRef<HTMLDivElement>(null)\n35\t\n36\t  // Focus first interactive element when workspace selector opens\n37\t  useEffect(() => {\n38\t    if (!showWsSelector || !wsModalRef.current) return\n39\t    const first = wsModalRef.current.querySelector<HTMLElement>(\n40\t      'button, [href], input, select, textarea, [tabindex]:not([tabindex=\"-1\"])'\n41\t    )\n42\t    first?.focus()\n43\t  }, [showWsSelector, wsLoading])\n44\t\n45\t  useEffect(() => {\n46\t    setRelatedPapers(result.related_papers || [])\n47\t  }, [result.related_papers])\n48\t\n49\t  const handleRefresh = async () => {\n50\t    if (!paperId) return\n51\t    setIsRefreshing(true)\n52\t    try {\n53\t      const papers = await refreshRelatedPapers(paperId)\n54\t      setRelatedPapers(papers)\n55\t    } catch {\n56\t      // keep existing data\n57\t    } finally {\n58\t      setIsRefreshing(false)\n59\t    }\n60\t  }\n61\t\n62\t  // Enter import mode\n63\t  const handleEnterImportMode = useCallback(async () => {\n64\t    setImportMode(true)\n65\t    setSelectedIndices(new Set())\n66\t    setImportResults(null)\n67\t    setImportProgress(null)\n68\t    // Load workspaces\n69\t    setWsLoading(true)\n70\t    try {\n71\t      const wss = await listWorkspaces()\n72\t      setWorkspaces(wss)\n73\t    } catch {\n74\t      setWorkspaces([])\n75\t      toast({ type: 'warning', message: '加载工作区列表失败' })\n76\t    } finally {\n77\t      setWsLoading(false)\n78\t    }\n79\t  }, [])\n80\t\n81\t  // Exit import mode\n82\t  const handleExitImportMode = useCallback(() => {\n83\t    setImportMode(false)\n84\t    setSelectedIndices(new Set())\n85\t    setImportResults(null)\n86\t    setImportProgress(null)\n87\t    setShowWsSelector(false)\n88\t  }, [])\n89\t\n90\t  // Toggle selection\n91\t  const toggleSelect = useCallback((idx: number) => {\n92\t    setSelectedIndices(prev => {\n93\t      const next = new Set(prev)\n94\t      if (next.has(idx)) next.delete(idx)\n95\t      else next.add(idx)\n96\t      return next\n97\t    })\n98\t  }, [])\n99\t\n100\t  // Select all\n101\t  const selectAll = useCallback(() => {\n102\t    if (selectedIndices.size === relatedPapers.length) {\n103\t      setSelectedIndices(new Set())\n104\t    } else {\n105\t      setSelectedIndices(new Set(relatedPapers.map((_, i) => i)))\n106\t    }\n107\t  }, [relatedPapers, selectedIndices.size])\n108\t\n109\t  // Start import → show workspace selector\n110\t  const handleStartImport = useCallback(() => {\n111\t    if (selectedIndices.size === 0) return\n112\t    setShowWsSelector(true)\n113\t  }, [selectedIndices.size])\n114\t\n115\t  // Execute import to a specific workspace\n116\t  const handleImportToWorkspace = useCallback(async (workspaceId: number) => {\n117\t    setShowWsSelector(false)\n118\t    setIsImporting(true)\n119\t    const papersToImport = Array.from(selectedIndices).map(idx => relatedPapers[idx])\n120\t    setImportProgress({ done: 0, total: papersToImport.length })\n121\t\n122\t    try {\n123\t      const resp = await importRelatedPapers(\n124\t        workspaceId,\n125\t        papersToImport.map(p => ({\n126\t          title: p.title,\n127\t          doi: p.doi || '',\n128\t          url: p.url || '',\n129\t        })),\n130\t      )\n131\t      setImportResults(resp.results)\n132\t      setImportProgress({ done: papersToImport.length, total: papersToImport.length })\n133\t    } catch {\n134\t      setImportResults(\n135\t        papersToImport.map(p => ({\n136\t          title: p.title,\n137\t          status: 'failed' as const,\n138\t          message: '导入请求失败',\n139\t        })),\n140\t      )\n141\t    } finally {\n142\t      setIsImporting(false)\n143\t    }\n144\t  }, [selectedIndices, relatedPapers])\n145\t\n146\t  return (\n147\t    <div className=\"space-y-6\">\n148\t      {/* Title + venue + year */}\n149\t      <div>\n150\t        <h1 className=\"text-2xl font-bold mb-2\" style={{ color: 'var(--text-primary)' }}>{result.title}</h1>\n151\t        <div className=\"flex items-center gap-2\">\n152\t          {result.venue && (\n153\t            <span className=\"px-2.5 py-0.5 text-xs font-medium rounded-full\" style={{ backgroundColor: 'var(--bg-elevated)', color: 'var(--text-secondary)' }}>\n154\t              {result.venue}\n155\t            </span>\n156\t          )}\n157\t          {result.year && (\n158\t            <span className=\"px-2.5 py-0.5 text-xs font-medium rounded-full\" style={{ backgroundColor: 'var(--bg-elevated)', color: 'var(--text-secondary)' }}>\n159\t              {result.year}\n160\t            </span>\n161\t          )}\n162\t        </div>\n163\t      </div>\n164\t\n165\t      {/* Authors */}\n166\t      {result.authors && (\n167\t        <p className=\"text-sm\" style={{ color: 'var(--text-secondary)' }}>{result.authors}</p>\n168\t      )}\n169\t\n170\t      {/* Tags + Export */}\n171\t      {paperId && (\n172\t        <div className=\"flex items-center justify-between gap-3\">\n173\t          <TagManager paperId={paperId} />\n174\t          <div className=\"flex items-center gap-2 shrink-0\">\n175\t            <button\n176\t              onClick={async () => {\n177\t                setBibtexLoading(true)\n178\t                try {\n179\t                  const bib = await exportBibtex(paperId)\n180\t                  const blob = new Blob([bib], { type: 'text/plain' })\n181\t                  const url = URL.createObjectURL(blob)\n182\t                  const a = document.createElement('a')\n183\t                  a.href = url\n184\t                  a.download = `${(result.title || 'paper').replace(/[^\\w\\s-]/g, '').trim() || 'paper'}.bib`\n185\t                  a.click()\n186\t                  URL.revokeObjectURL(url)\n187\t                } catch (e: any) {\n188\t                  toast({ type: 'error', message: e?.message || '导出 BibTeX 失败' })\n189\t                } finally {\n190\t                  setBibtexLoading(false)\n191\t                }\n192\t              }}\n193\t              disabled={bibtexLoading}\n194\t              className=\"flex items-center gap-1 text-xs px-2.5 py-1 rounded-md border transition-colors disabled:opacity-50\"\n195\t              style={{ borderColor: 'var(--border)', color: 'var(--text-muted)' }}\n196\t              title=\"导出 BibTeX\"\n197\t            >\n198\t              <svg className=\"w-3 h-3\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\">\n199\t                <path strokeLinecap=\"round\" strokeLinejoin=\"round\" strokeWidth={2} d=\"M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z\" />\n200\t              </svg>\n201\t              BibTeX\n202\t            </button>\n203\t          </div>\n204\t        </div>\n205\t      )}\n206\t\n207\t      {/* One-sentence contribution */}\n208\t      {result.one_sentence && (\n209\t        <div className=\"bg-blue-500/10 border-l-4 border-blue-500 p-4 rounded-r-lg\">\n210\t          <p className=\"text-blue-300 text-sm leading-relaxed\">{result.one_sentence}</p>\n211\t        </div>\n212\t      )}\n213\t\n214\t      {/* Research problem */}\n215\t      {result.problem && (\n216\t        <section>\n217\t          <h2 className=\"text-lg font-semibold mb-2\" style={{ color: 'var(--text-primary)' }}>研究问题</h2>\n218\t          <p className=\"text-sm leading-relaxed\" style={{ color: 'var(--text-secondary)' }}>{result.problem}</p>\n219\t        </section>\n220\t      )}\n221\t\n222\t      {/* Key contributions */}\n223\t      {result.key_contributions && result.key_contributions.length > 0 && (\n224\t        <section>\n225\t          <h2 className=\"text-lg font-semibold mb-3\" style={{ color: 'var(--text-primary)' }}>核心贡献</h2>\n226\t          <ol className=\"space-y-2\">\n227\t            {result.key_contributions.map((item, idx) => (\n228\t              <li key={idx} className=\"flex gap-3 text-sm\" style={{ color: 'var(--text-secondary)' }}>\n229\t                <span className=\"flex-shrink-0 w-6 h-6 flex items-center justify-center bg-blue-500/20 text-blue-400 rounded-full text-xs font-medium\">\n230\t                  {idx + 1}\n231\t                </span>\n232\t                <span className=\"leading-relaxed\">{item}</span>\n233\t              </li>\n234\t            ))}\n235\t          </ol>\n236\t        </section>\n237\t      )}\n238\t\n239\t      {/* Related papers */}\n240\t      <section>\n241\t        <div className=\"flex items-center justify-between mb-3\">\n242\t          <h2 className=\"text-lg font-semibold\" style={{ color: 'var(--text-primary)' }}>相关论文推荐</h2>\n243\t          <div className=\"flex items-center gap-2\">\n244\t            {importMode ? (\n245\t              <>\n246\t                <button\n247\t                  onClick={selectAll}\n248\t                  className=\"flex items-center gap-1.5 px-3 py-1 text-xs rounded transition-colors\"\n249\t                  style={{ color: 'var(--text-secondary)', backgroundColor: 'var(--bg-elevated)' }}\n250\t                  onMouseEnter={e => { (e.currentTarget as HTMLElement).style.backgroundColor = 'var(--bg-surface)'; (e.currentTarget as HTMLElement).style.color = 'var(--text-primary)' }}\n251\t                  onMouseLeave={e => { (e.currentTarget as HTMLElement).style.backgroundColor = 'var(--bg-elevated)'; (e.currentTarget as HTMLElement).style.color = 'var(--text-secondary)' }}\n252\t                >\n253\t                  {selectedIndices.size === relatedPapers.length ? '取消全选' : '全选'}\n254\t                </button>\n255\t                <button\n256\t                  onClick={handleStartImport}\n257\t                  disabled={selectedIndices.size === 0 || isImporting}\n258\t                  className=\"flex items-center gap-1.5 px-3 py-1 text-xs rounded transition-colors disabled:opacity-50\"\n259\t                  style={{ backgroundColor: 'var(--accent)', color: 'var(--bg-base)' }}\n260\t                  onMouseEnter={e => { (e.currentTarget as HTMLElement).style.opacity = '0.85' }}\n261\t                  onMouseLeave={e => { (e.currentTarget as HTMLElement).style.opacity = '1' }}\n262\t                >\n263\t                  导入选中 ({selectedIndices.size})\n264\t                </button>\n265\t                <button\n266\t                  onClick={handleExitImportMode}\n267\t                  disabled={isImporting}\n268\t                  className=\"flex items-center gap-1.5 px-3 py-1 text-xs rounded transition-colors disabled:opacity-50\"\n269\t                  style={{ color: 'var(--text-secondary)', backgroundColor: 'var(--bg-elevated)' }}\n270\t                  onMouseEnter={e => { (e.currentTarget as HTMLElement).style.backgroundColor = 'var(--bg-surface)'; (e.currentTarget as HTMLElement).style.color = 'var(--text-primary)' }}\n271\t                  onMouseLeave={e => { (e.currentTarget as HTMLElement).style.backgroundColor = 'var(--bg-elevated)'; (e.currentTarget as HTMLElement).style.color = 'var(--text-secondary)' }}\n272\t                >\n273\t                  取消\n274\t                </button>\n275\t              </>\n276\t            ) : (\n277\t              <>\n278\t                {relatedPapers.length > 0 && paperId && (\n279\t                  <>\n280\t                    <button\n281\t                      onClick={handleEnterImportMode}\n282\t                      className=\"flex items-center gap-1.5 px-3 py-1 text-xs rounded transition-colors\"\n283\t                      style={{ color: 'var(--text-secondary)', backgroundColor: 'var(--bg-elevated)' }}\n284\t                      onMouseEnter={e => { (e.currentTarget as HTMLElement).style.backgroundColor = 'var(--bg-surface)'; (e.currentTarget as HTMLElement).style.color = 'var(--success)' }}\n285\t                      onMouseLeave={e => { (e.currentTarget as HTMLElement).style.backgroundColor = 'var(--bg-elevated)'; (e.currentTarget as HTMLElement).style.color = 'var(--text-secondary)' }}\n286\t                    >\n287\t                      <svg className=\"w-3 h-3\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\">\n288\t                        <path strokeLinecap=\"round\" strokeLinejoin=\"round\" strokeWidth={2}\n289\t                          d=\"M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z\" />\n290\t                      </svg>\n291\t                      导入到工作区\n292\t                    </button>\n293\t                    <button\n294\t                      onClick={() => {\n295\t                        setSelectedIndices(new Set(relatedPapers.map((_, i) => i)))\n296\t                        setImportMode(true)\n297\t                        setShowWsSelector(true)\n298\t                        // Load workspaces if not already loaded\n299\t                        if (workspaces.length === 0) {\n300\t                          setWsLoading(true)\n301\t                          listWorkspaces().then(setWorkspaces).catch(() => setWorkspaces([])).finally(() => setWsLoading(false))\n302\t                        }\n303\t                      }}\n304\t                      className=\"flex items-center gap-1.5 px-3 py-1 text-xs rounded transition-colors\"\n305\t                      style={{ color: 'var(--text-secondary)', backgroundColor: 'var(--bg-elevated)' }}\n306\t                      onMouseEnter={e => { (e.currentTarget as HTMLElement).style.backgroundColor = 'var(--bg-surface)'; (e.currentTarget as HTMLElement).style.color = 'var(--success)' }}\n307\t                      onMouseLeave={e => { (e.currentTarget as HTMLElement).style.backgroundColor = 'var(--bg-elevated)'; (e.currentTarget as HTMLElement).style.color = 'var(--text-secondary)' }}\n308\t                    >\n309\t                      <svg className=\"w-3 h-3\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\">\n310\t                        <path strokeLinecap=\"round\" strokeLinejoin=\"round\" strokeWidth={2}\n311\t                          d=\"M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-8l-4-4m0 0L8 8m4-4v12\" />\n312\t                      </svg>\n313\t                      导入全部\n314\t                    </button>\n315\t                  </>\n316\t                )}\n317\t                {paperId && (\n318\t                  <button\n319\t                    onClick={handleRefresh}\n320\t                    disabled={isRefreshing}\n321\t                    className=\"flex items-center gap-1.5 px-3 py-1 text-xs rounded transition-colors disabled:opacity-50\"\n322\t                    style={{ color: 'var(--text-secondary)', backgroundColor: 'var(--bg-elevated)' }}\n323\t                    onMouseEnter={e => { (e.currentTarget as HTMLElement).style.backgroundColor = 'var(--bg-surface)'; (e.currentTarget as HTMLElement).style.color = 'var(--accent)' }}\n324\t                    onMouseLeave={e => { (e.currentTarget as HTMLElement).style.backgroundColor = 'var(--bg-elevated)'; (e.currentTarget as HTMLElement).style.color = 'var(--text-secondary)' }}\n325\t                  >\n326\t                    {isRefreshing ? (\n327\t                      <>\n328\t                        <div className=\"w-3 h-3 border rounded-full animate-spin\" style={{ borderColor: 'var(--text-muted)', borderTopColor: 'var(--accent)' }} role=\"status\"><span className=\"sr-only\">加载中</span></div>\n329\t                        搜索中...\n330\t                      </>\n331\t                    ) : (\n332\t                      <>\n333\t                        <svg className=\"w-3 h-3\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\">\n334\t                          <path strokeLinecap=\"round\" strokeLinejoin=\"round\" strokeWidth={2} d=\"M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15\" />\n335\t                        </svg>\n336\t                        刷新\n337\t                      </>\n338\t                    )}\n339\t                  </button>\n340\t                )}\n341\t              </>\n342\t            )}\n343\t          </div>\n344\t        </div>\n345\t\n346\t        {relatedPapers.length > 0 ? (\n347\t          <div className=\"space-y-3\">\n348\t            {relatedPapers.map((paper, idx) => (\n349\t              <div\n350\t                key={idx}\n351\t                className=\"rounded-lg p-3 border transition-colors\"\n352\t                style={importMode && selectedIndices.has(idx) ? { backgroundColor: 'var(--accent-subtle)', borderColor: 'var(--accent)' } : { backgroundColor: 'var(--bg-elevated)', borderColor: 'var(--border-light)' }}\n353\t              >\n354\t                <div className=\"flex items-start gap-2.5\">\n355\t                  {/* Checkbox (import mode only) */}\n356\t                  {importMode && !isImporting && !importResults && (\n357\t                    <button\n358\t                      onClick={() => toggleSelect(idx)}\n359\t                      className=\"flex-shrink-0 mt-0.5 w-4 h-4 rounded border transition-colors flex items-center justify-center\"\n360\t                      style={selectedIndices.has(idx) ? { backgroundColor: 'var(--accent)', borderColor: 'var(--accent)' } : { borderColor: 'var(--text-muted)' }}\n361\t                    >\n362\t                      {selectedIndices.has(idx) && (\n363\t                        <svg className=\"w-3 h-3 text-white\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\">\n364\t                          <path strokeLinecap=\"round\" strokeLinejoin=\"round\" strokeWidth={3} d=\"M5 13l4 4L19 7\" />\n365\t                        </svg>\n366\t                      )}\n367\t                    </button>\n368\t                  )}\n369\t                  <div className=\"flex-1 min-w-0\">\n370\t                    <p className=\"text-sm font-medium mb-1\" style={{ color: 'var(--text-primary)' }}>\n371\t                      {paper.url && paper.url.match(/^https?:\\/\\//) ? (\n372\t                        <a href={paper.url} target=\"_blank\" rel=\"noopener noreferrer\"\n373\t                           className=\"hover:text-blue-400 transition-colors\">\n374\t                          {paper.title}\n375\t                        </a>\n376\t                      ) : paper.title}\n377\t                    </p>\n378\t                    {paper.authors && (\n379\t                      <p className=\"text-xs mb-1\" style={{ color: 'var(--text-secondary)' }}>{paper.authors}</p>\n380\t                    )}\n381\t                    <div className=\"flex flex-wrap items-center gap-2 mb-1.5\">\n382\t                      {paper.venue && (\n383\t                        <span className=\"text-xs px-1.5 py-0.5 rounded\" style={{ backgroundColor: 'var(--bg-elevated)', color: 'var(--text-secondary)' }}>\n384\t                          {paper.venue}\n385\t                        </span>\n386\t                      )}\n387\t                      {paper.year > 0 && (\n388\t                        <span className=\"text-xs\" style={{ color: 'var(--text-muted)' }}>{paper.year}</span>\n389\t                      )}\n390\t                      {paper.citation_count > 0 && (\n391\t                        <span className=\"text-xs text-yellow-500/80\">\n392\t                          {paper.citation_count} citations\n393\t                        </span>\n394\t                      )}\n395\t                      {paper.doi && (\n396\t                        <a href={`https://doi.org/${paper.doi}`} target=\"_blank\" rel=\"noopener noreferrer\"\n397\t                           className=\"text-xs text-blue-400/70 hover:text-blue-400 transition-colors\">\n398\t                          DOI: {paper.doi}\n399\t                        </a>\n400\t                      )}\n401\t                      {/* Import result badge */}\n402\t                      {importResults && importResults[idx] && (\n403\t                        <span className={`text-xs px-1.5 py-0.5 rounded ${\n404\t                          importResults[idx].status === 'local'\n405\t                            ? 'bg-green-500/20 text-green-400'\n406\t                            : importResults[idx].status === 'downloaded'\n407\t                              ? 'bg-blue-500/20 text-blue-400'\n408\t                              : 'bg-red-500/20 text-red-400'\n409\t                        }`}>\n410\t                          {importResults[idx].message}\n411\t                        </span>\n412\t                      )}\n413\t                    </div>\n414\t                    {paper.relevance && (\n415\t                      <p className=\"text-xs italic\" style={{ color: 'var(--text-muted)' }}>{paper.relevance}</p>\n416\t                    )}\n417\t                  </div>\n418\t                </div>\n419\t              </div>\n420\t            ))}\n421\t          </div>\n422\t        ) : relatedStatus === 'loading' && !isRefreshing ? (\n423\t          <div className=\"flex items-center justify-center gap-2 py-6\">\n424\t            <div className=\"w-4 h-4 border-2 rounded-full animate-spin\" style={{ borderColor: 'var(--text-muted)', borderTopColor: 'var(--accent)' }} role=\"status\"><span className=\"sr-only\">加载中</span></div>\n425\t            <span className=\"text-sm\" style={{ color: 'var(--text-secondary)' }}>主体分析已完成，正在后台搜索相关论文...</span>\n426\t          </div>\n427\t        ) : relatedStatus === 'failed' && !isRefreshing ? (\n428\t          <div\n429\t            className=\"text-center py-6 rounded-lg border\"\n430\t            style={{ borderColor: 'var(--border)', backgroundColor: 'var(--bg-surface)' }}\n431\t          >\n432\t            <p className=\"text-sm mb-1\" style={{ color: 'var(--error)' }}>相关论文搜索超时或失败</p>\n433\t            <p className=\"text-xs mb-3\" style={{ color: 'var(--text-muted)' }}>不影响其他分析结果，可手动重试</p>\n434\t            {paperId && (\n435\t              <button\n436\t                onClick={handleRefresh}\n437\t                disabled={isRefreshing}\n438\t                className=\"text-xs text-blue-400 hover:text-blue-300 transition-colors disabled:opacity-50\"\n439\t              >\n440\t                {isRefreshing ? '搜索中...' : '重新搜索'}\n441\t              </button>\n442\t            )}\n443\t          </div>\n444\t        ) : (\n445\t          <div className=\"text-center py-6\">\n446\t            <p className=\"text-sm mb-2\" style={{ color: 'var(--text-muted)' }}>暂无相关论文推荐</p>\n447\t            {paperId && (\n448\t              <button\n449\t                onClick={handleRefresh}\n450\t                disabled={isRefreshing}\n451\t                className=\"text-xs text-blue-400 hover:text-blue-300 transition-colors disabled:opacity-50\"\n452\t              >\n453\t                {isRefreshing ? '搜索中...' : '通过 Semantic Scholar 搜索'}\n454\t              </button>\n455\t            )}\n456\t          </div>\n457\t        )}\n458\t\n459\t        {/* Import progress */}\n460\t        {isImporting && importProgress && (\n461\t          <div className=\"mt-3 p-3 rounded-lg border\" style={{ backgroundColor: 'var(--bg-elevated)', borderColor: 'var(--border-light)' }}>\n462\t            <div className=\"flex items-center gap-2 mb-2\">\n463\t              <div className=\"w-4 h-4 border-2 rounded-full animate-spin\" style={{ borderColor: 'var(--text-muted)', borderTopColor: 'var(--accent)' }} role=\"status\"><span className=\"sr-only\">加载中</span></div>\n464\t              <span className=\"text-sm\" style={{ color: 'var(--text-secondary)' }}>\n465\t                正在导入... {importProgress.done}/{importProgress.total}\n466\t              </span>\n467\t            </div>\n468\t            <div className=\"w-full rounded-full h-1.5\" style={{ backgroundColor: 'var(--bg-surface)' }}>\n469\t              <div\n470\t                className=\"bg-blue-500 h-1.5 rounded-full transition-all duration-500\"\n471\t                style={{ width: `${(importProgress.done / importProgress.total) * 100}%` }}\n472\t              />\n473\t            </div>\n474\t            <p className=\"text-xs mt-1.5\" style={{ color: 'var(--text-muted)' }}>\n475\t              正在通过 Semantic Scholar 查找 PDF 并下载，请耐心等待...\n476\t            </p>\n477\t          </div>\n478\t        )}\n479\t\n480\t        {/* Import results summary */}\n481\t        {importResults && !isImporting && (\n482\t          <div className=\"mt-3 p-3 rounded-lg border\" style={{ backgroundColor: 'var(--bg-elevated)', borderColor: 'var(--border-light)' }}>\n483\t            <div className=\"flex items-center justify-between mb-2\">\n484\t              <span className=\"text-sm font-medium\" style={{ color: 'var(--text-primary)' }}>导入完成</span>\n485\t              <button\n486\t                onClick={handleExitImportMode}\n487\t                className=\"text-xs transition-colors\" style={{ color: 'var(--text-secondary)' }} onMouseEnter={e => { (e.currentTarget as HTMLElement).style.color = 'var(--text-primary)' }} onMouseLeave={e => { (e.currentTarget as HTMLElement).style.color = 'var(--text-secondary)' }}\n488\t              >\n489\t                关闭\n490\t              </button>\n491\t            </div>\n492\t            <div className=\"flex gap-3 text-xs\">\n493\t              <span className=\"text-green-400\">\n494\t                本地导入: {importResults.filter(r => r.status === 'local').length}\n495\t              </span>\n496\t              <span className=\"text-blue-400\">\n497\t                新下载: {importResults.filter(r => r.status === 'downloaded').length}\n498\t              </span>\n499\t              <span className=\"text-red-400\">\n500\t                失败: {importResults.filter(r => r.status === 'failed').length}\n501\t              </span>\n502\t            </div>\n503\t          </div>\n504\t        )}\n505\t      </section>\n506\t\n507\t      {/* Limitations */}\n508\t      {result.limitations && (\n509\t        <section>\n510\t          <h2 className=\"text-lg font-semibold mb-2\" style={{ color: 'var(--text-primary)' }}>局限性</h2>\n511\t          <p className=\"text-sm leading-relaxed\" style={{ color: 'var(--text-secondary)' }}>{result.limitations}</p>\n512\t        </section>\n513\t      )}\n514\t\n515\t      {/* Workspace selector modal */}\n516\t      {showWsSelector && (\n517\t        <div\n518\t          className=\"fixed inset-0 z-[200] flex items-center justify-center\"\n519\t          style={{ backgroundColor: 'rgba(0,0,0,0.5)' }}\n520\t          onClick={() => !isImporting && setShowWsSelector(false)}\n521\t        >\n522\t          <div\n523\t            ref={wsModalRef}\n524\t            role=\"dialog\"\n525\t            aria-modal=\"true\"\n526\t            className=\"w-96 max-h-[70vh] rounded-xl border p-5 shadow-2xl flex flex-col\"\n527\t            style={{ backgroundColor: 'var(--bg-elevated, #1a1a2e)', borderColor: 'var(--border, #333)' }}\n528\t            onClick={e => e.stopPropagation()}\n529\t          >\n530\t            <h3 className=\"text-base font-semibold mb-1\" style={{ color: 'var(--text-primary)' }}>选择工作区</h3>\n531\t            <p className=\"text-xs mb-4\" style={{ color: 'var(--text-secondary)' }}>\n532\t              将 {selectedIndices.size} 篇论文导入到以下工作区：\n533\t            </p>\n534\t\n535\t            {wsLoading ? (\n536\t              <div className=\"flex items-center justify-center py-8 gap-2\">\n537\t                <div className=\"w-4 h-4 border-2 rounded-full animate-spin\" style={{ borderColor: 'var(--text-muted)', borderTopColor: 'var(--accent)' }} role=\"status\"><span className=\"sr-only\">加载中</span></div>\n538\t                <span className=\"text-sm\" style={{ color: 'var(--text-secondary)' }}>加载工作区...</span>\n539\t              </div>\n540\t            ) : workspaces.length === 0 ? (\n541\t              <div className=\"text-center py-8\">\n542\t                <p className=\"text-sm mb-2\" style={{ color: 'var(--text-muted)' }}>暂无工作区</p>\n543\t                <p className=\"text-xs\" style={{ color: 'var(--text-muted)' }}>请先在「工作区」页面创建工作区</p>\n544\t              </div>\n545\t            ) : (\n546\t              <div className=\"flex-1 overflow-auto space-y-2 max-h-60\">\n547\t                {workspaces.map(ws => (\n548\t                  <button\n549\t                    key={ws.id}\n550\t                    onClick={() => handleImportToWorkspace(ws.id)}\n551\t                    disabled={isImporting}\n552\t                    className=\"w-full text-left px-3 py-2.5 rounded-lg border transition-colors hover:border-blue-500/50 hover:bg-blue-500/5 disabled:opacity-50\"\n553\t                    style={{ borderColor: 'var(--border, #333)' }}\n554\t                  >\n555\t                    <div className=\"flex items-center justify-between\">\n556\t                      <span className=\"text-sm font-medium\" style={{ color: 'var(--text-primary)' }}>{ws.name}</span>\n557\t                      <span className=\"text-xs\" style={{ color: 'var(--text-muted)' }}>{ws.paper_count} 篇论文</span>\n558\t                    </div>\n559\t                  </button>\n560\t                ))}\n561\t              </div>\n562\t            )}\n563\t\n564\t            <div className=\"flex justify-end mt-4\">\n565\t              <button\n566\t                onClick={() => setShowWsSelector(false)}\n567\t                disabled={isImporting}\n568\t                className=\"px-4 py-1.5 text-xs rounded-md border transition-colors hover:opacity-80 disabled:opacity-50\"\n569\t                style={{ borderColor: 'var(--border, #333)', color: 'var(--text-secondary, #aaa)' }}\n570\t              >\n571\t                取消\n572\t              </button>\n573\t            </div>\n574\t          </div>\n575\t        </div>\n576\t      )}\n577\t    </div>\n578\t  )\n579\t}\n580\t"}]},"parent_tool_use_id":"call_bddd82a75f2e46b98e4517cc","session_id":"29257b8f-ede7-46a4-8e0f-a743591d296a","uuid":"cee8decd-b524-45ba-83f6-5b6404942322","timestamp":"2026-06-09T05:10:37.439Z","subagent_type":"Explore","task_description":"Explore frontend performance"}
