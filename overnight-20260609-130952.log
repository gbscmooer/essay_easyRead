{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call_bd56ffb8c70b40bc8edbb76d","type":"tool_result","content":"1\timport logging\n2\tfrom fastapi import APIRouter, HTTPException\n3\tfrom pydantic import BaseModel, Field\n4\tfrom sqlmodel import Session, create_engine, select\n5\tfrom datetime import datetime, timezone\n6\t\n7\tfrom ..models.tag import Tag, PaperTag\n8\tfrom ..models.paper import Paper\n9\tfrom ..config import settings\n10\t\n11\tlogger = logging.getLogger(__name__)\n12\t\n13\trouter = APIRouter(prefix=\"/api/tags\", tags=[\"tags\"])\n14\t\n15\t_engine = None\n16\t\n17\t\n18\tdef _get_engine():\n19\t    global _engine\n20\t    if _engine is None:\n21\t        _engine = create_engine(settings.resolved_database_url, connect_args={\"check_same_thread\": False})\n22\t    return _engine\n23\t\n24\t\n25\tclass TagCreate(BaseModel):\n26\t    name: str = Field(..., min_length=1, max_length=50)\n27\t    color: str = Field(\"#3b82f6\", pattern=r\"^#[0-9a-fA-F]{6}$\")\n28\t\n29\t\n30\tclass TagResponse(BaseModel):\n31\t    id: int\n32\t    name: str\n33\t    color: str\n34\t    paper_count: int = 0\n35\t\n36\t\n37\tclass PaperTagRequest(BaseModel):\n38\t    tag_id: int\n39\t\n40\t\n41\t@router.get(\"\", response_model=list[TagResponse])\n42\tasync def list_tags():\n43\t    engine = _get_engine()\n44\t    with Session(engine) as session:\n45\t        tags = session.exec(select(Tag).order_by(Tag.name)).all()\n46\t        result = []\n47\t        for tag in tags:\n48\t            count = len(session.exec(\n49\t                select(PaperTag).where(PaperTag.tag_id == tag.id)\n50\t            ).all())\n51\t            result.append(TagResponse(\n52\t                id=tag.id, name=tag.name, color=tag.color, paper_count=count,\n53\t            ))\n54\t        return result\n55\t\n56\t\n57\t@router.post(\"\", response_model=TagResponse)\n58\tasync def create_tag(req: TagCreate):\n59\t    engine = _get_engine()\n60\t    with Session(engine) as session:\n61\t        existing = session.exec(select(Tag).where(Tag.name == req.name)).first()\n62\t        if existing:\n63\t            raise HTTPException(status_code=400, detail={\"detail\": \"标签已存在\", \"code\": \"DUPLICATE\"})\n64\t        tag = Tag(name=req.name, color=req.color)\n65\t        session.add(tag)\n66\t        session.commit()\n67\t        session.refresh(tag)\n68\t        return TagResponse(id=tag.id, name=tag.name, color=tag.color, paper_count=0)\n69\t\n70\t\n71\t@router.delete(\"/{tag_id}\")\n72\tasync def delete_tag(tag_id: int):\n73\t    engine = _get_engine()\n74\t    with Session(engine) as session:\n75\t        tag = session.get(Tag, tag_id)\n76\t        if not tag:\n77\t            raise HTTPException(status_code=404, detail={\"detail\": \"标签不存在\", \"code\": \"NOT_FOUND\"})\n78\t        pts = session.exec(select(PaperTag).where(PaperTag.tag_id == tag_id)).all()\n79\t        for pt in pts:\n80\t            session.delete(pt)\n81\t        session.delete(tag)\n82\t        session.commit()\n83\t    return {\"message\": \"标签已删除\"}\n84\t\n85\t\n86\t@router.put(\"/{tag_id}\", response_model=TagResponse)\n87\tasync def update_tag(tag_id: int, req: TagCreate):\n88\t    engine = _get_engine()\n89\t    with Session(engine) as session:\n90\t        tag = session.get(Tag, tag_id)\n91\t        if not tag:\n92\t            raise HTTPException(status_code=404, detail={\"detail\": \"标签不存在\", \"code\": \"NOT_FOUND\"})\n93\t        dup = session.exec(select(Tag).where(Tag.name == req.name, Tag.id != tag_id)).first()\n94\t        if dup:\n95\t            raise HTTPException(status_code=400, detail={\"detail\": \"标签名已存在\", \"code\": \"DUPLICATE\"})\n96\t        tag.name = req.name\n97\t        tag.color = req.color\n98\t        session.add(tag)\n99\t        session.commit()\n100\t        session.refresh(tag)\n101\t        count = len(session.exec(select(PaperTag).where(PaperTag.tag_id == tag_id)).all())\n102\t        return TagResponse(id=tag.id, name=tag.name, color=tag.color, paper_count=count)\n103\t\n104\t\n105\t@router.get(\"/paper/{paper_id}\", response_model=list[TagResponse])\n106\tasync def get_paper_tags(paper_id: int):\n107\t    engine = _get_engine()\n108\t    with Session(engine) as session:\n109\t        pts = session.exec(select(PaperTag).where(PaperTag.paper_id == paper_id)).all()\n110\t        result = []\n111\t        for pt in pts:\n112\t            tag = session.get(Tag, pt.tag_id)\n113\t            if tag:\n114\t                result.append(TagResponse(id=tag.id, name=tag.name, color=tag.color))\n115\t        return result\n116\t\n117\t\n118\t@router.post(\"/paper/{paper_id}\")\n119\tasync def add_paper_tag(paper_id: int, req: PaperTagRequest):\n120\t    engine = _get_engine()\n121\t    with Session(engine) as session:\n122\t        paper = session.get(Paper, paper_id)\n123\t        if not paper:\n124\t            raise HTTPException(status_code=404, detail={\"detail\": \"论文不存在\", \"code\": \"NOT_FOUND\"})\n125\t        tag = session.get(Tag, req.tag_id)\n126\t        if not tag:\n127\t            raise HTTPException(status_code=404, detail={\"detail\": \"标签不存在\", \"code\": \"NOT_FOUND\"})\n128\t        existing = session.exec(\n129\t            select(PaperTag).where(PaperTag.paper_id == paper_id, PaperTag.tag_id == req.tag_id)\n130\t        ).first()\n131\t        if existing:\n132\t            return {\"message\": \"标签已存在\"}\n133\t        pt = PaperTag(paper_id=paper_id, tag_id=req.tag_id)\n134\t        session.add(pt)\n135\t        session.commit()\n136\t    return {\"message\": \"标签已添加\"}\n137\t\n138\t\n139\t@router.delete(\"/paper/{paper_id}/{tag_id}\")\n140\tasync def remove_paper_tag(paper_id: int, tag_id: int):\n141\t    engine = _get_engine()\n142\t    with Session(engine) as session:\n143\t        pt = session.exec(\n144\t            select(PaperTag).where(PaperTag.paper_id == paper_id, PaperTag.tag_id == tag_id)\n145\t        ).first()\n146\t        if pt:\n147\t            session.delete(pt)\n148\t            session.commit()\n149\t    return {\"message\": \"标签已移除\"}\n150\t\n151\t\n152\t@router.get(\"/papers/{tag_id}\", response_model=list[dict])\n153\tasync def get_papers_by_tag(tag_id: int):\n154\t    engine = _get_engine()\n155\t    with Session(engine) as session:\n156\t        pts = session.exec(select(PaperTag).where(PaperTag.tag_id == tag_id)).all()\n157\t        result = []\n158\t        for pt in pts:\n159\t            paper = session.get(Paper, pt.paper_id)\n160\t            if paper:\n161\t                result.append({\n162\t                    \"id\": paper.id,\n163\t                    \"filename\": paper.filename,\n164\t                    \"title\": paper.title,\n165\t                    \"venue\": paper.venue,\n166\t                    \"year\": paper.year,\n167\t                    \"status\": paper.status,\n168\t                    \"source\": paper.source,\n169\t                    \"created_at\": paper.created_at,\n170\t                    \"updated_at\": paper.updated_at,\n171\t                })\n172\t        return result\n173\t"}]},"parent_tool_use_id":"call_14fbefec6f4c427bbf12da10","session_id":"29257b8f-ede7-46a4-8e0f-a743591d296a","uuid":"85525052-1d3a-48fd-beb2-067fd3c14bc4","timestamp":"2026-06-09T05:10:22.907Z","subagent_type":"Explore","task_description":"Explore backend performance"}
