{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call_6a1e72cad97f4ff9a2500a18","type":"tool_result","content":"1\timport { useState, useEffect, useMemo } from 'react'\n2\timport type { ResearchRunCreate, ResearchMode } from '@/types'\n3\timport { getWorkspace, type WorkspacePaper } from '@/api/workspaces'\n4\timport { get, post } from '@/api/client'\n5\timport { toast } from '@/hooks/useToast'\n6\timport { Tooltip } from '@/components/Tooltip'\n7\t\n8\tinterface ControlPanelProps {\n9\t  wsId: number\n10\t  onStart: (body: ResearchRunCreate) => void\n11\t  onClear: () => void\n12\t  disabled: boolean\n13\t  linkDistance: number\n14\t  onLinkDistanceChange: (v: number) => void\n15\t}\n16\t\n17\tconst STATUS_LABEL: Record<string, string> = {\n18\t  done:       '已解析',\n19\t  indexed:    '已索引',\n20\t  pending:    '待解析',\n21\t  failed:     '解析失败',\n22\t  extracting: '提取中',\n23\t  analyzing:  '分析中',\n24\t}\n25\t\n26\texport function ControlPanel({ wsId, onStart, onClear, disabled, linkDistance, onLinkDistanceChange }: ControlPanelProps) {\n27\t  const [mode, setMode] = useState<ResearchMode>('local')\n28\t  const [topK, setTopK] = useState(5)\n29\t  const [deep, setDeep] = useState(1)\n30\t  const [rebuild, setRebuild] = useState(false)\n31\t  const [showAdvanced, setShowAdvanced] = useState(false)\n32\t  const [knnK, setKnnK] = useState(8)\n33\t  const [includeExpanded, setIncludeExpanded] = useState(true)\n34\t  const [papers, setPapers] = useState<WorkspacePaper[]>([])\n35\t  const [expandedCount, setExpandedCount] = useState(0)\n36\t  const [selectedIds, setSelectedIds] = useState<Set<number>>(new Set())\n37\t  const [showPicker, setShowPicker] = useState(false)\n38\t  const [saveState, setSaveState] = useState<'idle' | 'saving' | 'saved'>('idle')\n39\t\n40\t  useEffect(() => {\n41\t    getWorkspace(wsId)\n42\t      .then(ws => {\n43\t        const l1 = ws.papers.filter(p => (p.level ?? 1) === 1)\n44\t        const l2plus = ws.papers.filter(p => (p.level ?? 1) >= 2)\n45\t        setPapers(l1)\n46\t        setExpandedCount(l2plus.length)\n47\t        const usable = new Set(\n48\t          l1.filter(p => p.status === 'done' || p.status === 'indexed' || p.status === 'pending').map(p => p.id)\n49\t        )\n50\t        setSelectedIds(usable)\n51\t      })\n52\t      .catch(() => { toast({ type: 'error', message: '加载工作区论文失败' }) })\n53\t  }, [wsId])\n54\t\n55\t  useEffect(() => {\n56\t    get<{ research?: { knn_k?: number; link_distance?: number } }>('/analysis/config')\n57\t      .then(cfg => {\n58\t        const savedKnn = cfg.research?.knn_k\n59\t        if (typeof savedKnn === 'number') setKnnK(savedKnn)\n60\t        const savedDist = cfg.research?.link_distance\n61\t        if (typeof savedDist === 'number') onLinkDistanceChange(savedDist)\n62\t      })\n63\t      .catch(() => { toast({ type: 'warning', message: '研究配置加载失败，使用默认值' }) })\n64\t  }, [])\n65\t\n66\t  const isUsable = (status: string) =>\n67\t    status === 'done' || status === 'indexed' || status === 'pending'\n68\t\n69\t  const usableCount = useMemo(() =>\n70\t    papers.filter(p => isUsable(p.status)).length,\n71\t  [papers])\n72\t\n73\t  const selectedUsableCount = useMemo(() =>\n74\t    papers.filter(p => selectedIds.has(p.id) && isUsable(p.status)).length,\n75\t  [papers, selectedIds])\n76\t\n77\t  const toggleSelect = (id: number) => {\n78\t    setSelectedIds(prev => {\n79\t      const next = new Set(prev)\n80\t      if (next.has(id)) next.delete(id); else next.add(id)\n81\t      return next\n82\t    })\n83\t  }\n84\t\n85\t  const selectAll = () => {\n86\t    setSelectedIds(new Set(\n87\t      papers.filter(p => isUsable(p.status)).map(p => p.id)\n88\t    ))\n89\t  }\n90\t\n91\t  const selectNone = () => setSelectedIds(new Set())\n92\t\n93\t  const handleStart = () => {\n94\t    onStart({\n95\t      mode,\n96\t      paper_ids: Array.from(selectedIds),\n97\t      include_expanded: includeExpanded,\n98\t      expand_top_k: topK,\n99\t      deep,\n100\t      rebuild,\n101\t      knn_k: knnK,\n102\t    })\n103\t  }\n104\t\n105\t  const handleSaveAdvanced = async () => {\n106\t    setSaveState('saving')\n107\t    try {\n108\t      // Fetch current full config, patch research section, then save\n109\t      const fullCfg = await get<Record<string, any>>('/analysis/config')\n110\t      const patched = {\n111\t        ...fullCfg,\n112\t        research: {\n113\t          ...(fullCfg.research || {}),\n114\t          knn_k: knnK,\n115\t          link_distance: linkDistance,\n116\t        },\n117\t      }\n118\t      await post('/analysis/config', patched)\n119\t      setSaveState('saved')\n120\t      setTimeout(() => setSaveState('idle'), 1500)\n121\t    } catch {\n122\t      setSaveState('idle')\n123\t    }\n124\t  }\n125\t\n126\t  // 开始按钮文字：区分本地/联网，并说明论文来源\n127\t  const startLabel = (() => {\n128\t    if (disabled) return '运行中...'\n129\t    const withExpanded = includeExpanded && expandedCount > 0\n130\t    if (mode === 'local') {\n131\t      return withExpanded\n132\t        ? `开始研究（${selectedUsableCount} 篇本地 + ${expandedCount} 篇已扩展）`\n133\t        : `开始研究（${selectedUsableCount} 篇）`\n134\t    }\n135\t    const expandedPart = withExpanded\n136\t      ? `+ ${expandedCount} 篇已扩展`\n137\t      : ''\n138\t    return expandedPart\n139\t      ? `开始研究（${selectedUsableCount} 篇本地 ${expandedPart}）`\n140\t      : `开始研究（${selectedUsableCount} 篇本地）`\n141\t  })()\n142\t\n143\t  // 选择器按钮文字\n144\t  const pickerLabel = (() => {\n145\t    const base = `起始论文 ${selectedUsableCount}/${usableCount} 已选`\n146\t    if (includeExpanded && expandedCount > 0) return `${base}　· 另含 ${expandedCount} 篇扩展`\n147\t    return base\n148\t  })()\n149\t\n150\t  return (\n151\t    <div className=\"px-6 py-4 border-b\" style={{ borderColor: 'var(--border)', backgroundColor: 'var(--bg-surface)' }}>\n152\t      <div className=\"flex items-center gap-4 flex-wrap\">\n153\t\n154\t        {/* 构建范围 */}\n155\t        <div className=\"flex items-center gap-2\">\n156\t          <span className=\"text-xs\" style={{ color: 'var(--text-muted)' }}>构建范围</span>\n157\t          <div className=\"flex rounded-lg overflow-hidden border\" style={{ borderColor: 'var(--border)' }}>\n158\t            {([\n159\t              {\n160\t                key: 'local' as ResearchMode,\n161\t                label: '仅本地',\n162\t                tip: '只用工作区已选论文构建知识图谱，不联网。速度快，不消耗下载配额。',\n163\t              },\n164\t              {\n165\t                key: 'online' as ResearchMode,\n166\t                label: '联网扩展',\n167\t                tip: '在本地论文基础上，通过 OpenAlex / Semantic Scholar 以及 arXiv 引用列表，下载被引用的外部论文，一起纳入图谱与检索。',\n168\t              },\n169\t            ]).map(({ key, label, tip }) => (\n170\t              <Tooltip key={key} content={tip}>\n171\t                <button\n172\t                  onClick={() => setMode(key)}\n173\t                  disabled={disabled}\n174\t                  className={`px-3 py-1 text-xs transition-colors ${mode === key ? 'font-medium' : ''}`}\n175\t                  style={\n176\t                    mode === key\n177\t                      ? { backgroundColor: 'var(--accent-subtle)', color: 'var(--accent)' }\n178\t                      : { color: 'var(--text-muted)' }\n179\t                  }\n180\t                >\n181\t                  {label}\n182\t                </button>\n183\t              </Tooltip>\n184\t            ))}\n185\t          </div>\n186\t        </div>\n187\t\n188\t        {/* 联网扩展参数 */}\n189\t        {mode === 'online' && (\n190\t          <>\n191\t            <Tooltip content=\"联网扩展时，每篇起始论文最多从引用列表中下载多少篇引用数最高的外部论文。数字越大下载越多、耗时越长。\">\n192\t              <div className=\"flex items-center gap-1.5\">\n193\t                <span className=\"text-xs\" style={{ color: 'var(--text-muted)' }}>每篇最多下载</span>\n194\t                <input\n195\t                  type=\"number\"\n196\t                  min={1}\n197\t                  max={20}\n198\t                  value={topK}\n199\t                  onChange={e => setTopK(Number(e.target.value))}\n200\t                  disabled={disabled}\n201\t                  className=\"w-14 px-2 py-1 text-xs rounded border text-center\"\n202\t                  style={{\n203\t                    backgroundColor: 'var(--bg-base)',\n204\t                    borderColor: 'var(--border)',\n205\t                    color: 'var(--text-primary)',\n206\t                  }}\n207\t                />\n208\t                <span className=\"text-xs\" style={{ color: 'var(--text-muted)' }}>篇</span>\n209\t              </div>\n210\t            </Tooltip>\n211\t\n212\t            <Tooltip content=\"扩展层数：1 = 只扩展起始论文的引用（一跳）；2 = 继续扩展第一跳结果的引用（两跳）；以此类推。层数越多论文数量指数增长，谨慎调高。\">\n213\t              <div className=\"flex items-center gap-1.5\">\n214\t                <span className=\"text-xs\" style={{ color: 'var(--text-muted)' }}>扩展层数</span>\n215\t                <input\n216\t                  type=\"number\"\n217\t                  min={1}\n218\t                  max={3}\n219\t                  value={deep}\n220\t                  onChange={e => setDeep(Math.max(1, Math.min(3, Number(e.target.value) || 1)))}\n221\t                  disabled={disabled}\n222\t                  className=\"w-14 px-2 py-1 text-xs rounded border text-center\"\n223\t                  style={{\n224\t                    backgroundColor: 'var(--bg-base)',\n225\t                    borderColor: 'var(--border)',\n226\t                    color: 'var(--text-primary)',\n227\t                  }}\n228\t                />\n229\t              </div>\n230\t            </Tooltip>\n231\t          </>\n232\t        )}\n233\t\n234\t        {/* 起始论文选择器 */}\n235\t        <Tooltip\n236\t          content={\n237\t            <>\n238\t              展开/折叠起始论文列表。\n239\t              <br />起始论文：研究的出发点，图谱从这些论文的引用关系展开。\n240\t              {expandedCount > 0 && (\n241\t                <>\n242\t                  <br />另有 {expandedCount} 篇上次联网扩展到的论文，是否纳入由「含已扩展论文」开关控制。\n243\t                </>\n244\t              )}\n245\t            </>\n246\t          }\n247\t        >\n248\t          <button\n249\t            onClick={() => setShowPicker(v => !v)}\n250\t            disabled={disabled}\n251\t            className=\"px-3 py-1 text-xs rounded-md border transition-colors\"\n252\t            style={{\n253\t              borderColor: 'var(--border)',\n254\t              color: 'var(--text-secondary)',\n255\t              backgroundColor: showPicker ? 'var(--accent-subtle)' : 'transparent',\n256\t            }}\n257\t          >\n258\t            {pickerLabel}\n259\t          </button>\n260\t        </Tooltip>\n261\t\n262\t        {/* 是否纳入已下载的联网扩展论文 */}\n263\t        {expandedCount > 0 && (\n264\t          <Tooltip content={`工作区里有 ${expandedCount} 篇之前联网扩展下载到本地的论文。勾选则一并纳入本次图谱与检索；取消勾选则只用工作区内部添加的论文，扩展论文不参与。`}>\n265\t            <label className=\"flex items-center gap-1.5 text-xs cursor-pointer\" style={{ color: 'var(--text-muted)' }}>\n266\t              <input\n267\t                type=\"checkbox\"\n268\t                checked={includeExpanded}\n269\t                onChange={e => setIncludeExpanded(e.target.checked)}\n270\t                disabled={disabled}\n271\t                className=\"rounded accent-blue-500\"\n272\t              />\n273\t              含已扩展论文（{expandedCount}）\n274\t            </label>\n275\t          </Tooltip>\n276\t        )}\n277\t\n278\t        {/* 重建索引 */}\n279\t        <Tooltip content=\"强制清空并重建该工作区的向量索引和图谱。仅在切换了向量模型（维度变化）或图谱出现异常数据时才需要。日常使用保持关闭即可（默认为增量更新）。\">\n280\t          <label className=\"flex items-center gap-1.5 text-xs cursor-pointer\" style={{ color: 'var(--text-muted)' }}>\n281\t            <input\n282\t              type=\"checkbox\"\n283\t              checked={rebuild}\n284\t              onChange={e => setRebuild(e.target.checked)}\n285\t              disabled={disabled}\n286\t              className=\"rounded accent-blue-500\"\n287\t            />\n288\t            重建索引\n289\t          </label>\n290\t        </Tooltip>\n291\t\n292\t        <Tooltip content=\"调整图谱相似度阈值（控制相似边稀密程度）等高级参数。\">\n293\t          <button\n294\t            onClick={() => setShowAdvanced(v => !v)}\n295\t            className=\"text-xs transition-colors\"\n296\t            style={{ color: 'var(--text-muted)' }}\n297\t          >\n298\t            {showAdvanced ? '收起高级设置' : '高级设置'}\n299\t          </button>\n300\t        </Tooltip>\n301\t\n302\t        <div className=\"flex-1\" />\n303\t\n304\t        <Tooltip content={'清空该工作区的向量索引和图谱缓存（已上传的 PDF 文件不会删除）。下次点「开始研究」会从零重建。'}>\n305\t          <button\n306\t            onClick={onClear}\n307\t            disabled={disabled}\n308\t            className=\"px-3 py-1.5 text-xs rounded-lg border transition-colors disabled:opacity-50\"\n309\t            style={{ borderColor: 'var(--border)', color: 'var(--text-muted)' }}\n310\t          >\n311\t            清空图谱\n312\t          </button>\n313\t        </Tooltip>\n314\t\n315\t        <Tooltip content={\n316\t          mode === 'local'\n317\t            ? '对已选论文执行：文本切片 → 向量嵌入 → 构建知识图谱。仅使用向量模型，不调用 LLM，不消耗 Token。'\n318\t            : '在本地论文基础上联网下载被引用的论文，再执行：文本切片 → 向量嵌入 → 构建知识图谱。联网部分不消耗 LLM Token，但会调用 arXiv / Semantic Scholar / OpenAlex 接口。'\n319\t        }>\n320\t          <button\n321\t            onClick={handleStart}\n322\t            disabled={disabled || selectedUsableCount === 0}\n323\t            className=\"px-4 py-1.5 text-xs font-medium rounded-lg transition-colors disabled:opacity-50\"\n324\t            style={{\n325\t              backgroundColor: disabled ? 'var(--border)' : 'var(--accent)',\n326\t              color: 'var(--bg-base)',\n327\t            }}\n328\t          >\n329\t            {startLabel}\n330\t          </button>\n331\t        </Tooltip>\n332\t      </div>\n333\t\n334\t      {/* 起始论文选择面板 */}\n335\t      {showPicker && (\n336\t        <div className=\"mt-3 pt-3 border-t\" style={{ borderColor: 'var(--border)' }}>\n337\t          <div className=\"flex items-center justify-between mb-2\">\n338\t            <div>\n339\t              <span className=\"text-xs font-medium\" style={{ color: 'var(--text-secondary)' }}>\n340\t                起始论文（共 {papers.length} 篇 · 可用 {usableCount} 篇）\n341\t              </span>\n342\t              {expandedCount > 0 && (\n343\t                <span className=\"ml-2 text-xs\" style={{ color: 'var(--text-muted)' }}>\n344\t                  · 另有 {expandedCount} 篇联网扩展论文{includeExpanded ? '将一并纳入' : '已排除（仅用工作区内部论文）'}\n345\t                </span>\n346\t              )}\n347\t            </div>\n348\t            <div className=\"flex gap-3\">\n349\t              <button onClick={selectAll} className=\"text-xs underline\" style={{ color: 'var(--text-secondary)' }}>全选可用</button>\n350\t              <button onClick={selectNone} className=\"text-xs underline\" style={{ color: 'var(--text-muted)' }}>清空勾选</button>\n351\t            </div>\n352\t          </div>\n353\t          <div className=\"max-h-48 overflow-auto rounded border\" style={{ borderColor: 'var(--border)' }}>\n354\t            {papers.length === 0 ? (\n355\t              <p className=\"text-xs px-3 py-4 text-center\" style={{ color: 'var(--text-muted)' }}>工作区暂无论文</p>\n356\t            ) : (\n357\t              papers.map(p => {\n358\t                const usable = isUsable(p.status)\n359\t                const checked = selectedIds.has(p.id)\n360\t                return (\n361\t                  <label\n362\t                    key={p.id}\n363\t                    className={`flex items-center gap-2 px-3 py-1.5 text-xs cursor-pointer transition-colors ${\n364\t                      usable ? '' : 'opacity-40 cursor-not-allowed'\n365\t                    }`}\n366\t                    style={{ color: 'var(--text-secondary)' }}\n367\t                  >\n368\t                    <input\n369\t                      type=\"checkbox\"\n370\t                      checked={checked}\n371\t                      disabled={!usable || disabled}\n372\t                      onChange={() => toggleSelect(p.id)}\n373\t                      className=\"accent-blue-500 shrink-0\"\n374\t                    />\n375\t                    <span className=\"truncate flex-1\">{p.title || p.filename}</span>\n376\t                    <span\n377\t                      className=\"shrink-0 text-[10px] px-1.5 py-0.5 rounded-full\"\n378\t                      style={{\n379\t                        backgroundColor: p.status === 'failed' ? 'var(--error-subtle)' : 'var(--bg-base)',\n380\t                        color: p.status === 'failed' ? 'var(--error)' : 'var(--text-muted)',\n381\t                      }}\n382\t                    >\n383\t                      {STATUS_LABEL[p.status] ?? p.status}\n384\t                    </span>\n385\t                  </label>\n386\t                )\n387\t              })\n388\t            )}\n389\t          </div>\n390\t        </div>\n391\t      )}\n392\t\n393\t      {/* 高级设置面板 */}\n394\t      {showAdvanced && (\n395\t        <div className=\"mt-3 pt-3 border-t flex items-center gap-4 flex-wrap\" style={{ borderColor: 'var(--border)' }}>\n396\t          <Tooltip content={'相似边稀疏化：每篇论文只与最相似的 K 篇连「相似」边（kNN）。值越小图谱越稀疏精炼，越大越密。替代了旧的绝对阈值——因为 BGE 余弦整体偏高，绝对阈值几乎失效。默认 8。'}>\n397\t            <div className=\"flex items-center gap-2\">\n398\t              <span className=\"text-xs\" style={{ color: 'var(--text-muted)' }}>相似边密度 K</span>\n399\t              <input\n400\t                type=\"range\"\n401\t                min={2}\n402\t                max={20}\n403\t                step={1}\n404\t                value={knnK}\n405\t                onChange={e => setKnnK(Number(e.target.value))}\n406\t                className=\"w-24 h-1 accent-blue-500\"\n407\t              />\n408\t              <span className=\"text-xs font-mono\" style={{ color: 'var(--text-secondary)' }}>{knnK}</span>\n409\t            </div>\n410\t          </Tooltip>\n411\t\n412\t          <Tooltip content={'知识图谱中节点之间连线的基准长度。值越大节点间距越远、图谱越松散；值越小节点越紧凑。默认 50。'}>\n413\t            <div className=\"flex items-center gap-2\">\n414\t              <span className=\"text-xs\" style={{ color: 'var(--text-muted)' }}>节点边长</span>\n415\t              <input\n416\t                type=\"range\"\n417\t                min={20}\n418\t                max={150}\n419\t                step={5}\n420\t                value={linkDistance}\n421\t                onChange={e => onLinkDistanceChange(Number(e.target.value))}\n422\t                className=\"w-24 h-1 accent-blue-500\"\n423\t              />\n424\t              <span className=\"text-xs font-mono\" style={{ color: 'var(--text-secondary)' }}>{linkDistance}</span>\n425\t            </div>\n426\t          </Tooltip>\n427\t\n428\t          <button\n429\t            onClick={handleSaveAdvanced}\n430\t            disabled={saveState === 'saving'}\n431\t            className=\"px-3 py-1 text-xs rounded-md border transition-colors disabled:opacity-50\"\n432\t            style={{\n433\t              borderColor: 'var(--border)',\n434\t              backgroundColor: saveState === 'saved' ? 'var(--success-subtle)' : 'transparent',\n435\t              color: saveState === 'saved' ? 'var(--success)' : 'var(--text-secondary)',\n436\t            }}\n437\t          >\n438\t            {saveState === 'saving' ? '保存中…' : saveState === 'saved' ? '已保存' : '保存'}\n439\t          </button>\n440\t        </div>\n441\t      )}\n442\t    </div>\n443\t  )\n444\t}\n445\t"}]},"parent_tool_use_id":"call_bddd82a75f2e46b98e4517cc","session_id":"29257b8f-ede7-46a4-8e0f-a743591d296a","uuid":"5507b2a3-6163-4edd-95a6-15d152e160d4","timestamp":"2026-06-09T05:10:53.488Z","subagent_type":"Explore","task_description":"Explore frontend performance"}
