{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call_b8aab5e818884aa881dd926b","type":"tool_result","content":"1\timport { useState, useEffect, useCallback } from 'react'\n2\timport { Link } from 'react-router-dom'\n3\timport type { Paper } from '@/types'\n4\timport { getPaper } from '@/api/papers'\n5\timport { extractCodeUrl } from '@/api/code'\n6\timport { toast } from '@/hooks/useToast'\n7\t\n8\t\n9\tinterface CodeTabProps {\n10\t  paperId?: number\n11\t}\n12\t\n13\texport function CodeTab({ paperId }: CodeTabProps) {\n14\t  const [paper, setPaper] = useState<Paper | null>(null)\n15\t  const [searching, setSearching] = useState(false)\n16\t\n17\t  useEffect(() => {\n18\t    if (paperId) {\n19\t      getPaper(paperId).then(setPaper).catch((e: any) => { toast({ type: 'error', message: e?.message || '加载论文信息失败' }) })\n20\t    }\n21\t  }, [paperId])\n22\t\n23\t  const handleResearch = useCallback(async () => {\n24\t    if (!paperId) return\n25\t    setSearching(true)\n26\t    try {\n27\t      await extractCodeUrl(paperId)\n28\t      const updated = await getPaper(paperId)\n29\t      setPaper(updated)\n30\t    } catch (e: any) {\n31\t      toast({ type: 'error', message: e?.message || '提取代码 URL 失败' })\n32\t    } finally {\n33\t      setSearching(false)\n34\t    }\n35\t  }, [paperId])\n36\t\n37\t  const codeUrl = paper?.code_url\n38\t  const codeStatus = paper?.code_status || 'none'\n39\t\n40\t  return (\n41\t    <div className=\"space-y-6\">\n42\t      <section>\n43\t        <h2 className=\"text-lg font-semibold mb-3\" style={{ color: 'var(--text-primary)' }}>代码仓库</h2>\n44\t\n45\t        {codeUrl ? (\n46\t          <div className=\"rounded-lg p-4 space-y-3\" style={{ backgroundColor: 'var(--bg-elevated)', border: '1px solid var(--border-light)' }}>\n47\t            <div className=\"flex items-center gap-2\">\n48\t              <span className=\"w-2 h-2 rounded-full bg-green-500\" />\n49\t              <span className=\"text-sm\" style={{ color: 'var(--text-secondary)' }}>已找到代码仓库</span>\n50\t            </div>\n51\t            <a\n52\t              href={codeUrl.startsWith('http') ? codeUrl : `https://${codeUrl}`}\n53\t              target=\"_blank\"\n54\t              rel=\"noopener noreferrer\"\n55\t              className=\"text-sm text-blue-400 hover:text-blue-300 break-all transition-colors\"\n56\t            >\n57\t              {codeUrl}\n58\t            </a>\n59\t            <div className=\"flex items-center gap-2 pt-1\">\n60\t              {codeStatus === 'none' && paperId && (\n61\t                <Link\n62\t                  to={`/code/${paperId}`}\n63\t                  className=\"inline-flex items-center gap-1.5 px-4 py-2 text-sm rounded-lg transition-colors\"\n64\t                  style={{ backgroundColor: 'var(--accent)', color: 'var(--bg-base)' }}\n65\t                  onMouseEnter={e => { (e.currentTarget as HTMLElement).style.opacity = '0.85' }}\n66\t                  onMouseLeave={e => { (e.currentTarget as HTMLElement).style.opacity = '1' }}\n67\t                >\n68\t                  <svg className=\"w-4 h-4\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\">\n69\t                    <path strokeLinecap=\"round\" strokeLinejoin=\"round\" strokeWidth={2}\n70\t                      d=\"M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4\" />\n71\t                  </svg>\n72\t                  启用代码分析\n73\t                </Link>\n74\t              )}\n75\t              {codeStatus === 'ready' && paperId && (\n76\t                <Link\n77\t                  to={`/code/${paperId}`}\n78\t                  className=\"inline-flex items-center gap-1.5 px-4 py-2 text-sm rounded-lg transition-colors\"\n79\t                  style={{ backgroundColor: 'var(--bg-surface)', color: 'var(--text-primary)' }}\n80\t                  onMouseEnter={e => { (e.currentTarget as HTMLElement).style.backgroundColor = 'var(--bg-elevated)' }}\n81\t                  onMouseLeave={e => { (e.currentTarget as HTMLElement).style.backgroundColor = 'var(--bg-surface)' }}\n82\t                >\n83\t                  <svg className=\"w-4 h-4\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\">\n84\t                    <path strokeLinecap=\"round\" strokeLinejoin=\"round\" strokeWidth={2}\n85\t                      d=\"M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4\" />\n86\t                  </svg>\n87\t                  查看代码分析\n88\t                </Link>\n89\t              )}\n90\t              {codeStatus === 'cloning' && (\n91\t                <span className=\"inline-flex items-center gap-1.5 px-4 py-2 text-sm rounded-lg\" style={{ backgroundColor: 'var(--bg-surface)', color: 'var(--text-secondary)' }}>\n92\t                  <div className=\"w-4 h-4 border-2 rounded-full animate-spin\" style={{ borderColor: 'var(--text-muted)', borderTopColor: 'var(--accent)' }} />\n93\t                  正在克隆...\n94\t                </span>\n95\t              )}\n96\t              {codeStatus === 'failed' && (\n97\t                <span className=\"text-sm text-red-400\">克隆失败</span>\n98\t              )}\n99\t            </div>\n100\t          </div>\n101\t        ) : (\n102\t          <div className=\"rounded-lg p-4 text-center space-y-3\" style={{ backgroundColor: 'var(--bg-elevated)', border: '1px solid var(--border-light)' }}>\n103\t            <div>\n104\t              <p className=\"text-sm\" style={{ color: 'var(--text-muted)' }}>未找到公开的源码地址</p>\n105\t              <p className=\"text-xs mt-1\" style={{ color: 'var(--text-muted)' }}>论文中未发现 GitHub/GitLab 等代码仓库链接</p>\n106\t            </div>\n107\t            <button\n108\t              onClick={handleResearch}\n109\t              disabled={searching}\n110\t              className=\"inline-flex items-center gap-1.5 px-3 py-1.5 text-xs rounded disabled:opacity-50 transition-colors\"\n111\t              style={{ backgroundColor: 'var(--bg-surface)', color: 'var(--text-secondary)' }}\n112\t              onMouseEnter={e => { (e.currentTarget as HTMLElement).style.backgroundColor = 'var(--bg-elevated)' }}\n113\t              onMouseLeave={e => { (e.currentTarget as HTMLElement).style.backgroundColor = 'var(--bg-surface)' }}\n114\t            >\n115\t              {searching ? (\n116\t                <>\n117\t                  <div className=\"w-3 h-3 border rounded-full animate-spin\" style={{ borderColor: 'var(--text-muted)', borderTopColor: 'var(--accent)' }} />\n118\t                  搜索中...\n119\t                </>\n120\t              ) : (\n121\t                <>\n122\t                  <svg className=\"w-3 h-3\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\">\n123\t                    <path strokeLinecap=\"round\" strokeLinejoin=\"round\" strokeWidth={2} d=\"M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z\" />\n124\t                  </svg>\n125\t                  重新查找\n126\t                </>\n127\t              )}\n128\t            </button>\n129\t          </div>\n130\t        )}\n131\t      </section>\n132\t    </div>\n133\t  )\n134\t}\n135\t"}]},"parent_tool_use_id":"call_bddd82a75f2e46b98e4517cc","session_id":"29257b8f-ede7-46a4-8e0f-a743591d296a","uuid":"64c99f13-b46e-49f1-ac06-607d563baf83","timestamp":"2026-06-09T05:10:38.555Z","subagent_type":"Explore","task_description":"Explore frontend performance"}
