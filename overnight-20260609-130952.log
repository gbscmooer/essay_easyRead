{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call_b90f58474e4a4df1bacddf25","type":"tool_result","content":"1\timport { useState, useEffect, useCallback } from 'react'\n2\timport { post, get } from '@/api/client'\n3\t\n4\timport { refreshConfig, setUIPreview, clearUIPreview, hasUnsavedConfig } from '@/hooks/useConfig'\n5\timport { ThemeEditor } from '@/features/settings/ThemeEditor'\n6\timport { PromptEditor } from '@/features/settings/PromptEditor'\n7\timport { GrobidPanel } from '@/features/settings/GrobidPanel'\n8\timport type { Theme } from '@/theme/themes'\n9\t\n10\t\n11\tinterface TestResult {\n12\t  ok: boolean\n13\t  message: string\n14\t  latency_ms: number | null\n15\t}\n16\t\n17\t\n18\t/** 测试按钮：点击后调用后端 test-connection，显示结果 */\n19\tfunction TestButton({\n20\t  type,\n21\t  api_key,\n22\t  base_url,\n23\t  model,\n24\t  provider,\n25\t}: {\n26\t  type: 'translate' | 'analysis' | 'embedding'\n27\t  api_key?: string\n28\t  base_url?: string\n29\t  model?: string\n30\t  provider?: string\n31\t}) {\n32\t  const [testing, setTesting] = useState(false)\n33\t  const [result, setResult] = useState<TestResult | null>(null)\n34\t  const [showError, setShowError] = useState(false)\n35\t\n36\t  const handleTest = useCallback(async () => {\n37\t    setTesting(true)\n38\t    setResult(null)\n39\t    setShowError(false)\n40\t    try {\n41\t      const res = await post<TestResult>('/analysis/test-connection', {\n42\t        type,\n43\t        api_key: api_key ?? '',\n44\t        base_url: base_url ?? '',\n45\t        model: model ?? '',\n46\t        provider: provider ?? '',\n47\t      })\n48\t      setResult(res)\n49\t    } catch (e: any) {\n50\t      setResult({ ok: false, message: e?.message || '请求失败', latency_ms: null })\n51\t    } finally {\n52\t      setTesting(false)\n53\t    }\n54\t  }, [type, api_key, base_url, model, provider])\n55\t\n56\t  return (\n57\t    <div className=\"flex items-center gap-2 relative\">\n58\t      <button\n59\t        onClick={() => {\n60\t          if (result && !result.ok) {\n61\t            setShowError(v => !v)\n62\t          } else {\n63\t            handleTest()\n64\t          }\n65\t        }}\n66\t        disabled={testing}\n67\t        className=\"px-3 py-1 text-xs rounded-lg border transition-colors disabled:opacity-50\"\n68\t          style={result === null ? { borderColor: 'var(--border-light)', color: 'var(--text-secondary)' } : result.ok ? { borderColor: 'var(--success)', color: 'var(--success)', backgroundColor: 'var(--success-subtle)' } : { borderColor: 'var(--error)', color: 'var(--error)', backgroundColor: 'var(--error-subtle)', cursor: 'pointer' }}\n69\t      >\n70\t        {testing ? (\n71\t          <span className=\"flex items-center gap-1.5\">\n72\t            <svg className=\"w-3 h-3 animate-spin\" fill=\"none\" viewBox=\"0 0 24 24\">\n73\t              <circle className=\"opacity-25\" cx=\"12\" cy=\"12\" r=\"10\" stroke=\"currentColor\" strokeWidth=\"4\" />\n74\t              <path className=\"opacity-75\" fill=\"currentColor\" d=\"M4 12a8 8 0 018-8v4a4 4 0 00-4 4H4z\" />\n75\t            </svg>\n76\t            测试中\n77\t          </span>\n78\t        ) : result?.ok\n79\t          ? `测试通过${result.latency_ms != null ? ` (${result.latency_ms}ms)` : ''}`\n80\t          : result\n81\t            ? '测试失败'\n82\t            : '测试'}\n83\t      </button>\n84\t\n85\t      {/* 失败时点击按钮弹出错误详情 */}\n86\t      {showError && result && !result.ok && (\n87\t        <>\n88\t          {/* 遮罩 */}\n89\t          <div\n90\t            className=\"fixed inset-0 z-50\"\n91\t            onClick={() => setShowError(false)}\n92\t          />\n93\t          {/* 弹窗 */}\n94\t          <div\n95\t            className=\"absolute right-0 top-full mt-2 z-50 w-80 rounded-xl p-4 border\"\n96\t            style={{\n97\t              backgroundColor: 'var(--bg-elevated)',\n98\t              borderColor: 'var(--border)',\n99\t            }}\n100\t          >\n101\t            <div className=\"flex items-center justify-between mb-2\">\n102\t              <span className=\"text-sm font-medium text-red-400\">连接失败</span>\n103\t              <button\n104\t                onClick={() => setShowError(false)}\n105\t                className=\"text-xs hover:opacity-80\"\n106\t                style={{ color: 'var(--text-muted)' }}\n107\t              >\n108\t                &times;\n109\t              </button>\n110\t            </div>\n111\t            <p className=\"text-xs leading-relaxed break-all\" style={{ color: 'var(--text-secondary)' }}>\n112\t              {result.message}\n113\t            </p>\n114\t            {result.latency_ms != null && (\n115\t              <p className=\"text-[11px] mt-2\" style={{ color: 'var(--text-muted)' }}>\n116\t                耗时 {result.latency_ms}ms\n117\t              </p>\n118\t            )}\n119\t            <button\n120\t              onClick={() => { setShowError(false); handleTest() }}\n121\t              className=\"mt-3 px-3 py-1 text-xs rounded-lg border transition-colors\"\n122\t              style={{\n123\t                borderColor: 'var(--border)',\n124\t                color: 'var(--text-secondary)',\n125\t                backgroundColor: 'var(--bg-surface)',\n126\t              }}\n127\t            >\n128\t              重试\n129\t            </button>\n130\t          </div>\n131\t        </>\n132\t      )}\n133\t    </div>\n134\t  )\n135\t}interface AIModelConfig {\n136\t  api_key: string\n137\t  base_url: string\n138\t  model: string\n139\t  system_prompt: string\n140\t  temperature: number\n141\t  max_tokens: number\n142\t}\n143\t\n144\tinterface UIConfig {\n145\t  highlight_duration: number\n146\t  zoom_step: number\n147\t  zoom_min: number\n148\t  zoom_max: number\n149\t  pinch_zoom_step: number\n150\t  theme: string\n151\t  font: string\n152\t  custom_font: string\n153\t  custom_themes?: Theme[]\n154\t}\n155\t\n156\tinterface EmbeddingConfig {\n157\t  provider: 'local' | 'openai' | 'siliconflow'\n158\t  model: string\n159\t  api_key: string\n160\t  base_url: string\n161\t  batch_size: number\n162\t  device: string\n163\t}\n164\t\n165\tinterface ResearchConfig {\n166\t  provider: 'openalex' | 'semantic_scholar' | 'local'\n167\t  email: string\n168\t  api_key: string\n169\t  similarity_threshold: number\n170\t}\n171\t\n172\tinterface RerankerConfig {\n173\t  enabled: boolean\n174\t  provider: 'siliconflow' | 'custom'\n175\t  model: string\n176\t  api_key: string\n177\t  base_url: string\n178\t  candidate_k: number\n179\t  top_n: number\n180\t}\n181\t\n182\tinterface SimilarityConfig {\n183\t  provider: string\n184\t}\n185\t\n186\tinterface ArxivExpandConfig {\n187\t  enabled: boolean\n188\t  parser: 'grobid' | 'regex'\n189\t  grobid_url: string\n190\t  top_k: number\n191\t  use_llm_title: boolean\n192\t  max_llm_refs: number\n193\t}\n194\t\n195\tinterface PromptTemplate {\n196\t  id: string\n197\t  name: string\n198\t  content: string\n199\t}\n200\t\n201\tinterface AnalysisPromptConfig {\n202\t  active: string            // builtin | custom:<id>\n203\t  custom: PromptTemplate[]\n204\t}\n205\t\n206\tinterface FindpapersConfig {\n207\t  enabled: boolean\n208\t  databases: string[]\n209\t  max_results: number\n210\t}\n211\t\n212\tinterface AppConfig {\n213\t  translate: AIModelConfig\n214\t  analysis: AIModelConfig\n215\t  analysis_prompt: AnalysisPromptConfig\n216\t  ui: UIConfig\n217\t  embedding: EmbeddingConfig\n218\t  research: ResearchConfig\n219\t  reranker: RerankerConfig\n220\t  similarity: SimilarityConfig\n221\t  arxiv_expand: ArxivExpandConfig\n222\t  findpapers: FindpapersConfig\n223\t}\n224\t\n225\t\n226\tconst DEFAULT_CONFIG: AppConfig = {\n227\t  translate: {\n228\t    api_key: '',\n229\t    base_url: 'https://api.openai.com/v1',\n230\t    model: 'gpt-4o-mini',\n231\t    system_prompt: '',\n232\t    temperature: 0.3,\n233\t    max_tokens: 2048,\n234\t  },\n235\t  analysis: {\n236\t    api_key: '',\n237\t    base_url: 'https://token-plan-cn.xiaomimimo.com/anthropic',\n238\t    model: 'mimo-v2.5-pro',\n239\t    system_prompt: '',\n240\t    temperature: 0.1,\n241\t    max_tokens: 16384,\n242\t  },\n243\t  analysis_prompt: {\n244\t    active: 'builtin',\n245\t    custom: [],\n246\t  },\n247\t  ui: {\n248\t    highlight_duration: 3000,\n249\t    zoom_step: 0.2,\n250\t    zoom_min: 0.4,\n251\t    zoom_max: 3.0,\n252\t    pinch_zoom_step: 0.02,\n253\t    theme: 'light',\n254\t    font: 'sans',\n255\t    custom_font: '',\n256\t    custom_themes: [],\n257\t  },\n258\t  embedding: {\n259\t    provider: 'local',\n260\t    model: 'BAAI/bge-m3',\n261\t    api_key: '',\n262\t    base_url: 'https://api.openai.com/v1',\n263\t    batch_size: 32,\n264\t    device: 'auto',\n265\t  },\n266\t  research: {\n267\t    provider: 'openalex',\n268\t    email: '',\n269\t    api_key: '',\n270\t    similarity_threshold: 0.9,\n271\t  },\n272\t  reranker: {\n273\t    enabled: true,\n274\t    provider: 'siliconflow',\n275\t    model: 'BAAI/bge-reranker-v2-m3',\n276\t    api_key: '',\n277\t    base_url: '',\n278\t    candidate_k: 30,\n279\t    top_n: 5,\n280\t  },\n281\t  similarity: {\n282\t    provider: 'bge_centroid',\n283\t  },\n284\t  arxiv_expand: {\n285\t    enabled: true,\n286\t    parser: 'grobid',\n287\t    grobid_url: 'http://localhost:8070',\n288\t    top_k: 5,\n289\t    use_llm_title: true,\n290\t    max_llm_refs: 15,\n291\t  },\n292\t  findpapers: {\n293\t    enabled: false,\n294\t    databases: ['arxiv', 'openalex', 'pubmed', 'semantic_scholar'],\n295\t    max_results: 10,\n296\t  },\n297\t}\n298\t\n299\t\n300\tconst PROVIDER_PRESETS = [\n301\t  { label: 'OpenAI', base_url: 'https://api.openai.com/v1', models: ['gpt-4o', 'gpt-4o-mini', 'gpt-4.1-mini'] },\n302\t  { label: 'Anthropic', base_url: 'https://api.anthropic.com', models: ['claude-sonnet-4-6', 'claude-haiku-4-5-20251001'] },\n303\t]\n304\t\n305\t\n306\tfunction ConfigSection({\n307\t  title,\n308\t  description,\n309\t  config,\n310\t  onChange,\n311\t  defaultMaxTokens,\n312\t  testType,\n313\t}: {\n314\t  title: string\n315\t  description: string\n316\t  config: AIModelConfig\n317\t  onChange: (cfg: AIModelConfig) => void\n318\t  defaultMaxTokens: number\n319\t  testType: 'translate' | 'analysis'\n320\t}) {\n321\t  const [showKey, setShowKey] = useState(false)\n322\t  const [showAdvanced, setShowAdvanced] = useState(false)\n323\t  const keyMissing = !config.api_key.trim()\n324\t\n325\t  return (\n326\t    <div\n327\t      className=\"rounded-xl border p-5 space-y-4\"\n328\t      style={{\n329\t        backgroundColor: 'var(--bg-surface)',\n330\t        borderColor: keyMissing ? 'var(--error)' : 'var(--border)',\n331\t      }}\n332\t    >\n333\t      <div>\n334\t        <div className=\"flex items-center justify-between\">\n335\t          <div className=\"flex items-center gap-2\">\n336\t            <h2 className=\"text-base font-semibold\" style={{ color: 'var(--text-primary)' }}>{title}</h2>\n337\t            {keyMissing && (\n338\t              <span\n339\t                className=\"text-xs px-2 py-0.5 rounded-full\"\n340\t                style={{ color: 'var(--error)', backgroundColor: 'var(--error-subtle)' }}\n341\t              >\n342\t                未配置 API Key\n343\t              </span>\n344\t            )}\n345\t          </div>\n346\t          <TestButton\n347\t            type={testType}\n348\t            api_key={config.api_key}\n349\t            base_url={config.base_url}\n350\t            model={config.model}\n351\t          />\n352\t        </div>\n353\t        <p className=\"text-xs mt-0.5\" style={{ color: 'var(--text-muted)' }}>{description}</p>\n354\t      </div>\n355\t\n356\t      {/* 快捷选择 */}\n357\t      <div>\n358\t        <label className=\"block text-xs mb-1.5\" style={{ color: 'var(--text-muted)' }}>服务商预设</label>\n359\t        <div className=\"flex flex-wrap gap-2\">\n360\t          {PROVIDER_PRESETS.map(preset => (\n361\t            <button\n362\t              key={preset.label}\n363\t              onClick={() => {\n364\t                const updates: Partial<AIModelConfig> = { base_url: preset.base_url }\n365\t                if (preset.models.length === 1) {\n366\t                  updates.model = preset.models[0]\n367\t                }\n368\t                onChange({ ...config, ...updates })\n369\t              }}\n370\t              className=\"px-3 py-1 text-xs rounded-full border transition-colors\"\n371\t              style={\n372\t                config.base_url === preset.base_url\n373\t                  ? { borderColor: 'var(--accent)', backgroundColor: 'var(--accent-subtle)', color: 'var(--accent)' }\n374\t                  : { borderColor: 'var(--border-light)', color: 'var(--text-secondary)' }\n375\t              }\n376\t            >\n377\t              {preset.label}\n378\t            </button>\n379\t          ))}\n380\t        </div>\n381\t      </div>\n382\t\n383\t      {/* Base URL */}\n384\t      <div>\n385\t        <label className=\"block text-xs mb-1\" style={{ color: 'var(--text-muted)' }}>API Base URL</label>\n386\t        <input\n387\t          type=\"text\"\n388\t          value={config.base_url}\n389\t          onChange={e => onChange({ ...config, base_url: e.target.value })}\n390\t          placeholder=\"https://api.openai.com/v1\"\n391\t          className=\"w-full px-3 py-2 text-sm rounded-lg focus:outline-none transition-colors\"\n392\t          style={{ backgroundColor: 'var(--bg-elevated)', borderColor: 'var(--border-light)', color: 'var(--text-primary)' }}\n393\t        />\n394\t      </div>\n395\t\n396\t      {/* API Key */}\n397\t      <div>\n398\t        <label className=\"block text-xs mb-1\" style={{ color: 'var(--text-muted)' }}>API Key</label>\n399\t        <div className=\"relative\">\n400\t          <input\n401\t            type={showKey ? 'text' : 'password'}\n402\t            value={config.api_key}\n403\t            onChange={e => onChange({ ...config, api_key: e.target.value })}\n404\t            placeholder=\"sk-...\"\n405\t            className=\"w-full px-3 py-2 pr-10 text-sm rounded-lg focus:outline-none transition-colors font-mono\"\n406\t            style={{\n407\t              backgroundColor: 'var(--bg-elevated)',\n408\t              borderColor: keyMissing ? 'var(--error)' : 'var(--border-light)',\n409\t              color: 'var(--text-primary)',\n410\t            }}\n411\t          />\n412\t          <button\n413\t            onClick={() => setShowKey(v => !v)}\n414\t            className=\"absolute right-2 top-1/2 -translate-y-1/2 text-xs\"\n415\t            style={{ color: 'var(--text-muted)' }}\n416\t            onMouseEnter={e => { (e.currentTarget as HTMLElement).style.color = 'var(--text-secondary)' }}\n417\t            onMouseLeave={e => { (e.currentTarget as HTMLElement).style.color = 'var(--text-muted)' }}\n418\t          >\n419\t            {showKey ? '隐藏' : '显示'}\n420\t          </button>\n421\t        </div>\n422\t      </div>\n423\t\n424\t      {/* Model */}\n425\t      <div>\n426\t        <label className=\"block text-xs mb-1\" style={{ color: 'var(--text-muted)' }}>模型名称</label>\n427\t        <input\n428\t          type=\"text\"\n429\t          value={config.model}\n430\t          onChange={e => onChange({ ...config, model: e.target.value })}\n431\t          placeholder=\"gpt-4o-mini\"\n432\t          className=\"w-full px-3 py-2 text-sm rounded-lg focus:outline-none transition-colors\"\n433\t          style={{ backgroundColor: 'var(--bg-elevated)', borderColor: 'var(--border-light)', color: 'var(--text-primary)' }}\n434\t        />\n435\t      </div>\n436\t\n437\t      {/* 高级参数（折叠） */}\n438\t      <div>\n439\t        <button\n440\t          onClick={() => setShowAdvanced(v => !v)}\n441\t          className=\"flex items-center gap-1 text-xs transition-colors\"\n442\t          style={{ color: 'var(--text-muted)' }}\n443\t          onMouseEnter={e => { (e.currentTarget as HTMLElement).style.color = 'var(--text-secondary)' }}\n444\t          onMouseLeave={e => { (e.currentTarget as HTMLElement).style.color = 'var(--text-muted)' }}\n445\t        >\n446\t          <svg\n447\t            className={`w-3 h-3 transition-transform ${showAdvanced ? 'rotate-90' : ''}`}\n448\t            fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\"\n449\t          >\n450\t            <path strokeLinecap=\"round\" strokeLinejoin=\"round\" strokeWidth={2} d=\"M9 5l7 7-7 7\" />\n451\t          </svg>\n452\t          高级参数\n453\t        </button>\n454\t\n455\t        {showAdvanced && (\n456\t          <div className=\"mt-3 space-y-3 pl-2 border-l\" style={{ borderColor: 'var(--border)' }}>\n457\t            {/* Temperature */}\n458\t            <div>\n459\t              <div className=\"flex items-center justify-between mb-1\">\n460\t                <label className=\"text-xs\" style={{ color: 'var(--text-muted)' }}>Temperature</label>\n461\t                <span className=\"text-xs\" style={{ color: 'var(--text-muted)' }}>{config.temperature}</span>\n462\t              </div>\n463\t              <input\n464\t                type=\"range\"\n465\t                min={0}\n466\t                max={2}\n467\t                step={0.05}\n468\t                value={config.temperature}\n469\t                onChange={e => onChange({ ...config, temperature: parseFloat(e.target.value) })}\n470\t                className=\"w-full h-1.5 rounded-lg appearance-none cursor-pointer accent-blue-500\"\n471\t                style={{ backgroundColor: 'var(--border)' }}\n472\t              />\n473\t              <div className=\"flex justify-between text-[10px] mt-0.5\" style={{ color: 'var(--text-muted)' }}>\n474\t                <span>精确 (0)</span>\n475\t                <span>平衡 (1)</span>\n476\t                <span>随机 (2)</span>\n477\t              </div>\n478\t            </div>\n479\t\n480\t            {/* Max Tokens */}\n481\t            <div>\n482\t              <div className=\"flex items-center justify-between mb-1\">\n483\t                <label className=\"text-xs\" style={{ color: 'var(--text-muted)' }}>最大输出 Token 数</label>\n484\t                <span className=\"text-xs\" style={{ color: 'var(--text-muted)' }}>{config.max_tokens}</span>\n485\t              </div>\n486\t              <input\n487\t                type=\"range\"\n488\t                min={512}\n489\t                max={32768}\n490\t                step={512}\n491\t                value={config.max_tokens}\n492\t                onChange={e => onChange({ ...config, max_tokens: parseInt(e.target.value) })}\n493\t                className=\"w-full h-1.5 rounded-lg appearance-none cursor-pointer accent-blue-500\"\n494\t                style={{ backgroundColor: 'var(--border)' }}\n495\t              />\n496\t              <div className=\"flex justify-between text-[10px] mt-0.5\" style={{ color: 'var(--text-muted)' }}>\n497\t                <span>512</span>\n498\t                <span>默认 {defaultMaxTokens}</span>\n499\t                <span>32768</span>\n500\t              </div>\n501\t            </div>\n502\t          </div>\n503\t        )}\n504\t      </div>\n505\t    </div>\n506\t  )\n507\t}\n508\t\n509\t\n510\tconst FONTS = [\n511\t  { key: 'sans', label: 'Arial（非衬线）' },\n512\t  { key: 'serif', label: 'Times New Roman（衬线）' },\n513\t  { key: 'mono', label: '等宽字体' },\n514\t  { key: 'custom', label: '自定义字体' },\n515\t]\n516\t\n517\t\n518\tfunction UIConfigSection({\n519\t  config,\n520\t  onChange,\n521\t}: {\n522\t  config: UIConfig\n523\t  onChange: (cfg: UIConfig) => void\n524\t}) {\n525\t  const [showAdvanced, setShowAdvanced] = useState(false)\n526\t\n527\t  return (\n528\t    <div\n529\t      className=\"rounded-xl border p-5 space-y-4\"\n530\t      style={{ backgroundColor: 'var(--bg-surface)', borderColor: 'var(--border)' }}\n531\t    >\n532\t      <div>\n533\t        <h2 className=\"text-base font-semibold\" style={{ color: 'var(--text-primary)' }}>界面设置</h2>\n534\t        <p className=\"text-xs mt-0.5\" style={{ color: 'var(--text-muted)' }}>主题、字体和交互行为参数</p>\n535\t      </div>\n536\t\n537\t      {/* 主题选择 + 自定义编辑器 */}\n538\t      <ThemeEditor config={config} onChange={onChange} />\n539\t\n540\t      {/* 字体选择 */}\n541\t      <div>\n542\t        <label className=\"block text-xs mb-2\" style={{ color: 'var(--text-muted)' }}>界面字体</label>\n543\t        <div className=\"space-y-1.5\">\n544\t          {FONTS.map(font => (\n545\t            <button\n546\t              key={font.key}\n547\t              onClick={() => { onChange({ ...config, font: font.key }); setUIPreview({ font: font.key }) }}\n548\t              className=\"w-full text-left px-3 py-1.5 text-sm rounded border transition-colors\"\n549\t              style={\n550\t                config.font === font.key\n551\t                  ? { borderColor: 'var(--accent)', backgroundColor: 'var(--accent-subtle)', color: 'var(--accent)' }\n552\t                  : { borderColor: 'var(--border-light)', color: 'var(--text-secondary)' }\n553\t              }\n554\t            >\n555\t              {font.label}\n556\t            </button>\n557\t          ))}\n558\t        </div>\n559\t        {config.font === 'custom' && (\n560\t          <input\n561\t            type=\"text\"\n562\t            value={config.custom_font}\n563\t            onChange={e => { onChange({ ...config, custom_font: e.target.value }); setUIPreview({ custom_font: e.target.value }) }}\n564\t            placeholder=\"输入字体名称，如 PingFang SC\"\n565\t            className=\"mt-2 w-full px-3 py-1.5 text-sm rounded focus:outline-none\"\n566\t            style={{ backgroundColor: 'var(--bg-elevated)', borderColor: 'var(--border-light)', color: 'var(--text-primary)' }}\n567\t          />\n568\t        )}\n569\t        <p className=\"text-[10px] mt-1\" style={{ color: 'var(--text-muted)' }}>仅作用于界面文字，不影响源码展示</p>\n570\t      </div>\n571\t\n572\t      {/* 大纲跳转高亮时长 */}\n573\t      <div>\n574\t        <div className=\"flex items-center justify-between mb-1\">\n575\t          <label className=\"text-xs\" style={{ color: 'var(--text-muted)' }}>大纲跳转高亮时长</label>\n576\t          <span className=\"text-xs\" style={{ color: 'var(--text-muted)' }}>{(config.highlight_duration / 1000).toFixed(1)}s</span>\n577\t        </div>\n578\t        <input\n579\t          type=\"range\"\n580\t          min={500}\n581\t          max={10000}\n582\t          step={500}\n583\t          value={config.highlight_duration}\n584\t          onChange={e => onChange({ ...config, highlight_duration: parseInt(e.target.value) })}\n585\t          className=\"w-full h-1.5 rounded-lg appearance-none cursor-pointer accent-blue-500\"\n586\t          style={{ backgroundColor: 'var(--border)' }}\n587\t        />\n588\t        <div className=\"flex justify-between text-[10px] mt-0.5\" style={{ color: 'var(--text-muted)' }}>\n589\t          <span>0.5s</span>\n590\t          <span>默认 3s</span>\n591\t          <span>10s</span>\n592\t        </div>\n593\t      </div>\n594\t\n595\t      {/* PDF 缩放参数（折叠） */}\n596\t      <div>\n597\t        <button\n598\t          onClick={() => setShowAdvanced(v => !v)}\n599\t          className=\"flex items-center gap-1 text-xs transition-colors\"\n600\t          style={{ color: 'var(--text-muted)' }}\n601\t        >\n602\t          <svg\n603\t            className={`w-3 h-3 transition-transform ${showAdvanced ? 'rotate-90' : ''}`}\n604\t            fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\"\n605\t          >\n606\t            <path strokeLinecap=\"round\" strokeLinejoin=\"round\" strokeWidth={2} d=\"M9 5l7 7-7 7\" />\n607\t          </svg>\n608\t          PDF 缩放参数\n609\t        </button>\n610\t\n611\t        {showAdvanced && (\n612\t          <div className=\"mt-3 space-y-3 pl-2 border-l\" style={{ borderColor: 'var(--border)' }}>\n613\t            {/* Zoom Step */}\n614\t            <div>\n615\t              <div className=\"flex items-center justify-between mb-1\">\n616\t                <label className=\"text-xs\" style={{ color: 'var(--text-muted)' }}>每次缩放步进</label>\n617\t                <span className=\"text-xs\" style={{ color: 'var(--text-muted)' }}>{Math.round(config.zoom_step * 100)}%</span>\n618\t              </div>\n619\t              <input\n620\t                type=\"range\"\n621\t                min={5}\n622\t                max={50}\n623\t                step={5}\n624\t                value={Math.round(config.zoom_step * 100)}\n625\t                onChange={e => onChange({ ...config, zoom_step: parseInt(e.target.value) / 100 })}\n626\t                className=\"w-full h-1.5 rounded-lg appearance-none cursor-pointer accent-blue-500\"\n627\t                style={{ backgroundColor: 'var(--border)' }}\n628\t              />\n629\t            </div>\n630\t\n631\t            {/* Zoom Min */}\n632\t            <div>\n633\t              <div className=\"flex items-center justify-between mb-1\">\n634\t                <label className=\"text-xs\" style={{ color: 'var(--text-muted)' }}>最小缩放倍率</label>\n635\t                <span className=\"text-xs\" style={{ color: 'var(--text-muted)' }}>{Math.round(config.zoom_min * 100)}%</span>\n636\t              </div>\n637\t              <input\n638\t                type=\"range\"\n639\t                min={10}\n640\t                max={100}\n641\t                step={10}\n642\t                value={Math.round(config.zoom_min * 100)}\n643\t                onChange={e => onChange({ ...config, zoom_min: parseInt(e.target.value) / 100 })}\n644\t                className=\"w-full h-1.5 rounded-lg appearance-none cursor-pointer accent-blue-500\"\n645\t                style={{ backgroundColor: 'var(--border)' }}\n646\t              />\n647\t            </div>\n648\t\n649\t            {/* Zoom Max */}\n650\t            <div>\n651\t              <div className=\"flex items-center justify-between mb-1\">\n652\t                <label className=\"text-xs\" style={{ color: 'var(--text-muted)' }}>最大缩放倍率</label>\n653\t                <span className=\"text-xs\" style={{ color: 'var(--text-muted)' }}>{Math.round(config.zoom_max * 100)}%</span>\n654\t              </div>\n655\t              <input\n656\t                type=\"range\"\n657\t                min={100}\n658\t                max={500}\n659\t                step={50}\n660\t                value={Math.round(config.zoom_max * 100)}\n661\t                onChange={e => onChange({ ...config, zoom_max: parseInt(e.target.value) / 100 })}\n662\t                className=\"w-full h-1.5 rounded-lg appearance-none cursor-pointer accent-blue-500\"\n663\t                style={{ backgroundColor: 'var(--border)' }}\n664\t              />\n665\t            </div>\n666\t\n667\t            {/* Pinch Zoom Step */}\n668\t            <div>\n669\t              <div className=\"flex items-center justify-between mb-1\">\n670\t                <label className=\"text-xs\" style={{ color: 'var(--text-muted)' }}>触控板捏合灵敏度</label>\n671\t                <span className=\"text-xs\" style={{ color: 'var(--text-muted)' }}>{Math.round(config.pinch_zoom_step * 100)}%</span>\n672\t              </div>\n673\t              <input\n674\t                type=\"range\"\n675\t                min={1}\n676\t                max={10}\n677\t                step={1}\n678\t                value={Math.round(config.pinch_zoom_step * 100)}\n679\t                onChange={e => onChange({ ...config, pinch_zoom_step: parseInt(e.target.value) / 100 })}\n680\t                className=\"w-full h-1.5 rounded-lg appearance-none cursor-pointer accent-blue-500\"\n681\t                style={{ backgroundColor: 'var(--border)' }}\n682\t              />\n683\t              <div className=\"flex justify-between text-[10px] mt-0.5\" style={{ color: 'var(--text-muted)' }}>\n684\t                <span>低 (1%)</span>\n685\t                <span>默认 2%</span>\n686\t                <span>高 (10%)</span>\n687\t              </div>\n688\t            </div>\n689\t          </div>\n690\t        )}\n691\t      </div>\n692\t    </div>\n693\t  )\n694\t}\n695\t\n696\t\n697\texport default function SettingsPage() {\n698\t  const [config, setConfig] = useState<AppConfig>(DEFAULT_CONFIG)\n699\t  const [saving, setSaving] = useState(false)\n700\t  const [saved, setSaved] = useState(false)\n701\t  const [loading, setLoading] = useState(true)\n702\t  const [simProviders, setSimProviders] = useState<string[]>(['bge_centroid'])\n703\t\n704\t  useEffect(() => {\n705\t    get<AppConfig>('/analysis/config')\n706\t      .then(cfg => setConfig({\n707\t        ...DEFAULT_CONFIG,\n708\t        ...cfg,\n709\t        embedding: { ...DEFAULT_CONFIG.embedding, ...(cfg.embedding ?? {}) },\n710\t        translate: { ...DEFAULT_CONFIG.translate, ...(cfg.translate ?? {}) },\n711\t        analysis: { ...DEFAULT_CONFIG.analysis, ...(cfg.analysis ?? {}) },\n712\t        analysis_prompt: { ...DEFAULT_CONFIG.analysis_prompt, ...(cfg.analysis_prompt ?? {}) },\n713\t        ui: { ...DEFAULT_CONFIG.ui, ...(cfg.ui ?? {}) },\n714\t        research: { ...DEFAULT_CONFIG.research, ...(cfg.research ?? {}) },\n715\t        reranker: { ...DEFAULT_CONFIG.reranker, ...(cfg.reranker ?? {}) },\n716\t        similarity: { ...DEFAULT_CONFIG.similarity, ...(cfg.similarity ?? {}) },\n717\t        arxiv_expand: { ...DEFAULT_CONFIG.arxiv_expand, ...(cfg.arxiv_expand ?? {}) },\n718\t        findpapers: { ...DEFAULT_CONFIG.findpapers, ...(cfg.findpapers ?? {}) },\n719\t      }))\n720\t      .catch(() => {})\n721\t      .finally(() => setLoading(false))\n722\t\n723\t    get<{ providers: string[] }>('/analysis/similarity/providers')\n724\t      .then(r => { if (r?.providers?.length) setSimProviders(r.providers) })\n725\t      .catch(() => {})\n726\t  }, [])\n727\t\n728\t  // 离开页面时清除预览（不保存则恢复原样）\n729\t  useEffect(() => {\n730\t    return () => { clearUIPreview() }\n731\t  }, [])\n732\t\n733\t  // 浏览器关闭/刷新提示\n734\t  useEffect(() => {\n735\t    const handler = (e: BeforeUnloadEvent) => {\n736\t      if (hasUnsavedConfig()) {\n737\t        e.preventDefault()\n738\t      }\n739\t    }\n740\t    window.addEventListener('beforeunload', handler)\n741\t    return () => window.removeEventListener('beforeunload', handler)\n742\t  }, [])\n743\t\n744\t  const handleSave = async () => {\n745\t    setSaving(true)\n746\t    setSaved(false)\n747\t    try {\n748\t      await post('/analysis/config', config)\n749\t      refreshConfig()\n750\t      setSaved(true)\n751\t      setTimeout(() => setSaved(false), 2000)\n752\t    } catch {\n753\t      // ignore\n754\t    } finally {\n755\t      setSaving(false)\n756\t    }\n757\t  }\n758\t\n759\t  if (loading) {\n760\t    return (\n761\t      <div className=\"flex items-center justify-center h-64\">\n762\t        <div className=\"w-6 h-6 border-2 rounded-full animate-spin\" style={{ borderColor: 'var(--border-light)', borderTopColor: 'var(--accent)' }}  role=\"status\"><span className=\"sr-only\">加载中</span></div>\n763\t      </div>\n764\t    )\n765\t  }\n766\t\n767\t  const translateOk = !!config.translate.api_key.trim()\n768\t  const analysisOk = !!config.analysis.api_key.trim()\n769\t  const allConfigured = translateOk && analysisOk\n770\t\n771\t  return (\n772\t    <div className=\"max-w-2xl mx-auto px-6 py-8 space-y-6\">\n773\t      <div>\n774\t        <h1 className=\"text-xl font-bold\" style={{ color: 'var(--text-primary)' }}>设置</h1>\n775\t        <p className=\"text-sm mt-1\" style={{ color: 'var(--text-muted)' }}>\n776\t          配置模型参数和界面行为。点击\"高级参数\"可调整 temperature、token 上限等。\n777\t        </p>\n778\t      </div>\n779\t\n780\t      {/* 整体状态提示 */}\n781\t      {!allConfigured && (\n782\t        <div\n783\t          className=\"border rounded-lg p-4\"\n784\t          style={{ backgroundColor: 'var(--error-subtle)', borderColor: 'var(--error)' }}\n785\t        >\n786\t          <div className=\"flex items-start gap-3\">\n787\t            <span className=\"text-lg mt-0.5\" style={{ color: 'var(--error)' }}>!</span>\n788\t            <div>\n789\t              <p className=\"text-sm font-medium\" style={{ color: 'var(--error)' }}>配置不完整</p>\n790\t              <ul className=\"text-xs mt-1 space-y-0.5\" style={{ color: 'var(--error)', opacity: 0.8 }}>\n791\t                {!translateOk && <li>- 翻译模型未配置 API Key，画词翻译功能将不可用</li>}\n792\t                {!analysisOk && <li>- 解读模型未配置 API Key，论文分析功能将使用默认配置</li>}\n793\t              </ul>\n794\t            </div>\n795\t          </div>\n796\t        </div>\n797\t      )}\n798\t\n799\t      <ConfigSection\n800\t        title=\"翻译模型\"\n801\t        description=\"用于选中文本的翻译功能。\"\n802\t        config={config.translate}\n803\t        onChange={cfg => setConfig(prev => ({ ...prev, translate: cfg }))}\n804\t        defaultMaxTokens={2048}\n805\t        testType=\"translate\"\n806\t      />\n807\t\n808\t      <ConfigSection\n809\t        title=\"解读模型\"\n810\t        description=\"用于论文解析、总结等功能。\"\n811\t        config={config.analysis}\n812\t        onChange={cfg => setConfig(prev => ({ ...prev, analysis: cfg }))}\n813\t        defaultMaxTokens={16384}\n814\t        testType=\"analysis\"\n815\t      />\n816\t\n817\t      <PromptEditor\n818\t        value={config.analysis_prompt}\n819\t        onChange={ap => setConfig(prev => ({ ...prev, analysis_prompt: ap }))}\n820\t      />\n821\t\n822\t      <UIConfigSection\n823\t        config={config.ui}\n824\t        onChange={cfg => setConfig(prev => ({ ...prev, ui: cfg }))}\n825\t      />\n826\t\n827\t      {/* Embedding 配置 */}\n828\t      <div\n829\t        className=\"rounded-xl border p-5 space-y-4\"\n830\t        style={{ backgroundColor: 'var(--bg-surface)', borderColor: 'var(--border)' }}\n831\t      >\n832\t        <div className=\"flex items-center justify-between\">\n833\t          <div>\n834\t            <h2 className=\"text-base font-semibold\" style={{ color: 'var(--text-primary)' }}>Embedding 模型</h2>\n835\t            <p className=\"text-xs mt-0.5\" style={{ color: 'var(--text-muted)' }}>用于深度研究的向量嵌入模型。本地模式首次运行需下载模型（~2GB）。</p>\n836\t          </div>\n837\t          <TestButton\n838\t            type=\"embedding\"\n839\t            api_key={config.embedding.api_key}\n840\t            base_url={config.embedding.base_url}\n841\t            model={config.embedding.model}\n842\t            provider={config.embedding.provider}\n843\t          />\n844\t        </div>\n845\t\n846\t        {/* Provider 选择 */}\n847\t        <div>\n848\t          <label className=\"block text-xs mb-2\" style={{ color: 'var(--text-muted)' }}>Provider</label>\n849\t          <div className=\"flex gap-2\">\n850\t            {([\n851\t              { key: 'local' as const, label: '本地 (BGE-M3)' },\n852\t              { key: 'siliconflow' as const, label: '硅基流动' },\n853\t              { key: 'openai' as const, label: 'OpenAI' },\n854\t            ]).map(p => (\n855\t              <button\n856\t                key={p.key}\n857\t                onClick={() => setConfig(prev => {\n858\t                  const defaults: Record<string, Partial<EmbeddingConfig>> = {\n859\t                    local: { model: 'BAAI/bge-m3', base_url: 'https://api.openai.com/v1' },\n860\t                    siliconflow: { model: 'BAAI/bge-m3', base_url: 'https://api.siliconflow.cn/v1' },\n861\t                    openai: { model: 'text-embedding-3-small', base_url: 'https://api.openai.com/v1' },\n862\t                  }\n863\t                  return { ...prev, embedding: { ...prev.embedding, provider: p.key, ...defaults[p.key] } }\n864\t                })}\n865\t                className=\"px-3 py-1.5 text-xs rounded-lg border transition-colors\"\n866\t                style={\n867\t                  config.embedding.provider === p.key\n868\t                    ? { borderColor: 'var(--accent)', backgroundColor: 'var(--accent-subtle)', color: 'var(--accent)' }\n869\t                    : { borderColor: 'var(--border-light)', color: 'var(--text-secondary)' }\n870\t                }\n871\t              >\n872\t                {p.label}\n873\t              </button>\n874\t            ))}\n875\t          </div>\n876\t        </div>\n877\t\n878\t        {/* 模型名 */}\n879\t        <div>\n880\t          <label className=\"block text-xs mb-1\" style={{ color: 'var(--text-muted)' }}>模型名称</label>\n881\t          <input\n882\t            type=\"text\"\n883\t            value={config.embedding.model}\n884\t            onChange={e => setConfig(prev => ({ ...prev, embedding: { ...prev.embedding, model: e.target.value } }))}\n885\t            placeholder={config.embedding.provider === 'local' ? 'BAAI/bge-m3' : config.embedding.provider === 'siliconflow' ? 'BAAI/bge-m3' : 'text-embedding-3-small'}\n886\t            className=\"w-full px-3 py-2 text-sm rounded-lg focus:outline-none transition-colors\"\n887\t            style={{ backgroundColor: 'var(--bg-elevated)', borderColor: 'var(--border-light)', color: 'var(--text-primary)' }}\n888\t          />\n889\t        </div>\n890\t\n891\t        {/* OpenAI / SiliconFlow 专用配置 */}\n892\t        {(config.embedding.provider === 'openai' || config.embedding.provider === 'siliconflow') && (\n893\t          <>\n894\t            <div>\n895\t              <label className=\"block text-xs mb-1\" style={{ color: 'var(--text-muted)' }}>API Base URL</label>\n896\t              <input\n897\t                type=\"text\"\n898\t                value={config.embedding.base_url}\n899\t                onChange={e => setConfig(prev => ({ ...prev, embedding: { ...prev.embedding, base_url: e.target.value } }))}\n900\t                className=\"w-full px-3 py-2 text-sm rounded-lg focus:outline-none transition-colors\"\n901\t                style={{ backgroundColor: 'var(--bg-elevated)', borderColor: 'var(--border-light)', color: 'var(--text-primary)' }}\n902\t              />\n903\t            </div>\n904\t            <div>\n905\t              <label className=\"block text-xs mb-1\" style={{ color: 'var(--text-muted)' }}>API Key</label>\n906\t              <input\n907\t                type=\"password\"\n908\t                value={config.embedding.api_key}\n909\t                onChange={e => setConfig(prev => ({ ...prev, embedding: { ...prev.embedding, api_key: e.target.value } }))}\n910\t                placeholder=\"sk-...\"\n911\t                className=\"w-full px-3 py-2 text-sm rounded-lg focus:outline-none transition-colors font-mono\"\n912\t                style={{ backgroundColor: 'var(--bg-elevated)', borderColor: 'var(--border-light)', color: 'var(--text-primary)' }}\n913\t              />\n914\t            </div>\n915\t          </>\n916\t        )}\n917\t\n918\t        {config.embedding.provider === 'local' && (\n919\t          <p className=\"text-[10px]\" style={{ color: 'var(--text-muted)' }}>\n920\t            本地模式使用 sentence-transformers 加载模型，首次运行会自动下载。切换 provider 后建议重建索引以避免向量维度不匹配。\n921\t          </p>\n922\t        )}\n923\t      </div>\n924\t\n925\t      {/* 深度研究 Provider */}\n926\t      <div\n927\t        className=\"rounded-xl border p-5 space-y-4\"\n928\t        style={{ backgroundColor: 'var(--bg-surface)', borderColor: 'var(--border)' }}\n929\t      >\n930\t        <div>\n931\t          <h2 className=\"text-base font-semibold\" style={{ color: 'var(--text-primary)' }}>深度研究 — 论文扩展源</h2>\n932\t          <p className=\"text-xs mt-0.5\" style={{ color: 'var(--text-muted)' }}>\n933\t            决定\"联网扩展\"阶段从哪里抓取参考文献。本地模式表示不联网，只用工作区内已上传的论文构建图谱。\n934\t          </p>\n935\t        </div>\n936\t\n937\t        <div>\n938\t          <label className=\"block text-xs mb-2\" style={{ color: 'var(--text-muted)' }}>Provider</label>\n939\t          <div className=\"flex gap-2 flex-wrap\">\n940\t            {([\n941\t              { key: 'openalex' as const, label: 'OpenAlex（推荐）' },\n942\t              { key: 'semantic_scholar' as const, label: 'Semantic Scholar' },\n943\t              { key: 'local' as const, label: '本地（不联网）' },\n944\t            ]).map(p => (\n945\t              <button\n946\t                key={p.key}\n947\t                onClick={() => setConfig(prev => ({\n948\t                  ...prev,\n949\t                  research: { ...prev.research, provider: p.key },\n950\t                }))}\n951\t                className=\"px-3 py-1.5 text-xs rounded-lg border transition-colors\"\n952\t                style={\n953\t                  config.research.provider === p.key\n954\t                    ? { borderColor: 'var(--accent)', backgroundColor: 'var(--accent-subtle)', color: 'var(--accent)' }\n955\t                    : { borderColor: 'var(--border-light)', color: 'var(--text-secondary)' }\n956\t                }\n957\t              >\n958\t                {p.label}\n959\t              </button>\n960\t            ))}\n961\t          </div>\n962\t        </div>\n963\t\n964\t        {config.research.provider === 'openalex' && (\n965\t          <>\n966\t            <div>\n967\t              <label className=\"block text-xs mb-1\" style={{ color: 'var(--text-muted)' }}>\n968\t                邮箱（可选 · polite pool）\n969\t              </label>\n970\t              <input\n971\t                type=\"email\"\n972\t                value={config.research.email}\n973\t                onChange={e => setConfig(prev => ({\n974\t                  ...prev,\n975\t                  research: { ...prev.research, email: e.target.value },\n976\t                }))}\n977\t                placeholder=\"you@example.com\"\n978\t                className=\"w-full px-3 py-2 text-sm rounded-lg focus:outline-none transition-colors\"\n979\t                style={{ backgroundColor: 'var(--bg-elevated)', borderColor: 'var(--border-light)', color: 'var(--text-primary)' }}\n980\t              />\n981\t              <p className=\"text-[10px] mt-1\" style={{ color: 'var(--text-muted)' }}>\n982\t                填入邮箱可进入 OpenAlex polite pool，获得更稳定的速率配额。不填也能用。\n983\t              </p>\n984\t            </div>\n985\t          </>\n986\t        )}\n987\t\n988\t        {config.research.provider === 'semantic_scholar' && (\n989\t          <>\n990\t            <div>\n991\t              <label className=\"block text-xs mb-1\" style={{ color: 'var(--text-muted)' }}>\n992\t                API Key（强烈建议填写）\n993\t              </label>\n994\t              <input\n995\t                type=\"password\"\n996\t                value={config.research.api_key}\n997\t                onChange={e => setConfig(prev => ({\n998\t                  ...prev,\n999\t                  research: { ...prev.research, api_key: e.target.value },\n1000\t                }))}\n1001\t                placeholder=\"留空使用公共配额（容易 429）\"\n1002\t                className=\"w-full px-3 py-2 text-sm rounded-lg focus:outline-none transition-colors font-mono\"\n1003\t                style={{ backgroundColor: 'var(--bg-elevated)', borderColor: 'var(--border-light)', color: 'var(--text-primary)' }}\n1004\t              />\n1005\t              <p className=\"text-[10px] mt-1\" style={{ color: 'var(--text-muted)' }}>\n1006\t                申请地址：\n1007\t                <a\n1008\t                  href=\"https://www.semanticscholar.org/product/api\"\n1009\t                  target=\"_blank\"\n1010\t                  rel=\"noreferrer\"\n1011\t                  className=\"hover:underline ml-1\"\n1012\t                  style={{ color: 'var(--accent)' }}\n1013\t                >\n1014\t                  semanticscholar.org/product/api\n1015\t                </a>\n1016\t                （免费，约 1–2 天通过）\n1017\t              </p>\n1018\t            </div>\n1019\t          </>\n1020\t        )}\n1021\t\n1022\t        {config.research.provider === 'local' && (\n1023\t          <p className=\"text-[10px]\" style={{ color: 'var(--text-muted)' }}>\n1024\t            本地模式下，\"联网扩展\"阶段会被直接跳过；图谱仅基于工作区已上传的论文构建。\n1025\t          </p>\n1026\t        )}\n1027\t\n1028\t        {/* 相似度阈值 */}\n1029\t        <div className=\"pt-2 border-t\" style={{ borderColor: 'var(--border)' }}>\n1030\t          <div className=\"flex items-center justify-between mb-1\">\n1031\t            <div>\n1032\t              <span className=\"text-xs font-medium\" style={{ color: 'var(--text-secondary)' }}>默认相似度阈值</span>\n1033\t              <p className=\"text-[10px] mt-0.5\" style={{ color: 'var(--text-muted)' }}>\n1034\t                两篇论文向量余弦相似度超过此值时图谱连一条「相似」边。值越大边越少越精炼。可在每次开始研究时临时调整。\n1035\t              </p>\n1036\t            </div>\n1037\t            <span className=\"text-xs font-mono ml-4 shrink-0\" style={{ color: 'var(--text-secondary)' }}>\n1038\t              {config.research.similarity_threshold.toFixed(2)}\n1039\t            </span>\n1040\t          </div>\n1041\t          <input\n1042\t            type=\"range\"\n1043\t            min={0.5}\n1044\t            max={0.95}\n1045\t            step={0.01}\n1046\t            value={config.research.similarity_threshold}\n1047\t            onChange={e => setConfig(prev => ({\n1048\t              ...prev,\n1049\t              research: { ...prev.research, similarity_threshold: Number(e.target.value) },\n1050\t            }))}\n1051\t            className=\"w-full h-1 accent-blue-500\"\n1052\t          />\n1053\t          <div className=\"flex justify-between text-[10px] mt-0.5\" style={{ color: 'var(--text-muted)' }}>\n1054\t            <span>0.50 宽松</span>\n1055\t            <span>0.95 严格</span>\n1056\t          </div>\n1057\t        </div>\n1058\t      </div>\n1059\t\n1060\t      {/* 重排序模型 */}\n1061\t      <div\n1062\t        className=\"rounded-xl border p-5 space-y-4\"\n1063\t        style={{ backgroundColor: 'var(--bg-surface)', borderColor: 'var(--border)' }}\n1064\t      >\n1065\t        <div className=\"flex items-center justify-between\">\n1066\t          <div>\n1067\t            <h2 className=\"text-base font-semibold\" style={{ color: 'var(--text-primary)' }}>重排序模型（Reranker）</h2>\n1068\t            <p className=\"text-xs mt-0.5\" style={{ color: 'var(--text-muted)' }}>\n1069\t              在 RAG 跨论文问答时使用。向量检索召回 candidate_k 条候选，再由重排序模型按语义重排，最终取 top_n 喂给 LLM。提升答非所问的概率。\n1070\t            </p>\n1071\t          </div>\n1072\t          <label className=\"flex items-center gap-2 text-xs cursor-pointer\" style={{ color: 'var(--text-secondary)' }}>\n1073\t            <input\n1074\t              type=\"checkbox\"\n1075\t              checked={config.reranker.enabled}\n1076\t              onChange={e => setConfig(prev => ({ ...prev, reranker: { ...prev.reranker, enabled: e.target.checked } }))}\n1077\t              className=\"accent-blue-500\"\n1078\t            />\n1079\t            启用\n1080\t          </label>\n1081\t        </div>\n1082\t\n1083\t        {config.reranker.enabled && (\n1084\t          <>\n1085\t            <div>\n1086\t              <label className=\"block text-xs mb-1\" style={{ color: 'var(--text-muted)' }}>模型</label>\n1087\t              <input\n1088\t                type=\"text\"\n1089\t                value={config.reranker.model}\n1090\t                onChange={e => setConfig(prev => ({ ...prev, reranker: { ...prev.reranker, model: e.target.value } }))}\n1091\t                placeholder=\"BAAI/bge-reranker-v2-m3\"\n1092\t                className=\"w-full px-3 py-2 text-sm rounded-lg focus:outline-none transition-colors\"\n1093\t                style={{ backgroundColor: 'var(--bg-elevated)', borderColor: 'var(--border-light)', color: 'var(--text-primary)' }}\n1094\t              />\n1095\t              <p className=\"text-[10px] mt-1\" style={{ color: 'var(--text-muted)' }}>默认 BAAI/bge-reranker-v2-m3（硅基流动）</p>\n1096\t            </div>\n1097\t\n1098\t            <div className=\"grid grid-cols-2 gap-3\">\n1099\t              <div>\n1100\t                <label className=\"block text-xs mb-1\" style={{ color: 'var(--text-muted)' }}>API Base URL</label>\n1101\t                <input\n1102\t                  type=\"text\"\n1103\t                  value={config.reranker.base_url}\n1104\t                  onChange={e => setConfig(prev => ({ ...prev, reranker: { ...prev.reranker, base_url: e.target.value } }))}\n1105\t                  placeholder=\"留空 = 继承 embedding 的 base_url\"\n1106\t                  className=\"w-full px-3 py-2 text-sm rounded-lg focus:outline-none transition-colors\"\n1107\t                  style={{ backgroundColor: 'var(--bg-elevated)', borderColor: 'var(--border-light)', color: 'var(--text-primary)' }}\n1108\t                />\n1109\t              </div>\n1110\t              <div>\n1111\t                <label className=\"block text-xs mb-1\" style={{ color: 'var(--text-muted)' }}>API Key</label>\n1112\t                <input\n1113\t                  type=\"password\"\n1114\t                  value={config.reranker.api_key}\n1115\t                  onChange={e => setConfig(prev => ({ ...prev, reranker: { ...prev.reranker, api_key: e.target.value } }))}\n1116\t                  placeholder=\"留空 = 继承 embedding 的 api_key\"\n1117\t                  className=\"w-full px-3 py-2 text-sm rounded-lg focus:outline-none transition-colors font-mono\"\n1118\t                  style={{ backgroundColor: 'var(--bg-elevated)', borderColor: 'var(--border-light)', color: 'var(--text-primary)' }}\n1119\t                />\n1120\t              </div>\n1121\t            </div>\n1122\t\n1123\t            <div className=\"grid grid-cols-2 gap-3\">\n1124\t              <div>\n1125\t                <label className=\"block text-xs mb-1\" style={{ color: 'var(--text-muted)' }}>candidate_k（召回数）</label>\n1126\t                <input\n1127\t                  type=\"number\"\n1128\t                  min={5}\n1129\t                  max={200}\n1130\t                  value={config.reranker.candidate_k}\n1131\t                  onChange={e => setConfig(prev => ({ ...prev, reranker: { ...prev.reranker, candidate_k: Number(e.target.value) || 30 } }))}\n1132\t                  className=\"w-full px-3 py-2 text-sm rounded-lg focus:outline-none transition-colors\"\n1133\t                  style={{ backgroundColor: 'var(--bg-elevated)', borderColor: 'var(--border-light)', color: 'var(--text-primary)' }}\n1134\t                />\n1135\t                <p className=\"text-[10px] mt-1\" style={{ color: 'var(--text-muted)' }}>向量检索的初筛数量，越大重排越充分但越慢</p>\n1136\t              </div>\n1137\t              <div>\n1138\t                <label className=\"block text-xs mb-1\" style={{ color: 'var(--text-muted)' }}>top_n（送 LLM）</label>\n1139\t                <input\n1140\t                  type=\"number\"\n1141\t                  min={1}\n1142\t                  max={20}\n1143\t                  value={config.reranker.top_n}\n1144\t                  onChange={e => setConfig(prev => ({ ...prev, reranker: { ...prev.reranker, top_n: Number(e.target.value) || 5 } }))}\n1145\t                  className=\"w-full px-3 py-2 text-sm rounded-lg focus:outline-none transition-colors\"\n1146\t                  style={{ backgroundColor: 'var(--bg-elevated)', borderColor: 'var(--border-light)', color: 'var(--text-primary)' }}\n1147\t                />\n1148\t                <p className=\"text-[10px] mt-1\" style={{ color: 'var(--text-muted)' }}>重排序后保留的最终 chunk 数</p>\n1149\t              </div>\n1150\t            </div>\n1151\t          </>\n1152\t        )}\n1153\t      </div>\n1154\t\n1155\t      {/* 论文级相似度 Provider */}\n1156\t      <div\n1157\t        className=\"rounded-xl border p-5 space-y-4\"\n1158\t        style={{ backgroundColor: 'var(--bg-surface)', borderColor: 'var(--border)' }}\n1159\t      >\n1160\t        <div>\n1161\t          <h2 className=\"text-base font-semibold\" style={{ color: 'var(--text-primary)' }}>论文级相似度计算（Similarity Provider）</h2>\n1162\t          <p className=\"text-xs mt-0.5\" style={{ color: 'var(--text-muted)' }}>\n1163\t            深度研究知识图谱中\"相似\"边的计算方式。可插拔接口，可在 <code className=\"px-1 rounded\" style={{ backgroundColor: 'var(--bg-elevated)' }}>backend/services/deep_research/similarity/</code> 自行新增 provider 并在 REGISTRY 注册。\n1164\t          </p>\n1165\t        </div>\n1166\t\n1167\t        <div>\n1168\t          <label className=\"block text-xs mb-1\" style={{ color: 'var(--text-muted)' }}>Provider</label>\n1169\t          <select\n1170\t            value={config.similarity.provider}\n1171\t            onChange={e => setConfig(prev => ({ ...prev, similarity: { ...prev.similarity, provider: e.target.value } }))}\n1172\t            className=\"w-full px-3 py-2 text-sm rounded-lg focus:outline-none transition-colors\"\n1173\t            style={{ backgroundColor: 'var(--bg-elevated)', borderColor: 'var(--border-light)', color: 'var(--text-primary)' }}\n1174\t          >\n1175\t            {simProviders.map(p => (\n1176\t              <option key={p} value={p}>{p}</option>\n1177\t            ))}\n1178\t          </select>\n1179\t          <p className=\"text-[10px] mt-1\" style={{ color: 'var(--text-muted)' }}>\n1180\t            当前默认 <code className=\"px-1 rounded\" style={{ backgroundColor: 'var(--bg-elevated)' }}>bge_centroid</code>：复用 BGE chunk 向量取归一化均值后算余弦。\n1181\t            适合粗略相似度；细分方向区分有限。\n1182\t          </p>\n1183\t          <div\n1184\t            className=\"mt-3 px-3 py-2 rounded-lg border\"\n1185\t            style={{ backgroundColor: 'var(--bg-elevated)', borderColor: 'var(--border)', opacity: 0.5 }}\n1186\t          >\n1187\t            <p className=\"text-[11px] leading-relaxed\" style={{ color: 'var(--text-secondary)' }}>\n1188\t              <span className=\"font-medium\" style={{ color: 'var(--text-secondary)' }}>未来可扩展（已在 base.py 列出 TODO）：</span><br />\n1189\t              ·  <span style={{ color: 'var(--text-secondary)' }}>specter2 / scincl</span> —— 科研论文专用 embedding，用引用对训练，区分研究主题更准<br />\n1190\t              ·  <span style={{ color: 'var(--text-secondary)' }}>bibcoupling</span> —— 两篇论文共享引用的 Jaccard，捕获\"被同一领域引用\"<br />\n1191\t              ·  <span style={{ color: 'var(--text-secondary)' }}>hybrid</span> —— 多信号融合<br />\n1192\t              ·  <span style={{ color: 'var(--text-secondary)' }}>cross_encoder</span> —— 复用 BAAI/bge-reranker-v2-m3 当 cross-encoder\n1193\t            </p>\n1194\t          </div>\n1195\t        </div>\n1196\t      </div>\n1197\t\n1198\t      {/* arXiv 引用列表扩展 */}\n1199\t      <div\n1200\t        className=\"rounded-xl border p-5 space-y-4\"\n1201\t        style={{ backgroundColor: 'var(--bg-surface)', borderColor: 'var(--border)' }}\n1202\t      >\n1203\t        <div className=\"flex items-center justify-between\">\n1204\t          <div>\n1205\t            <h2 className=\"text-base font-semibold\" style={{ color: 'var(--text-primary)' }}>arXiv 引用列表扩展</h2>\n1206\t            <p className=\"text-xs mt-0.5\" style={{ color: 'var(--text-muted)' }}>\n1207\t              联网模式下，从 L1 论文 PDF 文本解析 <code className=\"px-1 rounded\" style={{ backgroundColor: 'var(--bg-elevated)' }}>[N]</code> 引用块，\n1208\t              提取 arXiv ID（正则优先，可选 LLM 兜底），从 arXiv 下载 PDF。\n1209\t              与 OpenAlex/S2 扩展互补。\n1210\t            </p>\n1211\t          </div>\n1212\t          <label className=\"flex items-center gap-2 text-xs cursor-pointer shrink-0 ml-4\" style={{ color: 'var(--text-secondary)' }}>\n1213\t            <input\n1214\t              type=\"checkbox\"\n1215\t              checked={config.arxiv_expand.enabled}\n1216\t              onChange={e => setConfig(prev => ({ ...prev, arxiv_expand: { ...prev.arxiv_expand, enabled: e.target.checked } }))}\n1217\t              className=\"accent-blue-500\"\n1218\t            />\n1219\t            启用\n1220\t          </label>\n1221\t        </div>\n1222\t\n1223\t        {config.arxiv_expand.enabled && (\n1224\t          <>\n1225\t            <GrobidPanel\n1226\t              parser={config.arxiv_expand.parser}\n1227\t              grobidUrl={config.arxiv_expand.grobid_url}\n1228\t              onChangeParser={p => setConfig(prev => ({ ...prev, arxiv_expand: { ...prev.arxiv_expand, parser: p } }))}\n1229\t              onChangeUrl={u => setConfig(prev => ({ ...prev, arxiv_expand: { ...prev.arxiv_expand, grobid_url: u } }))}\n1230\t            />\n1231\t\n1232\t            <div className=\"grid grid-cols-2 gap-3\">\n1233\t              <div>\n1234\t                <label className=\"block text-xs mb-1\" style={{ color: 'var(--text-muted)' }}>Top-K（按引用数取前 K 篇）</label>\n1235\t                <input\n1236\t                  type=\"number\"\n1237\t                  min={1}\n1238\t                  max={50}\n1239\t                  value={config.arxiv_expand.top_k}\n1240\t                  onChange={e => setConfig(prev => ({ ...prev, arxiv_expand: { ...prev.arxiv_expand, top_k: Number(e.target.value) || 5 } }))}\n1241\t                  className=\"w-full px-3 py-2 text-sm rounded-lg focus:outline-none transition-colors\"\n1242\t                  style={{ backgroundColor: 'var(--bg-elevated)', borderColor: 'var(--border-light)', color: 'var(--text-primary)' }}\n1243\t                />\n1244\t                <p className=\"text-[10px] mt-1\" style={{ color: 'var(--text-muted)' }}>从候选论文中取前 K 篇（引用列表越靠前越重要）</p>\n1245\t              </div>\n1246\t            </div>\n1247\t\n1248\t            <div className=\"flex items-start gap-4\">\n1249\t              <label className=\"flex items-center gap-2 text-xs cursor-pointer\" style={{ color: 'var(--text-secondary)' }}>\n1250\t                <input\n1251\t                  type=\"checkbox\"\n1252\t                  checked={config.arxiv_expand.use_llm_title}\n1253\t                  onChange={e => setConfig(prev => ({ ...prev, arxiv_expand: { ...prev.arxiv_expand, use_llm_title: e.target.checked } }))}\n1254\t                  className=\"accent-blue-500\"\n1255\t                />\n1256\t                LLM 标题兜底\n1257\t              </label>\n1258\t              {config.arxiv_expand.use_llm_title && (\n1259\t                <div className=\"flex-1\">\n1260\t                  <label className=\"block text-xs mb-1\" style={{ color: 'var(--text-muted)' }}>\n1261\t                    每篇 seed 最多 LLM+arXiv 搜索次数\n1262\t                  </label>\n1263\t                  <input\n1264\t                    type=\"number\"\n1265\t                    min={0}\n1266\t                    max={50}\n1267\t                    value={config.arxiv_expand.max_llm_refs}\n1268\t                    onChange={e => setConfig(prev => ({ ...prev, arxiv_expand: { ...prev.arxiv_expand, max_llm_refs: Number(e.target.value) || 15 } }))}\n1269\t                    className=\"w-48 px-3 py-2 text-sm rounded-lg focus:outline-none transition-colors\"\n1270\t                    style={{ backgroundColor: 'var(--bg-elevated)', borderColor: 'var(--border-light)', color: 'var(--text-primary)' }}\n1271\t                  />\n1272\t                  <p className=\"text-[10px] mt-1\" style={{ color: 'var(--text-muted)' }}>\n1273\t                    对无 arXiv ID 的引用，调用解读模型提取标题再搜索（消耗 Token）。\n1274\t                    每次 arXiv 搜索间隔 3 秒，过多会显著增加运行时间。\n1275\t                  </p>\n1276\t                </div>\n1277\t              )}\n1278\t            </div>\n1279\t          </>\n1280\t        )}\n1281\t      </div>\n1282\t\n1283\t      {/* findpapers 多源学术搜索 */}\n1284\t      <div\n1285\t        className=\"rounded-xl border p-5 space-y-4\"\n1286\t        style={{ backgroundColor: 'var(--bg-surface)', borderColor: 'var(--border)' }}\n1287\t      >\n1288\t        <div className=\"flex items-center justify-between\">\n1289\t          <div>\n1290\t            <h2 className=\"text-base font-semibold\" style={{ color: 'var(--text-primary)' }}>findpapers 多源搜索</h2>\n1291\t            <p className=\"text-xs mt-0.5\" style={{ color: 'var(--text-muted)' }}>\n1292\t              启用后使用 findpapers 库（arXiv、CrossRef、OpenAlex、PubMed 等 8 源并行搜索 + 自动去重）\n1293\t              替代 Semantic Scholar 进行相关论文推荐和 PDF 下载。\n1294\t              需要 <code className=\"px-1 rounded\" style={{ backgroundColor: 'var(--bg-elevated)' }}>pip install findpapers</code>。\n1295\t            </p>\n1296\t          </div>\n1297\t          <label className=\"flex items-center gap-2 text-xs cursor-pointer shrink-0 ml-4\" style={{ color: 'var(--text-secondary)' }}>\n1298\t            <input\n1299\t              type=\"checkbox\"\n1300\t              checked={config.findpapers.enabled}\n1301\t              onChange={e => setConfig(prev => ({ ...prev, findpapers: { ...prev.findpapers, enabled: e.target.checked } }))}\n1302\t              className=\"accent-blue-500\"\n1303\t            />\n1304\t            启用\n1305\t          </label>\n1306\t        </div>\n1307\t\n1308\t        {config.findpapers.enabled && (\n1309\t          <>\n1310\t            <div>\n1311\t              <label className=\"block text-xs mb-2\" style={{ color: 'var(--text-muted)' }}>启用的数据库</label>\n1312\t              <div className=\"flex flex-wrap gap-2\">\n1313\t                {[\n1314\t                  { key: 'arxiv', label: 'arXiv', free: true },\n1315\t                  { key: 'openalex', label: 'OpenAlex', free: true },\n1316\t                  { key: 'pubmed', label: 'PubMed', free: true },\n1317\t                  { key: 'semantic_scholar', label: 'Semantic Scholar', free: true },\n1318\t                  { key: 'ieee', label: 'IEEE Xplore', free: false },\n1319\t                  { key: 'scopus', label: 'Scopus', free: false },\n1320\t                  { key: 'wos', label: 'Web of Science', free: false },\n1321\t                ].map(db => (\n1322\t                  <label key={db.key} className=\"flex items-center gap-1.5 text-xs cursor-pointer\" style={{ color: 'var(--text-secondary)' }}>\n1323\t                    <input\n1324\t                      type=\"checkbox\"\n1325\t                      checked={config.findpapers.databases.includes(db.key)}\n1326\t                      onChange={e => {\n1327\t                        const dbs = e.target.checked\n1328\t                          ? [...config.findpapers.databases, db.key]\n1329\t                          : config.findpapers.databases.filter(d => d !== db.key)\n1330\t                        setConfig(prev => ({ ...prev, findpapers: { ...prev.findpapers, databases: dbs } }))\n1331\t                      }}\n1332\t                      className=\"accent-blue-500\"\n1333\t                    />\n1334\t                    {db.label}\n1335\t                    {!db.free && <span className=\"text-[10px]\" style={{ color: 'var(--warning)' }}>(需 key)</span>}\n1336\t                  </label>\n1337\t                ))}\n1338\t              </div>\n1339\t            </div>\n1340\t\n1341\t            <div className=\"grid grid-cols-2 gap-3\">\n1342\t              <div>\n1343\t                <label className=\"block text-xs mb-1\" style={{ color: 'var(--text-muted)' }}>搜索结果数量上限</label>\n1344\t                <input\n1345\t                  type=\"number\"\n1346\t                  min={1}\n1347\t                  max={50}\n1348\t                  value={config.findpapers.max_results}\n1349\t                  onChange={e => setConfig(prev => ({ ...prev, findpapers: { ...prev.findpapers, max_results: Number(e.target.value) || 10 } }))}\n1350\t                  className=\"w-full px-3 py-2 text-sm rounded-lg focus:outline-none transition-colors\"\n1351\t                  style={{ backgroundColor: 'var(--bg-elevated)', borderColor: 'var(--border-light)', color: 'var(--text-primary)' }}\n1352\t                />\n1353\t              </div>\n1354\t            </div>\n1355\t          </>\n1356\t        )}\n1357\t      </div>\n1358\t\n1359\t      <div className=\"flex items-center gap-3 pt-2\">\n1360\t        <button\n1361\t          onClick={handleSave}\n1362\t          disabled={saving}\n1363\t          className=\"px-5 py-2 text-sm font-medium rounded-lg disabled:opacity-50 transition-colors\"\n1364\t          style={{ backgroundColor: 'var(--accent)', color: 'var(--bg-base)' }}\n1365\t        >\n1366\t          {saving ? '保存中...' : '保存配置'}\n1367\t        </button>\n1368\t        {saved && (\n1369\t          <span className=\"text-sm\" style={{ color: 'var(--success)' }}>已保存</span>\n1370\t        )}\n1371\t      </div>\n1372\t    </div>\n1373\t  )\n1374\t}\n1375\t"}]},"parent_tool_use_id":"call_bddd82a75f2e46b98e4517cc","session_id":"29257b8f-ede7-46a4-8e0f-a743591d296a","uuid":"c9835b9b-b141-4c91-a782-6961ac69038b","timestamp":"2026-06-09T05:10:20.930Z","subagent_type":"Explore","task_description":"Explore frontend performance"}
{"type":"system","subtype":"task_progress","task_id":"aeb539a7a28be405a","tool_use_id":"call_bddd82a75f2e46b98e4517cc","description":"Reading frontend/src/pages/ResearchPage.tsx","subagent_type":"Explore","usage":{"total_tokens":0,"tool_uses":11,"duration_ms":13342},"last_tool_name":"Read","uuid":"a8965efe-5e9b-47dc-8fd0-8b94c3bdd301","session_id":"29257b8f-ede7-46a4-8e0f-a743591d296a"}
{"type":"assistant","message":{"id":"msg_cd7dc46b7e634118873bba74","type":"message","role":"assistant","model":"mimo-v2.5","content":[{"type":"tool_use","id":"call_58aac2821d554c3abd8af22a","name":"Read","input":{"file_path":"/Users/katisarrow/essay_read/frontend/src/pages/ResearchPage.tsx"}}],"usage":{"input_tokens":0,"output_tokens":0},"context_management":null},"parent_tool_use_id":"call_bddd82a75f2e46b98e4517cc","session_id":"29257b8f-ede7-46a4-8e0f-a743591d296a","uuid":"3691ce60-67fd-4793-889c-f222619ed97e","subagent_type":"Explore","task_description":"Explore frontend performance"}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call_58aac2821d554c3abd8af22a","type":"tool_result","content":"1\timport { useState, useEffect } from 'react'\n2\timport { useParams } from 'react-router-dom'\n3\timport type { ResearchRunCreate, ResearchGraph, GraphNode, GraphEdgeKind } from '@/types'\n4\timport { ConfirmDialog } from '@/components/ConfirmDialog'\n5\timport { createRun, getGraph, getLatestRun, clearResearch } from '@/api/research'\n6\timport { useResearchStream } from '@/hooks/useResearchStream'\n7\timport { ControlPanel } from '@/features/research/ControlPanel'\n8\timport { ProgressPanel } from '@/features/research/ProgressPanel'\n9\timport { GraphCanvas, type SelectedEdge } from '@/features/research/GraphCanvas'\n10\timport { NodeDetail } from '@/features/research/NodeDetail'\n11\timport { EdgeDetail } from '@/features/research/EdgeDetail'\n12\timport { ResearchSettingsDrawer } from '@/features/research/ResearchSettingsDrawer'\n13\timport { EdgeFilter } from '@/features/research/EdgeFilter'\n14\timport { RagQueryBox } from '@/features/research/RagQueryBox'\n15\timport { toast } from '@/hooks/useToast'\n16\t\n17\texport default function ResearchPage() {\n18\t  const { id } = useParams<{ id: string }>()\n19\t  const wsId = Number(id)\n20\t  const [runId, setRunId] = useState<number | null>(null)\n21\t  const [graph, setGraph] = useState<ResearchGraph | null>(null)\n22\t  const [selectedNode, setSelectedNode] = useState<GraphNode | null>(null)\n23\t  const [selectedEdge, setSelectedEdge] = useState<SelectedEdge | null>(null)\n24\t  const [edgeFilter, setEdgeFilter] = useState<Set<GraphEdgeKind>>(new Set(['cites', 'similar', 'shared-method']))\n25\t  const [linkDistance, setLinkDistance] = useState(50)\n26\t  const [showSettings, setShowSettings] = useState(false)\n27\t  const [graphLoading, setGraphLoading] = useState(true)\n28\t  const [showClearConfirm, setShowClearConfirm] = useState(false)\n29\t  const stream = useResearchStream(runId)\n30\t\n31\t  // Leave confirmation when research is running\n32\t  useEffect(() => {\n33\t    if (stream.status !== 'running') return\n34\t    const handler = (e: BeforeUnloadEvent) => {\n35\t      e.preventDefault()\n36\t      e.returnValue = ''\n37\t    }\n38\t    window.addEventListener('beforeunload', handler)\n39\t    return () => window.removeEventListener('beforeunload', handler)\n40\t  }, [stream.status])\n41\t\n42\t  // 1) 初始加载历史：图谱 + 最近 run\n43\t  useEffect(() => {\n44\t    getGraph(wsId).then(setGraph).catch(() => { toast({ type: 'error', message: '加载图谱失败' }) }).finally(() => setGraphLoading(false))\n45\t    getLatestRun(wsId).then(r => {\n46\t      if (r && r.status === 'running') setRunId(r.id)\n47\t    }).catch(() => { toast({ type: 'error', message: '加载研究记录失败' }) })\n48\t  }, [wsId])\n49\t\n50\t  // 2) stream.graph 覆盖历史\n51\t  useEffect(() => {\n52\t    if (stream.graph) {\n53\t      setGraph({\n54\t        workspace_id: wsId,\n55\t        run_id: runId!,\n56\t        nodes: stream.graph.nodes,\n57\t        edges: stream.graph.edges,\n58\t        stats: stream.graph.stats as ResearchGraph['stats'],\n59\t        updated_at: new Date().toISOString(),\n60\t      })\n61\t    }\n62\t  }, [stream.graph, wsId, runId])\n63\t\n64\t  const onStart = async (body: ResearchRunCreate) => {\n65\t    try {\n66\t      const run = await createRun(wsId, body)\n67\t      setRunId(run.id)\n68\t    } catch (e: any) {\n69\t      toast({ type: 'error', message: e.message || '启动失败' })\n70\t    }\n71\t  }\n72\t\n73\t  const onClear = () => {\n74\t    setShowClearConfirm(true)\n75\t  }\n76\t\n77\t  const confirmClear = async () => {\n78\t    setShowClearConfirm(false)\n79\t    try {\n80\t      await clearResearch(wsId)\n81\t      setGraph(null)\n82\t      setRunId(null)\n83\t    } catch (e: any) {\n84\t      toast({ type: 'error', message: e.message || '清空失败' })\n85\t    }\n86\t  }\n87\t\n88\t  return (\n89\t    <div className=\"flex flex-col h-full\">\n90\t      <ControlPanel\n91\t        wsId={wsId}\n92\t        onStart={onStart}\n93\t        onClear={onClear}\n94\t        disabled={stream.status === 'running'}\n95\t        linkDistance={linkDistance}\n96\t        onLinkDistanceChange={setLinkDistance}\n97\t      />\n98\t\n99\t      {(stream.status === 'running' || stream.status === 'failed') && (\n100\t        <ProgressPanel\n101\t          stage={stream.stage}\n102\t          progressMessage={stream.progressMessage}\n103\t          embed={stream.embed}\n104\t          papersAdded={stream.papersAdded}\n105\t          error={stream.error}\n106\t        />\n107\t      )}\n108\t\n109\t      {/* 边类型过滤 + 图谱 + RAG */}\n110\t      <div className=\"flex-1 flex flex-col md:flex-row gap-4 p-4 overflow-hidden\">\n111\t        <div className=\"flex-1 flex flex-col gap-2 min-w-0\">\n112\t          <div className=\"flex items-center justify-between\">\n113\t            <EdgeFilter selected={edgeFilter} onChange={setEdgeFilter} />\n114\t            <div className=\"flex items-center gap-3\">\n115\t              {graph && (\n116\t                <span className=\"text-[10px]\" style={{ color: 'var(--text-muted)' }}>\n117\t                  {graph.stats?.node_count ?? graph.nodes.length} 节点 / {graph.stats?.edge_count ?? graph.edges.length} 边\n118\t                </span>\n119\t              )}\n120\t              <button\n121\t                onClick={() => setShowSettings(true)}\n122\t                className=\"text-[11px] px-2 py-1 rounded-md border transition-colors\"\n123\t                style={{ borderColor: 'var(--border)', color: 'var(--text-secondary)' }}\n124\t              >\n125\t                研究设置\n126\t              </button>\n127\t            </div>\n128\t          </div>\n129\t          {graphLoading ? (\n130\t            <div className=\"flex-1 flex items-center justify-center\">\n131\t              <div className=\"w-8 h-8 border-2 rounded-full animate-spin\" style={{ borderColor: 'var(--border)', borderTopColor: 'var(--accent)' }} />\n132\t            </div>\n133\t          ) : (\n134\t            <GraphCanvas\n135\t              graph={graph}\n136\t              edgeFilter={edgeFilter}\n137\t              onSelectNode={(n) => { setSelectedNode(n); if (n) setSelectedEdge(null) }}\n138\t              onSelectEdge={(e) => { setSelectedEdge(e); if (e) setSelectedNode(null) }}\n139\t              linkDistance={linkDistance}\n140\t            />\n141\t          )}\n142\t        </div>\n143\t        <RagQueryBox wsId={wsId} />\n144\t      </div>\n145\t\n146\t      {/* 节点详情抽屉 */}\n147\t      <NodeDetail node={selectedNode} onClose={() => setSelectedNode(null)} />\n148\t\n149\t      {/* 相似边详情抽屉 */}\n150\t      <EdgeDetail edge={selectedEdge} onClose={() => setSelectedEdge(null)} />\n151\t\n152\t      {/* 研究设置抽屉（与设置页共用 DeepResearchSettings） */}\n153\t      <ResearchSettingsDrawer open={showSettings} onClose={() => setShowSettings(false)} />\n154\t\n155\t      <ConfirmDialog\n156\t        open={showClearConfirm}\n157\t        title=\"确认清空\"\n158\t        message=\"确定清空该工作区的图谱和向量索引？这不会删除论文文件。\"\n159\t        variant=\"warning\"\n160\t        confirmLabel=\"清空\"\n161\t        onConfirm={confirmClear}\n162\t        onCancel={() => setShowClearConfirm(false)}\n163\t      />\n164\t    </div>\n165\t  )\n166\t}\n167\t"}]},"parent_tool_use_id":"call_bddd82a75f2e46b98e4517cc","session_id":"29257b8f-ede7-46a4-8e0f-a743591d296a","uuid":"0fe6396f-a4c3-41b3-9c28-ce77c7f48736","timestamp":"2026-06-09T05:10:20.971Z","subagent_type":"Explore","task_description":"Explore frontend performance"}
{"type":"system","subtype":"task_progress","task_id":"aeb539a7a28be405a","tool_use_id":"call_bddd82a75f2e46b98e4517cc","description":"Reading frontend/src/pages/WorkspacePage.tsx","subagent_type":"Explore","usage":{"total_tokens":0,"tool_uses":12,"duration_ms":13731},"last_tool_name":"Read","uuid":"821d47a6-5ce5-499e-9ae6-08440f143c48","session_id":"29257b8f-ede7-46a4-8e0f-a743591d296a"}
{"type":"assistant","message":{"id":"msg_cd7dc46b7e634118873bba74","type":"message","role":"assistant","model":"mimo-v2.5","content":[{"type":"tool_use","id":"call_edf446d48ead4559b0488ba1","name":"Read","input":{"file_path":"/Users/katisarrow/essay_read/frontend/src/pages/WorkspacePage.tsx"}}],"usage":{"input_tokens":0,"output_tokens":0},"context_management":null},"parent_tool_use_id":"call_bddd82a75f2e46b98e4517cc","session_id":"29257b8f-ede7-46a4-8e0f-a743591d296a","uuid":"d4a0f7e5-9f22-4b55-a9d5-8d1da4b36cc4","subagent_type":"Explore","task_description":"Explore frontend performance"}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call_edf446d48ead4559b0488ba1","type":"tool_result","content":"1\timport { useState, useEffect, useCallback } from 'react'\n2\timport { useNavigate } from 'react-router-dom'\n3\timport { listWorkspaces, createWorkspace, deleteWorkspace, type WorkspaceItem } from '@/api/workspaces'\n4\timport { toast } from '@/hooks/useToast'\n5\timport { ConfirmDialog } from '@/components/ConfirmDialog'\n6\t\n7\t\n8\texport default function WorkspacePage() {\n9\t  const navigate = useNavigate()\n10\t  const [workspaces, setWorkspaces] = useState<WorkspaceItem[]>([])\n11\t  const [loading, setLoading] = useState(true)\n12\t  const [creating, setCreating] = useState(false)\n13\t  const [newName, setNewName] = useState('')\n14\t  const [deleteTarget, setDeleteTarget] = useState<number | null>(null)\n15\t\n16\t  const refresh = useCallback(() => {\n17\t    listWorkspaces()\n18\t      .then(setWorkspaces)\n19\t      .catch((e: any) => { toast({ type: 'error', message: e?.message || '加载工作区列表失败' }) })\n20\t      .finally(() => setLoading(false))\n21\t  }, [])\n22\t\n23\t  useEffect(() => { refresh() }, [refresh])\n24\t\n25\t  const handleCreate = async () => {\n26\t    const name = newName.trim() || '未命名工作区'\n27\t    setCreating(true)\n28\t    try {\n29\t      const ws = await createWorkspace(name)\n30\t      setNewName('')\n31\t      navigate(`/workspace/${ws.id}`)\n32\t    } catch (e: any) {\n33\t      toast({ type: 'error', message: e?.message || '创建工作区失败' })\n34\t    } finally {\n35\t      setCreating(false)\n36\t    }\n37\t  }\n38\t\n39\t  const handleDelete = (id: number, e: React.MouseEvent) => {\n40\t    e.stopPropagation()\n41\t    setDeleteTarget(id)\n42\t  }\n43\t\n44\t  const confirmDelete = async () => {\n45\t    if (deleteTarget === null) return\n46\t    try {\n47\t      await deleteWorkspace(deleteTarget)\n48\t      refresh()\n49\t    } catch (e: any) {\n50\t      toast({ type: 'error', message: e?.message || '删除工作区失败' })\n51\t    } finally {\n52\t      setDeleteTarget(null)\n53\t    }\n54\t  }\n55\t\n56\t  if (loading) {\n57\t    return (\n58\t      <div className=\"flex items-center justify-center h-64\">\n59\t        <div className=\"w-6 h-6 border-2 rounded-full animate-spin\" style={{ borderColor: 'var(--border)', borderTopColor: 'var(--accent)' }} role=\"status\"><span className=\"sr-only\">加载中</span></div>\n60\t      </div>\n61\t    )\n62\t  }\n63\t\n64\t  return (\n65\t    <div className=\"max-w-3xl mx-auto px-6 py-8\">\n66\t      <div className=\"flex items-center justify-between mb-6\">\n67\t        <div>\n68\t          <h1 className=\"text-xl font-bold\" style={{ color: 'var(--text-primary)' }}>工作区</h1>\n69\t          <p className=\"text-sm mt-1\" style={{ color: 'var(--text-muted)' }}>管理工作区，将论文组织在一起进行分析</p>\n70\t        </div>\n71\t      </div>\n72\t\n73\t      {/* 新建工作区 */}\n74\t      <div className=\"flex items-center gap-2 mb-6\">\n75\t        <input\n76\t          type=\"text\"\n77\t          value={newName}\n78\t          onChange={e => setNewName(e.target.value)}\n79\t          onKeyDown={e => e.key === 'Enter' && handleCreate()}\n80\t          placeholder=\"输入工作区名称...\"\n81\t          className=\"flex-1 px-3 py-2 text-sm rounded-lg focus:outline-none\"\n82\t        />\n83\t        <button\n84\t          onClick={handleCreate}\n85\t          disabled={creating}\n86\t          className=\"px-4 py-2 text-sm font-medium rounded-lg disabled:opacity-50 transition-colors\"\n87\t          style={{ backgroundColor: 'var(--accent)', color: 'var(--bg-base)' }}\n88\t        >\n89\t          {creating ? '创建中...' : '新建工作区'}\n90\t        </button>\n91\t      </div>\n92\t\n93\t      {/* 工作区列表 */}\n94\t      {workspaces.length === 0 ? (\n95\t        <div className=\"text-center py-12\">\n96\t          <p style={{ color: 'var(--text-muted)' }}>暂无工作区</p>\n97\t          <p className=\"text-xs mt-1\" style={{ color: 'var(--text-muted)', opacity: 0.7 }}>创建一个工作区，开始组织你的论文</p>\n98\t        </div>\n99\t      ) : (\n100\t        <div className=\"space-y-2\">\n101\t          {workspaces.map(ws => (\n102\t            <div\n103\t              key={ws.id}\n104\t              role=\"button\"\n105\t              tabIndex={0}\n106\t              onClick={() => navigate(`/workspace/${ws.id}`)}\n107\t              onKeyDown={e => { if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); navigate(`/workspace/${ws.id}`) } }}\n108\t              className=\"rounded-xl p-4 cursor-pointer card-hover transition-all group\"\n109\t              style={{\n110\t                backgroundColor: 'var(--bg-surface)',\n111\t                border: '1px solid var(--border)',\n112\t              }}\n113\t            >\n114\t              <div className=\"flex items-center justify-between\">\n115\t                <div>\n116\t                  <h3 className=\"text-sm font-medium transition-colors\" style={{ color: 'var(--text-primary)' }}>\n117\t                    {ws.name}\n118\t                  </h3>\n119\t                  <p className=\"text-xs mt-1\" style={{ color: 'var(--text-muted)' }}>\n120\t                    {ws.paper_count} 篇论文\n121\t                  </p>\n122\t                </div>\n123\t                <button\n124\t                  onClick={(e) => handleDelete(ws.id, e)}\n125\t                  className=\"opacity-0 group-hover:opacity-100 px-2 py-1 text-xs transition-all\"\n126\t                  style={{ color: 'var(--text-muted)' }}\n127\t                >\n128\t                  删除\n129\t                </button>\n130\t              </div>\n131\t            </div>\n132\t          ))}\n133\t        </div>\n134\t      )}\n135\t      <ConfirmDialog\n136\t        open={deleteTarget !== null}\n137\t        title=\"确认删除\"\n138\t        message=\"确定删除此工作区？\"\n139\t        variant=\"danger\"\n140\t        onConfirm={confirmDelete}\n141\t        onCancel={() => setDeleteTarget(null)}\n142\t      />\n143\t    </div>\n144\t  )\n145\t}\n146\t"}]},"parent_tool_use_id":"call_bddd82a75f2e46b98e4517cc","session_id":"29257b8f-ede7-46a4-8e0f-a743591d296a","uuid":"d2bba13c-3492-438d-9d49-ce5d0731aa73","timestamp":"2026-06-09T05:10:21.360Z","subagent_type":"Explore","task_description":"Explore frontend performance"}
