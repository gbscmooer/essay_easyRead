{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call_b050c4599edf4dcb86db24d9","type":"tool_result","content":"1\t\"\"\"\n2\tResearch 路由\n3\t\n4\t深度研究的 API 端点：创建/查询 run、SSE 进度、图谱查询、RAG 问答。\n5\t\"\"\"\n6\t\n7\timport asyncio\n8\timport logging\n9\tfrom fastapi import APIRouter, HTTPException\n10\tfrom fastapi.responses import StreamingResponse\n11\tfrom sqlmodel import Session, create_engine, select\n12\t\n13\tfrom ..config import settings\n14\tfrom ..models.research import ResearchRun, ResearchGraph\n15\tfrom ..models.workspace import Workspace, WorkspacePaper\n16\tfrom ..models.paper import Paper\n17\tfrom ..models.schemas import (\n18\t    StreamEvent,\n19\t    ResearchRunCreate, ResearchRunResponse, ResearchGraphResponse,\n20\t    RagQueryRequest, RagQueryResponse,\n21\t)\n22\tfrom ..utils.streaming import format_sse\n23\tfrom ..services.deep_research.pipeline import run_pipeline\n24\tfrom ..services.deep_research.event_bus import get_event_bus, has_event_bus\n25\tfrom ..services.deep_research.vector_store import query_workspace, drop_workspace_collection\n26\t\n27\tlogger = logging.getLogger(__name__)\n28\t\n29\trouter = APIRouter(prefix=\"/api/research\", tags=[\"research\"])\n30\t\n31\t_engine = None\n32\t\n33\t\n34\tdef _get_engine():\n35\t    global _engine\n36\t    if _engine is None:\n37\t        _engine = create_engine(settings.resolved_database_url, connect_args={\"check_same_thread\": False})\n38\t    return _engine\n39\t\n40\t\n41\t@router.post(\"/workspaces/{ws_id}/runs\", response_model=ResearchRunResponse)\n42\tasync def create_run(ws_id: int, req: ResearchRunCreate):\n43\t    engine = _get_engine()\n44\t    with Session(engine) as session:\n45\t        ws = session.get(Workspace, ws_id)\n46\t        if not ws:\n47\t            raise HTTPException(404, detail={\"detail\": \"工作区不存在\", \"code\": \"NOT_FOUND\"})\n48\t\n49\t        # 拒绝同时存在 running 任务\n50\t        existing = session.exec(\n51\t            select(ResearchRun)\n52\t            .where(ResearchRun.workspace_id == ws_id)\n53\t            .where(ResearchRun.status == \"running\")\n54\t        ).first()\n55\t        if existing:\n56\t            raise HTTPException(409, detail={\"detail\": \"已有运行中的研究任务\", \"code\": \"RESEARCH_RUNNING\"})\n57\t\n58\t        # 校验工作区有可用论文\n59\t        done_papers = session.exec(\n60\t            select(Paper)\n61\t            .join(WorkspacePaper, WorkspacePaper.paper_id == Paper.id)\n62\t            .where(WorkspacePaper.workspace_id == ws_id)\n63\t            .where(Paper.status == \"done\")\n64\t        ).all()\n65\t        if not done_papers:\n66\t            raise HTTPException(400, detail={\"detail\": \"工作区没有已完成解析的论文\", \"code\": \"WORKSPACE_EMPTY\"})\n67\t\n68\t        run = ResearchRun(\n69\t            workspace_id=ws_id,\n70\t            mode=req.mode,\n71\t            status=\"pending\",\n72\t            params=req.model_dump(),\n73\t        )\n74\t        session.add(run)\n75\t        session.commit()\n76\t        session.refresh(run)\n77\t        run_id = run.id\n78\t\n79\t    # 先建好事件总线再起任务：保证客户端连 /stream 时 bus 必然存在，\n80\t    # 从而 has_event_bus()==False 可可靠判定为\"孤儿 run\"（见 stream_run）。\n81\t    get_event_bus(run_id)\n82\t    # 异步启动 pipeline（不在 HTTP 请求内阻塞）\n83\t    asyncio.create_task(run_pipeline(run_id))\n84\t\n85\t    with Session(engine) as session:\n86\t        run = session.get(ResearchRun, run_id)\n87\t        return ResearchRunResponse.model_validate(run, from_attributes=True)\n88\t\n89\t\n90\t@router.get(\"/runs/{run_id}\", response_model=ResearchRunResponse)\n91\tasync def get_run(run_id: int):\n92\t    engine = _get_engine()\n93\t    with Session(engine) as session:\n94\t        run = session.get(ResearchRun, run_id)\n95\t        if not run:\n96\t            raise HTTPException(404, detail={\"detail\": \"Run not found\", \"code\": \"NOT_FOUND\"})\n97\t        return ResearchRunResponse.model_validate(run, from_attributes=True)\n98\t\n99\t\n100\t@router.get(\"/runs/{run_id}/stream\")\n101\tasync def stream_run(run_id: int):\n102\t    engine = _get_engine()\n103\t    with Session(engine) as session:\n104\t        run = session.get(ResearchRun, run_id)\n105\t        if not run:\n106\t            raise HTTPException(404, detail={\"detail\": \"Run not found\", \"code\": \"NOT_FOUND\"})\n107\t        # 提取需要在 session 外使用的值\n108\t        run_status = run.status\n109\t        run_workspace_id = run.workspace_id\n110\t        run_node_count = run.node_count\n111\t        run_edge_count = run.edge_count\n112\t        run_error_message = run.error_message\n113\t        run_current_stage = run.current_stage\n114\t\n115\t    async def gen():\n116\t        # 1. 历史已结束的 run：直接回放最终事件后关闭\n117\t        if run_status == \"done\":\n118\t            with Session(engine) as s:\n119\t                g = s.exec(select(ResearchGraph).where(ResearchGraph.workspace_id == run_workspace_id)).first()\n120\t                if g:\n121\t                    yield format_sse(StreamEvent(event=\"graph_ready\",\n122\t                        data={\"nodes\": g.nodes, \"edges\": g.edges, \"stats\": g.stats}))\n123\t                yield format_sse(StreamEvent(event=\"done\",\n124\t                    data={\"run_id\": run_id,\n125\t                          \"node_count\": run_node_count,\n126\t                          \"edge_count\": run_edge_count}))\n127\t            return\n128\t        if run_status == \"failed\":\n129\t            yield format_sse(StreamEvent(event=\"error\",\n130\t                data={\"message\": run_error_message or \"Unknown error\",\n131\t                      \"stage\": run_current_stage or \"\"}))\n132\t            return\n133\t\n134\t        # 2. 状态为 running/pending 但没有活跃 bus → 孤儿 run（pipeline 进程已不在，\n135\t        #    多为后端重启/硬崩溃遗留）。直接落 failed 并补发 error，避免订阅空 bus 永久阻塞、\n136\t        #    前端永久卡在\"运行中\"，同时解除 create_run 的 409 锁。\n137\t        if not has_event_bus(run_id):\n138\t            msg = run_error_message or \"研究任务已中断（服务可能已重启），请重新运行\"\n139\t            with Session(engine) as s:\n140\t                r = s.get(ResearchRun, run_id)\n141\t                if r is not None and r.status in (\"running\", \"pending\"):\n142\t                    r.status = \"failed\"\n143\t                    r.error_message = msg\n144\t                    s.commit()\n145\t            yield format_sse(StreamEvent(event=\"error\",\n146\t                data={\"message\": msg, \"stage\": run_current_stage or \"\"}))\n147\t            return\n148\t\n149\t        # 进行中：订阅 event_bus\n150\t        bus = get_event_bus(run_id)\n151\t        async for evt in bus.subscribe():\n152\t            yield format_sse(evt)\n153\t\n154\t    return StreamingResponse(\n155\t        gen(),\n156\t        media_type=\"text/event-stream\",\n157\t        headers={\"Cache-Control\": \"no-cache\", \"Connection\": \"keep-alive\", \"X-Accel-Buffering\": \"no\"},\n158\t    )\n159\t\n160\t\n161\t@router.get(\"/workspaces/{ws_id}/graph\", response_model=ResearchGraphResponse)\n162\tasync def get_graph(ws_id: int):\n163\t    engine = _get_engine()\n164\t    with Session(engine) as session:\n165\t        g = session.exec(select(ResearchGraph).where(ResearchGraph.workspace_id == ws_id)).first()\n166\t        if not g:\n167\t            raise HTTPException(404, detail={\"detail\": \"尚未构建图谱\", \"code\": \"NOT_FOUND\"})\n168\t        return ResearchGraphResponse(\n169\t            workspace_id=g.workspace_id, run_id=g.run_id,\n170\t            nodes=g.nodes, edges=g.edges, stats=g.stats, updated_at=g.updated_at,\n171\t        )\n172\t\n173\t\n174\t@router.get(\"/workspaces/{ws_id}/latest-run\", response_model=ResearchRunResponse)\n175\tasync def latest_run(ws_id: int):\n176\t    engine = _get_engine()\n177\t    with Session(engine) as session:\n178\t        run = session.exec(\n179\t            select(ResearchRun).where(ResearchRun.workspace_id == ws_id)\n180\t            .order_by(ResearchRun.created_at.desc())\n181\t        ).first()\n182\t        if not run:\n183\t            raise HTTPException(404, detail={\"detail\": \"无历史运行\", \"code\": \"NOT_FOUND\"})\n184\t        return ResearchRunResponse.model_validate(run, from_attributes=True)\n185\t\n186\t\n187\t@router.post(\"/workspaces/{ws_id}/query\", response_model=RagQueryResponse)\n188\tasync def query(ws_id: int, req: RagQueryRequest):\n189\t    from ..services.deep_research.embedder import embed_query\n190\t    from ..services.deep_research.vector_store import query_workspace as ws_query\n191\t    from ..services.deep_research.reranker import rerank\n192\t    from ..services.ai_config import get_reranker_config\n193\t\n194\t    vec = await embed_query(req.question)\n195\t\n196\t    rcfg = get_reranker_config()\n197\t    # rerank 启用时：先召回更大的候选集，再 rerank 取 top_n；否则直接按 req.top_k 走\n198\t    use_rerank = bool(rcfg.get(\"enabled\", True))\n199\t    final_k = req.top_k\n200\t    if use_rerank:\n201\t        recall_k = max(int(rcfg.get(\"candidate_k\", 30)), final_k)\n202\t        candidates = ws_query(ws_id, vec, top_k=recall_k, paper_ids=req.paper_ids)\n203\t        if not candidates:\n204\t            raise HTTPException(404, detail={\"detail\": \"未构建索引或无命中\", \"code\": \"CHROMA_NOT_INITIALIZED\"})\n205\t        ranked = await rerank(req.question, [c[\"snippet\"] for c in candidates], top_n=final_k)\n206\t        # ranked 已按 score 降序；若 rerank 失败 _fallback 也会返回原序前 N 条\n207\t        hits = []\n208\t        for r in ranked:\n209\t            base = dict(candidates[r[\"index\"]])\n210\t            base[\"score\"] = r[\"score\"]\n211\t            hits.append(base)\n212\t    else:\n213\t        hits = ws_query(ws_id, vec, top_k=final_k, paper_ids=req.paper_ids)\n214\t        if not hits:\n215\t            raise HTTPException(404, detail={\"detail\": \"未构建索引或无命中\", \"code\": \"CHROMA_NOT_INITIALIZED\"})\n216\t\n217\t    # 调用 LLM 用 hits 生成回答\n218\t    from ..services.ai_analyzer import _create_client\n219\t    from ..services.ai_config import get_analysis_config\n220\t    cfg = get_analysis_config()\n221\t    context = \"\\n\\n\".join(\n222\t        f\"[{i+1}] {h['paper_title']} / {h['section_name']}:\\n{h['snippet']}\"\n223\t        for i, h in enumerate(hits)\n224\t    )\n225\t    prompt = (\n226\t        f\"你是一名学术研究助手。基于下列检索到的论文片段回答用户问题。\"\n227\t        f\"必须使用中文，并用 [编号] 标注引用。\\n\\n问题：{req.question}\\n\\n资料：\\n{context}\"\n228\t    )\n229\t    client = _create_client(cfg[\"api_key\"], cfg[\"base_url\"])\n230\t    try:\n231\t        msg = await client.messages.create(\n232\t            model=cfg[\"model\"], max_tokens=2048,\n233\t            system=\"你是学术研究助手，必须基于提供的资料回答，引用编号写在文末。\",\n234\t            messages=[{\"role\": \"user\", \"content\": prompt}],\n235\t            temperature=0.2,\n236\t        )\n237\t        answer = msg.content[0].text.strip()\n238\t    finally:\n239\t        await client.close()\n240\t\n241\t    return RagQueryResponse(\n242\t        answer=answer,\n243\t        citations=[\n244\t            {\"paper_id\": h[\"paper_id\"], \"paper_title\": h[\"paper_title\"],\n245\t             \"section_name\": h[\"section_name\"], \"snippet\": h[\"snippet\"][:400],\n246\t             \"score\": h[\"score\"]}\n247\t            for h in hits\n248\t        ],\n249\t    )\n250\t\n251\t\n252\t@router.delete(\"/workspaces/{ws_id}\")\n253\tasync def clear_research(ws_id: int):\n254\t    \"\"\"清空该工作区的图谱与向量索引（不删除 expanded 论文文件）\"\"\"\n255\t    engine = _get_engine()\n256\t    with Session(engine) as session:\n257\t        g = session.exec(select(ResearchGraph).where(ResearchGraph.workspace_id == ws_id)).first()\n258\t        if g:\n259\t            session.delete(g)\n260\t            session.commit()\n261\t    drop_workspace_collection(ws_id)\n262\t    return {\"message\": \"已清空\"}\n263\t"}]},"parent_tool_use_id":"call_14fbefec6f4c427bbf12da10","session_id":"29257b8f-ede7-46a4-8e0f-a743591d296a","uuid":"0bf4608c-52b9-44c8-8ffc-19237c7181da","timestamp":"2026-06-09T05:10:22.882Z","subagent_type":"Explore","task_description":"Explore backend performance"}
