{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call_445a1ddcfdd74b8c8ca26e46","type":"tool_result","content":"1\timport { useToast, type Toast } from '@/hooks/useToast'\n2\t\n3\tconst ICONS: Record<Toast['type'], string> = {\n4\t  success: '✓',\n5\t  error: '✕',\n6\t  warning: '⚠',\n7\t  info: 'ℹ',\n8\t}\n9\t\n10\tconst COLORS: Record<Toast['type'], { bg: string; border: string; icon: string }> = {\n11\t  success: { bg: 'var(--success-subtle)', border: 'var(--success)', icon: 'var(--success)' },\n12\t  error: { bg: 'var(--error-subtle)', border: 'var(--error)', icon: 'var(--error)' },\n13\t  warning: { bg: 'var(--warning-subtle)', border: 'var(--warning)', icon: 'var(--warning)' },\n14\t  info: { bg: 'var(--accent-subtle)', border: 'var(--accent)', icon: 'var(--accent)' },\n15\t}\n16\t\n17\texport function ToastContainer() {\n18\t  const { toasts, dismiss } = useToast()\n19\t\n20\t  if (toasts.length === 0) return null\n21\t\n22\t  return (\n23\t    <div className=\"fixed bottom-4 right-4 z-[9999] flex flex-col gap-2 pointer-events-none\">\n24\t      {toasts.map(t => {\n25\t        const c = COLORS[t.type]\n26\t        return (\n27\t          <div\n28\t            key={t.id}\n29\t            className=\"pointer-events-auto rounded-lg shadow-lg border px-4 py-3 flex items-start gap-3 min-w-[280px] max-w-[400px] animate-slide-in\"\n30\t            style={{ backgroundColor: c.bg, borderColor: c.border }}\n31\t          >\n32\t            <span className=\"text-sm font-bold shrink-0 mt-px\" style={{ color: c.icon }}>\n33\t              {ICONS[t.type]}\n34\t            </span>\n35\t            <p className=\"text-sm flex-1\" style={{ color: 'var(--text-primary)' }}>\n36\t              {t.message}\n37\t            </p>\n38\t            <button\n39\t              onClick={() => dismiss(t.id)}\n40\t              className=\"text-xs shrink-0 p-1.5 rounded opacity-60 hover:opacity-100 hover:bg-white/10 transition-all\"\n41\t              style={{ color: 'var(--text-muted)' }}\n42\t              aria-label=\"关闭\"\n43\t            >\n44\t              ✕\n45\t            </button>\n46\t          </div>\n47\t        )\n48\t      })}\n49\t    </div>\n50\t  )\n51\t}\n52\t"}]},"parent_tool_use_id":"call_bddd82a75f2e46b98e4517cc","session_id":"29257b8f-ede7-46a4-8e0f-a743591d296a","uuid":"3a0f77b6-21e3-4aa0-a5f5-5ab304c4b93b","timestamp":"2026-06-09T05:10:53.479Z","subagent_type":"Explore","task_description":"Explore frontend performance"}
