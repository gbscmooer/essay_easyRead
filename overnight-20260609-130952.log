{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call_cc0d4a0945fc44faa9e4f2b9","type":"tool_result","content":"1\t\"\"\"\n2\t代码分析服务\n3\t\n4\t管理代码仓库的 clone、文件浏览和分析。\n5\t\"\"\"\n6\t\n7\timport os\n8\timport json\n9\timport asyncio\n10\timport logging\n11\timport subprocess\n12\tfrom pathlib import Path\n13\tfrom typing import Optional\n14\tfrom collections import defaultdict\n15\t\n16\tfrom .import_parser import parse_imports, SUPPORTED_EXTENSIONS, ParsedImport\n17\t\n18\tlogger = logging.getLogger(__name__)\n19\t\n20\t# 需要跳过的目录和文件\n21\tSKIP_DIRS = {\n22\t    \".git\", \"node_modules\", \"__pycache__\", \".venv\", \"venv\", \"env\",\n23\t    \".tox\", \".mypy_cache\", \".pytest_cache\", \"dist\", \"build\",\n24\t    \".eggs\", \"*.egg-info\", \".idea\", \".vscode\",\n25\t}\n26\t\n27\tSKIP_EXTENSIONS = {\n28\t    \".pyc\", \".pyo\", \".so\", \".dll\", \".dylib\", \".exe\", \".bin\",\n29\t    \".jpg\", \".jpeg\", \".png\", \".gif\", \".bmp\", \".ico\", \".svg\",\n30\t    \".mp4\", \".mp3\", \".wav\", \".avi\", \".mov\",\n31\t    \".zip\", \".tar\", \".gz\", \".rar\", \".7z\",\n32\t    \".pdf\", \".doc\", \".docx\", \".xls\", \".xlsx\",\n33\t    \".ttf\", \".otf\", \".woff\", \".woff2\", \".eot\",\n34\t}\n35\t\n36\t# 最大文件大小（1MB）\n37\tMAX_FILE_SIZE = 1 * 1024 * 1024\n38\t\n39\t# 文件树最大深度\n40\tMAX_TREE_DEPTH = 6\n41\t\n42\t\n43\tdef get_code_download_dir() -> str:\n44\t    \"\"\"获取代码下载目录\"\"\"\n45\t    base = os.path.join(os.path.dirname(os.path.dirname(os.path.dirname(__file__))), \"code_downloads\")\n46\t    os.makedirs(base, exist_ok=True)\n47\t    return base\n48\t\n49\t\n50\tasync def clone_repository(url: str, paper_id: int) -> str:\n51\t    \"\"\"\n52\t    Clone 代码仓库到本地。\n53\t\n54\t    Args:\n55\t        url: 仓库 URL\n56\t        paper_id: 论文 ID（用于目录命名）\n57\t\n58\t    Returns:\n59\t        clone 后的本地路径\n60\t\n61\t    Raises:\n62\t        Exception: clone 失败\n63\t    \"\"\"\n64\t    # 规范化 URL：确保有 https:// 前缀和 .git 后缀\n65\t    if not url.startswith(\"http\"):\n66\t        url = \"https://\" + url\n67\t    if not url.endswith(\".git\"):\n68\t        url = url.rstrip(\"/\") + \".git\"\n69\t\n70\t    # 安全校验：防止 git 参数注入\n71\t    if \"--\" in url:\n72\t        raise ValueError(\"URL 包含非法字符\")\n73\t    import re\n74\t    if not re.match(r\"https://(?:github\\.com|gitlab\\.com|bitbucket\\.org)/[\\w.\\-]+/[\\w.\\-]+(?:\\.git)?$\", url):\n75\t        raise ValueError(f\"不支持的仓库地址: {url}\")\n76\t\n77\t    target_dir = os.path.join(get_code_download_dir(), str(paper_id))\n78\t\n79\t    # 如果已存在，先删除\n80\t    if os.path.exists(target_dir):\n81\t        import shutil\n82\t        shutil.rmtree(target_dir, ignore_errors=True)\n83\t\n84\t    # 浅 clone，只获取最新代码\n85\t    cmd = [\n86\t        \"git\", \"clone\",\n87\t        \"--depth\", \"1\",\n88\t        \"--single-branch\",\n89\t        url,\n90\t        target_dir,\n91\t    ]\n92\t\n93\t    proc = await asyncio.create_subprocess_exec(\n94\t        *cmd,\n95\t        stdout=asyncio.subprocess.PIPE,\n96\t        stderr=asyncio.subprocess.PIPE,\n97\t    )\n98\t    stdout, stderr = await proc.communicate()\n99\t\n100\t    if proc.returncode != 0:\n101\t        error_msg = stderr.decode(\"utf-8\", errors=\"replace\").strip()\n102\t        raise RuntimeError(f\"git clone 失败: {error_msg}\")\n103\t\n104\t    return target_dir\n105\t\n106\t\n107\tdef build_file_tree(repo_path: str, max_depth: int = MAX_TREE_DEPTH) -> dict:\n108\t    \"\"\"\n109\t    遍历目录，构建文件树结构。\n110\t\n111\t    Args:\n112\t        repo_path: 仓库根目录\n113\t        max_depth: 最大遍历深度\n114\t\n115\t    Returns:\n116\t        文件树字典 {\"name\": ..., \"type\": \"dir\"|\"file\", \"children\": [...]}\n117\t    \"\"\"\n118\t    repo_path = os.path.abspath(repo_path)\n119\t\n120\t    def _build(current_path: str, depth: int) -> dict:\n121\t        name = os.path.basename(current_path)\n122\t        rel_path = os.path.relpath(current_path, repo_path)\n123\t\n124\t        if os.path.isdir(current_path):\n125\t            children = []\n126\t            if depth < max_depth:\n127\t                try:\n128\t                    entries = sorted(os.listdir(current_path))\n129\t                except PermissionError:\n130\t                    entries = []\n131\t                for entry in entries:\n132\t                    if entry in SKIP_DIRS or entry.startswith(\".\"):\n133\t                        continue\n134\t                    child_path = os.path.join(current_path, entry)\n135\t                    child = _build(child_path, depth + 1)\n136\t                    if child:\n137\t                        children.append(child)\n138\t            return {\n139\t                \"name\": name,\n140\t                \"type\": \"dir\",\n141\t                \"path\": rel_path,\n142\t                \"children\": children,\n143\t            }\n144\t        else:\n145\t            # 检查文件扩展名\n146\t            ext = os.path.splitext(name)[1].lower()\n147\t            if ext in SKIP_EXTENSIONS:\n148\t                return None\n149\t\n150\t            # 检查文件大小\n151\t            try:\n152\t                size = os.path.getsize(current_path)\n153\t            except OSError:\n154\t                return None\n155\t            if size > MAX_FILE_SIZE:\n156\t                return None\n157\t\n158\t            return {\n159\t                \"name\": name,\n160\t                \"type\": \"file\",\n161\t                \"path\": rel_path,\n162\t                \"size\": size,\n163\t            }\n164\t\n165\t    tree = _build(repo_path, 0)\n166\t    # 确保根节点是目录\n167\t    if tree and tree[\"type\"] == \"dir\":\n168\t        return tree\n169\t    return {\"name\": os.path.basename(repo_path), \"type\": \"dir\", \"path\": \".\", \"children\": [tree] if tree else []}\n170\t\n171\t\n172\tdef read_file_content(repo_path: str, rel_path: str, max_lines: int = 500) -> str:\n173\t    \"\"\"\n174\t    读取文件内容。\n175\t\n176\t    Args:\n177\t        repo_path: 仓库根目录\n178\t        rel_path: 相对路径\n179\t        max_lines: 最大行数\n180\t\n181\t    Returns:\n182\t        文件内容字符串\n183\t\n184\t    Raises:\n185\t        FileNotFoundError: 文件不存在\n186\t        ValueError: 跕径不安全\n187\t    \"\"\"\n188\t    # 安全检查：防止路径穿越\n189\t    full_path = os.path.realpath(os.path.join(repo_path, rel_path))\n190\t    if not full_path.startswith(os.path.realpath(repo_path) + os.sep):\n191\t        raise ValueError(\"不安全的文件路径\")\n192\t\n193\t    if not os.path.isfile(full_path):\n194\t        raise FileNotFoundError(f\"文件不存在: {rel_path}\")\n195\t\n196\t    # 检查是否为二进制文件\n197\t    try:\n198\t        with open(full_path, \"rb\") as f:\n199\t            chunk = f.read(8192)\n200\t            if b\"\\x00\" in chunk:\n201\t                return \"[二进制文件，无法显示]\"\n202\t    except Exception:\n203\t        pass\n204\t\n205\t    try:\n206\t        with open(full_path, \"r\", encoding=\"utf-8\", errors=\"replace\") as f:\n207\t            lines = []\n208\t            for i, line in enumerate(f):\n209\t                if i >= max_lines:\n210\t                    lines.append(f\"\\n... [文件过长，已截断前 {max_lines} 行]\")\n211\t                    break\n212\t                lines.append(line)\n213\t            return \"\".join(lines)\n214\t    except Exception as e:\n215\t        return f\"[读取失败: {e}]\"\n216\t\n217\t\n218\tdef read_notebook_content(repo_path: str, rel_path: str) -> list[dict]:\n219\t    \"\"\"\n220\t    读取并解析 Jupyter Notebook (.ipynb) 文件。\n221\t\n222\t    Args:\n223\t        repo_path: 仓库根目录\n224\t        rel_path: 相对路径\n225\t\n226\t    Returns:\n227\t        解析后的 cell 列表: [{cell_type, source, outputs, execution_count}]\n228\t\n229\t    Raises:\n230\t        FileNotFoundError: 文件不存在\n231\t        ValueError: 路径不安全或文件格式错误\n232\t    \"\"\"\n233\t    full_path = os.path.realpath(os.path.join(repo_path, rel_path))\n234\t    if not full_path.startswith(os.path.realpath(repo_path) + os.sep):\n235\t        raise ValueError(\"不安全的文件路径\")\n236\t\n237\t    if not os.path.isfile(full_path):\n238\t        raise FileNotFoundError(f\"文件不存在: {rel_path}\")\n239\t\n240\t    try:\n241\t        with open(full_path, \"r\", encoding=\"utf-8\", errors=\"replace\") as f:\n242\t            nb = json.load(f)\n243\t    except json.JSONDecodeError as e:\n244\t        raise ValueError(f\"无效的 Notebook JSON: {e}\")\n245\t    except Exception as e:\n246\t        raise ValueError(f\"读取失败: {e}\")\n247\t\n248\t    raw_cells = nb.get(\"cells\", [])\n249\t    cells = []\n250\t    for cell in raw_cells:\n251\t        cell_type = cell.get(\"cell_type\", \"raw\")\n252\t        source_parts = cell.get(\"source\", [])\n253\t        source = \"\".join(source_parts) if isinstance(source_parts, list) else str(source_parts)\n254\t        execution_count = cell.get(\"execution_count\")\n255\t\n256\t        outputs = []\n257\t        for out in cell.get(\"outputs\", []):\n258\t            output_type = out.get(\"output_type\", \"\")\n259\t            processed = {\"output_type\": output_type}\n260\t\n261\t            if output_type in (\"stream\", \"execute_result\", \"error\"):\n262\t                text_parts = out.get(\"text\", [])\n263\t                processed[\"text\"] = \"\".join(text_parts) if isinstance(text_parts, list) else str(text_parts)\n264\t                if output_type == \"execute_result\":\n265\t                    data = out.get(\"data\", {})\n266\t                    processed[\"data\"] = {\n267\t                        k: (v if isinstance(v, str) else \"\".join(v) if isinstance(v, list) else str(v))\n268\t                        for k, v in data.items()\n269\t                    }\n270\t                if output_type == \"error\":\n271\t                    processed[\"ename\"] = out.get(\"ename\", \"\")\n272\t                    processed[\"evalue\"] = out.get(\"evalue\", \"\")\n273\t            elif output_type == \"display_data\":\n274\t                data = out.get(\"data\", {})\n275\t                processed[\"data\"] = {\n276\t                    k: (v if isinstance(v, str) else \"\".join(v) if isinstance(v, list) else str(v))\n277\t                    for k, v in data.items()\n278\t                }\n279\t\n280\t            outputs.append(processed)\n281\t\n282\t        cells.append({\n283\t            \"cell_type\": cell_type,\n284\t            \"source\": source,\n285\t            \"outputs\": outputs,\n286\t            \"execution_count\": execution_count,\n287\t        })\n288\t\n289\t    return cells\n290\t\n291\t\n292\tdef _detect_package_root(repo_path: str) -> str:\n293\t    \"\"\"检测 Python 包根目录\"\"\"\n294\t    # 1. 从 setup.py/pyproject.toml 推断\n295\t    for cfg in (\"pyproject.toml\", \"setup.py\", \"setup.cfg\"):\n296\t        cfg_path = os.path.join(repo_path, cfg)\n297\t        if os.path.isfile(cfg_path):\n298\t            try:\n299\t                with open(cfg_path, \"r\", encoding=\"utf-8\", errors=\"replace\") as f:\n300\t                    content = f.read(10000)\n301\t                # 查找 package_dir 或 packages 配置\n302\t                import re\n303\t                m = re.search(r'package_dir\\s*=\\s*\\{[^}]*:\\s*[\"\\']([^\"\\']+)[\"\\']', content)\n304\t                if m:\n305\t                    candidate = os.path.join(repo_path, m.group(1))\n306\t                    if os.path.isdir(candidate):\n307\t                        return candidate\n308\t            except Exception:\n309\t                pass\n310\t\n311\t    # 2. 查找包含 __init__.py 的最顶层目录\n312\t    for entry in sorted(os.listdir(repo_path)):\n313\t        init_path = os.path.join(repo_path, entry, \"__init__.py\")\n314\t        if os.path.isfile(init_path):\n315\t            return repo_path\n316\t\n317\t    # 3. 查找 src/ 目录\n318\t    src_dir = os.path.join(repo_path, \"src\")\n319\t    if os.path.isdir(src_dir):\n320\t        for entry in os.listdir(src_dir):\n321\t            if os.path.isfile(os.path.join(src_dir, entry, \"__init__.py\")):\n322\t                return src_dir\n323\t\n324\t    return repo_path\n325\t\n326\t\n327\tdef _resolve_module_to_file(module: str, from_file: str, repo_path: str, package_root: str = None) -> Optional[str]:\n328\t    \"\"\"尝试将模块名解析为本地文件路径（增强版）\"\"\"\n329\t    if package_root is None:\n330\t        package_root = repo_path\n331\t\n332\t    # 相对导入: \".utils\", \"..lib.helper\"\n333\t    if module.startswith(\".\"):\n334\t        base_dir = os.path.dirname(from_file)\n335\t        dots = len(module) - len(module.lstrip(\".\"))\n336\t        rel = module[dots:]\n337\t        for ext in (\"\", \".py\", \".js\", \".ts\", \".jsx\", \".tsx\", \"/__init__.py\", \"/index.js\", \"/index.ts\", \"/index.jsx\", \"/index.tsx\"):\n338\t            candidate = os.path.join(base_dir, \"..\" * (dots - 1), rel + ext)\n339\t            candidate = os.path.normpath(candidate)\n340\t            full = os.path.join(repo_path, candidate)\n341\t            if os.path.isfile(full):\n342\t                return candidate\n343\t        return None\n344\t\n345\t    # Python 点号模块: \"models.backbone\"\n346\t    if \".\" in module and \"/\" not in module and \"\\\\\" not in module:\n347\t        parts = module.split(\".\")\n348\t        # 从 from_file 位置查找\n349\t        for base in (os.path.dirname(from_file), \"\"):\n350\t            for suffix in (\".py\", \"/__init__.py\"):\n351\t                candidate = os.path.join(*parts) + suffix\n352\t                full = os.path.join(repo_path, base, candidate)\n353\t                if os.path.isfile(full):\n354\t                    return os.path.relpath(full, repo_path)\n355\t        # 从包根目录查找\n356\t        for suffix in (\".py\", \"/__init__.py\"):\n357\t            candidate = os.path.join(*parts) + suffix\n358\t            full = os.path.join(package_root, candidate)\n359\t            if os.path.isfile(full):\n360\t                return os.path.relpath(full, repo_path)\n361\t\n362\t    # Python 绝对导入（无点号）: \"models\" → 查找 models.py 或 models/__init__.py\n363\t    if \".\" not in module and \"/\" not in module:\n364\t        for base in (os.path.dirname(from_file), \"\"):\n365\t            for suffix in (\".py\", \"/__init__.py\"):\n366\t                candidate = module + suffix\n367\t                full = os.path.join(repo_path, base, candidate)\n368\t                if os.path.isfile(full):\n369\t                    return os.path.relpath(full, repo_path)\n370\t        # 从包根目录查找\n371\t        for suffix in (\".py\", \"/__init__.py\"):\n372\t            candidate = module + suffix\n373\t            full = os.path.join(package_root, candidate)\n374\t            if os.path.isfile(full):\n375\t                return os.path.relpath(full, repo_path)\n376\t\n377\t    # JS/TS 相对路径（不以 . 开头但包含 / 的本地路径）\n378\t    if \"/\" in module and not module.startswith(\"@\"):\n379\t        for ext in (\"\", \".js\", \".ts\", \".jsx\", \".tsx\", \"/index.js\", \"/index.ts\"):\n380\t            candidate = module + ext\n381\t            full = os.path.join(repo_path, os.path.dirname(from_file), candidate)\n382\t            if os.path.isfile(full):\n383\t                return os.path.relpath(full, repo_path)\n384\t\n385\t    return None\n386\t\n387\t\n388\tdef _detect_cycles(edges: list[dict]) -> set[tuple[str, str]]:\n389\t    \"\"\"检测依赖图中的环路，返回循环边的 (source, target) 集合\"\"\"\n390\t    adj = defaultdict(set)\n391\t    for edge in edges:\n392\t        adj[edge[\"source\"]].add(edge[\"target\"])\n393\t\n394\t    cycle_edges = set()\n395\t    visited = set()\n396\t    rec_stack = set()\n397\t    path = []\n398\t\n399\t    def dfs(node: str):\n400\t        visited.add(node)\n401\t        rec_stack.add(node)\n402\t        path.append(node)\n403\t\n404\t        for neighbor in adj.get(node, []):\n405\t            if neighbor not in visited:\n406\t                dfs(neighbor)\n407\t            elif neighbor in rec_stack:\n408\t                # 找到环路，标记路径上的所有边\n409\t                idx = path.index(neighbor)\n410\t                for i in range(idx, len(path) - 1):\n411\t                    cycle_edges.add((path[i], path[i + 1]))\n412\t                cycle_edges.add((path[-1], neighbor))\n413\t\n414\t        path.pop()\n415\t        rec_stack.discard(node)\n416\t\n417\t    for node in adj:\n418\t        if node not in visited:\n419\t            dfs(node)\n420\t\n421\t    return cycle_edges\n422\t\n423\t\n424\tdef select_core_files(file_tree: dict, repo_path: str, max_files: int = 50) -> list[str]:\n425\t    \"\"\"\n426\t    智能选取核心文件用于 AI 分析。\n427\t\n428\t    优先级：\n429\t    1. README* 文件\n430\t    2. 配置文件 (setup.py, pyproject.toml, package.json, requirements.txt)\n431\t    3. 主入口文件 (main.py, app.py, train.py, run.py)\n432\t    4. 模型相关文件 (model*.py, net*.py, network*.py)\n433\t    5. 其他 Python/JS/TS 文件（按大小排序，小文件优先）\n434\t\n435\t    Returns:\n436\t        文件相对路径列表\n437\t    \"\"\"\n438\t    # 收集所有文件\n439\t    all_files = []\n440\t\n441\t    def _collect(node: dict):\n442\t        if node[\"type\"] == \"file\":\n443\t            all_files.append(node[\"path\"])\n444\t        elif node.get(\"children\"):\n445\t            for child in node[\"children\"]:\n446\t                _collect(child)\n447\t\n448\t    _collect(file_tree)\n449\t\n450\t    # 分类\n451\t    readme_files = []\n452\t    config_files = []\n453\t    entry_files = []\n454\t    model_files = []\n455\t    other_files = []\n456\t\n457\t    for f in all_files:\n458\t        name = os.path.basename(f).lower()\n459\t        if name.startswith(\"readme\"):\n460\t            readme_files.append(f)\n461\t        elif name in (\"setup.py\", \"pyproject.toml\", \"package.json\", \"requirements.txt\", \"setup.cfg\", \"Makefile\", \"Dockerfile\"):\n462\t            config_files.append(f)\n463\t        elif name in (\"main.py\", \"app.py\", \"train.py\", \"run.py\", \"test.py\", \"index.py\", \"index.ts\", \"index.js\"):\n464\t            entry_files.append(f)\n465\t        elif any(pattern in name for pattern in (\"model\", \"net\", \"network\", \"module\", \"backbone\", \"head\", \"loss\")):\n466\t            model_files.append(f)\n467\t        else:\n468\t            other_files.append(f)\n469\t\n470\t    # 合并，按优先级排序\n471\t    selected = readme_files + config_files + entry_files + model_files\n472\t\n473\t    # 如果还不够，从 other_files 中补充（按文件大小排序，小文件优先）\n474\t    if len(selected) < max_files:\n475\t        remaining = max_files - len(selected)\n476\t        # 按大小排序\n477\t        other_with_size = []\n478\t        for f in other_files:\n479\t            full = os.path.join(repo_path, f)\n480\t            try:\n481\t                size = os.path.getsize(full)\n482\t            except OSError:\n483\t                size = 0\n484\t            other_with_size.append((f, size))\n485\t        other_with_size.sort(key=lambda x: x[1])\n486\t        selected.extend(f for f, _ in other_with_size[:remaining])\n487\t\n488\t    return selected[:max_files]\n489\t\n490\t\n491\tdef analyze_imports(repo_path: str, files: list[str]) -> tuple[list[dict], list[dict]]:\n492\t    \"\"\"\n493\t    静态分析 import 语句，构建模块依赖图。\n494\t\n495\t    使用 AST 解析 Python，增强正则解析 JS/TS/C++/Go/Rust。\n496\t    新增循环检测和耦合指标。\n497\t\n498\t    Returns:\n499\t        (edges, node_metrics)\n500\t        edges: [{\"source\", \"target\", \"imports\", \"circular\", \"line\"}]\n501\t        node_metrics: [{\"file\", \"fan_in\", \"fan_out\"}]\n502\t    \"\"\"\n503\t    edges = []\n504\t    package_root = _detect_package_root(repo_path)\n505\t\n506\t    for rel_path in files:\n507\t        full_path = os.path.join(repo_path, rel_path)\n508\t        if not os.path.isfile(full_path):\n509\t            continue\n510\t\n511\t        ext = os.path.splitext(rel_path)[1].lower()\n512\t        if ext not in SUPPORTED_EXTENSIONS:\n513\t            continue\n514\t\n515\t        try:\n516\t            with open(full_path, \"r\", encoding=\"utf-8\", errors=\"replace\") as f:\n517\t                content = f.read(100000)\n518\t        except Exception:\n519\t            continue\n520\t\n521\t        file_imports = parse_imports(rel_path, content)\n522\t\n523\t        for imp in file_imports.imports:\n524\t            if not imp.module:\n525\t                continue\n526\t            target = _resolve_module_to_file(imp.module, rel_path, repo_path, package_root)\n527\t            if target and target != rel_path:\n528\t                edges.append({\n529\t                    \"source\": rel_path,\n530\t                    \"target\": target,\n531\t                    \"imports\": imp.names,\n532\t                    \"line\": imp.line_number,\n533\t                    \"circular\": False,\n534\t                })\n535\t\n536\t    # 去重\n537\t    seen = set()\n538\t    unique_edges = []\n539\t    for edge in edges:\n540\t        key = (edge[\"source\"], edge[\"target\"])\n541\t        if key not in seen:\n542\t            seen.add(key)\n543\t            unique_edges.append(edge)\n544\t        else:\n545\t            # 合并 imports\n546\t            for existing in unique_edges:\n547\t                if (existing[\"source\"], existing[\"target\"]) == key:\n548\t                    for name in edge[\"imports\"]:\n549\t                        if name not in existing[\"imports\"]:\n550\t                            existing[\"imports\"].append(name)\n551\t                    break\n552\t\n553\t    # 循环检测\n554\t    cycle_edges = _detect_cycles(unique_edges)\n555\t    for edge in unique_edges:\n556\t        if (edge[\"source\"], edge[\"target\"]) in cycle_edges:\n557\t            edge[\"circular\"] = True\n558\t\n559\t    # 耦合指标\n560\t    fan_in = defaultdict(int)\n561\t    fan_out = defaultdict(int)\n562\t    all_files = set()\n563\t    for edge in unique_edges:\n564\t        fan_in[edge[\"target\"]] += 1\n565\t        fan_out[edge[\"source\"]] += 1\n566\t        all_files.add(edge[\"source\"])\n567\t        all_files.add(edge[\"target\"])\n568\t\n569\t    node_metrics = [\n570\t        {\"file\": f, \"fan_in\": fan_in.get(f, 0), \"fan_out\": fan_out.get(f, 0)}\n571\t        for f in sorted(all_files)\n572\t    ]\n573\t\n574\t    return unique_edges, node_metrics\n575\t\n576\t\n577\t# ============================================================\n578\t# AI 分析函数\n579\t# ============================================================\n580\t\n581\tdef _format_file_contents(file_contents: dict[str, str], max_total_chars: int = 80000) -> str:\n582\t    \"\"\"格式化文件内容为 prompt 文本，限制总长度\"\"\"\n583\t    parts = []\n584\t    total = 0\n585\t    for path, content in file_contents.items():\n586\t        header = f\"\\n{'='*60}\\n文件: {path}\\n{'='*60}\\n\"\n587\t        entry = header + content\n588\t        if total + len(entry) > max_total_chars:\n589\t            parts.append(\"\\n... [剩余文件已省略]\")\n590\t            break\n591\t        parts.append(entry)\n592\t        total += len(entry)\n593\t    return \"\\n\".join(parts)\n594\t\n595\t\n596\tasync def ai_analyze_data_flow(\n597\t    file_contents: dict[str, str],\n598\t    paper_title: str,\n599\t    api_key: str, base_url: str, model: str,\n600\t) -> str:\n601\t    \"\"\"AI 分析代码数据流\"\"\"\n602\t    from .ai_analyzer import _create_client\n603\t\n604\t    formatted = _format_file_contents(file_contents)\n605\t    prompt = (\n606\t        f'你是一个代码分析专家。以下是论文\"{paper_title}\"的开源实现代码库中的核心文件内容。\\n\\n'\n607\t        f\"请分析这些代码，描述数据从输入到输出的完整流转过程。\\n\\n\"\n608\t        f\"要求：\\n\"\n609\t        f\"1. 从数据加载/预处理开始，到最终输出/后处理结束\\n\"\n610\t        f\"2. 每一步说明：输入是什么、做了什么处理、输出是什么\\n\"\n611\t        f\"3. 标注关键的类名和函数名\\n\"\n612\t        f\"4. 用清晰的编号步骤描述（Step 1, Step 2, ...）\\n\"\n613\t        f\"5. 如果有训练和推理两条路径，分别描述\\n\"\n614\t        f\"6. 总长度控制在 500-800 字\\n\\n\"\n615\t        f\"以下是代码文件内容：\\n{formatted}\"\n616\t    )\n617\t\n618\t    client = _create_client(api_key, base_url)\n619\t    try:\n620\t        message = await client.messages.create(\n621\t            model=model,\n622\t            max_tokens=4096,\n623\t            system=\"你是一个专业的代码分析助手。\",\n624\t            messages=[{\"role\": \"user\", \"content\": prompt}],\n625\t            temperature=0.2,\n626\t        )\n627\t    finally:\n628\t        await client.close()\n629\t    from .ai_analyzer import _extract_text\n630\t    return _extract_text(message).strip()\n631\t\n632\t\n633\tasync def ai_analyze_paper_code_mapping(\n634\t    file_contents: dict[str, str],\n635\t    paper_title: str,\n636\t    paper_one_sentence: str,\n637\t    existing_code_mapping: list[dict],\n638\t    api_key: str, base_url: str, model: str,\n639\t) -> list[dict]:\n640\t    \"\"\"AI 将论文概念映射到具体代码文件\"\"\"\n641\t    import json as json_mod\n642\t    from .ai_analyzer import _create_client\n643\t\n644\t    formatted = _format_file_contents(file_contents)\n645\t\n646\t    # 格式化已有的 code_mapping\n647\t    mappings_text = \"\"\n648\t    if existing_code_mapping:\n649\t        mappings_text = \"\\n\".join(\n650\t            f\"- {m.get('concept', '')}\" for m in existing_code_mapping\n651\t        )\n652\t    else:\n653\t        mappings_text = \"（无）\"\n654\t\n655\t    prompt = (\n656\t        f'你是一个学术代码分析专家。论文\"{paper_title}\"的核心贡献是：{paper_one_sentence}\\n\\n'\n657\t        f\"论文中已识别的关键概念：\\n{mappings_text}\\n\\n\"\n658\t        f\"以下是该论文开源实现的核心代码文件。请将上述论文概念映射到具体的代码文件和函数。\\n\\n\"\n659\t        f\"输出 JSON 数组，每个元素格式：\\n\"\n660\t        f'{{\"concept\": \"论文概念名\", \"file\": \"代码文件相对路径\", \"function\": \"类名.方法名或函数名\", \"explanation\": \"这段代码如何实现论文中的概念（2-3句话）\"}}\\n\\n'\n661\t        f\"要求：\\n\"\n662\t        f\"1. 每个论文概念都要映射到具体的代码位置\\n\"\n663\t        f\"2. 如果一个概念对应多个文件，选择最核心的那个\\n\"\n664\t        f\"3. function 字段格式：ClassName.method_name 或 module.function_name\\n\"\n665\t        f\"4. explanation 要说明代码与论文公式的对应关系\\n\\n\"\n666\t        f\"只输出 JSON 数组，不要添加其他文字。\\n\\n\"\n667\t        f\"以下是代码文件内容：\\n{formatted}\"\n668\t    )\n669\t\n670\t    client = _create_client(api_key, base_url)\n671\t    try:\n672\t        message = await client.messages.create(\n673\t            model=model,\n674\t            max_tokens=4096,\n675\t            system=\"你是一个学术代码分析助手。只输出 JSON 数组，不要其他文字。\",\n676\t            messages=[{\"role\": \"user\", \"content\": prompt}],\n677\t            temperature=0.2,\n678\t        )\n679\t    finally:\n680\t        await client.close()\n681\t\n682\t    from .ai_analyzer import _extract_text\n683\t    content = _extract_text(message).strip()\n684\t    # 提取 JSON\n685\t    if \"```\" in content:\n686\t        start = content.find(\"[\")\n687\t        end = content.rfind(\"]\") + 1\n688\t        if start >= 0 and end > start:\n689\t            content = content[start:end]\n690\t\n691\t    try:\n692\t        result = json_mod.loads(content)\n693\t        if isinstance(result, list):\n694\t            return result\n695\t    except json_mod.JSONDecodeError:\n696\t        pass\n697\t    return []\n698\t\n699\t\n700\tasync def ai_summarize_readme(\n701\t    readme_content: str,\n702\t    api_key: str, base_url: str, model: str,\n703\t) -> str:\n704\t    \"\"\"AI 总结 README\"\"\"\n705\t    from .ai_analyzer import _create_client\n706\t\n707\t    prompt = (\n708\t        f\"请总结以下 README 内容，输出格式：\\n\\n\"\n709\t        f\"1. **项目简介**：一句话说明这个项目做什么\\n\"\n710\t        f\"2. **环境要求**：Python 版本、主要依赖、GPU 要求等\\n\"\n711\t        f\"3. **安装方法**：pip install、conda 等安装步骤\\n\"\n712\t        f\"4. **运行方法**：训练/推理/测试的命令\\n\"\n713\t        f\"5. **项目结构**：主要目录和文件的作用（3-5 个要点）\\n\\n\"\n714\t        f\"要求简洁实用，每个要点 1-2 行。\\n\\n\"\n715\t        f\"README 内容：\\n{readme_content[:10000]}\"\n716\t    )\n717\t\n718\t    client = _create_client(api_key, base_url)\n719\t    try:\n720\t        message = await client.messages.create(\n721\t            model=model,\n722\t            max_tokens=2048,\n723\t            system=\"你是一个技术文档总结助手。\",\n724\t            messages=[{\"role\": \"user\", \"content\": prompt}],\n725\t            temperature=0.2,\n726\t        )\n727\t    finally:\n728\t        await client.close()\n729\t    from .ai_analyzer import _extract_text\n730\t    return _extract_text(message).strip()\n731\t"}]},"parent_tool_use_id":"call_14fbefec6f4c427bbf12da10","session_id":"29257b8f-ede7-46a4-8e0f-a743591d296a","uuid":"d4595814-b6d3-49c6-a711-b8edc1ad4457","timestamp":"2026-06-09T05:10:24.008Z","subagent_type":"Explore","task_description":"Explore backend performance"}
