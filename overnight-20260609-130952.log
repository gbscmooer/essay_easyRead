{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call_34f356cc58fc4b14a4c20779","type":"tool_result","content":"1\timport { useEffect } from 'react'\n2\timport { useUIConfig } from '@/hooks/useConfig'\n3\timport { resolveTheme, applyTheme } from '@/theme/themes'\n4\t\n5\tconst FONT_MAP: Record<string, string> = {\n6\t  sans: \"'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Arial, sans-serif\",\n7\t  serif: \"'Times New Roman', Georgia, 'Noto Serif', serif\",\n8\t  mono: \"'Menlo', 'Monaco', 'Courier New', monospace\",\n9\t}\n10\t\n11\texport function ThemeProvider({ children }: { children: React.ReactNode }) {\n12\t  const config = useUIConfig()\n13\t\n14\t  useEffect(() => {\n15\t    const theme = resolveTheme(config.theme, config.custom_themes || [])\n16\t    applyTheme(theme)\n17\t  }, [config.theme, config.custom_themes])\n18\t\n19\t  useEffect(() => {\n20\t    const font = config.font || 'sans'\n21\t    let fontFamily = FONT_MAP[font] || FONT_MAP.sans\n22\t    if (font === 'custom' && config.custom_font) {\n23\t      fontFamily = `'${config.custom_font}', sans-serif`\n24\t    }\n25\t    document.documentElement.style.setProperty('--font-ui', fontFamily)\n26\t  }, [config.font, config.custom_font])\n27\t\n28\t  return <>{children}</>\n29\t}\n30\t"}]},"parent_tool_use_id":"call_bddd82a75f2e46b98e4517cc","session_id":"29257b8f-ede7-46a4-8e0f-a743591d296a","uuid":"8e66e5e1-2e16-43e9-8ba5-6f6febb0d21a","timestamp":"2026-06-09T05:10:34.350Z","subagent_type":"Explore","task_description":"Explore frontend performance"}
