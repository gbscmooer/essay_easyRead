{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call_752540c887c144e7a5ed61fc","type":"tool_result","content":"1\t/**\n2\t * useStreaming Hook\n3\t *\n4\t * 管理 SSE 连接，逐字段接收解析结果。\n5\t * 提供连接状态、已接收数据、重连逻辑。\n6\t *\n7\t * paperId 为 null 时不建立连接（idle 状态）。\n8\t * paperId 变化时自动断开旧连接、建立新连接。\n9\t * 这样可以在 useAnalysis 顶层无条件调用此 hook。\n10\t */\n11\t\n12\timport { useState, useEffect, useRef, useCallback } from 'react'\n13\timport type { AnalysisResult, AnalysisStatus } from '@/types'\n14\t\n15\t\n16\tinterface UseStreamingReturn {\n17\t  /** 当前解析状态 */\n18\t  status: AnalysisStatus\n19\t  /** 已接收的部分解析结果（字段逐步填充） */\n20\t  partialResult: Partial<AnalysisResult>\n21\t  /** 错误信息（status='failed' 时有值） */\n22\t  error: string | null\n23\t  /** 进度消息（如 \"正在分析方法论...\"） */\n24\t  progressMessage: string\n25\t  /** 后端计算的进度百分比（0-100），无 progress 事件时为 -1 */\n26\t  progress: number\n27\t  /** 相关论文模块的独立状态：idle 未开始 / loading 搜索中 / ok 完成 / failed 超时或失败 */\n28\t  relatedStatus: 'idle' | 'loading' | 'ok' | 'failed'\n29\t  /** 手动重连 */\n30\t  reconnect: () => void\n31\t}\n32\t\n33\t\n34\t/**\n35\t * 连接 SSE 端点，逐步接收解析结果。\n36\t *\n37\t * @param paperId 论文 ID，为 null 时不连接\n38\t * @param shouldConnect 是否建立连接（默认 true，传 false 可延迟连接）\n39\t * @returns 解析状态和部分结果\n40\t */\n41\texport function useStreaming(paperId: number | null, shouldConnect: boolean = true): UseStreamingReturn {\n42\t  const [status, setStatus] = useState<AnalysisStatus>('idle')\n43\t  const [partialResult, setPartialResult] = useState<Partial<AnalysisResult>>({})\n44\t  const [error, setError] = useState<string | null>(null)\n45\t  const [progressMessage, setProgressMessage] = useState('')\n46\t  const [progress, setProgress] = useState(-1)\n47\t  const [relatedStatus, setRelatedStatus] = useState<'idle' | 'loading' | 'ok' | 'failed'>('idle')\n48\t\n49\t  const eventSourceRef = useRef<EventSource | null>(null)\n50\t  const reconnectCountRef = useRef(0)\n51\t  const reconnectTimerRef = useRef<ReturnType<typeof setTimeout> | null>(null)\n52\t  const isUnmountedRef = useRef(false)\n53\t  // 主体完成后，相关论文阶段仍会发 status=analyzing 的 progress 事件，\n54\t  // 用此 ref 防止把已 done 的状态又拉回 analyzing（否则界面会闪回加载态）\n55\t  const mainDoneRef = useRef(false)\n56\t\n57\t  const cleanup = useCallback(() => {\n58\t    if (reconnectTimerRef.current !== null) {\n59\t      clearTimeout(reconnectTimerRef.current)\n60\t      reconnectTimerRef.current = null\n61\t    }\n62\t    if (eventSourceRef.current) {\n63\t      eventSourceRef.current.close()\n64\t      eventSourceRef.current = null\n65\t    }\n66\t  }, [])\n67\t\n68\t  const connect = useCallback(() => {\n69\t    cleanup()\n70\t\n71\t    if (paperId === null || !shouldConnect) {\n72\t      setStatus('idle')\n73\t      setPartialResult({})\n74\t      setError(null)\n75\t      setProgressMessage('')\n76\t      setProgress(-1)\n77\t      setRelatedStatus('idle')\n78\t      return\n79\t    }\n80\t\n81\t    const es = new EventSource(`/api/analysis/${paperId}/stream`)\n82\t    eventSourceRef.current = es\n83\t\n84\t    es.addEventListener('status', (e: MessageEvent) => {\n85\t      if (isUnmountedRef.current) return\n86\t      try {\n87\t        const data = JSON.parse(e.data)\n88\t        setStatus(data.status as AnalysisStatus)\n89\t        setProgressMessage(data.message || '')\n90\t      } catch {\n91\t        // 忽略解析错误\n92\t      }\n93\t    })\n94\t\n95\t    es.addEventListener('progress', (e: MessageEvent) => {\n96\t      if (isUnmountedRef.current) return\n97\t      try {\n98\t        const data = JSON.parse(e.data)\n99\t        if (typeof data.percent === 'number') setProgress(data.percent)\n100\t        // 主体完成后不再下调状态（相关论文阶段的 analyzing 进度不影响已展示的结果）\n101\t        if (data.status && !mainDoneRef.current) setStatus(data.status as AnalysisStatus)\n102\t        if (data.message) setProgressMessage(data.message)\n103\t      } catch {\n104\t        // 忽略解析错误\n105\t      }\n106\t    })\n107\t\n108\t    es.addEventListener('field', (e: MessageEvent) => {\n109\t      if (isUnmountedRef.current) return\n110\t      try {\n111\t        const data = JSON.parse(e.data)\n112\t        const fieldName = data.field_name as keyof AnalysisResult\n113\t        const value = data.value\n114\t        setPartialResult(prev => ({ ...prev, [fieldName]: value }))\n115\t      } catch {\n116\t        // 忽略解析错误\n117\t      }\n118\t    })\n119\t\n120\t    // 主体分析完成：立即切到 done 让前端渲染全部主体字段，但保持连接以接收相关论文\n121\t    // （相关论文模块的 loading/ok/failed 状态由后端的 related_status 事件驱动）\n122\t    es.addEventListener('main_done', () => {\n123\t      if (isUnmountedRef.current) return\n124\t      mainDoneRef.current = true\n125\t      setStatus('done')\n126\t    })\n127\t\n128\t    // 相关论文模块的独立状态\n129\t    es.addEventListener('related_status', (e: MessageEvent) => {\n130\t      if (isUnmountedRef.current) return\n131\t      try {\n132\t        const data = JSON.parse(e.data)\n133\t        if (data.status) setRelatedStatus(data.status)\n134\t      } catch {\n135\t        // 忽略解析错误\n136\t      }\n137\t    })\n138\t\n139\t    es.addEventListener('done', () => {\n140\t      if (isUnmountedRef.current) return\n141\t      setStatus('done')\n142\t      setProgressMessage('')\n143\t      setProgress(100)\n144\t      reconnectCountRef.current = 0\n145\t      es.close()\n146\t    })\n147\t\n148\t    es.addEventListener('error', (e: MessageEvent) => {\n149\t      if (isUnmountedRef.current) return\n150\t      try {\n151\t        const data = JSON.parse(e.data)\n152\t        setStatus('failed')\n153\t        setError(data.detail || data.message || '分析失败')\n154\t      } catch {\n155\t        setStatus('failed')\n156\t        setError('连接错误')\n157\t      }\n158\t      es.close()\n159\t    })\n160\t\n161\t    es.onopen = () => {\n162\t      reconnectCountRef.current = 0\n163\t    }\n164\t\n165\t    es.onerror = () => {\n166\t      if (isUnmountedRef.current) return\n167\t      es.close()\n168\t      eventSourceRef.current = null\n169\t\n170\t      // 自动重连（最多 3 次，间隔递增：1s, 2s, 4s）\n171\t      if (reconnectCountRef.current < 3) {\n172\t        const delay = Math.pow(2, reconnectCountRef.current) * 1000\n173\t        reconnectCountRef.current += 1\n174\t        reconnectTimerRef.current = setTimeout(() => {\n175\t          if (!isUnmountedRef.current) {\n176\t            connect()\n177\t          }\n178\t        }, delay)\n179\t      } else {\n180\t        setStatus('failed')\n181\t        setError('连接中断，请刷新重试')\n182\t      }\n183\t    }\n184\t  }, [paperId, shouldConnect, cleanup])\n185\t\n186\t  const reconnect = useCallback(() => {\n187\t    reconnectCountRef.current = 0\n188\t    setError(null)\n189\t    setStatus('idle')\n190\t    connect()\n191\t  }, [connect])\n192\t\n193\t  useEffect(() => {\n194\t    isUnmountedRef.current = false\n195\t    reconnectCountRef.current = 0\n196\t    mainDoneRef.current = false\n197\t    setPartialResult({})\n198\t    setError(null)\n199\t    setProgressMessage('')\n200\t    setProgress(-1)\n201\t    setRelatedStatus('idle')\n202\t    connect()\n203\t\n204\t    return () => {\n205\t      isUnmountedRef.current = true\n206\t      cleanup()\n207\t    }\n208\t  }, [paperId, shouldConnect, connect, cleanup])\n209\t\n210\t  return {\n211\t    status,\n212\t    partialResult,\n213\t    error,\n214\t    progressMessage,\n215\t    progress,\n216\t    relatedStatus,\n217\t    reconnect,\n218\t  }\n219\t}\n220\t"}]},"parent_tool_use_id":"call_bddd82a75f2e46b98e4517cc","session_id":"29257b8f-ede7-46a4-8e0f-a743591d296a","uuid":"476ef902-bf6e-40b7-874f-54693c71c45d","timestamp":"2026-06-09T05:10:32.314Z","subagent_type":"Explore","task_description":"Explore frontend performance"}
