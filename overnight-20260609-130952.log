{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call_dc85c8fce2c443cf9b6e6cd7","type":"tool_result","content":"1\t\"\"\"\n2\tAI 分析服务\n3\t\n4\t调用 MiMo API（Anthropic 格式端点）对论文文本进行结构化解析。\n5\t支持真流式输出和增量 JSON 解析。\n6\t\n7\t借鉴 DeepTutor 的重试机制和错误处理模式。\n8\t\"\"\"\n9\t\n10\timport asyncio\n11\timport json\n12\timport re\n13\timport logging\n14\tfrom typing import AsyncGenerator\n15\tfrom ..models.schemas import StreamEvent\n16\t\n17\tlogger = logging.getLogger(__name__)\n18\t\n19\t# 重试配置（借鉴 DeepTutor）\n20\tMAX_RETRIES = 5\n21\tBASE_DELAY = 3.0  # 秒\n22\tMAX_DELAY = 120.0  # 秒\n23\tTRANSIENT_STATUS_CODES = {429, 500, 502, 503, 504}\n24\tTRANSIENT_MARKERS = [\"rate limit\", \"timeout\", \"overloaded\", \"capacity\"]\n25\t\n26\t\n27\tdef _is_transient_error(exc: Exception) -> bool:\n28\t    \"\"\"判断是否为瞬态错误（可重试）\"\"\"\n29\t    msg = str(exc).lower()\n30\t    # HTTP 状态码\n31\t    for code in TRANSIENT_STATUS_CODES:\n32\t        if str(code) in msg:\n33\t            return True\n34\t    # 常见瞬态错误关键词\n35\t    for marker in TRANSIENT_MARKERS:\n36\t        if marker in msg:\n37\t            return True\n38\t    return False\n39\t\n40\t\n41\tdef _build_retry_delays() -> list[float]:\n42\t    \"\"\"构建指数退避延迟序列\"\"\"\n43\t    delays = []\n44\t    delay = BASE_DELAY\n45\t    for _ in range(MAX_RETRIES):\n46\t        delays.append(min(delay, MAX_DELAY))\n47\t        delay *= 2\n48\t    return delays\n49\t\n50\t\n51\t# AI 系统提示词\n52\tSYSTEM_PROMPT = \"\"\"你是一个专业的学术论文分析助手，擅长 CV/ML 领域的论文精读。\n53\t用户会提供一篇论文的全文内容，你需要进行深度分析并输出结构化的 JSON 结果。\n54\t\n55\t请严格按照以下 JSON 格式输出，不要添加任何额外文字：\n56\t\n57\t{\n58\t  \"title\": \"论文标题\",\n59\t  \"authors\": \"作者1, 作者2, 作者3（从论文中提取完整作者列表，去除上标数字和特殊符号）\",\n60\t  \"venue\": \"发表会议/期刊（CVPR/ICCV/NeurIPS/ECCV/AAAI/ICML/ICLR 等，如无法判断则填 'Unknown'）\",\n61\t  \"year\": 2024,\n62\t  \"one_sentence\": \"一句话核心贡献，适合在面试中清晰表达\",\n63\t  \"problem\": \"这篇论文要解决什么问题？现有方法有什么局限性？\",\n64\t  \"key_contributions\": [\"贡献1\", \"贡献2\", \"贡献3\"],\n65\t  \"outline\": [\n66\t    {\"section\": \"Introduction\", \"page\": \"1-2\", \"summary\": \"本节介绍了...\"},\n67\t    {\"section\": \"Related Work\", \"page\": \"2-3\", \"summary\": \"回顾了...\"},\n68\t    {\"section\": \"Method\", \"page\": \"3-5\", \"summary\": \"提出了...\"},\n69\t    {\"section\": \"Experiments\", \"page\": \"5-7\", \"summary\": \"实验结果表明...\"},\n70\t    {\"section\": \"Conclusion\", \"page\": \"8\", \"summary\": \"总结了...\"}\n71\t  ],\n72\t  \"method\": {\n73\t    \"overview\": \"方法的总体描述\",\n74\t    \"pipeline\": \"Step 1: ...\\nStep 2: ...\\nStep 3: ...\",\n75\t    \"key_modules\": [\n76\t      {\"name\": \"模块名\", \"role\": \"作用\", \"innovation\": \"创新点\"}\n77\t    ],\n78\t    \"mermaid_chart\": \"graph TD\\\\n    A[Input] --> B[Process]\\\\n    B --> C[Output]\"\n79\t  },\n80\t  \"experiments\": {\n81\t    \"datasets\": [\"数据集1\", \"数据集2\"],\n82\t    \"baselines\": [\"方法1\", \"方法2\"],\n83\t    \"main_results\": \"主要实验结论\",\n84\t    \"ablation\": \"消融实验说明了什么\",\n85\t    \"result_table\": [\n86\t      {\"method\": \"本文方法\", \"dataset\": \"数据集名\", \"metric\": \"指标名\", \"value\": \"数值\"},\n87\t      {\"method\": \"Baseline A\", \"dataset\": \"数据集名\", \"metric\": \"指标名\", \"value\": \"数值\"}\n88\t    ],\n89\t    \"figures\": [\n90\t      {\n91\t        \"name\": \"Table 1\",\n92\t        \"caption\": \"在 XX 数据集上与 SOTA 方法的对比\",\n93\t        \"page\": \"6\",\n94\t        \"chart_type\": \"bar\",\n95\t        \"columns\": [\"Method\", \"mAP\", \"F1\"],\n96\t        \"rows\": [\n97\t          [\"Ours\", \"52.3\", \"48.1\"],\n98\t          [\"Baseline A\", \"49.1\", \"45.6\"]\n99\t        ],\n100\t        \"interpretation\": \"本文方法在 mAP 和 F1 指标上均优于所有基线方法...\"\n101\t      }\n102\t    ]\n103\t  },\n104\t  \"code_mapping\": [\n105\t    {\"concept\": \"论文中的概念/公式\", \"likely_implementation\": \"PyTorch 风格的代码实现思路\"}\n106\t  ],\n107\t  \"interview_qa\": [\n108\t    {\"q\": \"面试问题\", \"a\": \"简洁清晰的回答\", \"source\": \"Section X.Y, Page Z\"}\n109\t  ],\n110\t  \"limitations\": \"局限性和未来工作方向\"\n111\t}\n112\t\n113\t要求：\n114\t1. one_sentence 要简洁有力，能让人在30秒内理解论文核心\n115\t2. authors 从论文中提取完整的作者列表，去除上标数字（如 ∗1,2）、特殊符号（如 ¨o → o），用逗号分隔\n116\t3. outline 按论文实际章节结构列出每节的标题、页码和内容概述，page 字段填写该章节在论文中的起始页码（纯数字），用于跳转\n117\t3. method.pipeline 要用清晰的步骤描述完整流程\n118\t4. method.mermaid_chart 用 Mermaid graph TD 语法画出 pipeline 流程图。严格遵守以下规则：\n119\t   - 节点文本只能用英文、数字、空格，不能用括号 () [] {} 等特殊字符\n120\t   - 箭头用 --> 连接\n121\t   - 每行一个连接，不要把多行写在一行里\n122\t   - 节点ID用简短英文如 A, B, C 或 Step1, Step2\n123\t   - 示例：graph TD\\\\n    A[Input Image] --> B[Feature Extraction]\\\\n    B --> C[Anomaly Detection]\n124\t5. key_modules 列出 2-4 个最关键的模块\n125\t6. experiments.figures 是重点：逐一列出论文中每一个数据表格(Table)和图表(Figure)，每个都要：\n126\t   - name: 图表编号，如 \"Table 1\", \"Figure 3\"\n127\t   - caption: 图表的原始标题或说明文字\n128\t   - page: 该图表所在的页码（纯数字，如 \"6\"），用于点击跳转到论文对应页\n129\t   - chart_type: 推荐可视化类型（bar=柱状图, line=折线图, scatter=散点图, table=纯表格）\n130\t   - columns: 表格的列名数组\n131\t   - rows: 表格数据，每行是字符串数组，数值保持原始精度\n132\t   - interpretation: AI 对该图表的解读（2-3句话），说明图表展示了什么结论\n133\t   注意：不要遗漏任何一个 Table 或 Figure！每个图表都必须有独立的分析。\n134\t7. experiments.result_table 保留作为汇总（可从 figures 中提取主要对比数据）\n135\t8. code_mapping 给出 3-5 个核心概念的代码映射\n136\t9. interview_qa 生成 5-8 个高频面试问题，每个问题的 source 字段标注答案来源于论文的哪个章节和页码（如 \"Section 3.2, Page 5\"）\n137\t10. 所有内容基于论文实际内容，不要编造\"\"\"\n138\t\n139\t\n140\t# 顶层字段名列表，用于检测 JSON 中哪些字段已完整\n141\t_TOP_LEVEL_FIELDS = [\n142\t    \"title\", \"authors\", \"venue\", \"year\", \"one_sentence\", \"problem\",\n143\t    \"key_contributions\", \"outline\", \"method\", \"experiments\",\n144\t    \"code_mapping\", \"interview_qa\", \"limitations\",\n145\t]\n146\t\n147\t\n148\tdef _try_parse_partial_json(text: str) -> dict | None:\n149\t    \"\"\"\n150\t    尝试从不完整的 JSON 字符串中提取已完成的顶层字段。\n151\t\n152\t    策略：找到每个顶层字段的键，提取其值（处理嵌套括号），\n153\t    尝试构建一个只有已完成字段的完整 JSON 并 parse。\n154\t\n155\t    Returns:\n156\t        已解析的字段 dict，或 None（如果无法解析任何字段）\n157\t    \"\"\"\n158\t    result = {}\n159\t    for field in _TOP_LEVEL_FIELDS:\n160\t        # 匹配 \"field_name\": 后面的内容\n161\t        pattern = f'\"{field}\"\\\\s*:\\\\s*'\n162\t        match = re.search(pattern, text)\n163\t        if not match:\n164\t            continue\n165\t\n166\t        start = match.end()\n167\t        remaining = text[start:]\n168\t\n169\t        # 提取该字段的值（处理嵌套 {} 和 []）\n170\t        value_str = _extract_json_value(remaining)\n171\t        if value_str is None:\n172\t            continue\n173\t\n174\t        try:\n175\t            result[field] = json.loads(value_str)\n176\t        except json.JSONDecodeError:\n177\t            continue\n178\t\n179\t    return result if result else None\n180\t\n181\t\n182\tdef _extract_json_value(text: str) -> str | None:\n183\t    \"\"\"\n184\t    从 JSON 片段中提取第一个完整的值（字符串/数字/对象/数组）。\n185\t\n186\t    处理嵌套括号和字符串中的转义引号。\n187\t    \"\"\"\n188\t    if not text:\n189\t        return None\n190\t\n191\t    # 跳过前导空白\n192\t    text = text.lstrip()\n193\t\n194\t    if text[0] == '\"':\n195\t        # 字符串值：找到未转义的结束引号\n196\t        i = 1\n197\t        while i < len(text):\n198\t            if text[i] == '\\\\':\n199\t                i += 2  # 跳过转义字符\n200\t                continue\n201\t            if text[i] == '\"':\n202\t                return text[:i + 1]\n203\t            i += 1\n204\t        return None  # 字符串未闭合\n205\t\n206\t    if text[0] in ('{', '['):\n207\t        # 对象或数组：匹配括号\n208\t        open_char = text[0]\n209\t        close_char = '}' if open_char == '{' else ']'\n210\t        depth = 0\n211\t        in_string = False\n212\t        i = 0\n213\t        while i < len(text):\n214\t            c = text[i]\n215\t            if c == '\\\\':\n216\t                i += 2\n217\t                continue\n218\t            if c == '\"':\n219\t                in_string = not in_string\n220\t            elif not in_string:\n221\t                if c == open_char:\n222\t                    depth += 1\n223\t                elif c == close_char:\n224\t                    depth -= 1\n225\t                    if depth == 0:\n226\t                        return text[:i + 1]\n227\t            i += 1\n228\t        return None  # 括号未闭合\n229\t\n230\t    # 数字/布尔/null：取到下一个逗号或 } 或 ]\n231\t    for i, c in enumerate(text):\n232\t        if c in (',', '}', ']', '\\n'):\n233\t            return text[:i].rstrip()\n234\t    return text\n235\t\n236\t\n237\tdef _sanitize_content(text: str) -> str:\n238\t    \"\"\"\n239\t    清理内容，防止空内容导致 API 400 错误。\n240\t    借鉴 DeepTutor 的 _sanitize_empty_content 模式。\n241\t    \"\"\"\n242\t    if not text or not text.strip():\n243\t        return \"（空内容）\"\n244\t    return text\n245\t\n246\t\n247\tdef _create_client(api_key: str, base_url: str):\n248\t    \"\"\"\n249\t    创建 Anthropic 客户端。\n250\t\n251\t    MiMo 使用 api-key 头而非标准的 x-api-key，\n252\t    通过 default_headers 传递正确的认证格式。\n253\t    \"\"\"\n254\t    from anthropic import AsyncAnthropic\n255\t\n256\t    # 规范化 base_url：去掉末尾的 /v1 或 /（SDK 会自动加 /v1/messages）\n257\t    if base_url:\n258\t        base_url = base_url.rstrip(\"/\")\n259\t        if base_url.endswith(\"/v1\"):\n260\t            base_url = base_url[:-3]\n261\t\n262\t    return AsyncAnthropic(\n263\t        api_key=api_key,\n264\t        base_url=base_url,\n265\t        default_headers={\"api-key\": api_key},\n266\t    )\n267\t\n268\t\n269\tdef _extract_text(message) -> str:\n270\t    \"\"\"从 Anthropic 响应中提取第一个文本 block 的内容。\n271\t\n272\t    MiMo 等模型会在 content 里返回 ThinkingBlock，content[0] 不一定是 TextBlock。\n273\t    此函数跳过所有非文本 block，返回第一个有 .text 属性的 block 内容。\n274\t    \"\"\"\n275\t    for block in message.content:\n276\t        if hasattr(block, \"text\"):\n277\t            return block.text\n278\t    return \"\"\n279\t\n280\t\n281\tasync def analyze_paper_stream(\n282\t    pdf_text: str, api_key: str, base_url: str, model: str,\n283\t    temperature: float = 0.1, max_tokens: int = 16384,\n284\t    system_prompt: str | None = None,\n285\t) -> AsyncGenerator[StreamEvent, None]:\n286\t    \"\"\"\n287\t    真流式调用 AI 分析论文（Anthropic SDK）。\n288\t\n289\t    使用 Anthropic SDK 的 messages.stream() API，\n290\t    每收到一个 chunk 就尝试增量解析 JSON，已完成的字段立即 yield。\n291\t\n292\t    借鉴 DeepTutor 的重试机制：对瞬态错误进行指数退避重试。\n293\t\n294\t    Args:\n295\t        pdf_text: 论文全文文本\n296\t        api_key: MiMo API Key\n297\t        base_url: API 基础 URL（Anthropic 格式端点）\n298\t        model: 模型名称\n299\t        temperature: 生成温度\n300\t        max_tokens: 最大输出 token 数\n301\t\n302\t    Yields:\n303\t        StreamEvent: 流式事件，包含进度状态和解析字段\n304\t    \"\"\"\n305\t    yield StreamEvent(event=\"status\", data={\"message\": \"正在分析论文内容...\"})\n306\t\n307\t    system = system_prompt or SYSTEM_PROMPT\n308\t    pdf_text = _sanitize_content(pdf_text)\n309\t    delays = _build_retry_delays()\n310\t\n311\t    for attempt in range(MAX_RETRIES + 1):\n312\t        client = _create_client(api_key, base_url)\n313\t        try:\n314\t            accumulated = \"\"\n315\t            yielded_fields: set[str] = set()\n316\t\n317\t            async with client.messages.stream(\n318\t                model=model,\n319\t                max_tokens=max_tokens,\n320\t                system=system,\n321\t                messages=[{\"role\": \"user\", \"content\": pdf_text}],\n322\t                temperature=temperature,\n323\t            ) as stream:\n324\t                async for text_chunk in stream.text_stream:\n325\t                    accumulated += text_chunk\n326\t\n327\t                    # 尝试增量解析\n328\t                    parsed = _try_parse_partial_json(accumulated)\n329\t                    if parsed:\n330\t                        for field_name in _TOP_LEVEL_FIELDS:\n331\t                            if field_name in parsed and field_name not in yielded_fields:\n332\t                                yielded_fields.add(field_name)\n333\t                                yield StreamEvent(\n334\t                                    event=\"field\",\n335\t                                    field_name=field_name,\n336\t                                    data={\"value\": parsed[field_name]},\n337\t                                )\n338\t\n339\t            # 流结束，确保所有字段都被 yield\n340\t            try:\n341\t                final = json.loads(accumulated)\n342\t            except json.JSONDecodeError as e:\n343\t                logger.warning(f\"Final JSON parse failed: {e}, accumulated length: {len(accumulated)}\")\n344\t                # 尝试从不完整 JSON 中提取已有字段\n345\t                partial = _try_parse_partial_json(accumulated)\n346\t                if partial:\n347\t                    final = partial\n348\t                else:\n349\t                    raise ValueError(f\"无法解析 AI 返回的 JSON: {e}\")\n350\t\n351\t            for field_name in _TOP_LEVEL_FIELDS:\n352\t                if field_name in final and field_name not in yielded_fields:\n353\t                    yielded_fields.add(field_name)\n354\t                    yield StreamEvent(\n355\t                        event=\"field\",\n356\t                        field_name=field_name,\n357\t                        data={\"value\": final[field_name]},\n358\t                    )\n359\t\n360\t            # mermaid_chart 嵌套在 method 中，单独提取\n361\t            mermaid = final.get(\"method\", {}).get(\"mermaid_chart\")\n362\t            if mermaid:\n363\t                yield StreamEvent(\n364\t                    event=\"field\",\n365\t                    field_name=\"mermaid_chart\",\n366\t                    data={\"value\": mermaid},\n367\t                )\n368\t\n369\t            yield StreamEvent(event=\"done\", data={\"message\": \"解析完成\"})\n370\t            return  # 成功，退出重试循环\n371\t\n372\t        except Exception as e:\n373\t            if _is_transient_error(e) and attempt < MAX_RETRIES:\n374\t                delay = delays[attempt]\n375\t                logger.warning(f\"Transient error (attempt {attempt + 1}/{MAX_RETRIES + 1}): {e}. Retrying in {delay:.1f}s...\")\n376\t                yield StreamEvent(\n377\t                    event=\"status\",\n378\t                    data={\"message\": f\"遇到临时错误，正在重试（{attempt + 1}/{MAX_RETRIES + 1}）...\"},\n379\t                )\n380\t                await asyncio.sleep(delay)\n381\t                continue\n382\t\n383\t            logger.error(f\"Analysis failed: {e}\")\n384\t            yield StreamEvent(event=\"error\", data={\"message\": f\"解析失败: {str(e)}\"})\n385\t            return\n386\t        finally:\n387\t            await client.close()\n388\t\n389\t\n390\tdef extract_code_url(pdf_text: str) -> str:\n391\t    \"\"\"\n392\t    用正则从论文全文中提取代码仓库 URL。\n393\t\n394\t    搜索 github.com、gitlab.com、bitbucket.org、gitee.com 等代码托管平台的链接。\n395\t    优先返回 github.com 的链接（最常见）。\n396\t\n397\t    Args:\n398\t        pdf_text: 论文全文\n399\t\n400\t    Returns:\n401\t        代码仓库 URL，未找到则返回空字符串\n402\t    \"\"\"\n403\t    import re\n404\t\n405\t    # 匹配代码仓库 URL（支持有/无 https:// 前缀）\n406\t    # 有前缀: https://github.com/user/repo\n407\t    # 无前缀: github.com/user/repo（常见于论文脚注）\n408\t    pattern = r'(?:https?://)?(?:www\\.)?(?:github\\.com|gitlab\\.com|bitbucket\\.org|gitee\\.com)/[\\w\\-./]+'\n409\t    matches = re.findall(pattern, pdf_text)\n410\t\n411\t    if not matches:\n412\t        return \"\"\n413\t\n414\t    # 清理 URL\n415\t    cleaned = []\n416\t    for url in matches:\n417\t        # 去掉末尾标点\n418\t        url = url.rstrip(\".,;:!?\")\n419\t        # 去掉 URL fragment (#...)\n420\t        if \"#\" in url:\n421\t            url = url[:url.index(\"#\")]\n422\t        # 去掉尾部斜杠\n423\t        url = url.rstrip(\"/\")\n424\t        # 只保留 owner/repo（去掉更深的路径如 /issues/123）\n425\t        parts = url.split(\"/\")\n426\t        for i, part in enumerate(parts):\n427\t            if part in (\"github.com\", \"gitlab.com\", \"bitbucket.org\", \"gitee.com\"):\n428\t                if i + 2 < len(parts):\n429\t                    clean_url = \"/\".join(parts[:i + 3])\n430\t                    cleaned.append(clean_url)\n431\t                elif i + 1 < len(parts):\n432\t                    clean_url = \"/\".join(parts[:i + 2])\n433\t                    cleaned.append(clean_url)\n434\t                break\n435\t        else:\n436\t            cleaned.append(url)\n437\t\n438\t    # 去重，保持顺序\n439\t    seen = set()\n440\t    unique = []\n441\t    for url in cleaned:\n442\t        normalized = url.rstrip(\"/\").lower()\n443\t        if normalized not in seen:\n444\t            seen.add(normalized)\n445\t            unique.append(url)\n446\t\n447\t    # 优先返回 github.com 链接\n448\t    for url in unique:\n449\t        if \"github.com\" in url:\n450\t            return url\n451\t\n452\t    return unique[0] if unique else \"\"\n453\t"}]},"parent_tool_use_id":"call_14fbefec6f4c427bbf12da10","session_id":"29257b8f-ede7-46a4-8e0f-a743591d296a","uuid":"6a7f812a-1014-43f1-b7c0-2f0410d87f35","timestamp":"2026-06-09T05:10:18.291Z","subagent_type":"Explore","task_description":"Explore backend performance"}
