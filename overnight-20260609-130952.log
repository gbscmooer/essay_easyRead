{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call_9b99abf25c084a1eb0f566e7","type":"tool_result","content":"1\t\"\"\"\n2\t数据库服务\n3\t\n4\tSQLite + SQLModel 的数据库初始化和 CRUD 操作。\n5\t\"\"\"\n6\t\n7\tfrom datetime import datetime, timezone\n8\tfrom typing import Optional\n9\tfrom sqlmodel import Session, create_engine, SQLModel, select, col\n10\tfrom sqlalchemy import func\n11\t\n12\tfrom ..models.paper import Paper\n13\tfrom ..models.analysis import AnalysisResult\n14\tfrom ..models.code_analysis import CodeAnalysis\n15\tfrom ..models.research import ResearchRun, ResearchGraph\n16\tfrom ..models.tag import Tag, PaperTag\n17\tfrom ..models.note import Note\n18\tfrom ..models.annotation import Annotation\n19\t\n20\t\n21\tdef _migrate_schema(engine) -> None:\n22\t    \"\"\"简易 schema 迁移：为已有表添加缺失的列\"\"\"\n23\t    import logging\n24\t    logger = logging.getLogger(__name__)\n25\t\n26\t    with engine.connect() as conn:\n27\t        # 检查 analysis_results 表的列\n28\t        try:\n29\t            result = conn.exec_driver_sql(\"PRAGMA table_info(analysis_results)\")\n30\t            existing_cols = {row[1] for row in result.fetchall()}\n31\t        except Exception:\n32\t            existing_cols = set()\n33\t\n34\t        # analysis_results 表迁移\n35\t        analysis_migrations = [\n36\t            (\"outline\", \"JSON DEFAULT '[]'\"),\n37\t            (\"authors\", \"TEXT DEFAULT ''\"),\n38\t        ]\n39\t        for col_name, col_def in analysis_migrations:\n40\t            if col_name not in existing_cols:\n41\t                try:\n42\t                    conn.exec_driver_sql(f\"ALTER TABLE analysis_results ADD COLUMN {col_name} {col_def}\")\n43\t                    conn.commit()\n44\t                    logger.info(f\"Migration: added column {col_name} to analysis_results\")\n45\t                except Exception as e:\n46\t                    logger.warning(f\"Migration failed for {col_name}: {e}\")\n47\t\n48\t        # papers 表迁移：代码仓库相关字段\n49\t        try:\n50\t            result = conn.exec_driver_sql(\"PRAGMA table_info(papers)\")\n51\t            existing_paper_cols = {row[1] for row in result.fetchall()}\n52\t        except Exception:\n53\t            existing_paper_cols = set()\n54\t\n55\t        paper_migrations = [\n56\t            (\"code_url\", \"TEXT\"),\n57\t            (\"code_status\", \"TEXT DEFAULT 'none'\"),\n58\t            (\"code_path\", \"TEXT\"),\n59\t            (\"code_summary\", \"TEXT\"),\n60\t            (\"source\", \"TEXT DEFAULT 'uploaded'\"),\n61\t            (\"level\", \"INTEGER DEFAULT 1\"),\n62\t            (\"parent_paper_id\", \"INTEGER\"),\n63\t            (\"external_id\", \"TEXT\"),\n64\t            (\"authors\", \"TEXT\"),\n65\t            (\"full_text\", \"TEXT\"),\n66\t            (\"index_status\", \"TEXT DEFAULT 'none'\"),\n67\t            (\"category\", \"TEXT\"),\n68\t        ]\n69\t        for col_name, col_def in paper_migrations:\n70\t            if col_name not in existing_paper_cols:\n71\t                try:\n72\t                    conn.exec_driver_sql(f\"ALTER TABLE papers ADD COLUMN {col_name} {col_def}\")\n73\t                    conn.commit()\n74\t                    logger.info(f\"Migration: added column {col_name} to papers\")\n75\t                except Exception as e:\n76\t                    logger.warning(f\"Migration failed for {col_name}: {e}\")\n77\t\n78\t        # code_analyses 表迁移\n79\t        try:\n80\t            result = conn.exec_driver_sql(\"PRAGMA table_info(code_analyses)\")\n81\t            existing_code_cols = {row[1] for row in result.fetchall()}\n82\t        except Exception:\n83\t            existing_code_cols = set()\n84\t\n85\t        code_migrations = [\n86\t            (\"node_metrics\", \"JSON DEFAULT '[]'\"),\n87\t        ]\n88\t        for col_name, col_def in code_migrations:\n89\t            if col_name not in existing_code_cols:\n90\t                try:\n91\t                    conn.exec_driver_sql(f\"ALTER TABLE code_analyses ADD COLUMN {col_name} {col_def}\")\n92\t                    conn.commit()\n93\t                    logger.info(f\"Migration: added column {col_name} to code_analyses\")\n94\t                except Exception as e:\n95\t                    logger.warning(f\"Migration failed for {col_name}: {e}\")\n96\t\n97\t        # 数据回填：早期 expand 阶段创建的 paper 没有正确写 level\n98\t        # source='expanded' 的论文按定义就是 L2+，level=1 是历史脏数据\n99\t        try:\n100\t            cur = conn.exec_driver_sql(\n101\t                \"UPDATE papers SET level = 2 WHERE source = 'expanded' AND (level IS NULL OR level = 1)\"\n102\t            )\n103\t            conn.commit()\n104\t            if cur.rowcount:\n105\t                logger.info(f\"Migration: backfilled level=2 for {cur.rowcount} expanded papers\")\n106\t        except Exception as e:\n107\t            logger.warning(f\"Migration backfill expanded.level failed: {e}\")\n108\t\n109\t        # annotations 表迁移：group_id 字段\n110\t        try:\n111\t            result = conn.exec_driver_sql(\"PRAGMA table_info(annotations)\")\n112\t            existing_ann_cols = {row[1] for row in result.fetchall()}\n113\t        except Exception:\n114\t            existing_ann_cols = set()\n115\t\n116\t        ann_migrations = [\n117\t            (\"group_id\", \"TEXT\"),\n118\t        ]\n119\t        for col_name, col_def in ann_migrations:\n120\t            if col_name not in existing_ann_cols:\n121\t                try:\n122\t                    conn.exec_driver_sql(f\"ALTER TABLE annotations ADD COLUMN {col_name} {col_def}\")\n123\t                    conn.commit()\n124\t                    logger.info(f\"Migration: added column {col_name} to annotations\")\n125\t                except Exception as e:\n126\t                    logger.warning(f\"Migration failed for {col_name}: {e}\")\n127\t\n128\t\n129\tdef init_db(database_url: str) -> None:\n130\t    \"\"\"\n131\t    初始化数据库。\n132\t\n133\t    创建所有表（如果不存在）。\n134\t    在应用启动时调用一次。\n135\t\n136\t    Args:\n137\t        database_url: 数据库连接字符串（应为绝对路径）\n138\t    \"\"\"\n139\t    engine = create_engine(database_url, connect_args={\"check_same_thread\": False})\n140\t    SQLModel.metadata.create_all(engine)\n141\t\n142\t    # 简易迁移：为已有表添加新列\n143\t    _migrate_schema(engine)\n144\t\n145\t\n146\tdef create_paper(session: Session, filename: str, pdf_path: str, file_size: int) -> int:\n147\t    \"\"\"\n148\t    创建论文记录。\n149\t\n150\t    Args:\n151\t        session: 数据库会话\n152\t        filename: 原始文件名\n153\t        pdf_path: 服务器存储路径\n154\t        file_size: 文件大小（字节）\n155\t\n156\t    Returns:\n157\t        int: 新创建的论文 ID\n158\t    \"\"\"\n159\t    paper = Paper(filename=filename, pdf_path=pdf_path, file_size=file_size)\n160\t    session.add(paper)\n161\t    session.commit()\n162\t    session.refresh(paper)\n163\t    return paper.id\n164\t\n165\t\n166\tdef update_paper_status(session: Session, paper_id: int, status: str, error_message: Optional[str] = None) -> None:\n167\t    \"\"\"\n168\t    更新论文解析状态。\n169\t\n170\t    Args:\n171\t        session: 数据库会话\n172\t        paper_id: 论文 ID\n173\t        status: 新状态（pending | extracting | analyzing | done | failed）\n174\t        error_message: 失败时的错误信息\n175\t    \"\"\"\n176\t    paper = session.get(Paper, paper_id)\n177\t    if paper is None:\n178\t        raise ValueError(f\"Paper {paper_id} not found\")\n179\t    paper.status = status\n180\t    paper.error_message = error_message\n181\t    session.add(paper)\n182\t    session.commit()\n183\t\n184\t\n185\tdef update_paper_metadata(session: Session, paper_id: int, title: str, venue: str, year: int) -> None:\n186\t    \"\"\"\n187\t    更新论文元信息（解析完成后）。\n188\t\n189\t    Args:\n190\t        session: 数据库会话\n191\t        paper_id: 论文 ID\n192\t        title: 论文标题\n193\t        venue: 会议/期刊\n194\t        year: 发表年份\n195\t    \"\"\"\n196\t    paper = session.get(Paper, paper_id)\n197\t    if paper is None:\n198\t        raise ValueError(f\"Paper {paper_id} not found\")\n199\t    paper.title = title\n200\t    paper.venue = venue\n201\t    paper.year = year\n202\t    session.add(paper)\n203\t    session.commit()\n204\t\n205\t\n206\tdef save_analysis_result(session: Session, paper_id: int, result: dict) -> None:\n207\t    \"\"\"\n208\t    保存解析结果。\n209\t\n210\t    将 AI 返回的完整 JSON 存入 AnalysisResult 表。\n211\t    如果已存在则更新（upsert）。\n212\t\n213\t    Args:\n214\t        session: 数据库会话\n215\t        paper_id: 论文 ID\n216\t        result: AI 返回的完整解析结果 dict\n217\t    \"\"\"\n218\t    # 查找已有的分析结果\n219\t    statement = select(AnalysisResult).where(AnalysisResult.paper_id == paper_id)\n220\t    existing = session.exec(statement).first()\n221\t\n222\t    method_data = dict(result.get(\"method\", {}))\n223\t    # 从 method 中提取 mermaid_chart，因为它需要单独存储\n224\t    mermaid = method_data.pop(\"mermaid_chart\", None)\n225\t\n226\t    if existing:\n227\t        existing.title = result.get(\"title\", \"\")\n228\t        existing.venue = result.get(\"venue\", \"\")\n229\t        existing.year = result.get(\"year\", 0)\n230\t        existing.one_sentence = result.get(\"one_sentence\", \"\")\n231\t        existing.problem = result.get(\"problem\", \"\")\n232\t        existing.key_contributions = result.get(\"key_contributions\", [])\n233\t        existing.outline = result.get(\"outline\", [])\n234\t        existing.method = method_data\n235\t        existing.experiments = result.get(\"experiments\", {})\n236\t        existing.code_mapping = result.get(\"code_mapping\", [])\n237\t        existing.interview_qa = result.get(\"interview_qa\", [])\n238\t        existing.limitations = result.get(\"limitations\", \"\")\n239\t        existing.related_papers = result.get(\"related_papers\", [])\n240\t        existing.mermaid_chart = mermaid\n241\t        session.add(existing)\n242\t    else:\n243\t        analysis = AnalysisResult(\n244\t            paper_id=paper_id,\n245\t            title=result.get(\"title\", \"\"),\n246\t            venue=result.get(\"venue\", \"\"),\n247\t            year=result.get(\"year\", 0),\n248\t            one_sentence=result.get(\"one_sentence\", \"\"),\n249\t            problem=result.get(\"problem\", \"\"),\n250\t            key_contributions=result.get(\"key_contributions\", []),\n251\t            outline=result.get(\"outline\", []),\n252\t            method=method_data,\n253\t            experiments=result.get(\"experiments\", {}),\n254\t            code_mapping=result.get(\"code_mapping\", []),\n255\t            interview_qa=result.get(\"interview_qa\", []),\n256\t            limitations=result.get(\"limitations\", \"\"),\n257\t            related_papers=result.get(\"related_papers\", []),\n258\t            mermaid_chart=mermaid,\n259\t        )\n260\t        session.add(analysis)\n261\t\n262\t    session.commit()\n263\t\n264\t\n265\tdef get_paper(session: Session, paper_id: int) -> dict:\n266\t    \"\"\"\n267\t    获取单篇论文信息。\n268\t\n269\t    Args:\n270\t        session: 数据库会话\n271\t        paper_id: 论文 ID\n272\t\n273\t    Returns:\n274\t        dict: 论文信息字典\n275\t\n276\t    Raises:\n277\t        ValueError: 论文不存在\n278\t    \"\"\"\n279\t    paper = session.get(Paper, paper_id)\n280\t    if paper is None:\n281\t        raise ValueError(f\"Paper {paper_id} not found\")\n282\t    return {\n283\t        \"id\": paper.id,\n284\t        \"filename\": paper.filename,\n285\t        \"pdf_path\": paper.pdf_path,\n286\t        \"title\": paper.title,\n287\t        \"authors\": paper.authors,\n288\t        \"venue\": paper.venue,\n289\t        \"year\": paper.year,\n290\t        \"category\": paper.category,\n291\t        \"status\": paper.status,\n292\t        \"index_status\": paper.index_status,\n293\t        \"error_message\": paper.error_message,\n294\t        \"code_url\": paper.code_url,\n295\t        \"code_status\": paper.code_status,\n296\t        \"code_path\": paper.code_path,\n297\t        \"code_summary\": paper.code_summary,\n298\t        \"created_at\": paper.created_at,\n299\t        \"updated_at\": paper.updated_at,\n300\t    }\n301\t\n302\t\n303\tdef get_analysis(session: Session, paper_id: int) -> dict:\n304\t    \"\"\"\n305\t    获取论文的解析结果。\n306\t\n307\t    Args:\n308\t        session: 数据库会话\n309\t        paper_id: 论文 ID\n310\t\n311\t    Returns:\n312\t        dict: 完整的解析结果\n313\t\n314\t    Raises:\n315\t        ValueError: 解析结果不存在\n316\t    \"\"\"\n317\t    statement = select(AnalysisResult).where(AnalysisResult.paper_id == paper_id)\n318\t    analysis = session.exec(statement).first()\n319\t    if analysis is None:\n320\t        raise ValueError(f\"Analysis result for paper {paper_id} not found\")\n321\t    return {\n322\t        \"paper_id\": analysis.paper_id,\n323\t        \"title\": analysis.title,\n324\t        \"authors\": getattr(analysis, \"authors\", \"\") or \"\",\n325\t        \"venue\": analysis.venue,\n326\t        \"year\": analysis.year,\n327\t        \"one_sentence\": analysis.one_sentence,\n328\t        \"problem\": analysis.problem,\n329\t        \"key_contributions\": analysis.key_contributions,\n330\t        \"outline\": analysis.outline if analysis.outline else [],\n331\t        \"method\": analysis.method,\n332\t        \"experiments\": analysis.experiments,\n333\t        \"code_mapping\": analysis.code_mapping,\n334\t        \"interview_qa\": analysis.interview_qa,\n335\t        \"limitations\": analysis.limitations,\n336\t        \"related_papers\": analysis.related_papers,\n337\t        \"mermaid_chart\": analysis.mermaid_chart,\n338\t    }\n339\t\n340\t\n341\tdef update_paper_code_url(session: Session, paper_id: int, code_url: str) -> None:\n342\t    \"\"\"更新论文的代码仓库 URL\"\"\"\n343\t    paper = session.get(Paper, paper_id)\n344\t    if paper is None:\n345\t        raise ValueError(f\"Paper {paper_id} not found\")\n346\t    paper.code_url = code_url or None\n347\t    paper.updated_at = datetime.now(timezone.utc)\n348\t    session.add(paper)\n349\t    session.commit()\n350\t\n351\t\n352\tdef update_related_papers(session: Session, paper_id: int, related_papers: list[dict]) -> None:\n353\t    \"\"\"仅更新 related_papers 字段\"\"\"\n354\t    from sqlmodel import select\n355\t    statement = select(AnalysisResult).where(AnalysisResult.paper_id == paper_id)\n356\t    analysis = session.exec(statement).first()\n357\t    if analysis is None:\n358\t        raise ValueError(f\"Analysis result for paper {paper_id} not found\")\n359\t    analysis.related_papers = related_papers\n360\t    analysis.updated_at = datetime.now(timezone.utc)\n361\t    session.add(analysis)\n362\t    session.commit()\n363\t\n364\t\n365\tdef list_papers(\n366\t    session: Session,\n367\t    search: str = None,\n368\t    category: str = None,\n369\t    year: int = None,\n370\t    date_added: str = None,\n371\t    page: int = 1,\n372\t    per_page: int = 20,\n373\t    source: str = \"uploaded\",\n374\t) -> tuple[list[dict], int]:\n375\t    \"\"\"\n376\t    列出论文，支持筛选和分页。\n377\t\n378\t    Args:\n379\t        category:   按 arXiv 学科方向（如 cs.LG）筛选\n380\t        year:       按论文发表年份筛选\n381\t        date_added: 按加入论文库的日期筛选（\"YYYY-MM-DD\"）\n382\t        source: \"uploaded\"（默认，仅用户上传）| \"expanded\"（深度研究扩展）| \"all\"（全部）\n383\t    \"\"\"\n384\t    statement = select(Paper)\n385\t\n386\t    # source 过滤\n387\t    if source == \"uploaded\":\n388\t        statement = statement.where(Paper.source == \"uploaded\")\n389\t    elif source == \"expanded\":\n390\t        statement = statement.where(Paper.source == \"expanded\")\n391\t    # source == \"all\" 不过滤\n392\t\n393\t    if search:\n394\t        # 大小写不敏感：统一 lower 后子串匹配\n395\t        statement = statement.where(func.lower(col(Paper.title)).contains(search.lower()))\n396\t    if category:\n397\t        statement = statement.where(Paper.category == category)\n398\t    if year is not None:\n399\t        statement = statement.where(Paper.year == year)\n400\t    if date_added:\n401\t        statement = statement.where(func.date(Paper.created_at) == date_added)\n402\t\n403\t    count_statement = select(func.count()).select_from(statement.subquery())\n404\t    total = session.exec(count_statement).one()\n405\t\n406\t    statement = statement.order_by(Paper.created_at.desc())\n407\t    statement = statement.offset((page - 1) * per_page).limit(per_page)\n408\t\n409\t    papers = session.exec(statement).all()\n410\t    result = [\n411\t        {\n412\t            \"id\": p.id,\n413\t            \"filename\": p.filename,\n414\t            \"title\": p.title,\n415\t            \"authors\": p.authors,\n416\t            \"venue\": p.venue,\n417\t            \"year\": p.year,\n418\t            \"category\": p.category,\n419\t            \"status\": p.status,\n420\t            \"index_status\": p.index_status,\n421\t            \"error_message\": p.error_message,\n422\t            \"code_url\": p.code_url,\n423\t            \"code_status\": p.code_status,\n424\t            \"source\": p.source,\n425\t            \"level\": p.level,\n426\t            \"created_at\": p.created_at,\n427\t            \"updated_at\": p.updated_at,\n428\t        }\n429\t        for p in papers\n430\t    ]\n431\t\n432\t    return result, total\n433\t\n434\t\n435\tdef delete_paper(session: Session, paper_id: int) -> tuple[str, str | None]:\n436\t    \"\"\"\n437\t    删除论文及其解析结果。\n438\t\n439\t    Args:\n440\t        session: 数据库会话\n441\t        paper_id: 论文 ID\n442\t\n443\t    Returns:\n444\t        tuple[str, str]: (pdf_path, code_path) 被删除论文的文件路径（供调用方删除文件）\n445\t\n446\t    Raises:\n447\t        ValueError: 论文不存在\n448\t    \"\"\"\n449\t    paper = session.get(Paper, paper_id)\n450\t    if paper is None:\n451\t        raise ValueError(f\"Paper {paper_id} not found\")\n452\t\n453\t    pdf_path = paper.pdf_path\n454\t    code_path = paper.code_path\n455\t\n456\t    # AnalysisResult 通过 CASCADE 会自动删除，但显式删除更安全\n457\t    statement = select(AnalysisResult).where(AnalysisResult.paper_id == paper_id)\n458\t    analysis = session.exec(statement).first()\n459\t    if analysis:\n460\t        session.delete(analysis)\n461\t\n462\t    session.delete(paper)\n463\t    session.commit()\n464\t\n465\t    return pdf_path, code_path\n466\t"}]},"parent_tool_use_id":"call_14fbefec6f4c427bbf12da10","session_id":"29257b8f-ede7-46a4-8e0f-a743591d296a","uuid":"3c4a96ea-8700-4d6f-93ea-8885f7e41265","timestamp":"2026-06-09T05:10:17.942Z","subagent_type":"Explore","task_description":"Explore backend performance"}
