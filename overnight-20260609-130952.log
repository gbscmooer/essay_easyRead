{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call_0401ff309df9491bb3787996","type":"tool_result","content":"1\t\"\"\"\n2\tPapers 路由\n3\t\n4\t处理论文的上传、列表、查询、删除等操作。\n5\t\"\"\"\n6\t\n7\timport os\n8\timport re\n9\timport shutil\n10\timport uuid\n11\timport asyncio\n12\timport logging\n13\tfrom fastapi import APIRouter, UploadFile, File, Query, HTTPException\n14\tfrom fastapi.responses import FileResponse, Response\n15\tfrom sqlmodel import Session, create_engine, select\n16\t\n17\tlogger = logging.getLogger(__name__)\n18\t\n19\tfrom ..models.schemas import PaperResponse, PaperListResponse, ErrorResponse\n20\tfrom ..config import settings\n21\tfrom ..services.database import (\n22\t    create_paper,\n23\t    get_paper,\n24\t    list_papers,\n25\t    delete_paper,\n26\t    update_paper_status,\n27\t)\n28\tfrom ..services.pdf_parser import extract_pdf_content\n29\tfrom ..utils.streaming import format_analysis_as_markdown\n30\t\n31\trouter = APIRouter(prefix=\"/api/papers\", tags=[\"papers\"])\n32\t\n33\t# 数据库引擎单例\n34\t_engine = None\n35\t\n36\t\n37\tdef _get_engine():\n38\t    global _engine\n39\t    if _engine is None:\n40\t        _engine = create_engine(settings.resolved_database_url, connect_args={\"check_same_thread\": False})\n41\t    return _engine\n42\t\n43\t\n44\t# ============================================================\n45\t# POST /api/papers/upload\n46\t# ============================================================\n47\t@router.post(\"/upload\", response_model=PaperResponse)\n48\tasync def upload_paper(file: UploadFile = File(...)):\n49\t    \"\"\"上传 PDF 文件并触发解析流程\"\"\"\n50\t    # 验证文件格式\n51\t    if not file.filename or not file.filename.lower().endswith(\".pdf\"):\n52\t        raise HTTPException(\n53\t            status_code=400,\n54\t            detail={\"detail\": \"Only PDF files are accepted\", \"code\": \"INVALID_FORMAT\"},\n55\t        )\n56\t\n57\t    # 读取文件内容\n58\t    content = await file.read()\n59\t\n60\t    # 验证文件大小\n61\t    if len(content) > settings.max_file_size:\n62\t        raise HTTPException(\n63\t            status_code=400,\n64\t            detail={\"detail\": \"File too large, max 50MB\", \"code\": \"FILE_TOO_LARGE\"},\n65\t        )\n66\t\n67\t    # 确保上传目录存在\n68\t    upload_dir = settings.resolved_upload_dir\n69\t    os.makedirs(upload_dir, exist_ok=True)\n70\t\n71\t    # 生成唯一文件名并保存\n72\t    file_id = str(uuid.uuid4())\n73\t    filename = f\"{file_id}.pdf\"\n74\t    pdf_path = os.path.join(upload_dir, filename)\n75\t\n76\t    with open(pdf_path, \"wb\") as f:\n77\t        f.write(content)\n78\t\n79\t    # 创建数据库记录\n80\t    engine = _get_engine()\n81\t    with Session(engine) as session:\n82\t        paper_id = create_paper(session, file.filename, pdf_path, len(content))\n83\t        paper = get_paper(session, paper_id)\n84\t\n85\t    # 自动索引：后台提取全文 + 基本元数据（不跑 LLM，不阻塞上传响应）\n86\t    from ..services.auto_indexer import auto_index\n87\t    asyncio.create_task(auto_index(paper_id, pdf_path))\n88\t\n89\t    # 不自动启动分析，用户在阅读页面手动点击\"开始分析\"\n90\t\n91\t    return PaperResponse(\n92\t        id=paper[\"id\"],\n93\t        filename=paper[\"filename\"],\n94\t        title=paper[\"title\"],\n95\t        authors=paper.get(\"authors\"),\n96\t        venue=paper[\"venue\"],\n97\t        year=paper[\"year\"],\n98\t        category=paper.get(\"category\"),\n99\t        status=paper[\"status\"],\n100\t        index_status=paper.get(\"index_status\", \"none\"),\n101\t        error_message=paper[\"error_message\"],\n102\t        code_url=paper.get(\"code_url\"),\n103\t        code_status=paper.get(\"code_status\", \"none\"),\n104\t        created_at=paper[\"created_at\"],\n105\t        updated_at=paper[\"updated_at\"],\n106\t    )\n107\t\n108\t\n109\t# ============================================================\n110\t# GET /api/papers\n111\t# ============================================================\n112\t@router.get(\"\", response_model=PaperListResponse)\n113\tasync def get_papers_list(\n114\t    search: str = Query(None, description=\"Search by title\"),\n115\t    category: str = Query(None, description=\"按 arXiv 学科方向筛选，如 cs.LG\"),\n116\t    year: int = Query(None, description=\"Filter by year\"),\n117\t    date_added: str = Query(None, description=\"按加入论文库日期筛选，YYYY-MM-DD\"),\n118\t    page: int = Query(1, ge=1, description=\"Page number\"),\n119\t    per_page: int = Query(20, ge=1, le=100, description=\"Items per page\"),\n120\t    source: str = Query(\"uploaded\", description=\"uploaded | expanded | all\"),\n121\t):\n122\t    \"\"\"获取论文列表，支持筛选和搜索\"\"\"\n123\t    engine = _get_engine()\n124\t    with Session(engine) as session:\n125\t        papers, total = list_papers(\n126\t            session, search=search, category=category, year=year,\n127\t            date_added=date_added, page=page, per_page=per_page, source=source,\n128\t        )\n129\t\n130\t    paper_responses = [\n131\t        PaperResponse(\n132\t            id=p[\"id\"],\n133\t            filename=p[\"filename\"],\n134\t            title=p[\"title\"],\n135\t            authors=p.get(\"authors\"),\n136\t            venue=p[\"venue\"],\n137\t            year=p[\"year\"],\n138\t            category=p.get(\"category\"),\n139\t            status=p[\"status\"],\n140\t            index_status=p.get(\"index_status\", \"none\"),\n141\t            error_message=p[\"error_message\"],\n142\t            code_url=p.get(\"code_url\"),\n143\t            code_status=p.get(\"code_status\", \"none\"),\n144\t            source=p.get(\"source\", \"uploaded\"),\n145\t            level=p.get(\"level\", 1),\n146\t            created_at=p[\"created_at\"],\n147\t            updated_at=p[\"updated_at\"],\n148\t        )\n149\t        for p in papers\n150\t    ]\n151\t\n152\t    return PaperListResponse(papers=paper_responses, total=total)\n153\t\n154\t\n155\t# ============================================================\n156\t# GET /api/papers/smart-search\n157\t# 智能搜索：标题/作者/刊物/年份 + 解读内容（+ 可选全局正文全文），统一返回命中标签\n158\t# 注意：必须定义在 /{paper_id} 之前，否则 \"smart-search\" 会被当成 paper_id → 422\n159\t# ============================================================\n160\tdef _match_content_fields(ar, ql: str) -> list[dict]:\n161\t    \"\"\"在解读结果（AnalysisResult）里做大小写不敏感命中，返回 matched_fields。\"\"\"\n162\t    import json as _json\n163\t\n164\t    out: list[dict] = []\n165\t    if ar.one_sentence and ql in ar.one_sentence.lower():\n166\t        out.append({\"field\": \"one_sentence\", \"snippet\": ar.one_sentence})\n167\t    if ar.problem and ql in ar.problem.lower():\n168\t        out.append({\"field\": \"problem\", \"snippet\": ar.problem[:200]})\n169\t    if ar.limitations and ql in ar.limitations.lower():\n170\t        out.append({\"field\": \"limitations\", \"snippet\": ar.limitations[:200]})\n171\t\n172\t    for field, obj in ((\"method\", ar.method), (\"experiments\", ar.experiments)):\n173\t        s = _json.dumps(obj or {}, ensure_ascii=False)\n174\t        sl = s.lower()\n175\t        if ql in sl:\n176\t            idx = sl.find(ql)\n177\t            start = max(0, idx - 80)\n178\t            end = min(len(s), idx + len(ql) + 80)\n179\t            out.append({\"field\": field, \"snippet\": s[start:end]})\n180\t    return out\n181\t\n182\t\n183\t@router.get(\"/smart-search\")\n184\tasync def smart_search(\n185\t    q: str = Query(..., min_length=1, description=\"搜索关键词（大小写不敏感）\"),\n186\t    category: str = Query(None, description=\"按 arXiv 学科方向筛选，如 cs.LG\"),\n187\t    year: int = Query(None, description=\"按年份筛选\"),\n188\t    date_added: str = Query(None, description=\"按加入论文库日期筛选，YYYY-MM-DD\"),\n189\t    global_: bool = Query(False, alias=\"global\", description=\"开启则额外匹配论文正文全文\"),\n190\t    include_expanded: bool = Query(False, description=\"开启则一并搜索深度研究联网下载的相关论文\"),\n191\t    page: int = Query(1, ge=1),\n192\t    per_page: int = Query(20, ge=1, le=100),\n193\t):\n194\t    \"\"\"论文库统一智能搜索：元数据 + 解读内容 + 可选全文，命中并集 + 命中标签。\"\"\"\n195\t    from ..models.paper import Paper as PaperModel\n196\t    from ..models.analysis import AnalysisResult as AR\n197\t\n198\t    ql = q.lower()\n199\t    engine = _get_engine()\n200\t    results: list[dict] = []\n201\t\n202\t    with Session(engine) as session:\n203\t        stmt = select(PaperModel)\n204\t        # 默认只搜「加入论文库」（uploaded）；开启后并入联网扩展下载的相关论文（expanded）\n205\t        if not include_expanded:\n206\t            stmt = stmt.where(PaperModel.source == \"uploaded\")\n207\t        if category:\n208\t            stmt = stmt.where(PaperModel.category == category)\n209\t        if year is not None:\n210\t            stmt = stmt.where(PaperModel.year == year)\n211\t        if date_added:\n212\t            from sqlalchemy import func as _func\n213\t            stmt = stmt.where(_func.date(PaperModel.created_at) == date_added)\n214\t        papers = session.exec(stmt).all()\n215\t\n216\t        for p in papers:\n217\t            matched: list[dict] = []\n218\t            # 元数据\n219\t            if p.title and ql in p.title.lower():\n220\t                matched.append({\"field\": \"title\", \"snippet\": p.title})\n221\t            # 文件名兜底：当 title 为空或 title 未命中时，额外检查原始文件名\n222\t            if p.filename and ql in p.filename.lower():\n223\t                # 避免 title 和 filename 重复命中（如文件名就是标题）\n224\t                if not (p.title and ql in p.title.lower()):\n225\t                    matched.append({\"field\": \"filename\", \"snippet\": p.filename})\n226\t            if p.authors and ql in p.authors.lower():\n227\t                matched.append({\"field\": \"authors\", \"snippet\": p.authors})\n228\t            if p.venue and ql in p.venue.lower():\n229\t                matched.append({\"field\": \"venue\", \"snippet\": p.venue})\n230\t            if p.year and ql in str(p.year):\n231\t                matched.append({\"field\": \"year\", \"snippet\": str(p.year)})\n232\t\n233\t            # 解读内容（加异常保护，避免单篇论文 JSON 异常导致整个搜索崩溃）\n234\t            try:\n235\t                ar = session.exec(select(AR).where(AR.paper_id == p.id)).first()\n236\t                if ar:\n237\t                    matched.extend(_match_content_fields(ar, ql))\n238\t            except Exception as ex:\n239\t                logger.warning(f\"smart_search: paper {p.id} 解读内容匹配异常: {ex}\")\n240\t\n241\t            # 全局：正文全文字面匹配\n242\t            if global_ and p.full_text and ql in p.full_text.lower():\n243\t                fl = p.full_text.lower()\n244\t                idx = fl.find(ql)\n245\t                start = max(0, idx - 80)\n246\t                end = min(len(p.full_text), idx + len(ql) + 80)\n247\t                # 计算匹配位置所在行号\n248\t                line_num = p.full_text[:idx].count('\\n') + 1\n249\t                matched.append({\n250\t                    \"field\": \"fulltext\",\n251\t                    \"snippet\": \"…\" + p.full_text[start:end] + \"…\",\n252\t                    \"line\": line_num,\n253\t                })\n254\t\n255\t            if matched:\n256\t                results.append({\n257\t                    \"paper_id\": p.id,\n258\t                    \"title\": p.title or p.filename,\n259\t                    \"authors\": p.authors,\n260\t                    \"venue\": p.venue,\n261\t                    \"year\": p.year,\n262\t                    \"source\": p.source,\n263\t                    \"matched_fields\": matched,\n264\t                })\n265\t\n266\t    # 命中字段越多越靠前\n267\t    results.sort(key=lambda r: len(r[\"matched_fields\"]), reverse=True)\n268\t    total = len(results)\n269\t    start_idx = (page - 1) * per_page\n270\t    return {\"results\": results[start_idx:start_idx + per_page], \"total\": total, \"query\": q}\n271\t\n272\t\n273\t# ============================================================\n274\t# POST /api/papers/reindex\n275\t# 批量重新索引：用 GROBID 强制重提元数据，覆盖未解读论文的脏数据。\n276\t# 注意：必须定义在 /{paper_id} 之前，否则 \"reindex\" 会被当成 paper_id → 422\n277\t# ============================================================\n278\t@router.post(\"/reindex\")\n279\tasync def reindex_library_endpoint(\n280\t    include_expanded: bool = Query(False, description=\"是否一并重索引联网扩展下载的论文\"),\n281\t):\n282\t    \"\"\"重新索引：对范围内每篇论文逐篇清空旧索引并用 GROBID 重做（不跳过已索引的）。\n283\t\n284\t    默认处理「加入论文库」的所有论文；include_expanded=True 时一并处理深度研究发现的论文。\n285\t    后台异步执行，立即返回处理数量；前端可轮询论文列表的 index_status 观察进度。\n286\t    \"\"\"\n287\t    from ..services.auto_indexer import count_reindex_targets, reindex_library\n288\t\n289\t    queued = await asyncio.to_thread(count_reindex_targets, include_expanded)\n290\t    if queued:\n291\t        asyncio.create_task(reindex_library(include_expanded))\n292\t    return {\"queued\": queued}\n293\t\n294\t\n295\t# ============================================================\n296\t# GET /api/papers/{paper_id}\n297\t# ============================================================\n298\t@router.get(\"/{paper_id}\", response_model=PaperResponse)\n299\tasync def get_paper_detail(paper_id: int):\n300\t    \"\"\"获取单篇论文详情\"\"\"\n301\t    engine = _get_engine()\n302\t    try:\n303\t        with Session(engine) as session:\n304\t            paper = get_paper(session, paper_id)\n305\t    except ValueError:\n306\t        raise HTTPException(\n307\t            status_code=404,\n308\t            detail={\"detail\": f\"Paper {paper_id} not found\", \"code\": \"NOT_FOUND\"},\n309\t        )\n310\t\n311\t    return PaperResponse(\n312\t        id=paper[\"id\"],\n313\t        filename=paper[\"filename\"],\n314\t        title=paper[\"title\"],\n315\t        authors=paper.get(\"authors\"),\n316\t        venue=paper[\"venue\"],\n317\t        year=paper[\"year\"],\n318\t        category=paper.get(\"category\"),\n319\t        status=paper[\"status\"],\n320\t        index_status=paper.get(\"index_status\", \"none\"),\n321\t        error_message=paper[\"error_message\"],\n322\t        code_url=paper.get(\"code_url\"),\n323\t        code_status=paper.get(\"code_status\", \"none\"),\n324\t        created_at=paper[\"created_at\"],\n325\t        updated_at=paper[\"updated_at\"],\n326\t    )\n327\t\n328\t\n329\t# ============================================================\n330\t# DELETE /api/papers/{paper_id}\n331\t# ============================================================\n332\t@router.delete(\"/{paper_id}\")\n333\tasync def delete_paper_endpoint(paper_id: int):\n334\t    \"\"\"删除论文及其解析结果\"\"\"\n335\t    engine = _get_engine()\n336\t    try:\n337\t        with Session(engine) as session:\n338\t            pdf_path, code_path = delete_paper(session, paper_id)\n339\t    except ValueError:\n340\t        raise HTTPException(\n341\t            status_code=404,\n342\t            detail={\"detail\": f\"Paper {paper_id} not found\", \"code\": \"NOT_FOUND\"},\n343\t        )\n344\t\n345\t    # 删除 PDF 文件\n346\t    if os.path.exists(pdf_path):\n347\t        os.remove(pdf_path)\n348\t\n349\t    # 删除代码仓库目录\n350\t    if code_path and os.path.isdir(code_path):\n351\t        shutil.rmtree(code_path, ignore_errors=True)\n352\t\n353\t    return {\"message\": \"Paper deleted successfully\"}\n354\t\n355\t\n356\t# ============================================================\n357\t# POST /api/papers/{paper_id}/promote\n358\t# ============================================================\n359\t@router.post(\"/{paper_id}/promote\")\n360\tasync def promote_paper(paper_id: int):\n361\t    \"\"\"将深度研究扩展论文提升为普通用户论文（移入论文库）\"\"\"\n362\t    from datetime import datetime, timezone\n363\t    from sqlmodel import Session as S\n364\t    from ..models.paper import Paper as PaperModel\n365\t\n366\t    engine = _get_engine()\n367\t    with S(engine) as session:\n368\t        p = session.get(PaperModel, paper_id)\n369\t        if p is None:\n370\t            raise HTTPException(\n371\t                status_code=404,\n372\t                detail={\"detail\": f\"Paper {paper_id} not found\", \"code\": \"NOT_FOUND\"},\n373\t            )\n374\t        p.source = \"uploaded\"\n375\t        p.level = 1\n376\t        p.parent_paper_id = None\n377\t        p.updated_at = datetime.now(timezone.utc)\n378\t        session.add(p)\n379\t        session.commit()\n380\t    return {\"message\": \"Paper promoted to library\"}\n381\t\n382\t\n383\t# ============================================================\n384\t# GET /api/papers/{paper_id}/export\n385\t# ============================================================\n386\t@router.get(\"/{paper_id}/export\")\n387\tasync def export_paper(paper_id: int):\n388\t    \"\"\"导出论文解析结果为 Markdown\"\"\"\n389\t    from ..services.database import get_analysis\n390\t\n391\t    engine = _get_engine()\n392\t    try:\n393\t        with Session(engine) as session:\n394\t            paper = get_paper(session, paper_id)\n395\t    except ValueError:\n396\t        raise HTTPException(\n397\t            status_code=404,\n398\t            detail={\"detail\": f\"Paper {paper_id} not found\", \"code\": \"NOT_FOUND\"},\n399\t        )\n400\t\n401\t    if paper[\"status\"] != \"done\":\n402\t        raise HTTPException(\n403\t            status_code=400,\n404\t            detail={\"detail\": \"Paper analysis is not completed yet\", \"code\": \"NOT_READY\"},\n405\t        )\n406\t\n407\t    try:\n408\t        with Session(engine) as session:\n409\t            analysis = get_analysis(session, paper_id)\n410\t    except ValueError:\n411\t        raise HTTPException(\n412\t            status_code=404,\n413\t            detail={\"detail\": f\"Analysis for paper {paper_id} not found\", \"code\": \"NOT_FOUND\"},\n414\t        )\n415\t\n416\t    markdown = format_analysis_as_markdown(analysis)\n417\t    title = analysis.get(\"title\", \"paper\")\n418\t    safe_title = re.sub(r'[^\\w\\s\\-.]', '', title).strip() or 'paper'\n419\t\n420\t    return Response(\n421\t        content=markdown,\n422\t        media_type=\"text/markdown\",\n423\t        headers={\"Content-Disposition\": f'attachment; filename=\"{safe_title}.md\"'},\n424\t    )\n425\t\n426\t\n427\t# ============================================================\n428\t# GET /api/papers/{paper_id}/pdf\n429\t# ============================================================\n430\t@router.get(\"/{paper_id}/pdf\")\n431\tasync def get_paper_pdf(paper_id: int):\n432\t    \"\"\"获取论文 PDF 文件\"\"\"\n433\t    engine = _get_engine()\n434\t    try:\n435\t        with Session(engine) as session:\n436\t            paper = get_paper(session, paper_id)\n437\t    except ValueError:\n438\t        raise HTTPException(\n439\t            status_code=404,\n440\t            detail={\"detail\": f\"Paper {paper_id} not found\", \"code\": \"NOT_FOUND\"},\n441\t        )\n442\t\n443\t    # 通过数据库记录获取实际文件路径\n444\t    with Session(engine) as session:\n445\t        from sqlmodel import select\n446\t        from ..models.paper import Paper as PaperModel\n447\t        db_paper = session.get(PaperModel, paper_id)\n448\t        if db_paper is None:\n449\t            raise HTTPException(\n450\t                status_code=404,\n451\t                detail={\"detail\": f\"Paper {paper_id} not found\", \"code\": \"NOT_FOUND\"},\n452\t            )\n453\t        pdf_path = db_paper.pdf_path\n454\t\n455\t    if not os.path.exists(pdf_path):\n456\t        raise HTTPException(\n457\t            status_code=404,\n458\t            detail={\"detail\": \"PDF file not found on disk\", \"code\": \"FILE_NOT_FOUND\"},\n459\t        )\n460\t\n461\t    return FileResponse(\n462\t        pdf_path,\n463\t        media_type=\"application/pdf\",\n464\t        headers={\"Content-Disposition\": \"inline\"},\n465\t    )\n466\t\n467\t\n468\t# ============================================================\n469\t# GET /api/papers\n470\t# ============================================================\n471\t# 获取论文列表，支持筛选和搜索。\n472\t#\n473\t# 查询参数：\n474\t#   - search: str = None      # 按标题/关键词搜索\n475\t#   - venue: str = None       # 按会议筛选\n476\t#   - year: int = None        # 按年份筛选\n477\t#   - page: int = 1           # 页码\n478\t#   - per_page: int = 20      # 每页数量\n479\t#\n480\t# 返回 200: PaperListResponse\n481\t#   - papers: list[PaperResponse]  # 当前页的论文列表\n482\t#   - total: int                   # 总数\n483\t\n484\t\n485\t# ============================================================\n486\t# GET /api/papers/{paper_id}\n487\t# ============================================================\n488\t# 获取单篇论文详情。\n489\t#\n490\t# 路径参数：\n491\t#   - paper_id: int\n492\t#\n493\t# 返回 200: PaperResponse\n494\t#\n495\t# 返回 404: ErrorResponse\n496\t#   - code=\"NOT_FOUND\": 论文不存在\n497\t\n498\t\n499\t# ============================================================\n500\t# DELETE /api/papers/{paper_id}\n501\t# ============================================================\n502\t# 删除一篇论文及其解析结果。\n503\t#\n504\t# 路径参数：\n505\t#   - paper_id: int\n506\t#\n507\t# 返回 200: {\"message\": \"Paper deleted successfully\"}\n508\t#\n509\t# 业务流程：\n510\t#   1. 删除 AnalysisResult 记录（如果有）\n511\t#   2. 删除 Paper 记录\n512\t#   3. 删除上传的 PDF 文件\n513\t#\n514\t# 返回 404: ErrorResponse\n515\t#   - code=\"NOT_FOUND\": 论文不存在\n516\t\n517\t\n518\t# ============================================================\n519\t# GET /api/papers/{paper_id}/export\n520\t# ============================================================\n521\t# 导出论文解析结果为 Markdown。\n522\t#\n523\t# 路径参数：\n524\t#   - paper_id: int\n525\t#\n526\t# 返回 200: text/markdown\n527\t#   - Content-Disposition: attachment; filename=\"{title}.md\"\n528\t#   - 返回格式化的 Markdown 文本\n529\t#\n530\t# 返回 404: ErrorResponse\n531\t#   - code=\"NOT_FOUND\": 论文不存在\n532\t#\n533\t# 返回 400: ErrorResponse\n534\t#   - code=\"NOT_READY\": 论文尚未解析完成\n535\t\n536\t\n537\t# ============================================================\n538\t# GET /api/papers/{paper_id}/pdf\n539\t# ============================================================\n540\t# 获取论文 PDF 文件（用于前端 PdfViewer 预览）。\n541\t#\n542\t# 路径参数：\n543\t#   - paper_id: int\n544\t#\n545\t# 返回 200: application/pdf\n546\t#   - 返回 PDF 文件流\n547\t#   - Content-Disposition: inline（浏览器内预览，不下载）\n548\t#\n549\t# 返回 404: ErrorResponse\n550\t#   - code=\"NOT_FOUND\": 论文不存在\n551\t#\n552\t# 实现要点：\n553\t#   1. 根据 paper_id 查询 Paper 记录获取 pdf_path\n554\t#   2. 使用 FileResponse 返回文件\n555\t#   3. media_type=\"application/pdf\"\n556\t#   4. 前端通过此 URL 传给 react-pdf 的 Document 组件\n557\t"}]},"parent_tool_use_id":"call_14fbefec6f4c427bbf12da10","session_id":"29257b8f-ede7-46a4-8e0f-a743591d296a","uuid":"a82e35c6-dedf-443f-850e-6d05d6867671","timestamp":"2026-06-09T05:10:21.429Z","subagent_type":"Explore","task_description":"Explore backend performance"}
