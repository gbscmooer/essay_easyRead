{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call_e04d38383e124230a20c769b","type":"tool_result","content":"1\timport { useState, useEffect, useCallback } from 'react'\n2\timport type { Note } from '@/types'\n3\timport { listNotes, createNote, updateNote, deleteNote } from '@/api/notes'\n4\timport { toast } from '@/hooks/useToast'\n5\t\n6\tinterface NotesPanelProps {\n7\t  paperId: number\n8\t}\n9\t\n10\texport function NotesPanel({ paperId }: NotesPanelProps) {\n11\t  const [notes, setNotes] = useState<Note[]>([])\n12\t  const [newContent, setNewContent] = useState('')\n13\t  const [editingId, setEditingId] = useState<number | null>(null)\n14\t  const [editContent, setEditContent] = useState('')\n15\t\n16\t  const fetchNotes = useCallback(async () => {\n17\t    try {\n18\t      const result = await listNotes(paperId)\n19\t      setNotes(result)\n20\t    } catch (e: any) {\n21\t      toast({ type: 'error', message: e?.message || '加载笔记失败' })\n22\t    }\n23\t  }, [paperId])\n24\t\n25\t  useEffect(() => { fetchNotes() }, [fetchNotes])\n26\t\n27\t  const handleCreate = async () => {\n28\t    if (!newContent.trim()) return\n29\t    try {\n30\t      await createNote(paperId, newContent.trim())\n31\t      setNewContent('')\n32\t      fetchNotes()\n33\t    } catch (e: any) {\n34\t      toast({ type: 'error', message: e?.message || '创建笔记失败' })\n35\t    }\n36\t  }\n37\t\n38\t  const handleUpdate = async (noteId: number) => {\n39\t    if (!editContent.trim()) return\n40\t    try {\n41\t      await updateNote(noteId, editContent.trim())\n42\t      setEditingId(null)\n43\t      fetchNotes()\n44\t    } catch (e: any) {\n45\t      toast({ type: 'error', message: e?.message || '更新笔记失败' })\n46\t    }\n47\t  }\n48\t\n49\t  const handleDelete = async (noteId: number) => {\n50\t    try {\n51\t      await deleteNote(noteId)\n52\t      fetchNotes()\n53\t    } catch (e: any) {\n54\t      toast({ type: 'error', message: e?.message || '删除笔记失败' })\n55\t    }\n56\t  }\n57\t\n58\t  return (\n59\t    <div className=\"space-y-3\">\n60\t      <div className=\"flex gap-2\">\n61\t        <textarea\n62\t          value={newContent}\n63\t          onChange={e => setNewContent(e.target.value)}\n64\t          placeholder=\"添加笔记...\"\n65\t          rows={2}\n66\t          className=\"flex-1 text-sm px-3 py-2 rounded-lg border resize-none focus:outline-none\"\n67\t          style={{ borderColor: 'var(--border)', backgroundColor: 'var(--bg-base)', color: 'var(--text-primary)' }}\n68\t        />\n69\t        <button\n70\t          onClick={handleCreate}\n71\t          disabled={!newContent.trim()}\n72\t          className=\"self-end px-3 py-2 text-sm rounded-lg transition-colors disabled:opacity-40 hover:opacity-90\"\n73\t          style={{ backgroundColor: 'var(--accent)', color: 'var(--bg-base)' }}\n74\t        >\n75\t          添加\n76\t        </button>\n77\t      </div>\n78\t\n79\t      {notes.length === 0 && (\n80\t        <p className=\"text-xs text-center py-4\" style={{ color: 'var(--text-muted)' }}>暂无笔记</p>\n81\t      )}\n82\t\n83\t      {notes.map(note => (\n84\t        <div\n85\t          key={note.id}\n86\t          className=\"rounded-lg border p-3\"\n87\t          style={{ borderColor: 'var(--border)', backgroundColor: 'var(--bg-base)' }}\n88\t        >\n89\t          {editingId === note.id ? (\n90\t            <div className=\"space-y-2\">\n91\t              <textarea\n92\t                value={editContent}\n93\t                onChange={e => setEditContent(e.target.value)}\n94\t                rows={3}\n95\t                className=\"w-full text-sm px-2 py-1 rounded border resize-none focus:outline-none\"\n96\t                style={{ borderColor: 'var(--border)', backgroundColor: 'var(--bg-surface)', color: 'var(--text-primary)' }}\n97\t              />\n98\t              <div className=\"flex gap-2 justify-end\">\n99\t                <button\n100\t                  onClick={() => setEditingId(null)}\n101\t                  className=\"text-xs px-2 py-1 rounded border transition-colors hover:opacity-80\"\n102\t                  style={{ borderColor: 'var(--border)', color: 'var(--text-muted)' }}\n103\t                >\n104\t                  取消\n105\t                </button>\n106\t                <button\n107\t                  onClick={() => handleUpdate(note.id)}\n108\t                  className=\"text-xs px-2 py-1 rounded transition-colors hover:opacity-90\"\n109\t                  style={{ backgroundColor: 'var(--accent)', color: 'var(--bg-base)' }}\n110\t                >\n111\t                  保存\n112\t                </button>\n113\t              </div>\n114\t            </div>\n115\t          ) : (\n116\t            <>\n117\t              <p className=\"text-sm whitespace-pre-wrap\" style={{ color: 'var(--text-primary)' }}>{note.content}</p>\n118\t              <div className=\"flex items-center justify-between mt-2\">\n119\t                <span className=\"text-[10px]\" style={{ color: 'var(--text-muted)' }}>\n120\t                  {new Date(note.created_at).toLocaleString('zh-CN')}\n121\t                </span>\n122\t                <div className=\"flex gap-2\">\n123\t                  <button\n124\t                    onClick={() => { setEditingId(note.id); setEditContent(note.content) }}\n125\t                    className=\"text-[10px] transition-colors hover:opacity-80\"\n126\t                    style={{ color: 'var(--text-muted)' }}\n127\t                  >\n128\t                    编辑\n129\t                  </button>\n130\t                  <button\n131\t                    onClick={() => handleDelete(note.id)}\n132\t                    className=\"text-[10px] transition-colors hover:opacity-80\"\n133\t                    style={{ color: 'var(--error)' }}\n134\t                  >\n135\t                    删除\n136\t                  </button>\n137\t                </div>\n138\t              </div>\n139\t            </>\n140\t          )}\n141\t        </div>\n142\t      ))}\n143\t    </div>\n144\t  )\n145\t}\n146\t"}]},"parent_tool_use_id":"call_bddd82a75f2e46b98e4517cc","session_id":"29257b8f-ede7-46a4-8e0f-a743591d296a","uuid":"ccdb6ecd-6cd2-4b1d-89ce-62c66540ddbd","timestamp":"2026-06-09T05:10:28.177Z","subagent_type":"Explore","task_description":"Explore frontend performance"}
