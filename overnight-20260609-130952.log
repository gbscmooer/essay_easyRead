{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call_a055219e350d457d89f87e58","type":"tool_result","content":"1\t\"\"\"\n2\t自动索引：论文上传即提取「全文 + 基本元数据」，不跑 LLM。\n3\t\n4\t- full_text：PyMuPDF 提取的全文（截断），供论文库「全局搜索」做字面匹配。\n5\t- 元数据（title/authors/year/venue）：组合回退——\n6\t    GROBID processHeaderDocument 优先（最准，需容器在跑）→ 失败回退 PDF 元信息 + 首页正则启发式。\n7\t  只「填空补缺」：仅当 Paper 对应字段为空时写入，绝不覆盖完整 LLM 解读得到的结果。\n8\t\n9\t触发点：papers.upload_paper 创建记录后 asyncio.create_task(auto_index(...))；\n10\t以及 main.py 启动时对存量 index_status='none' 的论文后台补跑。\n11\t\"\"\"\n12\timport asyncio\n13\timport logging\n14\timport re\n15\t\n16\tfrom sqlmodel import Session, create_engine, select\n17\t\n18\tfrom ..config import settings\n19\tfrom ..models.paper import Paper\n20\tfrom .ai_config import get_arxiv_expand_config\n21\tfrom .pdf_parser import _extract_with_pymupdf, _extract_with_pypdf\n22\tfrom .deep_research.grobid_parser import is_grobid_alive, parse_header\n23\t\n24\tlogger = logging.getLogger(__name__)\n25\t\n26\tFULL_TEXT_LIMIT = 300_000  # 单篇全文落库上限，兜底超长 PDF\n27\t_YEAR_RE = re.compile(r\"(19|20)\\d{2}\")\n28\t# arXiv 首页戳：arXiv:2201.00072v2 [cs.LG] 10 Apr 2022\n29\t_ARXIV_ID_RE = re.compile(r\"arxiv[:\\s]*(\\d{4}\\.\\d{4,5})\", re.IGNORECASE)\n30\t# 学科分类如 cs.LG / stat.ML / eess.IV / cond-mat.stat-mech（取方括号内首个）\n31\t_CATEGORY_RE = re.compile(r\"\\[([a-z][a-z\\-]*\\.[A-Za-z\\-]{2,})\\]\")\n32\t# arXiv 戳上印的提交/版本日期里的年份：arXiv:<id>[vN] [cat] DD Mon YYYY → 取那个年份。\n33\t# 锚定在 arXiv ID 之后取年份，避免误抓正文里出现的年份（如 “In 1904, ...”）。\n34\t_ARXIV_STAMP_YEAR_RE = re.compile(\n35\t    r\"arxiv[:\\s]*\\d{4}\\.\\d{4,5}(?:v\\d+)?[\\s\\S]{0,40}?\\b((?:19|20)\\d{2})\\b\",\n36\t    re.IGNORECASE,\n37\t)\n38\t\n39\t\n40\tdef _arxiv_stamp_year(first_page: str):\n41\t    \"\"\"从首页 arXiv 戳的日期里取年份（用户在 PDF 上看到的那个年份）。无则 None。\"\"\"\n42\t    m = _ARXIV_STAMP_YEAR_RE.search(first_page or \"\")\n43\t    return int(m.group(1)) if m else None\n44\t\n45\t# 写回时只填空/可覆盖的元数据字段（不含 full_text）\n46\t_META_FIELDS = (\"title\", \"authors\", \"venue\", \"year\", \"category\")\n47\t_MIN_VALID_YEAR = 1900\n48\t\n49\t\n50\tdef _valid_year(y) -> bool:\n51\t    \"\"\"4 位合理年份才算有效。过滤 LLM/启发式抽出的脏年份（如 20、2）。\"\"\"\n52\t    from datetime import datetime, timezone\n53\t    return isinstance(y, int) and _MIN_VALID_YEAR <= y <= datetime.now(timezone.utc).year + 1\n54\t\n55\t_engine = None\n56\t\n57\t\n58\tdef _get_engine():\n59\t    global _engine\n60\t    if _engine is None:\n61\t        _engine = create_engine(settings.resolved_database_url, connect_args={\"check_same_thread\": False})\n62\t    return _engine\n63\t\n64\t\n65\tdef _extract(pdf_path: str) -> tuple[str, dict, str]:\n66\t    \"\"\"返回 (全文截断, pdf元信息, 首页文本)。双路径：PyMuPDF 主、pypdf 备。\"\"\"\n67\t    res = _extract_with_pymupdf(pdf_path) or _extract_with_pypdf(pdf_path)\n68\t    if not res:\n69\t        return \"\", {}, \"\"\n70\t    page_texts, metadata = res\n71\t    full = \"\".join(page_texts)\n72\t    first_page = page_texts[0] if page_texts else \"\"\n73\t    return full[:FULL_TEXT_LIMIT], (metadata or {}), first_page\n74\t\n75\t\n76\tdef _heuristic_meta(metadata: dict, first_page: str) -> dict:\n77\t    \"\"\"无 GROBID 时的兜底：PDF 元信息 + 首页正则启发式。\"\"\"\n78\t    # 标题：PDF 元信息 title 优先（够长才可信），否则取首页首个较长的非空行\n79\t    title = (metadata.get(\"title\") or \"\").strip()\n80\t    if len(title) < 6:\n81\t        title = \"\"\n82\t        for line in first_page.splitlines():\n83\t            s = line.strip()\n84\t            if len(s) >= 12 and not s.lower().startswith((\"arxiv\", \"doi\", \"http\")):\n85\t                title = s\n86\t                break\n87\t\n88\t    authors = (metadata.get(\"author\") or \"\").strip() or None\n89\t\n90\t    # 年份：优先 arXiv 戳上的日期年份；没有戳再退而取首页第一个 19xx/20xx\n91\t    year = _arxiv_stamp_year(first_page)\n92\t    if year is None:\n93\t        m = _YEAR_RE.search(first_page)\n94\t        if m:\n95\t            year = int(m.group(0))\n96\t\n97\t    # arXiv ID 与学科分类：直接从首页的 arXiv 戳抓取\n98\t    aid_m = _ARXIV_ID_RE.search(first_page)\n99\t    arxiv_id = aid_m.group(1) if aid_m else None\n100\t    cat_m = _CATEGORY_RE.search(first_page)\n101\t    category = cat_m.group(1) if cat_m else None\n102\t\n103\t    return {\n104\t        \"title\": title or None, \"authors\": authors, \"year\": year,\n105\t        \"venue\": None, \"category\": category, \"arxiv_id\": arxiv_id,\n106\t    }\n107\t\n108\t\n109\tasync def _extract_meta(pdf_path: str, metadata: dict, first_page: str) -> dict:\n110\t    \"\"\"组合回退：GROBID header 优先，逐字段用启发式补缺；学科分类经 arXiv API 兜底。\n111\t\n112\t    GROBID 给结构化的 title/authors/year/venue（最准），但不给 arXiv 学科分类；\n113\t    分类优先从首页 arXiv 戳正则抓 [cs.LG]，仍缺且有 arXiv ID 时调 arXiv API 取主分类。\n114\t    \"\"\"\n115\t    ae = get_arxiv_expand_config()\n116\t    grobid_url = ae.get(\"grobid_url\", \"http://localhost:8070\")\n117\t    meta = {\"title\": None, \"authors\": None, \"year\": None,\n118\t            \"venue\": None, \"category\": None, \"arxiv_id\": None}\n119\t\n120\t    if await is_grobid_alive(grobid_url):\n121\t        try:\n122\t            header = await parse_header(pdf_path, grobid_url)\n123\t            if header:\n124\t                meta.update({k: v for k, v in header.items() if v})\n125\t        except Exception as ex:\n126\t            logger.warning(f\"auto_index: GROBID header 失败，回退启发式: {ex}\")\n127\t\n128\t    fallback = _heuristic_meta(metadata, first_page)\n129\t    for k, v in fallback.items():\n130\t        if not meta.get(k):\n131\t            meta[k] = v\n132\t\n133\t    # 年份以 arXiv 戳上印的日期为准（用户在 PDF 上看到的那个），优先于 GROBID/正文猜测\n134\t    stamp_year = _arxiv_stamp_year(first_page)\n135\t    if stamp_year:\n136\t        meta[\"year\"] = stamp_year\n137\t\n138\t    # 学科分类兜底：有 arXiv ID 但分类仍缺时，查 arXiv API 拿权威主分类（同时补全年份）\n139\t    if not meta.get(\"category\") and meta.get(\"arxiv_id\"):\n140\t        try:\n141\t            from .deep_research.arxiv_client import get_metadata\n142\t            am = await get_metadata(meta[\"arxiv_id\"])\n143\t            if am:\n144\t                if am.get(\"category\"):\n145\t                    meta[\"category\"] = am[\"category\"]\n146\t                if not meta.get(\"year\") and am.get(\"year\"):\n147\t                    meta[\"year\"] = am[\"year\"]\n148\t        except Exception as ex:\n149\t            logger.debug(f\"auto_index: arXiv API 取分类失败 ({meta.get('arxiv_id')}): {ex}\")\n150\t\n151\t    return meta\n152\t\n153\t\n154\tasync def auto_index(\n155\t    paper_id: int, pdf_path: str, *, force_meta: bool = False, overwrite: bool = False\n156\t) -> None:\n157\t    \"\"\"对单篇论文做自动索引（全文 + 元数据）。异常吞掉，置 failed。\n158\t\n159\t    force_meta：即使已有标题也强制重新提取元数据（重新索引时用）。\n160\t    overwrite：未跑 LLM 解读的论文（status != 'done'）允许用 GROBID 结果覆盖旧的脏数据；\n161\t               已解读论文始终只填空补缺，不动 LLM 写入的字段。\n162\t    \"\"\"\n163\t    engine = _get_engine()\n164\t    with Session(engine) as s:\n165\t        p = s.get(Paper, paper_id)\n166\t        if p is None:\n167\t            return\n168\t        had_title = bool(p.title)  # 已有标题（如联网扩展论文）则跳过元数据提取，只取全文\n169\t        p.index_status = \"indexing\"\n170\t        s.add(p)\n171\t        s.commit()\n172\t\n173\t    try:\n174\t        full, metadata, first_page = await asyncio.to_thread(_extract, pdf_path)\n175\t        # 标题已有且非强制时跳过元数据提取，避免无谓 GROBID 调用\n176\t        need_meta = force_meta or not had_title\n177\t        meta = await _extract_meta(pdf_path, metadata, first_page) if need_meta else {}\n178\t\n179\t        with Session(engine) as s:\n180\t            p = s.get(Paper, paper_id)\n181\t            if p is None:\n182\t                return\n183\t            if full:\n184\t                p.full_text = full\n185\t            # GROBID 是论文库元数据的唯一来源，overwrite=True 时直接覆盖旧值；\n186\t            # 脏年份（如 20、2）视同缺失——即使非覆盖模式也允许用 GROBID 的合理年份修复\n187\t            can_overwrite = overwrite\n188\t            for field in _META_FIELDS:\n189\t                val = meta.get(field)\n190\t                if not val:\n191\t                    continue\n192\t                if field == \"year\" and not _valid_year(val):\n193\t                    continue  # 不写入脏年份\n194\t                cur = getattr(p, field)\n195\t                cur_bad_year = field == \"year\" and cur is not None and not _valid_year(cur)\n196\t                if can_overwrite or not cur or cur_bad_year:\n197\t                    setattr(p, field, val)\n198\t            p.index_status = \"indexed\"\n199\t            s.add(p)\n200\t            s.commit()\n201\t        logger.info(f\"auto_index: paper {paper_id} indexed (title={meta.get('title')!r}, category={meta.get('category')!r})\")\n202\t    except Exception as ex:\n203\t        logger.warning(f\"auto_index: paper {paper_id} 失败: {ex}\")\n204\t        with Session(engine) as s:\n205\t            p = s.get(Paper, paper_id)\n206\t            if p is not None:\n207\t                p.index_status = \"failed\"\n208\t                s.add(p)\n209\t                s.commit()\n210\t\n211\t\n212\tasync def reindex_missing(concurrency: int = 2) -> None:\n213\t    \"\"\"对 index_status='none' 且 PDF 在本地的论文后台补跑索引。\n214\t\n215\t    覆盖「加入论文库」(uploaded) 与「联网扩展下载」(expanded) 两类——后者的正文\n216\t    也需要 full_text 才能被全局搜索命中。启动时 + 每次研究运行结束后调用，幂等。\n217\t    \"\"\"\n218\t    import os\n219\t\n220\t    engine = _get_engine()\n221\t    with Session(engine) as s:\n222\t        rows = s.exec(\n223\t            select(Paper.id, Paper.pdf_path).where(Paper.index_status == \"none\")\n224\t        ).all()\n225\t    rows = [(pid, path) for pid, path in rows if path and os.path.exists(path)]\n226\t    if not rows:\n227\t        return\n228\t    logger.info(f\"auto_index: 补跑 {len(rows)} 篇未索引论文（含联网扩展）\")\n229\t    sem = asyncio.Semaphore(concurrency)\n230\t\n231\t    async def _one(pid: int, path: str):\n232\t        async with sem:\n233\t            await auto_index(pid, path)\n234\t\n235\t    await asyncio.gather(*[_one(pid, path) for pid, path in rows], return_exceptions=True)\n236\t\n237\t\n238\tdef _pick_reindex_targets(include_expanded: bool = False) -> list[tuple[int, str]]:\n239\t    \"\"\"选出重新索引的目标论文（PDF 在本地），返回 (id, path)。\n240\t\n241\t    重新索引会逐篇清空旧索引并用 GROBID 重做，不跳过已索引的论文：\n242\t      - 默认：论文库里的所有论文（uploaded）。\n243\t      - include_expanded=True：再加上深度研究发现的论文（expanded），即全部论文。\n244\t    \"\"\"\n245\t    import os\n246\t\n247\t    engine = _get_engine()\n248\t    with Session(engine) as s:\n249\t        stmt = select(Paper.id, Paper.pdf_path)\n250\t        if not include_expanded:\n251\t            stmt = stmt.where(Paper.source == \"uploaded\")\n252\t        rows = s.exec(stmt).all()\n253\t    return [(pid, path) for pid, path in rows if path and os.path.exists(path)]\n254\t\n255\t\n256\tdef count_reindex_targets(include_expanded: bool = False) -> int:\n257\t    \"\"\"统计本次重新索引会处理的论文数（供前端展示进度）。\"\"\"\n258\t    return len(_pick_reindex_targets(include_expanded))\n259\t\n260\t\n261\tasync def reindex_library(include_expanded: bool = False, concurrency: int = 2) -> int:\n262\t    \"\"\"手动重新索引：对范围内每篇论文逐篇清空旧索引并用 GROBID 重做（不跳过已索引的）。\n263\t\n264\t    默认处理论文库里的所有论文（uploaded）；include_expanded=True 时一并处理深度研究\n265\t    发现的论文（expanded）。GROBID 作为唯一索引来源，直接覆盖旧元数据（仅在 GROBID\n266\t    给出非空值时；脏年份永不写入）。返回本次处理的论文数。\n267\t    \"\"\"\n268\t    rows = _pick_reindex_targets(include_expanded)\n269\t    if not rows:\n270\t        return 0\n271\t    logger.info(\n272\t        f\"reindex_library: 重新索引 {len(rows)} 篇论文\"\n273\t        f\"（含联网扩展={include_expanded}）\"\n274\t    )\n275\t    sem = asyncio.Semaphore(concurrency)\n276\t\n277\t    async def _one(pid: int, path: str):\n278\t        async with sem:\n279\t            await auto_index(pid, path, force_meta=True, overwrite=True)\n280\t\n281\t    await asyncio.gather(*[_one(pid, path) for pid, path in rows], return_exceptions=True)\n282\t    return len(rows)\n283\t"}]},"parent_tool_use_id":"call_14fbefec6f4c427bbf12da10","session_id":"29257b8f-ede7-46a4-8e0f-a743591d296a","uuid":"cd42d69c-aae4-44bf-95b1-03d43ac578d1","timestamp":"2026-06-09T05:10:24.192Z","subagent_type":"Explore","task_description":"Explore backend performance"}
