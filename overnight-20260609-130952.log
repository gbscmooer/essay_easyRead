{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call_52db78d1be73408b84ca21ce","type":"tool_result","content":"1\timport React, { useState, useCallback, useRef, useEffect, forwardRef, useImperativeHandle } from 'react'\n2\timport { Document, Page, pdfjs } from 'react-pdf'\n3\timport { SelectionPopup } from '@/components/SelectionPopup'\n4\timport { AnnotationLayer } from './AnnotationLayer'\n5\timport { useUIConfig } from '@/hooks/useConfig'\n6\timport { listAnnotations, createAnnotation, deleteAnnotation, deleteAnnotationGroup } from '@/api/annotations'\n7\timport { toast } from '@/hooks/useToast'\n8\timport type { Annotation, AnnotationType } from '@/types'\n9\timport 'react-pdf/dist/esm/Page/AnnotationLayer.css'\n10\timport 'react-pdf/dist/esm/Page/TextLayer.css'\n11\t\n12\t\n13\tpdfjs.GlobalWorkerOptions.workerSrc = new URL(\n14\t  'pdfjs-dist/build/pdf.worker.min.js',\n15\t  import.meta.url,\n16\t).toString()\n17\t\n18\t\n19\tinterface PdfViewerProps {\n20\t  pdfUrl: string\n21\t  paperId?: number\n22\t  activePage?: number | null\n23\t  onPageChange: (page: number) => void\n24\t}\n25\t\n26\texport interface PdfViewerHandle {\n27\t  jumpToPage: (page: number) => void\n28\t}\n29\t\n30\texport const PdfViewer = forwardRef<PdfViewerHandle, PdfViewerProps>(function PdfViewer(\n31\t  { pdfUrl, paperId, activePage, onPageChange },\n32\t  ref,\n33\t) {\n34\t  const uiConfig = useUIConfig()\n35\t  const [numPages, setNumPages] = useState(0)\n36\t  const [scale, setScale] = useState(1.0)\n37\t  const [pageInput, setPageInput] = useState('')\n38\t  const [isLoading, setIsLoading] = useState(true)\n39\t  const [visiblePage, setVisiblePage] = useState(1)\n40\t  const [annotations, setAnnotations] = useState<Annotation[]>([])\n41\t  const scrollRef = useRef<HTMLDivElement>(null)\n42\t  const pageRefs = useRef<Map<number, HTMLDivElement>>(new Map())\n43\t  const isScrollingRef = useRef(false)\n44\t  const scrollTimerRef = useRef<ReturnType<typeof setTimeout>>()\n45\t  const visiblePageRef = useRef(visiblePage)\n46\t\n47\t  // Load annotations when paperId changes\n48\t  useEffect(() => {\n49\t    if (!paperId) {\n50\t      setAnnotations([])\n51\t      return\n52\t    }\n53\t    listAnnotations(paperId)\n54\t      .then(setAnnotations)\n55\t      .catch(() => setAnnotations([]))\n56\t  }, [paperId])\n57\t\n58\t  const handleAnnotate = useCallback(async (data: {\n59\t    pageNumber: number\n60\t    x: number\n61\t    y: number\n62\t    width: number\n63\t    height: number\n64\t    annotationType: AnnotationType\n65\t    color: string\n66\t    text: string\n67\t    groupId: string\n68\t  }) => {\n69\t    if (!paperId) return\n70\t    try {\n71\t      const ann = await createAnnotation(paperId, {\n72\t        page_number: data.pageNumber,\n73\t        x: data.x,\n74\t        y: data.y,\n75\t        width: data.width,\n76\t        height: data.height,\n77\t        annotation_type: data.annotationType,\n78\t        color: data.color,\n79\t        text: data.text,\n80\t        group_id: data.groupId,\n81\t      })\n82\t      setAnnotations(prev => [...prev, ann])\n83\t    } catch (e: any) {\n84\t      toast({ type: 'error', message: e?.message || '创建标注失败' })\n85\t    }\n86\t  }, [paperId])\n87\t\n88\t  const handleDeleteAnnotation = useCallback(async (id: number) => {\n89\t    try {\n90\t      // Find the annotation to check its group_id\n91\t      const target = annotations.find(a => a.id === id)\n92\t      if (target?.group_id) {\n93\t        // Delete the entire group\n94\t        await deleteAnnotationGroup(target.group_id)\n95\t        const gid = target.group_id\n96\t        setAnnotations(prev => prev.filter(a => a.group_id !== gid))\n97\t      } else {\n98\t        // Fallback: single delete (legacy annotations without group_id)\n99\t        await deleteAnnotation(id)\n100\t        setAnnotations(prev => prev.filter(a => a.id !== id))\n101\t      }\n102\t    } catch (e: any) {\n103\t      toast({ type: 'error', message: e?.message || '删除标注失败' })\n104\t    }\n105\t  }, [annotations])\n106\t\n107\t  const onDocumentLoadSuccess = useCallback(({ numPages: total }: { numPages: number }) => {\n108\t    setNumPages(total)\n109\t    setIsLoading(false)\n110\t  }, [])\n111\t\n112\t  const onDocumentLoadError = useCallback(() => {\n113\t    setIsLoading(false)\n114\t  }, [])\n115\t\n116\t  const scrollToPage = useCallback((page: number) => {\n117\t    const container = scrollRef.current\n118\t    const el = pageRefs.current.get(page)\n119\t    if (!container || !el) return\n120\t\n121\t    isScrollingRef.current = true\n122\t    if (scrollTimerRef.current) clearTimeout(scrollTimerRef.current)\n123\t\n124\t    const containerRect = container.getBoundingClientRect()\n125\t    const elRect = el.getBoundingClientRect()\n126\t    const offset = elRect.top - containerRect.top + container.scrollTop - 16\n127\t\n128\t    container.scrollTo({ top: offset, behavior: 'smooth' })\n129\t\n130\t    scrollTimerRef.current = setTimeout(() => {\n131\t      isScrollingRef.current = false\n132\t      setVisiblePage(page)\n133\t      onPageChange(page)\n134\t    }, 800)\n135\t  }, [onPageChange])\n136\t\n137\t  useImperativeHandle(ref, () => ({\n138\t    jumpToPage: (page: number) => {\n139\t      if (page >= 1 && page <= numPages) {\n140\t        scrollToPage(page)\n141\t      }\n142\t    },\n143\t  }), [numPages, scrollToPage])\n144\t\n145\t  useEffect(() => {\n146\t    const container = scrollRef.current\n147\t    if (!container) return\n148\t\n149\t    let scrollTimer: ReturnType<typeof setTimeout>\n150\t    const handleScroll = () => {\n151\t      isScrollingRef.current = true\n152\t      clearTimeout(scrollTimer)\n153\t      scrollTimer = setTimeout(() => {\n154\t        isScrollingRef.current = false\n155\t      }, 150)\n156\t    }\n157\t\n158\t    container.addEventListener('scroll', handleScroll, { passive: true })\n159\t    return () => {\n160\t      container.removeEventListener('scroll', handleScroll)\n161\t      clearTimeout(scrollTimer)\n162\t    }\n163\t  }, [])\n164\t\n165\t  useEffect(() => { visiblePageRef.current = visiblePage }, [visiblePage])\n166\t\n167\t  useEffect(() => {\n168\t    const container = scrollRef.current\n169\t    if (!container || numPages === 0) return\n170\t\n171\t    const observer = new IntersectionObserver(\n172\t      (entries) => {\n173\t        if (isScrollingRef.current) return\n174\t\n175\t        let maxRatio = 0\n176\t        let mostVisible = 1\n177\t        for (const entry of entries) {\n178\t          if (entry.intersectionRatio > maxRatio) {\n179\t            maxRatio = entry.intersectionRatio\n180\t            const pageNum = Number(entry.target.getAttribute('data-page'))\n181\t            if (pageNum) mostVisible = pageNum\n182\t          }\n183\t        }\n184\t        if (maxRatio > 0 && mostVisible !== visiblePageRef.current) {\n185\t          setVisiblePage(mostVisible)\n186\t        }\n187\t      },\n188\t      {\n189\t        root: container,\n190\t        threshold: [0, 0.25, 0.5, 0.75, 1],\n191\t      }\n192\t    )\n193\t\n194\t    pageRefs.current.forEach((el) => observer.observe(el))\n195\t    return () => observer.disconnect()\n196\t  }, [numPages])\n197\t\n198\t  useEffect(() => {\n199\t    const container = scrollRef.current\n200\t    if (!container) return\n201\t\n202\t    const handleWheel = (e: WheelEvent) => {\n203\t      if (!e.ctrlKey) return\n204\t      e.preventDefault()\n205\t      const delta = -e.deltaY\n206\t      setScale(s => {\n207\t        const step = uiConfig.pinch_zoom_step || 0.02\n208\t        const max = uiConfig.zoom_max || 3\n209\t        const min = uiConfig.zoom_min || 0.4\n210\t        if (delta > 0) return Math.min(s + step, max)\n211\t        if (delta < 0) return Math.max(s - step, min)\n212\t        return s\n213\t      })\n214\t    }\n215\t\n216\t    container.addEventListener('wheel', handleWheel, { passive: false })\n217\t    return () => container.removeEventListener('wheel', handleWheel)\n218\t  }, [uiConfig])\n219\t\n220\t  useEffect(() => {\n221\t    return () => {\n222\t      if (scrollTimerRef.current) clearTimeout(scrollTimerRef.current)\n223\t    }\n224\t  }, [])\n225\t\n226\t  const goToPage = useCallback((page: number) => {\n227\t    if (page >= 1 && page <= numPages) {\n228\t      scrollToPage(page)\n229\t    }\n230\t  }, [numPages, scrollToPage])\n231\t\n232\t  const handlePageInputKeyDown = useCallback((e: React.KeyboardEvent<HTMLInputElement>) => {\n233\t    if (e.key === 'Enter') {\n234\t      const page = parseInt(pageInput, 10)\n235\t      if (!isNaN(page)) goToPage(page)\n236\t      setPageInput('')\n237\t    }\n238\t  }, [pageInput, goToPage])\n239\t\n240\t  const zoomIn = useCallback(() => setScale(s => Math.min(s + (uiConfig.zoom_step || 0.2), uiConfig.zoom_max || 3)), [uiConfig])\n241\t  const zoomOut = useCallback(() => setScale(s => Math.max(s - (uiConfig.zoom_step || 0.2), uiConfig.zoom_min || 0.4)), [uiConfig])\n242\t  const resetZoom = useCallback(() => setScale(1.0), [])\n243\t\n244\t  return (\n245\t    <div className=\"flex flex-col h-full rounded-lg overflow-hidden relative\" style={{ backgroundColor: 'var(--bg-surface)' }}>\n246\t      {/* 文本选择弹窗 */}\n247\t      <SelectionPopup containerRef={scrollRef} onAnnotate={handleAnnotate} />\n248\t\n249\t      {/* PDF 内容区 — 连续滚动 */}\n250\t      <div ref={scrollRef} className=\"flex-1 overflow-auto\">\n251\t        {isLoading && (\n252\t          <div className=\"w-full h-full flex items-center justify-center\">\n253\t            <div className=\"w-8 h-8 border-2 rounded-full animate-spin\" style={{ borderColor: 'var(--border-light)', borderTopColor: 'var(--accent)' }} />\n254\t          </div>\n255\t        )}\n256\t        <Document\n257\t          file={pdfUrl}\n258\t          onLoadSuccess={onDocumentLoadSuccess}\n259\t          onLoadError={onDocumentLoadError}\n260\t          loading={null}\n261\t        >\n262\t          <div className=\"flex flex-col items-center gap-4 py-4\">\n263\t            {Array.from({ length: numPages }, (_, i) => i + 1).map(pageNum => (\n264\t              <div\n265\t                key={pageNum}\n266\t                data-page={pageNum}\n267\t                ref={el => {\n268\t                  if (el) pageRefs.current.set(pageNum, el)\n269\t                  else pageRefs.current.delete(pageNum)\n270\t                }}\n271\t                className={`relative transition-all duration-300 ${\n272\t                  activePage === pageNum\n273\t                    ? 'ring-2 ring-blue-500/60 ring-offset-2 ring-offset-gray-900 scale-[1.01]'\n274\t                    : ''\n275\t                }`}\n276\t              >\n277\t                <Page\n278\t                  pageNumber={pageNum}\n279\t                  scale={scale}\n280\t                  renderTextLayer={true}\n281\t                  renderAnnotationLayer={true}\n282\t                  className=\"shadow-xl\"\n283\t                />\n284\t                {/* 标注叠加层 */}\n285\t                <AnnotationLayer\n286\t                  annotations={annotations}\n287\t                  pageNumber={pageNum}\n288\t                  onDelete={handleDeleteAnnotation}\n289\t                />\n290\t                {/* 页码标注 */}\n291\t                <div className=\"absolute -left-12 top-0 text-xs w-8 text-right select-none\" style={{ color: 'var(--text-muted)' }}>\n292\t                  {pageNum}\n293\t                </div>\n294\t                {/* 跳转高亮光晕 */}\n295\t                {activePage === pageNum && (\n296\t                  <div className=\"absolute inset-0 pointer-events-none bg-blue-500/10 rounded\" />\n297\t                )}\n298\t              </div>\n299\t            ))}\n300\t          </div>\n301\t        </Document>\n302\t      </div>\n303\t\n304\t      {/* 底部控制栏 */}\n305\t      <div className=\"flex items-center justify-between px-4 py-2 border-t backdrop-blur-sm\" style={{ backgroundColor: 'var(--bg-surface)', opacity: 0.9, borderColor: 'var(--border)' }}>\n306\t        {/* 翻页控制 */}\n307\t        <div className=\"flex items-center gap-2\">\n308\t          <button\n309\t            onClick={() => goToPage(Math.max(1, visiblePage - 1))}\n310\t            disabled={visiblePage <= 1}\n311\t            className=\"px-2 py-1 text-sm rounded disabled:opacity-30 disabled:cursor-not-allowed transition-colors\"\n312\t            style={{ color: 'var(--text-secondary)', backgroundColor: 'var(--bg-elevated)' }}\n313\t            onMouseEnter={e => { (e.currentTarget as HTMLElement).style.backgroundColor = 'var(--bg-surface)' }}\n314\t            onMouseLeave={e => { (e.currentTarget as HTMLElement).style.backgroundColor = 'var(--bg-elevated)' }}\n315\t          >\n316\t            上一页\n317\t          </button>\n318\t\n319\t          <div className=\"flex items-center gap-1 text-sm\" style={{ color: 'var(--text-secondary)' }}>\n320\t            <input\n321\t              type=\"text\"\n322\t              value={pageInput}\n323\t              onChange={e => setPageInput(e.target.value)}\n324\t              onKeyDown={handlePageInputKeyDown}\n325\t              placeholder={String(visiblePage)}\n326\t              className=\"w-10 text-center rounded text-sm py-0.5 focus:outline-none\" style={{ backgroundColor: 'var(--bg-elevated)', border: '1px solid var(--border-light)', color: 'var(--text-primary)' }}\n327\t            />\n328\t            <span>/ {numPages || '--'}</span>\n329\t          </div>\n330\t\n331\t          <button\n332\t            onClick={() => goToPage(Math.min(numPages, visiblePage + 1))}\n333\t            disabled={visiblePage >= numPages}\n334\t            className=\"px-2 py-1 text-sm rounded disabled:opacity-30 disabled:cursor-not-allowed transition-colors\"\n335\t            style={{ color: 'var(--text-secondary)', backgroundColor: 'var(--bg-elevated)' }}\n336\t            onMouseEnter={e => { (e.currentTarget as HTMLElement).style.backgroundColor = 'var(--bg-surface)' }}\n337\t            onMouseLeave={e => { (e.currentTarget as HTMLElement).style.backgroundColor = 'var(--bg-elevated)' }}\n338\t          >\n339\t            下一页\n340\t          </button>\n341\t        </div>\n342\t\n343\t        {/* 标注统计 */}\n344\t        {annotations.length > 0 && (\n345\t          <span className=\"text-xs text-gray-500\">\n346\t            {annotations.length} 个标注\n347\t          </span>\n348\t        )}\n349\t\n350\t        {/* 缩放控制 */}\n351\t        <div className=\"flex items-center gap-2\">\n352\t          <button\n353\t            onClick={zoomOut}\n354\t            className=\"px-2 py-1 text-sm rounded transition-colors\" style={{ color: 'var(--text-secondary)', backgroundColor: 'var(--bg-elevated)' }} onMouseEnter={e => { (e.currentTarget as HTMLElement).style.backgroundColor = 'var(--bg-surface)' }} onMouseLeave={e => { (e.currentTarget as HTMLElement).style.backgroundColor = 'var(--bg-elevated)' }}\n355\t          >\n356\t            −\n357\t          </button>\n358\t          <button\n359\t            onClick={resetZoom}\n360\t            className=\"px-2 py-1 text-xs rounded transition-colors min-w-[3rem] text-center\" style={{ color: 'var(--text-secondary)', backgroundColor: 'var(--bg-elevated)' }} onMouseEnter={e => { (e.currentTarget as HTMLElement).style.backgroundColor = 'var(--bg-surface)' }} onMouseLeave={e => { (e.currentTarget as HTMLElement).style.backgroundColor = 'var(--bg-elevated)' }}\n361\t          >\n362\t            {Math.round(scale * 100)}%\n363\t          </button>\n364\t          <button\n365\t            onClick={zoomIn}\n366\t            className=\"px-2 py-1 text-sm rounded transition-colors\" style={{ color: 'var(--text-secondary)', backgroundColor: 'var(--bg-elevated)' }} onMouseEnter={e => { (e.currentTarget as HTMLElement).style.backgroundColor = 'var(--bg-surface)' }} onMouseLeave={e => { (e.currentTarget as HTMLElement).style.backgroundColor = 'var(--bg-elevated)' }}\n367\t          >\n368\t            +\n369\t          </button>\n370\t        </div>\n371\t      </div>\n372\t    </div>\n373\t  )\n374\t})\n375\t"}]},"parent_tool_use_id":"call_bddd82a75f2e46b98e4517cc","session_id":"29257b8f-ede7-46a4-8e0f-a743591d296a","uuid":"9fc7030f-4712-496e-970f-f2168b8662bf","timestamp":"2026-06-09T05:10:29.375Z","subagent_type":"Explore","task_description":"Explore frontend performance"}
