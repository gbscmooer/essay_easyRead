{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call_dc6528861d7b42bcae2fef23","type":"tool_result","content":"1\timport { useState, useEffect, useRef, useCallback } from 'react'\n2\timport { useNavigate } from 'react-router-dom'\n3\timport { textAction } from '@/api/textAction'\n4\timport type { AnnotationType } from '@/types'\n5\timport { toast } from '@/hooks/useToast'\n6\t\n7\t\n8\tinterface SelectionPopupProps {\n9\t  containerRef: React.RefObject<HTMLElement | null>\n10\t  onAnnotate?: (data: {\n11\t    pageNumber: number\n12\t    x: number\n13\t    y: number\n14\t    width: number\n15\t    height: number\n16\t    annotationType: AnnotationType\n17\t    color: string\n18\t    text: string\n19\t    groupId: string\n20\t  }) => void\n21\t}\n22\t\n23\t\n24\tfunction mergeLineRects(rects: DOMRect[]): DOMRect[] {\n25\t  const valid = rects.filter(r => r.width > 1 && r.height > 1)\n26\t  if (valid.length === 0) return []\n27\t  valid.sort((a, b) => a.top - b.top)\n28\t  const merged: DOMRect[] = []\n29\t  for (const r of valid) {\n30\t    const last = merged[merged.length - 1]\n31\t    if (last && Math.abs(r.top - last.top) < last.height * 0.6) {\n32\t      const left = Math.min(last.left, r.left)\n33\t      const top = Math.min(last.top, r.top)\n34\t      const right = Math.max(last.right, r.right)\n35\t      const bottom = Math.max(last.bottom, r.bottom)\n36\t      merged[merged.length - 1] = new DOMRect(left, top, right - left, bottom - top)\n37\t    } else {\n38\t      merged.push(new DOMRect(r.left, r.top, r.width, r.height))\n39\t    }\n40\t  }\n41\t  return merged\n42\t}\n43\t\n44\t\n45\tconst HIGHLIGHT_COLORS = [\n46\t  { name: '黄', value: '#fde047' },\n47\t  { name: '绿', value: '#86efac' },\n48\t  { name: '蓝', value: '#93c5fd' },\n49\t  { name: '粉', value: '#f9a8d4' },\n50\t  { name: '橙', value: '#fdba74' },\n51\t]\n52\t\n53\t\n54\texport function SelectionPopup({ containerRef, onAnnotate }: SelectionPopupProps) {\n55\t  const [visible, setVisible] = useState(false)\n56\t  const [position, setPosition] = useState({ x: 0, y: 0 })\n57\t  const [selectedText, setSelectedText] = useState('')\n58\t  const [result, setResult] = useState<string | null>(null)\n59\t  const [loading, setLoading] = useState(false)\n60\t  const [action, setAction] = useState<'translate' | 'summarize' | null>(null)\n61\t  const [configError, setConfigError] = useState<string | null>(null)\n62\t  const [copied, setCopied] = useState(false)\n63\t  const [showColorPicker, setShowColorPicker] = useState(false)\n64\t  const [pendingAnnotationType, setPendingAnnotationType] = useState<AnnotationType | null>(null)\n65\t  const [flipY, setFlipY] = useState(false)\n66\t  const popupRef = useRef<HTMLDivElement>(null)\n67\t  const navigate = useNavigate()\n68\t  const dragging = useRef(false)\n69\t  const dragOffset = useRef({ x: 0, y: 0 })\n70\t  const timeoutRef = useRef<number | null>(null)\n71\t  const selectionRectRef = useRef<DOMRect | null>(null)\n72\t  const selectionLineRectsRef = useRef<DOMRect[]>([])\n73\t  const pageElementRef = useRef<HTMLElement | null>(null)\n74\t\n75\t\n76\t  const hidePopup = useCallback(() => {\n77\t    setVisible(false)\n78\t    setResult(null)\n79\t    setLoading(false)\n80\t    setAction(null)\n81\t    setSelectedText('')\n82\t    setConfigError(null)\n83\t    setCopied(false)\n84\t    setShowColorPicker(false)\n85\t    setPendingAnnotationType(null)\n86\t    selectionRectRef.current = null\n87\t    selectionLineRectsRef.current = []\n88\t    pageElementRef.current = null\n89\t  }, [])\n90\t\n91\t\n92\t  useEffect(() => {\n93\t    const container = containerRef.current\n94\t    if (!container) return\n95\t\n96\t    const handleMouseUp = () => {\n97\t      if (timeoutRef.current) clearTimeout(timeoutRef.current)\n98\t      timeoutRef.current = window.setTimeout(() => {\n99\t        const selection = window.getSelection()\n100\t        const text = selection?.toString().trim() || ''\n101\t\n102\t        if (text.length < 3) return\n103\t\n104\t        if (!selection || selection.rangeCount === 0) return\n105\t        const range = selection.getRangeAt(0)\n106\t        if (!container.contains(range.commonAncestorContainer)) return\n107\t\n108\t        const rect = range.getBoundingClientRect()\n109\t        const containerRect = container.getBoundingClientRect()\n110\t\n111\t        // 查找包含选区的页面元素\n112\t        let pageEl: HTMLElement | null = null\n113\t        let node: Node | null = range.commonAncestorContainer\n114\t        while (node && node !== container) {\n115\t          if (node instanceof HTMLElement && node.dataset.page) {\n116\t            pageEl = node\n117\t            break\n118\t          }\n119\t          node = node.parentNode\n120\t        }\n121\t\n122\t        selectionRectRef.current = rect\n123\t        selectionLineRectsRef.current = mergeLineRects(Array.from(range.getClientRects()))\n124\t        pageElementRef.current = pageEl\n125\t\n126\t        const posY = rect.top - containerRect.top - 8\n127\t        setFlipY(posY < 60)\n128\t        setPosition({\n129\t          x: rect.left + rect.width / 2 - containerRect.left,\n130\t          y: posY,\n131\t        })\n132\t        setSelectedText(text)\n133\t        setResult(null)\n134\t        setLoading(false)\n135\t        setAction(null)\n136\t        setShowColorPicker(false)\n137\t        setPendingAnnotationType(null)\n138\t        setVisible(true)\n139\t      }, 10)\n140\t    }\n141\t\n142\t    const handleMouseDown = (e: MouseEvent) => {\n143\t      if (popupRef.current && !popupRef.current.contains(e.target as Node)) {\n144\t        hidePopup()\n145\t      }\n146\t    }\n147\t\n148\t    // Mobile: selectionchange fires during long-press text selection\n149\t    let selectionTimer: number | null = null\n150\t    const handleSelectionChange = () => {\n151\t      if (selectionTimer) clearTimeout(selectionTimer)\n152\t      selectionTimer = window.setTimeout(() => {\n153\t        const sel = document.getSelection()\n154\t        if (!sel || sel.isCollapsed || !sel.rangeCount) return\n155\t        const range = sel.getRangeAt(0)\n156\t        const text = sel.toString().trim()\n157\t        if (text.length < 3) return\n158\t        // Check if selection is within the container\n159\t        if (!container.contains(range.commonAncestorContainer)) return\n160\t        const containerRect = container.getBoundingClientRect()\n161\t        const rect = range.getBoundingClientRect()\n162\t        if (rect.width === 0) return\n163\t        const posX = rect.left + rect.width / 2 - containerRect.left\n164\t        const posY = rect.top - containerRect.top - 8\n165\t        setFlipY(posY < 60)\n166\t        setPosition({ x: posX, y: posY })\n167\t        setSelectedText(text)\n168\t        setResult(null)\n169\t        setLoading(false)\n170\t        setAction(null)\n171\t        setShowColorPicker(false)\n172\t        setPendingAnnotationType(null)\n173\t        setVisible(true)\n174\t      }, 300)\n175\t    }\n176\t\n177\t    container.addEventListener('mouseup', handleMouseUp)\n178\t    document.addEventListener('mousedown', handleMouseDown)\n179\t    document.addEventListener('selectionchange', handleSelectionChange)\n180\t\n181\t    return () => {\n182\t      if (timeoutRef.current) clearTimeout(timeoutRef.current)\n183\t      if (selectionTimer) clearTimeout(selectionTimer)\n184\t      container.removeEventListener('mouseup', handleMouseUp)\n185\t      document.removeEventListener('mousedown', handleMouseDown)\n186\t      document.removeEventListener('selectionchange', handleSelectionChange)\n187\t    }\n188\t  }, [containerRef, hidePopup])\n189\t\n190\t\n191\t  useEffect(() => {\n192\t    const handleMouseMove = (e: MouseEvent) => {\n193\t      if (!dragging.current) return\n194\t      const container = containerRef.current\n195\t      if (!container) return\n196\t      const containerRect = container.getBoundingClientRect()\n197\t      const popup = popupRef.current\n198\t      const popupW = popup?.offsetWidth || 0\n199\t      const popupH = popup?.offsetHeight || 0\n200\t      setPosition({\n201\t        x: e.clientX - containerRect.left - dragOffset.current.x + popupW / 2,\n202\t        y: e.clientY - containerRect.top - dragOffset.current.y + popupH,\n203\t      })\n204\t    }\n205\t    const handleMouseUp = () => {\n206\t      dragging.current = false\n207\t      document.body.style.cursor = ''\n208\t      document.body.style.userSelect = ''\n209\t    }\n210\t    document.addEventListener('mousemove', handleMouseMove)\n211\t    document.addEventListener('mouseup', handleMouseUp)\n212\t    return () => {\n213\t      document.removeEventListener('mousemove', handleMouseMove)\n214\t      document.removeEventListener('mouseup', handleMouseUp)\n215\t    }\n216\t  }, [containerRef])\n217\t\n218\t\n219\t  const handleAction = useCallback(async (act: 'translate' | 'summarize') => {\n220\t    setAction(act)\n221\t    setLoading(true)\n222\t    setResult(null)\n223\t    setConfigError(null)\n224\t\n225\t    try {\n226\t      const res = await textAction(selectedText, act)\n227\t      setResult(res)\n228\t    } catch (err: unknown) {\n229\t      const msg = err instanceof Error ? err.message : String(err)\n230\t      if (msg.includes('API Key') || msg.includes('配置')) {\n231\t        setConfigError(msg)\n232\t      } else {\n233\t        setResult(`处理失败: ${msg}`)\n234\t      }\n235\t    } finally {\n236\t      setLoading(false)\n237\t    }\n238\t  }, [selectedText])\n239\t\n240\t\n241\t  const doAnnotate = useCallback((type: AnnotationType, color: string) => {\n242\t    const pageEl = pageElementRef.current\n243\t    if (!pageEl || !onAnnotate) return\n244\t\n245\t    const lineRects = selectionLineRectsRef.current.length > 0\n246\t      ? selectionLineRectsRef.current\n247\t      : selectionRectRef.current ? [selectionRectRef.current] : []\n248\t\n249\t    if (lineRects.length === 0) return\n250\t\n251\t    const pageRect = pageEl.getBoundingClientRect()\n252\t    const pageNumber = parseInt(pageEl.dataset.page || '1', 10)\n253\t\n254\t    // Generate a unique group_id so all annotations from this action can be deleted together\n255\t    const groupId = `g_${Date.now()}_${Math.random().toString(36).slice(2, 8)}`\n256\t\n257\t    for (const selRect of lineRects) {\n258\t      const x = Math.max(0, (selRect.left - pageRect.left) / pageRect.width)\n259\t      const y = Math.max(0, (selRect.top - pageRect.top) / pageRect.height)\n260\t      const width = Math.min(1, selRect.width / pageRect.width)\n261\t      const height = Math.min(1, selRect.height / pageRect.height)\n262\t      if (width < 0.001 || height < 0.001) continue\n263\t      onAnnotate({\n264\t        pageNumber,\n265\t        x, y, width, height,\n266\t        annotationType: type,\n267\t        color,\n268\t        text: selectedText,\n269\t        groupId,\n270\t      })\n271\t    }\n272\t\n273\t    hidePopup()\n274\t    window.getSelection()?.removeAllRanges()\n275\t  }, [onAnnotate, selectedText, hidePopup])\n276\t\n277\t\n278\t  const handleMarkupClick = useCallback((type: AnnotationType) => {\n279\t    setPendingAnnotationType(type)\n280\t    if (type === 'highlight') {\n281\t      setShowColorPicker(true)\n282\t    } else {\n283\t      doAnnotate(type, '#ef4444')\n284\t    }\n285\t  }, [doAnnotate])\n286\t\n287\t\n288\t  const handleColorSelect = useCallback((color: string) => {\n289\t    if (pendingAnnotationType) {\n290\t      doAnnotate(pendingAnnotationType, color)\n291\t    }\n292\t    setShowColorPicker(false)\n293\t  }, [pendingAnnotationType, doAnnotate])\n294\t\n295\t\n296\t  if (!visible || selectedText.length < 3) return null\n297\t\n298\t\n299\t  return (\n300\t    <div\n301\t      ref={popupRef}\n302\t      className=\"absolute z-50 pointer-events-auto\"\n303\t      style={{\n304\t        left: `${position.x}px`,\n305\t        top: `${position.y}px`,\n306\t        transform: flipY ? 'translate(-50%, 0)' : 'translate(-50%, -100%)',\n307\t      }}\n308\t    >\n309\t      <div\n310\t        className=\"rounded-lg shadow-2xl overflow-hidden cursor-move select-none transition-colors\"\n311\t        style={{ backgroundColor: 'var(--bg-elevated)', border: '1px solid var(--border-light)' }}\n312\t        onMouseEnter={e => { (e.currentTarget as HTMLElement).style.borderColor = 'var(--text-muted)' }}\n313\t        onMouseLeave={e => { (e.currentTarget as HTMLElement).style.borderColor = 'var(--border-light)' }}\n314\t        onMouseDown={(e) => {\n315\t          e.preventDefault()\n316\t          const popup = popupRef.current\n317\t          if (!popup) return\n318\t          const rect = popup.getBoundingClientRect()\n319\t          dragging.current = true\n320\t          dragOffset.current = {\n321\t            x: e.clientX - rect.left,\n322\t            y: e.clientY - rect.top,\n323\t          }\n324\t          document.body.style.cursor = 'move'\n325\t          document.body.style.userSelect = 'none'\n326\t        }}\n327\t      >\n328\t        {/* 操作按钮行 */}\n329\t        {!result && !loading && !showColorPicker && (\n330\t          <div className=\"flex items-center gap-1 p-1.5\">\n331\t            <button\n332\t              onMouseDown={e => e.stopPropagation()}\n333\t              onClick={() => handleAction('translate')}\n334\t              aria-label=\"翻译\"\n335\t              className=\"px-3 py-1.5 text-xs font-medium rounded transition-colors\"\n336\t              style={{ color: 'var(--text-primary)', backgroundColor: 'var(--bg-surface)' }}\n337\t              onMouseEnter={e => { (e.currentTarget as HTMLElement).style.backgroundColor = 'var(--accent)' }}\n338\t              onMouseLeave={e => { (e.currentTarget as HTMLElement).style.backgroundColor = 'var(--bg-surface)' }}\n339\t            >\n340\t              翻译\n341\t            </button>\n342\t            <button\n343\t              onMouseDown={e => e.stopPropagation()}\n344\t              onClick={() => handleAction('summarize')}\n345\t              aria-label=\"总结\"\n346\t              className=\"px-3 py-1.5 text-xs font-medium rounded transition-colors\"\n347\t              style={{ color: 'var(--text-primary)', backgroundColor: 'var(--bg-surface)' }}\n348\t              onMouseEnter={e => { (e.currentTarget as HTMLElement).style.backgroundColor = 'var(--accent)' }}\n349\t              onMouseLeave={e => { (e.currentTarget as HTMLElement).style.backgroundColor = 'var(--bg-surface)' }}\n350\t            >\n351\t              总结\n352\t            </button>\n353\t            <div className=\"w-px h-5 bg-gray-600 mx-0.5\" />\n354\t            <button\n355\t              onMouseDown={e => e.stopPropagation()}\n356\t              onClick={() => handleMarkupClick('highlight')}\n357\t              className=\"px-2.5 py-1.5 text-xs font-medium bg-gray-700 hover:bg-yellow-600 rounded transition-colors\"\n358\t              style={{ color: 'var(--text-primary)' }}\n359\t              title=\"荧光笔\"\n360\t            >\n361\t              <svg className=\"w-3.5 h-3.5 inline-block mr-0.5\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\">\n362\t                <path strokeLinecap=\"round\" strokeLinejoin=\"round\" strokeWidth={2} d=\"M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z\" />\n363\t              </svg>\n364\t            </button>\n365\t            <button\n366\t              onMouseDown={e => e.stopPropagation()}\n367\t              onClick={() => handleMarkupClick('underline')}\n368\t              className=\"px-2.5 py-1.5 text-xs font-medium bg-gray-700 hover:bg-blue-600 rounded transition-colors\"\n369\t              style={{ color: 'var(--text-primary)' }}\n370\t              title=\"下划线\"\n371\t            >\n372\t              <svg className=\"w-3.5 h-3.5 inline-block mr-0.5\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\">\n373\t                <path strokeLinecap=\"round\" strokeLinejoin=\"round\" strokeWidth={2} d=\"M7 4v7a5 5 0 0010 0V4M5 20h14\" />\n374\t              </svg>\n375\t              划线\n376\t            </button>\n377\t            <button\n378\t              onMouseDown={e => e.stopPropagation()}\n379\t              onClick={() => handleMarkupClick('strikethrough')}\n380\t              className=\"px-2.5 py-1.5 text-xs font-medium bg-gray-700 hover:bg-red-600 rounded transition-colors\"\n381\t              style={{ color: 'var(--text-primary)' }}\n382\t              title=\"删除线\"\n383\t            >\n384\t              <svg className=\"w-3.5 h-3.5 inline-block mr-0.5\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\">\n385\t                <path strokeLinecap=\"round\" strokeLinejoin=\"round\" strokeWidth={2} d=\"M4 12h16M8 6h8a2 2 0 012 2v0a2 2 0 01-2 2H8M8 14h8a2 2 0 012 2v0a2 2 0 01-2 2H8\" />\n386\t              </svg>\n387\t              删除\n388\t            </button>\n389\t          </div>\n390\t        )}\n391\t\n392\t        {/* 颜色选择器 */}\n393\t        {showColorPicker && (\n394\t          <div className=\"p-2\">\n395\t            <p className=\"text-xs text-gray-400 mb-1.5\">选择颜色</p>\n396\t            <div className=\"flex items-center gap-1.5\">\n397\t              {HIGHLIGHT_COLORS.map(c => (\n398\t                <button\n399\t                  key={c.value}\n400\t                  onMouseDown={e => e.stopPropagation()}\n401\t                  onClick={() => handleColorSelect(c.value)}\n402\t                  className=\"w-6 h-6 rounded-full border-2 border-gray-600 hover:border-white transition-colors\"\n403\t                  style={{ backgroundColor: c.value }}\n404\t                  title={c.name}\n405\t                />\n406\t              ))}\n407\t              <button\n408\t                onMouseDown={e => e.stopPropagation()}\n409\t                onClick={() => setShowColorPicker(false)}\n410\t                className=\"ml-1 text-xs text-gray-400 hover:text-gray-200\"\n411\t              >\n412\t                取消\n413\t              </button>\n414\t            </div>\n415\t          </div>\n416\t        )}\n417\t\n418\t        {/* 加载状态 */}\n419\t        {loading && (\n420\t          <div className=\"flex items-center gap-2 px-4 py-3\">\n421\t            <div className=\"w-4 h-4 border-2 rounded-full animate-spin\" style={{ borderColor: 'var(--border-light)', borderTopColor: 'var(--accent)' }} role=\"status\"><span className=\"sr-only\">加载中</span></div>\n422\t            <span className=\"text-xs\" style={{ color: 'var(--text-secondary)' }}>\n423\t              {action === 'translate' ? '正在翻译...' : '正在总结...'}\n424\t            </span>\n425\t          </div>\n426\t        )}\n427\t\n428\t        {/* 配置错误 */}\n429\t        {configError && (\n430\t          <div className=\"px-3 py-2 max-w-xs\">\n431\t            <p className=\"text-xs text-red-400 mb-2\">{configError}</p>\n432\t            <button\n433\t              onMouseDown={e => e.stopPropagation()}\n434\t              onClick={() => {\n435\t                hidePopup()\n436\t                navigate('/settings')\n437\t              }}\n438\t              aria-label=\"设置\"\n439\t              className=\"text-xs text-blue-400 hover:text-blue-300 underline\"\n440\t            >\n441\t              前往配置页面 →\n442\t            </button>\n443\t          </div>\n444\t        )}\n445\t\n446\t        {/* 结果展示 */}\n447\t        {result && (\n448\t          <div className=\"max-w-sm\">\n449\t            <div className=\"flex items-center justify-between px-3 py-1.5 border-b\" style={{ borderColor: 'var(--border-light)' }}>\n450\t              <span className=\"text-xs\" style={{ color: 'var(--text-secondary)' }}>\n451\t                {action === 'translate' ? '翻译结果' : '总结'}\n452\t              </span>\n453\t              <div className=\"flex items-center gap-2\">\n454\t                <button\n455\t                  onMouseDown={e => e.stopPropagation()}\n456\t                  onClick={() => {\n457\t                    navigator.clipboard.writeText(result).then(() => {\n458\t                      setCopied(true)\n459\t                      setTimeout(() => setCopied(false), 1500)\n460\t                    }).catch(() => {\n461\t                      toast({ type: 'error', message: '复制到剪贴板失败' })\n462\t                    })\n463\t                  }}\n464\t                  aria-label=\"复制结果\"\n465\t                  className=\"text-xs transition-colors\"\n466\t                  style={{ color: 'var(--text-secondary)' }}\n467\t                  onMouseEnter={e => { (e.currentTarget as HTMLElement).style.color = 'var(--text-primary)' }}\n468\t                  onMouseLeave={e => { (e.currentTarget as HTMLElement).style.color = 'var(--text-secondary)' }}\n469\t                >\n470\t                  {copied ? '已复制' : '复制'}\n471\t                </button>\n472\t                <button\n473\t                  onMouseDown={e => e.stopPropagation()}\n474\t                  onClick={hidePopup}\n475\t                  aria-label=\"关闭\"\n476\t                  className=\"text-xs\"\n477\t                  style={{ color: 'var(--text-muted)' }}\n478\t                  onMouseEnter={e => { (e.currentTarget as HTMLElement).style.color = 'var(--text-secondary)' }}\n479\t                  onMouseLeave={e => { (e.currentTarget as HTMLElement).style.color = 'var(--text-muted)' }}\n480\t                >\n481\t                  &times;\n482\t                </button>\n483\t              </div>\n484\t            </div>\n485\t            <div className=\"px-3 py-2 max-h-48 overflow-auto\" onMouseDown={e => e.stopPropagation()}>\n486\t              <p className=\"text-sm leading-relaxed whitespace-pre-wrap\" style={{ color: 'var(--text-primary)' }}>\n487\t                {result}\n488\t              </p>\n489\t            </div>\n490\t            {/* 操作按钮 */}\n491\t            <div className=\"flex items-center gap-1 px-3 py-1.5 border-t\" style={{ borderColor: 'var(--border-light)' }}>\n492\t              <button\n493\t                onMouseDown={e => e.stopPropagation()}\n494\t                onClick={() => handleAction('translate')}\n495\t                className=\"px-2 py-1 text-xs rounded transition-colors\"\n496\t                style={action === 'translate' ? { backgroundColor: 'var(--accent)', color: 'var(--bg-base)' } : { color: 'var(--text-secondary)' }}\n497\t                onMouseEnter={e => { if (action !== 'translate') { (e.currentTarget as HTMLElement).style.backgroundColor = 'var(--bg-surface)'; (e.currentTarget as HTMLElement).style.color = 'var(--text-primary)' } }}\n498\t                onMouseLeave={e => { if (action !== 'translate') { (e.currentTarget as HTMLElement).style.backgroundColor = ''; (e.currentTarget as HTMLElement).style.color = 'var(--text-secondary)' } }}\n499\t              >\n500\t                翻译\n501\t              </button>\n502\t              <button\n503\t                onMouseDown={e => e.stopPropagation()}\n504\t                onClick={() => handleAction('summarize')}\n505\t                className=\"px-2 py-1 text-xs rounded transition-colors\"\n506\t                style={action === 'summarize' ? { backgroundColor: 'var(--accent)', color: 'var(--bg-base)' } : { color: 'var(--text-secondary)' }}\n507\t                onMouseEnter={e => { if (action !== 'summarize') { (e.currentTarget as HTMLElement).style.backgroundColor = 'var(--bg-surface)'; (e.currentTarget as HTMLElement).style.color = 'var(--text-primary)' } }}\n508\t                onMouseLeave={e => { if (action !== 'summarize') { (e.currentTarget as HTMLElement).style.backgroundColor = ''; (e.currentTarget as HTMLElement).style.color = 'var(--text-secondary)' } }}\n509\t              >\n510\t                总结\n511\t              </button>\n512\t            </div>\n513\t          </div>\n514\t        )}\n515\t      </div>\n516\t\n517\t      {/* 小三角箭头 */}\n518\t      <div className={`flex ${flipY ? 'justify-center -mb-1' : 'justify-center'}`}>\n519\t        <div\n520\t          className=\"w-2 h-2 transform rotate-45\"\n521\t          style={{\n522\t            backgroundColor: 'var(--bg-elevated)',\n523\t            borderRight: '1px solid var(--border-light)',\n524\t            borderBottom: flipY ? 'none' : '1px solid var(--border-light)',\n525\t            borderTop: flipY ? '1px solid var(--border-light)' : 'none',\n526\t            borderLeft: flipY ? '1px solid var(--border-light)' : 'none',\n527\t            marginTop: flipY ? 0 : '-4px',\n528\t            marginBottom: flipY ? 0 : undefined,\n529\t          }}\n530\t        />\n531\t      </div>\n532\t    </div>\n533\t  )\n534\t}\n535\t"}]},"parent_tool_use_id":"call_bddd82a75f2e46b98e4517cc","session_id":"29257b8f-ede7-46a4-8e0f-a743591d296a","uuid":"9e0df9a6-74b5-4e37-badf-ec9bc4c2edfe","timestamp":"2026-06-09T05:10:51.999Z","subagent_type":"Explore","task_description":"Explore frontend performance"}
