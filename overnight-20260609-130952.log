{"type":"assistant","message":{"id":"msg_733d605c1c2a48339bd68ff0","type":"message","role":"assistant","model":"mimo-v2.5","content":[{"type":"tool_use","id":"call_9ef8c621bb5844578f994dcc","name":"Read","input":{"file_path":"/Users/katisarrow/essay_read/frontend/src/components/LoadingState.tsx"}}],"usage":{"input_tokens":0,"output_tokens":0},"context_management":null},"parent_tool_use_id":"call_bddd82a75f2e46b98e4517cc","session_id":"29257b8f-ede7-46a4-8e0f-a743591d296a","uuid":"4078149c-eb62-43a4-98e7-47793bae8a83","subagent_type":"Explore","task_description":"Explore frontend performance"}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call_9ef8c621bb5844578f994dcc","type":"tool_result","content":"1\timport { useMemo } from 'react'\n2\timport type { AnalysisStatus, AnalysisResult } from '@/types'\n3\t\n4\t\n5\tinterface LoadingStateProps {\n6\t  status: AnalysisStatus\n7\t  message: string\n8\t  partialResult: Partial<AnalysisResult>\n9\t  /** 后端计算的进度百分比（0-100）。<0 时回退到前端字段估算 */\n10\t  progress?: number\n11\t}\n12\t\n13\t// 分析阶段产出的字段（按典型到达顺序）\n14\tconst ANALYSIS_FIELDS = [\n15\t  { key: 'title', label: '标题' },\n16\t  { key: 'venue', label: '会议' },\n17\t  { key: 'year', label: '年份' },\n18\t  { key: 'one_sentence', label: '核心贡献' },\n19\t  { key: 'problem', label: '研究问题' },\n20\t  { key: 'key_contributions', label: '核心贡献' },\n21\t  { key: 'outline', label: '大纲' },\n22\t  { key: 'method', label: '方法论' },\n23\t  { key: 'experiments', label: '实验' },\n24\t  { key: 'code_mapping', label: '代码映射' },\n25\t  { key: 'interview_qa', label: '面试问答' },\n26\t  { key: 'limitations', label: '局限性' },\n27\t  { key: 'related_papers', label: '相关论文' },\n28\t  { key: 'mermaid_chart', label: '流程图' },\n29\t] as const\n30\t\n31\tconst TOTAL_FIELDS = ANALYSIS_FIELDS.length\n32\t\n33\tconst STEPS = [\n34\t  { key: 'extracting', label: '提取文本', icon: '📄' },\n35\t  { key: 'analyzing', label: '分析中', icon: '🧠' },\n36\t] as const\n37\t\n38\t\n39\tfunction countReceivedFields(partialResult: Partial<AnalysisResult>): number {\n40\t  let count = 0\n41\t  for (const field of ANALYSIS_FIELDS) {\n42\t    const value = partialResult[field.key as keyof AnalysisResult]\n43\t    if (value !== undefined && value !== null) {\n44\t      count++\n45\t    }\n46\t  }\n47\t  return count\n48\t}\n49\t\n50\t\n51\tfunction getStepProgress(status: AnalysisStatus, receivedFields: number): number {\n52\t  if (status === 'done') return 100\n53\t  if (status === 'failed') return 0\n54\t  if (status === 'idle') return 0\n55\t\n56\t  // 提取阶段：0-10%\n57\t  if (status === 'extracting') return 5\n58\t\n59\t  // 生成阶段：5-95%，根据已接收字段数计算\n60\t  if (status === 'generating') {\n61\t    const fieldProgress = receivedFields / TOTAL_FIELDS\n62\t    return Math.round(5 + fieldProgress * 90)\n63\t  }\n64\t\n65\t  // 分析阶段：10-95%，根据已接收字段数计算\n66\t  if (status === 'analyzing') {\n67\t    const fieldProgress = receivedFields / TOTAL_FIELDS\n68\t    return Math.round(10 + fieldProgress * 85)\n69\t  }\n70\t\n71\t  return 0\n72\t}\n73\t\n74\t\n75\texport function LoadingState({ status, message, partialResult, progress: serverProgress = -1 }: LoadingStateProps) {\n76\t  const receivedFields = useMemo(\n77\t    () => countReceivedFields(partialResult),\n78\t    [partialResult]\n79\t  )\n80\t\n81\t  // 优先使用后端计算的进度；无 progress 事件（如旧连接、回放）时回退到前端估算\n82\t  const estimated = useMemo(\n83\t    () => getStepProgress(status, receivedFields),\n84\t    [status, receivedFields]\n85\t  )\n86\t  const progress = status === 'done'\n87\t    ? 100\n88\t    : serverProgress >= 0\n89\t    ? Math.max(serverProgress, estimated)\n90\t    : estimated\n91\t\n92\t  const isActive = status !== 'done' && status !== 'failed' && status !== 'idle'\n93\t\n94\t  return (\n95\t    <div className=\"flex flex-col h-full\">\n96\t      {/* 顶部进度条 */}\n97\t      <div className=\"h-1 shrink-0\" style={{ backgroundColor: 'var(--bg-surface)' }}>\n98\t        <div\n99\t          className=\"h-full transition-all duration-500 ease-out\"\n100\t          style={{\n101\t            width: `${progress}%`,\n102\t            backgroundColor: status === 'failed' ? 'var(--error)' : 'var(--accent)',\n103\t          }}\n104\t        />\n105\t      </div>\n106\t\n107\t      <div className=\"flex-1 flex flex-col items-center justify-center p-6 gap-5 max-w-md mx-auto w-full\">\n108\t        {/* 百分比数字 */}\n109\t        {isActive && (\n110\t          <div className=\"text-3xl font-light tabular-nums\" style={{ color: 'var(--accent)' }}>\n111\t            {progress}%\n112\t          </div>\n113\t        )}\n114\t\n115\t        {/* 步骤指示器 */}\n116\t        <div className=\"w-full space-y-2\">\n117\t          {STEPS.map(step => {\n118\t            const isCurrentStep =\n119\t              (step.key === 'extracting' && (status === 'extracting')) ||\n120\t              (step.key === 'analyzing' && (status === 'analyzing'))\n121\t\n122\t            const isDone =\n123\t              (step.key === 'extracting' && ['analyzing', 'done'].includes(status)) ||\n124\t              (step.key === 'analyzing' && status === 'done')\n125\t\n126\t            return (\n127\t              <div\n128\t                key={step.key}\n129\t                className=\"flex items-center gap-3 px-3 py-2 rounded-lg transition-colors\"\n130\t                style={{\n131\t                  backgroundColor: isCurrentStep ? 'var(--accent-subtle)' : isDone ? 'var(--success-subtle)' : 'transparent',\n132\t                  border: isCurrentStep ? '1px solid var(--accent)' : isDone ? '1px solid var(--success)' : '1px solid transparent',\n133\t                }}\n134\t              >\n135\t                {/* 状态图标 */}\n136\t                <div className=\"w-6 h-6 flex items-center justify-center rounded-full text-xs shrink-0\" style={{\n137\t                  backgroundColor: isDone ? 'var(--success)' : isCurrentStep ? 'var(--accent)' : 'var(--bg-surface)',\n138\t                  color: isDone || isCurrentStep ? 'var(--text-primary)' : 'var(--text-muted)',\n139\t                }}>\n140\t                  {isDone ? '\\u2713' : isCurrentStep ? (\n141\t                    <div className=\"w-3 h-3 border-2 border-white/30 border-t-white rounded-full animate-spin\" role=\"status\"><span className=\"sr-only\">\\u52A0\\u8F7D\\u4E2D</span></div>\n142\t                  ) : '\\u25CB'}\n143\t                </div>\n144\t\n145\t                {/* 步骤信息 */}\n146\t                <div className=\"flex-1 min-w-0\">\n147\t                  <div className=\"flex items-center justify-between\">\n148\t                    <span className=\"text-sm font-medium\" style={{\n149\t                      color: isDone ? 'var(--success)' : isCurrentStep ? 'var(--accent)' : 'var(--text-muted)',\n150\t                    }}>\n151\t                      {step.label}\n152\t                    </span>\n153\t                    {isCurrentStep && step.key === 'analyzing' && (\n154\t                      <span className=\"text-xs tabular-nums\" style={{ color: 'var(--accent)', opacity: 0.7 }}>\n155\t                        {receivedFields}/{TOTAL_FIELDS}\n156\t                      </span>\n157\t                    )}\n158\t                  </div>\n159\t\n160\t                  {/* 分析阶段的子进度条 */}\n161\t                  {isCurrentStep && step.key === 'analyzing' && (\n162\t                    <div className=\"mt-1.5 h-1 rounded-full overflow-hidden\" style={{ backgroundColor: 'var(--bg-surface)' }}>\n163\t                      <div\n164\t                        className=\"h-full transition-all duration-300\"\n165\t                        style={{ width: `${(receivedFields / TOTAL_FIELDS) * 100}%`, backgroundColor: 'var(--accent)', opacity: 0.6 }}\n166\t                      />\n167\t                    </div>\n168\t                  )}\n169\t                </div>\n170\t              </div>\n171\t            )\n172\t          })}\n173\t        </div>\n174\t\n175\t        {/* 当前状态消息 */}\n176\t        {message && (\n177\t          <p className=\"text-xs text-center\" style={{ color: 'var(--text-muted)' }}>{message}</p>\n178\t        )}\n179\t\n180\t        {/* 已接收的字段标签 */}\n181\t        {status === 'analyzing' && receivedFields > 0 && (\n182\t          <div className=\"w-full\">\n183\t            <p className=\"text-xs mb-2\" style={{ color: 'var(--text-muted)' }}>已解析：</p>\n184\t            <div className=\"flex flex-wrap gap-1.5\">\n185\t              {ANALYSIS_FIELDS.map(field => {\n186\t                const value = partialResult[field.key as keyof AnalysisResult]\n187\t                const received = value !== undefined && value !== null\n188\t                return (\n189\t                  <span\n190\t                    key={field.key}\n191\t                    className=\"text-xs px-2 py-0.5 rounded-full transition-colors\"\n192\t                    style={received\n193\t                      ? { backgroundColor: 'var(--success-subtle)', color: 'var(--success)', border: '1px solid var(--success)' }\n194\t                      : { backgroundColor: 'var(--bg-surface)', color: 'var(--text-muted)', border: '1px solid var(--border)' }\n195\t                    }\n196\t                  >\n197\t                    {field.label}\n198\t                  </span>\n199\t                )\n200\t              })}\n201\t            </div>\n202\t          </div>\n203\t        )}\n204\t\n205\t        {/* 已识别的标题 */}\n206\t        {partialResult.title && (\n207\t          <div className=\"w-full rounded-lg p-3\" style={{ backgroundColor: 'var(--bg-surface)', border: '1px solid var(--border)' }}>\n208\t            <p className=\"text-xs mb-1\" style={{ color: 'var(--text-muted)' }}>已识别论文</p>\n209\t            <p className=\"text-sm font-medium leading-snug\" style={{ color: 'var(--text-primary)' }}>\n210\t              {partialResult.title}\n211\t            </p>\n212\t          </div>\n213\t        )}\n214\t\n215\t        {/* 错误状态 */}\n216\t        {status === 'failed' && (\n217\t          <div className=\"text-center\">\n218\t            <p className=\"text-sm mb-2\" style={{ color: 'var(--error)' }}>解析失败</p>\n219\t            <p className=\"text-xs\" style={{ color: 'var(--text-muted)' }}>请在左侧点击「重试」按钮重新分析</p>\n220\t          </div>\n221\t        )}\n222\t      </div>\n223\t    </div>\n224\t  )\n225\t}\n226\t"}]},"parent_tool_use_id":"call_bddd82a75f2e46b98e4517cc","session_id":"29257b8f-ede7-46a4-8e0f-a743591d296a","uuid":"578872b1-8cbd-4eec-90bd-3d20ad883d01","timestamp":"2026-06-09T05:10:52.277Z","subagent_type":"Explore","task_description":"Explore frontend performance"}
