{"type":"assistant","message":{"id":"msg_bfcef08f35b34c798fd44d8c","type":"message","role":"assistant","model":"mimo-v2.5","content":[{"type":"tool_use","id":"call_6856105fd7e94537af19aacf","name":"Read","input":{"file_path":"/Users/katisarrow/essay_read/frontend/src/features/research/GraphCanvas.tsx"}}],"usage":{"input_tokens":0,"output_tokens":0},"context_management":null},"parent_tool_use_id":"call_bddd82a75f2e46b98e4517cc","session_id":"29257b8f-ede7-46a4-8e0f-a743591d296a","uuid":"0ce620f6-4e3a-4ad5-a737-ea7d78b4324d","subagent_type":"Explore","task_description":"Explore frontend performance"}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call_6856105fd7e94537af19aacf","type":"tool_result","content":"1\timport { useRef, useEffect, useMemo, useCallback, useState } from 'react'\n2\timport ForceGraph2D from 'react-force-graph-2d'\n3\timport type { GraphNode, ResearchGraph, GraphEdgeKind, SimilarityDetail, CitationContext } from '@/types'\n4\t\n5\texport interface SelectedEdge {\n6\t  sourceLabel: string\n7\t  targetLabel: string\n8\t  kind: GraphEdgeKind\n9\t  weight: number\n10\t  detail?: SimilarityDetail\n11\t  contexts?: CitationContext[]\n12\t}\n13\t\n14\tinterface GraphCanvasProps {\n15\t  graph: ResearchGraph | null\n16\t  edgeFilter: Set<GraphEdgeKind>\n17\t  onSelectNode: (node: GraphNode | null) => void\n18\t  onSelectEdge?: (edge: SelectedEdge | null) => void\n19\t  linkDistance?: number\n20\t}\n21\t\n22\tconst ZOOM_MIN = 0.1\n23\tconst ZOOM_MAX = 8\n24\tconst ZOOM_STEP = 1.4\n25\tconst DEFAULT_LINK_DISTANCE = 50\n26\t\n27\t// 研究子方向（Louvain 社区）配色，节点填充按 cluster 取色\n28\tconst CLUSTER_COLORS = [\n29\t  '#3b82f6', '#f59e0b', '#10b981', '#8b5cf6', '#ef4444',\n30\t  '#06b6d4', '#ec4899', '#84cc16', '#f97316', '#6366f1',\n31\t]\n32\t\n33\texport function GraphCanvas({ graph, edgeFilter, onSelectNode, onSelectEdge, linkDistance = DEFAULT_LINK_DISTANCE }: GraphCanvasProps) {\n34\t  const fgRef = useRef<any>(null)\n35\t  const containerRef = useRef<HTMLDivElement | null>(null)\n36\t  const [size, setSize] = useState({ w: 0, h: 0 })\n37\t  const [zoomLevel, setZoomLevel] = useState(1)\n38\t  const labelColorRef = useRef<string>('rgba(230,230,230,0.92)')\n39\t  const strokeColorRef = useRef<string>('rgba(255,255,255,0.9)')\n40\t  const expandedStrokeColorRef = useRef<string>('rgba(245,158,11,0.95)')\n41\t\n42\t  // Cache CSS variable values for canvas drawing (avoid reading per-frame)\n43\t  useEffect(() => {\n44\t    const style = getComputedStyle(document.documentElement)\n45\t    const c = style.getPropertyValue('--text-primary').trim()\n46\t    if (c) labelColorRef.current = c\n47\t    const border = style.getPropertyValue('--border-light').trim()\n48\t    if (border) strokeColorRef.current = border\n49\t    const warning = style.getPropertyValue('--warning').trim()\n50\t    if (warning) expandedStrokeColorRef.current = warning\n51\t  }, [])\n52\t\n53\t  // 监听容器尺寸 → 显式传给 ForceGraph2D（否则它默认用 window 尺寸，flex 布局下会渲染失败）\n54\t  // ref callback：元素挂载时立即测一次 + ResizeObserver 跟踪后续变化\n55\t  const setContainer = useCallback((el: HTMLDivElement | null) => {\n56\t    containerRef.current = el\n57\t    if (!el) return\n58\t    const rect = el.getBoundingClientRect()\n59\t    if (rect.width > 0 && rect.height > 0) {\n60\t      setSize({ w: Math.floor(rect.width), h: Math.floor(rect.height) })\n61\t    }\n62\t  }, [])\n63\t\n64\t  useEffect(() => {\n65\t    const el = containerRef.current\n66\t    if (!el) return\n67\t    const ro = new ResizeObserver(entries => {\n68\t      for (const entry of entries) {\n69\t        const cr = entry.contentRect\n70\t        const w = Math.max(0, Math.floor(cr.width))\n71\t        const h = Math.max(0, Math.floor(cr.height))\n72\t        setSize(prev => (prev.w === w && prev.h === h ? prev : { w, h }))\n73\t      }\n74\t    })\n75\t    ro.observe(el)\n76\t    // 兜底：下一帧再测一次，应对父容器异步铺开\n77\t    const raf = requestAnimationFrame(() => {\n78\t      const r = el.getBoundingClientRect()\n79\t      if (r.width > 0 && r.height > 0) {\n80\t        setSize(prev =>\n81\t          prev.w === Math.floor(r.width) && prev.h === Math.floor(r.height)\n82\t            ? prev\n83\t            : { w: Math.floor(r.width), h: Math.floor(r.height) }\n84\t        )\n85\t      }\n86\t    })\n87\t    return () => {\n88\t      ro.disconnect()\n89\t      cancelAnimationFrame(raf)\n90\t    }\n91\t  }, [])\n92\t\n93\t  const graphData = useMemo(() => {\n94\t    if (!graph) return { nodes: [], links: [] }\n95\t    const filteredEdges = graph.edges.filter(e => edgeFilter.has(e.kind as GraphEdgeKind))\n96\t    // 始终显示所有节点（含孤立节点），不因无边而过滤\n97\t    const visibleNodes = graph.nodes\n98\t\n99\t    return {\n100\t      nodes: visibleNodes.map(n => ({\n101\t        id: n.id,\n102\t        name: n.label,\n103\t        kind: n.kind,\n104\t        meta: n.meta,\n105\t        _raw: n,\n106\t      })),\n107\t      links: filteredEdges.map(e => ({\n108\t        source: e.source,\n109\t        target: e.target,\n110\t        kind: e.kind,\n111\t        weight: e.weight,\n112\t        detail: e.detail,\n113\t        contexts: e.contexts,\n114\t      })),\n115\t    }\n116\t  }, [graph, edgeFilter])\n117\t\n118\t  useEffect(() => {\n119\t    if (fgRef.current && graphData.nodes.length > 0 && size.w > 0) {\n120\t      // 等一帧让布局先跑一下再 fit\n121\t      const t = setTimeout(() => {\n122\t        try {\n123\t          fgRef.current?.zoomToFit(400, 60)\n124\t          setZoomLevel(fgRef.current?.zoom?.() ?? 1)\n125\t        } catch { /* noop */ }\n126\t      }, 50)\n127\t      return () => clearTimeout(t)\n128\t    }\n129\t  }, [graphData.nodes.length, size.w])\n130\t\n131\t  // Update link distance independently (no zoom reset)\n132\t  useEffect(() => {\n133\t    if (fgRef.current && graphData.nodes.length > 0) {\n134\t      try {\n135\t        fgRef.current.d3Force('link')?.distance(linkDistance)\n136\t        // Reheat simulation so the layout adjusts to the new distance\n137\t        fgRef.current.d3ReheatSimulation?.()\n138\t      } catch { /* noop */ }\n139\t    }\n140\t  }, [linkDistance, graphData.nodes.length])\n141\t\n142\t  const nodeColor = useCallback((node: any) => {\n143\t    if (node.kind === 'paper') {\n144\t      // 优先按研究子方向（Louvain 社区）着色；无聚类时回退到来源色\n145\t      const c = node.meta?.cluster\n146\t      if (typeof c === 'number' && c >= 0) return CLUSTER_COLORS[c % CLUSTER_COLORS.length]\n147\t      return node.meta?.source === 'expanded' ? '#f59e0b' : '#3b82f6'\n148\t    }\n149\t    if (node.kind === 'method') return '#10b981'\n150\t    if (node.kind === 'dataset') return '#8b5cf6'\n151\t    return '#6b7280'\n152\t  }, [])\n153\t\n154\t  const linkColor = useCallback((link: any) => {\n155\t    if (link.kind === 'cites') return '#ef4444'\n156\t    if (link.kind === 'similar') return '#3b82f6'\n157\t    if (link.kind === 'shared-method') return '#10b981'\n158\t    if (link.kind === 'uses-dataset') return '#8b5cf6'\n159\t    return '#4b5563'\n160\t  }, [])\n161\t\n162\t  const handleNodeClick = useCallback((node: any) => {\n163\t    if (node._raw) {\n164\t      onSelectNode(node._raw)\n165\t    }\n166\t  }, [onSelectNode])\n167\t\n168\t  // 点击连线 → 弹出相似度分解（source/target 经 force-graph 处理后是节点对象）\n169\t  const handleLinkClick = useCallback((link: any) => {\n170\t    if (!onSelectEdge) return\n171\t    const srcLabel = typeof link.source === 'object' ? link.source.name : String(link.source)\n172\t    const tgtLabel = typeof link.target === 'object' ? link.target.name : String(link.target)\n173\t    onSelectEdge({\n174\t      sourceLabel: srcLabel || '',\n175\t      targetLabel: tgtLabel || '',\n176\t      kind: link.kind,\n177\t      weight: link.weight,\n178\t      detail: link.detail,\n179\t      contexts: link.contexts,\n180\t    })\n181\t  }, [onSelectEdge])\n182\t\n183\t  // 节点绘制：半径随 importance（PageRank）放大，边框按来源区分上传/扩展\n184\t  const drawNode = useCallback((node: any, ctx: CanvasRenderingContext2D, globalScale: number) => {\n185\t    const label = node.name || ''\n186\t    const importance = typeof node.meta?.importance === 'number' ? node.meta.importance : 0\n187\t    const r = 4 + importance * 8  // 关键论文（importance≈1）半径 12，普通节点 4\n188\t    ctx.beginPath()\n189\t    ctx.arc(node.x, node.y, r, 0, 2 * Math.PI)\n190\t    ctx.fillStyle = nodeColor(node)\n191\t    ctx.fill()\n192\t    // 边框：上传=白，扩展=琥珀；importance 高则描边更粗，进一步突出关键论文\n193\t    ctx.strokeStyle = node.meta?.source === 'expanded' ? expandedStrokeColorRef.current : strokeColorRef.current\n194\t    ctx.lineWidth = (importance > 0.6 ? 2.5 : 1.5) / globalScale\n195\t    ctx.stroke()\n196\t\n197\t    // 文字（缩放过小时隐藏，避免过密）\n198\t    if (globalScale > 0.6) {\n199\t      const fontSize = 12 / globalScale\n200\t      ctx.font = `${fontSize}px ui-sans-serif, system-ui, -apple-system, sans-serif`\n201\t      ctx.textAlign = 'center'\n202\t      ctx.textBaseline = 'top'\n203\t      ctx.fillStyle = labelColorRef.current\n204\t      const maxLen = 24\n205\t      const text = label.length > maxLen ? label.slice(0, maxLen) + '…' : label\n206\t      ctx.fillText(text, node.x, node.y + r + 2)\n207\t    }\n208\t  }, [nodeColor])\n209\t\n210\t  const zoomBy = useCallback((factor: number) => {\n211\t    if (!fgRef.current) return\n212\t    const cur = fgRef.current.zoom?.() ?? 1\n213\t    const next = Math.min(ZOOM_MAX, Math.max(ZOOM_MIN, cur * factor))\n214\t    fgRef.current.zoom(next, 200)\n215\t    setZoomLevel(next)\n216\t  }, [])\n217\t\n218\t  const resetZoom = useCallback(() => {\n219\t    if (!fgRef.current) return\n220\t    fgRef.current.zoomToFit(400, 60)\n221\t    setTimeout(() => setZoomLevel(fgRef.current?.zoom?.() ?? 1), 450)\n222\t  }, [])\n223\t\n224\t  // 兜底：监听 ForceGraph2D 内部的 zoom 事件同步本地状态（用于按钮上 % 显示）\n225\t  useEffect(() => {\n226\t    const t = setInterval(() => {\n227\t      const z = fgRef.current?.zoom?.()\n228\t      if (typeof z === 'number' && Math.abs(z - zoomLevel) > 0.01) {\n229\t        setZoomLevel(z)\n230\t      }\n231\t    }, 300)\n232\t    return () => clearInterval(t)\n233\t  }, [zoomLevel])\n234\t\n235\t  if (!graph || graph.nodes.length === 0) {\n236\t    return (\n237\t      <div className=\"flex-1 flex items-center justify-center rounded-xl border\" style={{ borderColor: 'var(--border)', backgroundColor: 'var(--bg-base)' }}>\n238\t        <div className=\"text-center\">\n239\t          <p className=\"text-sm\" style={{ color: 'var(--text-muted)' }}>暂无图谱</p>\n240\t          <p className=\"text-xs mt-1\" style={{ color: 'var(--text-muted)', opacity: 0.6 }}>点击\"开始研究\"构建知识图谱</p>\n241\t        </div>\n242\t      </div>\n243\t    )\n244\t  }\n245\t\n246\t  return (\n247\t    <div\n248\t      ref={setContainer}\n249\t      className=\"flex-1 rounded-xl border overflow-hidden relative min-h-[300px]\"\n250\t      style={{ borderColor: 'var(--border)', backgroundColor: 'var(--bg-base)' }}\n251\t    >\n252\t      {size.w > 0 && size.h > 0 && (\n253\t        <ForceGraph2D\n254\t          ref={fgRef}\n255\t          graphData={graphData}\n256\t          width={size.w}\n257\t          height={size.h}\n258\t          nodeColor={nodeColor}\n259\t          nodeRelSize={6}\n260\t          nodeVal={(node: any) => Math.pow((4 + (node.meta?.importance ?? 0) * 8) / 6, 2)}\n261\t          nodeLabel={(node: any) => `<b>${node.name}</b><br/><small>${node.meta?.cluster_label ? '子方向: ' + node.meta.cluster_label : node.kind}</small>`}\n262\t          nodeCanvasObject={drawNode}\n263\t          nodeCanvasObjectMode={() => 'replace'}\n264\t          linkColor={linkColor}\n265\t          linkDirectionalArrowLength={4}\n266\t          linkDirectionalArrowRelPos={0.9}\n267\t          linkWidth={(link: any) => {\n268\t            if (link.kind === 'cites') {\n269\t              const n = link.contexts?.length ?? 0\n270\t              if (n >= 4) return 3.5\n271\t              if (n >= 2) return 2.5\n272\t              if (n >= 1) return 1.8\n273\t              return 1\n274\t            }\n275\t            return Math.max(1, link.weight * 3)\n276\t          }}\n277\t          linkLabel={(link: any) => {\n278\t            if (link.kind === 'cites' && link.contexts?.length) {\n279\t              return `引用 · ${link.contexts.length} 处上下文 · 点击查看`\n280\t            }\n281\t            if (link.detail) {\n282\t              return `综合相似度 ${link.weight.toFixed(2)} · 点击查看分解`\n283\t            }\n284\t            return `${link.kind} (${link.weight.toFixed(2)})`\n285\t          }}\n286\t          onNodeClick={handleNodeClick}\n287\t          onLinkClick={handleLinkClick}\n288\t          onZoomEnd={(t: any) => setZoomLevel(t.k)}\n289\t          cooldownTicks={100}\n290\t          d3AlphaDecay={0.02}\n291\t          d3VelocityDecay={0.3}\n292\t          minZoom={ZOOM_MIN}\n293\t          maxZoom={ZOOM_MAX}\n294\t          enableZoomInteraction={true}\n295\t          enablePanInteraction={true}\n296\t        />\n297\t      )}\n298\t\n299\t      {/* 缩放控制（右上角） */}\n300\t      <div\n301\t        className=\"absolute top-3 right-3 flex items-center gap-1 rounded-lg border px-1.5 py-1 shadow-sm\"\n302\t        style={{ backgroundColor: 'var(--bg-elevated)', borderColor: 'var(--border)' }}\n303\t      >\n304\t        {/* 回到总观 */}\n305\t        <button\n306\t          onClick={resetZoom}\n307\t          title=\"回到总观（适配全部节点）\"\n308\t          className=\"w-7 h-7 flex items-center justify-center rounded transition-colors hover:bg-black/5\"\n309\t          style={{ color: 'var(--text-secondary)' }}\n310\t        >\n311\t          <svg className=\"w-3.5 h-3.5\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\">\n312\t            <path strokeLinecap=\"round\" strokeLinejoin=\"round\" strokeWidth={2}\n313\t              d=\"M15 12a3 3 0 11-6 0 3 3 0 016 0z\" />\n314\t            <path strokeLinecap=\"round\" strokeLinejoin=\"round\" strokeWidth={2}\n315\t              d=\"M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z\" />\n316\t          </svg>\n317\t        </button>\n318\t        <span className=\"w-px h-4 mx-0.5\" style={{ backgroundColor: 'var(--border)' }} />\n319\t        <button\n320\t          onClick={() => zoomBy(1 / ZOOM_STEP)}\n321\t          title=\"缩小\"\n322\t          className=\"w-7 h-7 flex items-center justify-center rounded text-base transition-colors hover:bg-black/5\"\n323\t          style={{ color: 'var(--text-secondary)' }}\n324\t        >\n325\t          −\n326\t        </button>\n327\t        <button\n328\t          onClick={resetZoom}\n329\t          title=\"适配画布\"\n330\t          className=\"px-2 h-7 text-xs rounded transition-colors hover:bg-black/5 min-w-[3.5rem]\"\n331\t          style={{ color: 'var(--text-secondary)' }}\n332\t        >\n333\t          {Math.round(zoomLevel * 100)}%\n334\t        </button>\n335\t        <button\n336\t          onClick={() => zoomBy(ZOOM_STEP)}\n337\t          title=\"放大\"\n338\t          className=\"w-7 h-7 flex items-center justify-center rounded text-base transition-colors hover:bg-black/5\"\n339\t          style={{ color: 'var(--text-secondary)' }}\n340\t        >\n341\t          +\n342\t        </button>\n343\t      </div>\n344\t\n345\t      {/* 图例 */}\n346\t      <div className=\"absolute bottom-3 left-3 flex flex-wrap items-center gap-x-3 gap-y-1 text-[10px]\" style={{ color: 'var(--text-muted)' }}>\n347\t        <span className=\"flex items-center gap-1\">\n348\t          <span className=\"w-1.5 h-1.5 rounded-full bg-gray-400 inline-block\" />\n349\t          <span className=\"w-2.5 h-2.5 rounded-full bg-gray-400 inline-block\" />\n350\t          大小 = 影响力\n351\t        </span>\n352\t        <span className=\"flex items-center gap-1\">\n353\t          <span className=\"w-2 h-2 rounded-full inline-block\" style={{ background: 'conic-gradient(#3b82f6,#10b981,#f59e0b,#8b5cf6)' }} />\n354\t          颜色 = 研究子方向\n355\t        </span>\n356\t        <span className=\"flex items-center gap-1\"><span className=\"w-2 h-2 rounded-full inline-block border-2 border-amber-500\" />扩展论文</span>\n357\t        <span className=\"flex items-center gap-1\"><span className=\"w-3 h-px bg-red-500 inline-block\" />引用</span>\n358\t        <span className=\"flex items-center gap-1\"><span className=\"w-3 h-px bg-blue-500 inline-block\" />相似</span>\n359\t      </div>\n360\t    </div>\n361\t  )\n362\t}\n363\t"}]},"parent_tool_use_id":"call_bddd82a75f2e46b98e4517cc","session_id":"29257b8f-ede7-46a4-8e0f-a743591d296a","uuid":"e64e81cd-c1a8-4587-976f-50a66c9a3eb7","timestamp":"2026-06-09T05:10:29.767Z","subagent_type":"Explore","task_description":"Explore frontend performance"}
