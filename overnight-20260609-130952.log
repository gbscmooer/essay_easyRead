{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call_089fc5255edf450cafb663e1","type":"tool_result","content":"1\timport { useState, useEffect, useCallback, useRef } from 'react'\n2\timport type { Tag } from '@/types'\n3\timport { listTags, getPaperTags, addPaperTag, removePaperTag, createTag } from '@/api/tags'\n4\timport { toast } from '@/hooks/useToast'\n5\t\n6\tinterface TagManagerProps {\n7\t  paperId: number\n8\t}\n9\t\n10\texport function TagManager({ paperId }: TagManagerProps) {\n11\t  const [allTags, setAllTags] = useState<Tag[]>([])\n12\t  const [paperTags, setPaperTags] = useState<Tag[]>([])\n13\t  const [showDropdown, setShowDropdown] = useState(false)\n14\t  const [newTagName, setNewTagName] = useState('')\n15\t  const inputRef = useRef<HTMLInputElement>(null)\n16\t\n17\t  const fetchTags = useCallback(async () => {\n18\t    try {\n19\t      const [all, paper] = await Promise.all([listTags(), getPaperTags(paperId)])\n20\t      setAllTags(all)\n21\t      setPaperTags(paper)\n22\t    } catch (e: any) {\n23\t      toast({ type: 'error', message: e?.message || '加载标签失败' })\n24\t    }\n25\t  }, [paperId])\n26\t\n27\t  useEffect(() => { fetchTags() }, [fetchTags])\n28\t\n29\t\n30\t  // Auto-focus input when dropdown opens\n31\t  useEffect(() => {\n32\t    if (showDropdown && inputRef.current) {\n33\t      inputRef.current.focus()\n34\t    }\n35\t  }, [showDropdown])\n36\t  // 点击外部关闭下拉菜单\n37\t  useEffect(() => {\n38\t    if (!showDropdown) return\n39\t    const handleClickOutside = (e: MouseEvent) => {\n40\t      const target = e.target as HTMLElement\n41\t      if (target.closest('[data-tag-dropdown]')) return\n42\t      setShowDropdown(false)\n43\t    }\n44\t    const handleEscape = (e: KeyboardEvent) => {\n45\t      if (e.key === 'Escape') setShowDropdown(false)\n46\t    }\n47\t    document.addEventListener('mousedown', handleClickOutside)\n48\t    document.addEventListener('keydown', handleEscape)\n49\t    return () => {\n50\t      document.removeEventListener('mousedown', handleClickOutside)\n51\t      document.removeEventListener('keydown', handleEscape)\n52\t    }\n53\t  }, [showDropdown])\n54\t\n55\t  const handleAdd = async (tagId: number) => {\n56\t    try {\n57\t      await addPaperTag(paperId, tagId)\n58\t      fetchTags()\n59\t      setShowDropdown(false)\n60\t    } catch (e: any) {\n61\t      toast({ type: 'error', message: e?.message || '添加标签失败' })\n62\t    }\n63\t  }\n64\t\n65\t  const handleRemove = async (tagId: number) => {\n66\t    try {\n67\t      await removePaperTag(paperId, tagId)\n68\t      fetchTags()\n69\t    } catch (e: any) {\n70\t      toast({ type: 'error', message: e?.message || '移除标签失败' })\n71\t    }\n72\t  }\n73\t\n74\t  const handleCreate = async () => {\n75\t    if (!newTagName.trim()) return\n76\t    try {\n77\t      const tag = await createTag(newTagName.trim())\n78\t      await addPaperTag(paperId, tag.id)\n79\t      setNewTagName('')\n80\t      fetchTags()\n81\t      setShowDropdown(false)\n82\t    } catch (e: any) {\n83\t      toast({ type: 'error', message: e?.message || '创建标签失败' })\n84\t    }\n85\t  }\n86\t\n87\t  const assignedIds = new Set(paperTags.map(t => t.id))\n88\t  const availableTags = allTags.filter(t => !assignedIds.has(t.id))\n89\t\n90\t  return (\n91\t    <div className=\"relative\">\n92\t      <div className=\"flex flex-wrap items-center gap-1.5\">\n93\t        {paperTags.map(tag => (\n94\t          <span\n95\t            key={tag.id}\n96\t            className=\"inline-flex items-center gap-1 text-xs px-2 py-0.5 rounded-full cursor-default group\"\n97\t            style={{ backgroundColor: tag.color + '22', color: tag.color, border: `1px solid ${tag.color}44` }}\n98\t          >\n99\t            {tag.name}\n100\t            <button\n101\t              onClick={() => handleRemove(tag.id)}\n102\t              className=\"opacity-0 group-hover:opacity-100 transition-opacity ml-0.5\"\n103\t              style={{ color: tag.color }}\n104\t            >\n105\t              &times;\n106\t            </button>\n107\t          </span>\n108\t        ))}\n109\t        <button\n110\t          onClick={() => setShowDropdown(v => !v)}\n111\t          aria-expanded={showDropdown}\n112\t          aria-haspopup=\"true\"\n113\t          className=\"text-xs px-2 py-0.5 rounded-full transition-colors\"\n114\t          style={{ color: 'var(--text-muted)', border: '1px dashed var(--border)' }}\n115\t        >\n116\t          + 标签\n117\t        </button>\n118\t      </div>\n119\t\n120\t      {showDropdown && (\n121\t        <div\n122\t          data-tag-dropdown\n123\t          className=\"absolute z-50 mt-2 w-56 rounded-lg border shadow-lg p-2\"\n124\t          style={{ backgroundColor: 'var(--bg-elevated)', borderColor: 'var(--border)' }}\n125\t        >\n126\t          <div className=\"flex gap-1 mb-2\">\n127\t            <input\n128\t              type=\"text\"\n129\t              value={newTagName}\n130\t              onChange={e => setNewTagName(e.target.value)}\n131\t              onKeyDown={e => e.key === 'Enter' && handleCreate()}\n132\t              placeholder=\"新建标签...\"\n133\t              className=\"flex-1 text-xs px-2 py-1 rounded border focus:outline-none\"\n134\t              style={{ borderColor: 'var(--border)', backgroundColor: 'var(--bg-surface)', color: 'var(--text-primary)' }}\n135\t            />\n136\t            <button\n137\t              onClick={handleCreate}\n138\t              className=\"text-xs px-2 py-1 rounded transition-colors\"\n139\t              style={{ backgroundColor: 'var(--accent)', color: 'var(--bg-base)' }}\n140\t            >\n141\t              创建\n142\t            </button>\n143\t          </div>\n144\t          {availableTags.length > 0 && (\n145\t            <div className=\"max-h-32 overflow-auto space-y-0.5\">\n146\t              {availableTags.map(tag => (\n147\t                <button\n148\t                  key={tag.id}\n149\t                  onClick={() => handleAdd(tag.id)}\n150\t                  className=\"w-full text-left text-xs px-2 py-1 rounded transition-colors flex items-center gap-2\"\n151\t                  style={{ color: 'var(--text-secondary)' }}\n152\t                  onMouseEnter={e => (e.currentTarget.style.backgroundColor = 'var(--bg-surface)')}\n153\t                  onMouseLeave={e => (e.currentTarget.style.backgroundColor = 'transparent')}\n154\t                >\n155\t                  <span className=\"w-2.5 h-2.5 rounded-full shrink-0\" style={{ backgroundColor: tag.color }} />\n156\t                  {tag.name}\n157\t                </button>\n158\t              ))}\n159\t            </div>\n160\t          )}\n161\t          {availableTags.length === 0 && !newTagName && (\n162\t            <p className=\"text-xs text-center py-2\" style={{ color: 'var(--text-muted)' }}>输入名称创建新标签</p>\n163\t          )}\n164\t        </div>\n165\t      )}\n166\t    </div>\n167\t  )\n168\t}\n169\t"}]},"parent_tool_use_id":"call_bddd82a75f2e46b98e4517cc","session_id":"29257b8f-ede7-46a4-8e0f-a743591d296a","uuid":"ab2b7cc8-6817-4153-89f8-f1f0267f27dc","timestamp":"2026-06-09T05:10:28.742Z","subagent_type":"Explore","task_description":"Explore frontend performance"}
