{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call_c1ddd47250694b18bf4baec5","type":"tool_result","content":"1\t\"\"\"\n2\t多语言 import 解析器\n3\t\n4\t使用 Python AST 模块精确解析 Python import，\n5\tJS/TS/C++ 使用增强正则解析。\n6\t\"\"\"\n7\t\n8\timport ast\n9\timport os\n10\timport re\n11\tfrom dataclasses import dataclass, field\n12\t\n13\t\n14\t@dataclass\n15\tclass ParsedImport:\n16\t    \"\"\"一条 import 语句的解析结果\"\"\"\n17\t    module: str           # 原始模块路径 (\"models.backbone\", \"./utils\")\n18\t    names: list[str]      # 导入的具体名称 ([\"Conv\", \"BN\"])\n19\t    is_relative: bool     # 是否相对导入\n20\t    line_number: int      # import 所在行号 (1-based)\n21\t    is_type_only: bool = False  # 是否在 TYPE_CHECKING 块中\n22\t\n23\t\n24\t@dataclass\n25\tclass FileImports:\n26\t    \"\"\"一个文件的所有 import\"\"\"\n27\t    file_path: str        # 相对路径\n28\t    imports: list[ParsedImport] = field(default_factory=list)\n29\t\n30\t\n31\t# ============================================================\n32\t# Python — AST 解析\n33\t# ============================================================\n34\t\n35\tdef _parse_python(content: str) -> list[ParsedImport]:\n36\t    \"\"\"使用 AST 精确解析 Python import\"\"\"\n37\t    try:\n38\t        tree = ast.parse(content)\n39\t    except SyntaxError:\n40\t        return _parse_python_regex(content)\n41\t\n42\t    results = []\n43\t    for node in ast.walk(tree):\n44\t        if isinstance(node, ast.Import):\n45\t            for alias in node.names:\n46\t                name = alias.name\n47\t                asname = alias.asname\n48\t                results.append(ParsedImport(\n49\t                    module=name,\n50\t                    names=[asname or name.split(\".\")[-1]],\n51\t                    is_relative=False,\n52\t                    line_number=node.lineno,\n53\t                ))\n54\t\n55\t        elif isinstance(node, ast.ImportFrom):\n56\t            module = node.module or \"\"\n57\t            level = node.level  # 0 = 绝对, 1 = from ., 2 = from ..\n58\t            is_relative = level > 0\n59\t\n60\t            names = []\n61\t            for alias in node.names:\n62\t                if alias.name == \"*\":\n63\t                    names.append(\"*\")\n64\t                else:\n65\t                    names.append(alias.asname or alias.name)\n66\t\n67\t            results.append(ParsedImport(\n68\t                module=module,\n69\t                names=names,\n70\t                is_relative=is_relative,\n71\t                line_number=node.lineno,\n72\t            ))\n73\t\n74\t    return results\n75\t\n76\t\n77\tdef _parse_python_regex(content: str) -> list[ParsedImport]:\n78\t    \"\"\"Python 回退方案：增强正则（AST 解析失败时使用）\"\"\"\n79\t    results = []\n80\t\n81\t    # from X import (Y, Z, ...) 多行支持\n82\t    for m in re.finditer(\n83\t        r\"^from\\s+(\\.*)(\\S+)\\s+import\\s+\\(([^)]*)\\)\",\n84\t        content, re.MULTILINE | re.DOTALL\n85\t    ):\n86\t        dots, module, names_str = m.group(1), m.group(2), m.group(3)\n87\t        names = [n.strip().split(\" as \")[0].strip()\n88\t                 for n in names_str.split(\",\") if n.strip()]\n89\t        line = content[:m.start()].count(\"\\n\") + 1\n90\t        results.append(ParsedImport(\n91\t            module=module, names=names,\n92\t            is_relative=len(dots) > 0, line_number=line,\n93\t        ))\n94\t\n95\t    # from X import Y, Z (单行)\n96\t    for m in re.finditer(\n97\t        r\"^from\\s+(\\.*)(\\S+)\\s+import\\s+(.+)$\",\n98\t        content, re.MULTILINE\n99\t    ):\n100\t        dots, module, names_str = m.group(1), m.group(2), m.group(3)\n101\t        if \"(\" in names_str:\n102\t            continue  # 已被上面的多行模式处理\n103\t        names = [n.strip().split(\" as \")[0].strip()\n104\t                 for n in names_str.split(\",\") if n.strip()]\n105\t        line = content[:m.start()].count(\"\\n\") + 1\n106\t        results.append(ParsedImport(\n107\t            module=module, names=names,\n108\t            is_relative=len(dots) > 0, line_number=line,\n109\t        ))\n110\t\n111\t    # import X, Y\n112\t    for m in re.finditer(r\"^import\\s+(\\S+(?:\\s*,\\s*\\S+)*)\", content, re.MULTILINE):\n113\t        modules = [s.strip() for s in m.group(1).split(\",\")]\n114\t        line = content[:m.start()].count(\"\\n\") + 1\n115\t        for mod in modules:\n116\t            as_match = re.match(r\"(\\S+)\\s+as\\s+(\\S+)\", mod)\n117\t            if as_match:\n118\t                results.append(ParsedImport(\n119\t                    module=as_match.group(1),\n120\t                    names=[as_match.group(2)],\n121\t                    is_relative=False, line_number=line,\n122\t                ))\n123\t            else:\n124\t                results.append(ParsedImport(\n125\t                    module=mod,\n126\t                    names=[mod.split(\".\")[-1]],\n127\t                    is_relative=False, line_number=line,\n128\t                ))\n129\t\n130\t    return results\n131\t\n132\t\n133\t# ============================================================\n134\t# JS/TS — 增强正则\n135\t# ============================================================\n136\t\n137\t_JS_IMPORT_RE = re.compile(\n138\t    r\"\"\"(?:import\\s+(?:(?:type)\\s+)?(?:([^{}\\n]+?)\\s*,?\\s*)?\\{([^}]*)\\}\\s*from\\s*['\"]([^'\"]+)['\"]\"\"\"\n139\t    r\"\"\"|import\\s+(?:type\\s+)?(?:(\\w+)\\s+from\\s*)?['\"]([^'\"]+)['\"]\"\"\"\n140\t    r\"\"\"|export\\s+\\{[^}]*\\}\\s*from\\s*['\"]([^'\"]+)['\"]\"\"\"\n141\t    r\"\"\"|require\\s*\\(\\s*['\"]([^'\"]+)['\"]\\s*\\))\"\"\",\n142\t    re.MULTILINE,\n143\t)\n144\t\n145\t_JS_DYNAMIC_IMPORT_RE = re.compile(\n146\t    r\"\"\"import\\s*\\(\\s*['\"]([^'\"]+)['\"]\\s*\\)\"\"\",\n147\t)\n148\t\n149\t\n150\tdef _parse_js_ts(content: str) -> list[ParsedImport]:\n151\t    \"\"\"解析 JS/TS import/require/export-from\"\"\"\n152\t    results = []\n153\t\n154\t    for m in _JS_IMPORT_RE.finditer(content):\n155\t        named_imports = m.group(2)  # { foo, bar }\n156\t        module_from_named = m.group(3)\n157\t        default_import = m.group(4)\n158\t        module_from_default = m.group(5)\n159\t        module_from_export = m.group(6)\n160\t        module_from_require = m.group(7)\n161\t\n162\t        module = module_from_named or module_from_default or module_from_export or module_from_require\n163\t        if not module:\n164\t            continue\n165\t\n166\t        names = []\n167\t        if named_imports:\n168\t            for part in named_imports.split(\",\"):\n169\t                name = part.strip().split(\" as \")[0].strip().split(\":\")[0].strip()\n170\t                if name:\n171\t                    names.append(name)\n172\t        if default_import:\n173\t            names.append(default_import)\n174\t\n175\t        line = content[:m.start()].count(\"\\n\") + 1\n176\t        results.append(ParsedImport(\n177\t            module=module,\n178\t            names=names,\n179\t            is_relative=module.startswith(\".\"),\n180\t            line_number=line,\n181\t        ))\n182\t\n183\t    # Dynamic import() — 弱引用\n184\t    for m in _JS_DYNAMIC_IMPORT_RE.finditer(content):\n185\t        module = m.group(1)\n186\t        line = content[:m.start()].count(\"\\n\") + 1\n187\t        results.append(ParsedImport(\n188\t            module=module,\n189\t            names=[],\n190\t            is_relative=module.startswith(\".\"),\n191\t            line_number=line,\n192\t        ))\n193\t\n194\t    return results\n195\t\n196\t\n197\t# ============================================================\n198\t# C/C++ — 增强正则\n199\t# ============================================================\n200\t\n201\t_C_INCLUDE_RE = re.compile(r'#\\s*include\\s+[\"<]([^\">]+)[\">]')\n202\t\n203\t\n204\tdef _parse_cpp(content: str) -> list[ParsedImport]:\n205\t    \"\"\"解析 C/C++ #include\"\"\"\n206\t    results = []\n207\t    for m in _C_INCLUDE_RE.finditer(content):\n208\t        path = m.group(1)\n209\t        line = content[:m.start()].count(\"\\n\") + 1\n210\t        # 双引号形式一定是本地文件；尖括号形式只在项目内存在时才保留\n211\t        is_quoted = '\"' in m.group(0).split(\"#include\")[1].strip()[:1]\n212\t        results.append(ParsedImport(\n213\t            module=path,\n214\t            names=[],\n215\t            is_relative=is_quoted,\n216\t            line_number=line,\n217\t        ))\n218\t    return results\n219\t\n220\t\n221\t# ============================================================\n222\t# Go / Rust — 基础支持\n223\t# ============================================================\n224\t\n225\t_GO_IMPORT_RE = re.compile(r'import\\s+(?:\\(\\s*(.*?)\\s*\\)|\"([^\"]+)\")', re.DOTALL)\n226\t\n227\t\n228\tdef _parse_go(content: str) -> list[ParsedImport]:\n229\t    \"\"\"解析 Go import\"\"\"\n230\t    results = []\n231\t    for m in _GO_IMPORT_RE.finditer(content):\n232\t        if m.group(1):  # 多行 import block\n233\t            for line_content in m.group(1).strip().split(\"\\n\"):\n234\t                line_content = line_content.strip().strip('\"').strip()\n235\t                if line_content and not line_content.startswith(\"//\"):\n236\t                    # 去掉别名\n237\t                    parts = line_content.rsplit(\"/\", 1)\n238\t                    module = parts[-1].strip().strip('\"') if parts else line_content\n239\t                    results.append(ParsedImport(\n240\t                        module=line_content, names=[module],\n241\t                        is_relative=False, line_number=0,\n242\t                    ))\n243\t        elif m.group(2):  # 单行 import\n244\t            module = m.group(2)\n245\t            results.append(ParsedImport(\n246\t                module=module, names=[module.rsplit(\"/\", 1)[-1]],\n247\t                is_relative=False, line_number=0,\n248\t            ))\n249\t    return results\n250\t\n251\t\n252\t_RUST_USE_RE = re.compile(r\"(?:pub\\s+)?use\\s+([\\w:]+(?:\\s*::\\s*\\{[^}]*\\})?)\")\n253\t\n254\t\n255\tdef _parse_rust(content: str) -> list[ParsedImport]:\n256\t    \"\"\"解析 Rust use 语句\"\"\"\n257\t    results = []\n258\t    for m in _RUST_USE_RE.finditer(content):\n259\t        path = m.group(1)\n260\t        parts = path.split(\"::\")\n261\t        if parts and parts[0] in (\"self\", \"super\", \"crate\"):\n262\t            module = \"::\".join(parts[1:])\n263\t            is_relative = True\n264\t        else:\n265\t            module = path\n266\t            is_relative = False\n267\t        line = content[:m.start()].count(\"\\n\") + 1\n268\t        results.append(ParsedImport(\n269\t            module=module, names=[],\n270\t            is_relative=is_relative, line_number=line,\n271\t        ))\n272\t    return results\n273\t\n274\t\n275\t# ============================================================\n276\t# 统一入口\n277\t# ============================================================\n278\t\n279\t_LANG_PARSERS = {\n280\t    \".py\": (\"python\", _parse_python),\n281\t    \".pyw\": (\"python\", _parse_python),\n282\t    \".js\": (\"js\", _parse_js_ts),\n283\t    \".jsx\": (\"js\", _parse_js_ts),\n284\t    \".mjs\": (\"js\", _parse_js_ts),\n285\t    \".ts\": (\"ts\", _parse_js_ts),\n286\t    \".tsx\": (\"ts\", _parse_js_ts),\n287\t    \".mts\": (\"ts\", _parse_js_ts),\n288\t    \".c\": (\"c\", _parse_cpp),\n289\t    \".cc\": (\"c\", _parse_cpp),\n290\t    \".cpp\": (\"c\", _parse_cpp),\n291\t    \".cxx\": (\"c\", _parse_cpp),\n292\t    \".h\": (\"c\", _parse_cpp),\n293\t    \".hpp\": (\"c\", _parse_cpp),\n294\t    \".hxx\": (\"c\", _parse_cpp),\n295\t    \".go\": (\"go\", _parse_go),\n296\t    \".rs\": (\"rust\", _parse_rust),\n297\t}\n298\t\n299\tSUPPORTED_EXTENSIONS = set(_LANG_PARSERS.keys())\n300\t\n301\t\n302\tdef parse_imports(file_path: str, content: str) -> FileImports:\n303\t    \"\"\"\n304\t    解析一个文件的所有 import。\n305\t\n306\t    Args:\n307\t        file_path: 相对路径\n308\t        content: 文件内容\n309\t\n310\t    Returns:\n311\t        FileImports 包含解析结果\n312\t    \"\"\"\n313\t    ext = os.path.splitext(file_path)[1].lower()\n314\t    parser_info = _LANG_PARSERS.get(ext)\n315\t\n316\t    if not parser_info:\n317\t        return FileImports(file_path=file_path, imports=[])\n318\t\n319\t    lang, parser = parser_info\n320\t    try:\n321\t        imports = parser(content)\n322\t    except Exception:\n323\t        imports = []\n324\t\n325\t    return FileImports(file_path=file_path, imports=imports)\n326\t"}]},"parent_tool_use_id":"call_14fbefec6f4c427bbf12da10","session_id":"29257b8f-ede7-46a4-8e0f-a743591d296a","uuid":"23be120d-f71b-4d42-a22c-77aaec6449cd","timestamp":"2026-06-09T05:10:30.502Z","subagent_type":"Explore","task_description":"Explore backend performance"}
