{"type":"assistant","message":{"id":"msg_cd7dc46b7e634118873bba74","type":"message","role":"assistant","model":"mimo-v2.5","content":[{"type":"tool_use","id":"call_a4c727f5406f417fb6f7b437","name":"Read","input":{"file_path":"/Users/katisarrow/essay_read/frontend/src/pages/HomePage.tsx"}}],"usage":{"input_tokens":0,"output_tokens":0},"context_management":null},"parent_tool_use_id":"call_bddd82a75f2e46b98e4517cc","session_id":"29257b8f-ede7-46a4-8e0f-a743591d296a","uuid":"2a8f0606-63a9-438f-8faa-31274a11ad1a","subagent_type":"Explore","task_description":"Explore frontend performance"}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call_a4c727f5406f417fb6f7b437","type":"tool_result","content":"1\t/**\n2\t * HomePage 组件\n3\t *\n4\t * 应用首页，包含上传入口和最近论文概览。\n5\t * 清新学术风格：简洁的 Hero 区域 + 论文卡片网格。\n6\t */\n7\t\n8\timport { useEffect, useState } from 'react'\n9\timport { useNavigate } from 'react-router-dom'\n10\timport type { Paper } from '@/types'\n11\timport { UploadZone } from '@/features/upload/UploadZone'\n12\timport { listPapers, uploadPaperWithProgress } from '@/api/papers'\n13\timport { listWorkspaces, type WorkspaceItem } from '@/api/workspaces'\n14\timport { toast } from '@/hooks/useToast'\n15\t\n16\t\n17\texport default function HomePage() {\n18\t  const navigate = useNavigate()\n19\t  const [recentPapers, setRecentPapers] = useState<Paper[]>([])\n20\t  const [recentWorkspaces, setRecentWorkspaces] = useState<WorkspaceItem[]>([])\n21\t  const [isUploading, setIsUploading] = useState(false)\n22\t  const [uploadProgress, setUploadProgress] = useState(0)\n23\t  const [uploadError, setUploadError] = useState<string | null>(null)\n24\t  const [loading, setLoading] = useState(true)\n25\t\n26\t  useEffect(() => {\n27\t    Promise.all([\n28\t      listPapers({ page: 1, per_page: 6, source: 'uploaded' })\n29\t        .then(res => setRecentPapers(res.papers))\n30\t        .catch(() => { toast({ type: 'error', message: '加载最近论文失败' }) }),\n31\t      listWorkspaces()\n32\t        .then(ws => {\n33\t          const sorted = ws.sort((a, b) =>\n34\t            new Date(b.updated_at).getTime() - new Date(a.updated_at).getTime()\n35\t          )\n36\t          setRecentWorkspaces(sorted.slice(0, 6))\n37\t        })\n38\t        .catch(() => { toast({ type: 'error', message: '加载工作区失败' }) }),\n39\t    ]).finally(() => setLoading(false))\n40\t  }, [])\n41\t\n42\t  const handleUpload = async (file: File) => {\n43\t    setIsUploading(true)\n44\t    setUploadProgress(0)\n45\t    setUploadError(null)\n46\t    try {\n47\t      const paper = await uploadPaperWithProgress(file, setUploadProgress)\n48\t      toast({ type: 'success', message: '上传成功，正在自动分析...' })\n49\t      navigate(`/reader/${paper.id}`, { state: { autoAnalyze: true } })\n50\t    } catch {\n51\t      setUploadError('上传失败，请检查文件格式后重试')\n52\t      toast({ type: 'error', message: '上传失败，请检查文件格式后重试' })\n53\t    } finally {\n54\t      setIsUploading(false)\n55\t    }\n56\t  }\n57\t\n58\t  return (\n59\t    <div className=\"max-w-4xl mx-auto px-6 py-8\">\n60\t      {/* Hero 区域 */}\n61\t      <div className=\"text-center mb-14\">\n62\t        <h1 className=\"text-3xl font-bold mb-3\" style={{ color: 'var(--text-primary)', letterSpacing: '-0.02em' }}>\n63\t          Easy Essay\n64\t        </h1>\n65\t        <p className=\"text-base mb-10\" style={{ color: 'var(--text-muted)', maxWidth: '28rem', margin: '0 auto' }}>\n66\t          上传 PDF，自动提取方法论、实验结果和代码映射\n67\t        </p>\n68\t\n69\t        <UploadZone onUpload={handleUpload} isUploading={isUploading} uploadProgress={uploadProgress} />\n70\t        {uploadError && (\n71\t          <p className=\"mt-4 text-sm\" style={{ color: 'var(--error)' }}>{uploadError}</p>\n72\t        )}\n73\t      </div>\n74\t\n75\t      {/* 加载状态 */}\n76\t      {loading && (\n77\t        <div className=\"flex items-center justify-center py-16\">\n78\t          <div className=\"w-6 h-6 border-2 rounded-full animate-spin\" style={{ borderColor: 'var(--border)', borderTopColor: 'var(--accent)' }} />\n79\t        </div>\n80\t      )}\n81\t\n82\t      {/* 最近论文 */}\n83\t      {!loading && recentPapers.length > 0 && (\n84\t        <section>\n85\t          <div className=\"flex items-center justify-between mb-5\">\n86\t            <h2 className=\"text-lg font-semibold\" style={{ color: 'var(--text-primary)' }}>最近解析</h2>\n87\t            <button\n88\t              onClick={() => navigate('/library')}\n89\t              className=\"text-xs transition-colors\"\n90\t              style={{ color: 'var(--text-muted)' }}\n91\t            >\n92\t              查看全部 &rarr;\n93\t            </button>\n94\t          </div>\n95\t          <div className=\"grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4\">\n96\t            {recentPapers.map(paper => (\n97\t              <div\n98\t                key={paper.id}\n99\t                role=\"button\"\n100\t                tabIndex={0}\n101\t                onClick={() => navigate(`/reader/${paper.id}`)}\n102\t                onKeyDown={e => { if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); navigate(`/reader/${paper.id}`) } }}\n103\t                className=\"rounded-xl p-4 cursor-pointer card-hover transition-all\"\n104\t                style={{\n105\t                  backgroundColor: 'var(--bg-surface)',\n106\t                  boxShadow: 'var(--shadow-card)',\n107\t                  border: '1px solid var(--border)',\n108\t                }}\n109\t              >\n110\t                <h3 className=\"text-sm font-medium mb-2 line-clamp-2 leading-snug\" style={{ color: 'var(--text-primary)' }}>\n111\t                  {paper.title || paper.filename}\n112\t                </h3>\n113\t                <div className=\"flex items-center gap-2 text-xs\" style={{ color: 'var(--text-muted)' }}>\n114\t                  {paper.venue && <span>{paper.venue}</span>}\n115\t                  {paper.venue && paper.year && <span>&middot;</span>}\n116\t                  {paper.year && <span>{paper.year}</span>}\n117\t                </div>\n118\t                <div className=\"mt-3 flex items-center gap-1.5\">\n119\t                  <span\n120\t                    className=\"w-2 h-2 rounded-full\"\n121\t                    style={{\n122\t                      backgroundColor:\n123\t                        paper.status === 'done' ? '#22c55e'\n124\t                        : paper.status === 'failed' ? '#ef4444'\n125\t                        : paper.status === 'pending' ? '#6b7280'\n126\t                        : '#eab308'\n127\t                    }}\n128\t                  />\n129\t                  <span className=\"text-xs\" style={{ color: 'var(--text-muted)' }}>\n130\t                    {paper.status === 'done' ? '已完成' : paper.status === 'failed' ? '失败' : paper.status === 'pending' ? '尚未解析' : '处理中'}\n131\t                  </span>\n132\t                </div>\n133\t              </div>\n134\t            ))}\n135\t          </div>\n136\t        </section>\n137\t      )}\n138\t\n139\t      {/* 最近使用工作区 */}\n140\t      {recentWorkspaces.length > 0 && (\n141\t        <section className={recentPapers.length > 0 ? 'mt-10' : ''}>\n142\t          <div className=\"flex items-center justify-between mb-5\">\n143\t            <h2 className=\"text-lg font-semibold\" style={{ color: 'var(--text-primary)' }}>最近使用工作区</h2>\n144\t            <button\n145\t              onClick={() => navigate('/workspace')}\n146\t              className=\"text-xs transition-colors\"\n147\t              style={{ color: 'var(--text-muted)' }}\n148\t            >\n149\t              查看全部 &rarr;\n150\t            </button>\n151\t          </div>\n152\t          <div className=\"grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4\">\n153\t            {recentWorkspaces.map(ws => (\n154\t              <div\n155\t                key={ws.id}\n156\t                role=\"button\"\n157\t                tabIndex={0}\n158\t                onClick={() => navigate(`/workspace/${ws.id}`)}\n159\t                onKeyDown={e => { if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); navigate(`/workspace/${ws.id}`) } }}\n160\t                className=\"rounded-xl p-4 cursor-pointer card-hover transition-all\"\n161\t                style={{\n162\t                  backgroundColor: 'var(--bg-surface)',\n163\t                  boxShadow: 'var(--shadow-card)',\n164\t                  border: '1px solid var(--border)',\n165\t                }}\n166\t              >\n167\t                <h3 className=\"text-sm font-medium mb-2 truncate\" style={{ color: 'var(--text-primary)' }}>\n168\t                  {ws.name}\n169\t                </h3>\n170\t                <div className=\"flex items-center gap-2 text-xs\" style={{ color: 'var(--text-muted)' }}>\n171\t                  <span>{ws.paper_count} 篇论文</span>\n172\t                  <span>&middot;</span>\n173\t                  <span>{new Date(ws.updated_at).toLocaleDateString('zh-CN')}</span>\n174\t                </div>\n175\t              </div>\n176\t            ))}\n177\t          </div>\n178\t        </section>\n179\t      )}\n180\t    </div>\n181\t  )\n182\t}\n183\t"}]},"parent_tool_use_id":"call_bddd82a75f2e46b98e4517cc","session_id":"29257b8f-ede7-46a4-8e0f-a743591d296a","uuid":"643c77b5-52e6-4007-b033-267dcfba1290","timestamp":"2026-06-09T05:10:19.015Z","subagent_type":"Explore","task_description":"Explore frontend performance"}
