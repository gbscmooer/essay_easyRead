{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call_49bd165d570b4a34902ed990","type":"tool_result","content":"1\t\"\"\"\n2\tPDF 解析服务\n3\t\n4\t使用 PyMuPDF (fitz) 提取 PDF 文本，pypdf 作为后备方案。\n5\t借鉴 DeepTutor 的双路径提取和错误层次化模式。\n6\t\n7\t提取策略：\n8\t  - 主路径：PyMuPDF（速度快，处理复杂布局更好）\n9\t  - 后备路径：pypdf（当 PyMuPDF 失败时自动切换）\n10\t  - 智能截断：保留前3页+正文前部+最后1页\n11\t\"\"\"\n12\t\n13\timport os\n14\timport logging\n15\tfrom dataclasses import dataclass\n16\t\n17\tlogger = logging.getLogger(__name__)\n18\t\n19\t# Token 限制策略\n20\tMAX_CHARS = 100_000  # 约 25k-30k tokens\n21\t\n22\t\n23\tclass PDFExtractionError(Exception):\n24\t    \"\"\"PDF 提取错误基类\"\"\"\n25\t    pass\n26\t\n27\t\n28\tclass PDFNotFoundError(PDFExtractionError):\n29\t    \"\"\"文件不存在\"\"\"\n30\t    pass\n31\t\n32\t\n33\tclass PDFInvalidError(PDFExtractionError):\n34\t    \"\"\"文件不是有效的 PDF\"\"\"\n35\t    pass\n36\t\n37\t\n38\tclass PDFEmptyError(PDFExtractionError):\n39\t    \"\"\"PDF 无法提取任何文本\"\"\"\n40\t    pass\n41\t\n42\t\n43\t@dataclass\n44\tclass PDFContent:\n45\t    \"\"\"\n46\t    PDF 提取结果\n47\t\n48\t    Attributes:\n49\t        full_text: 全文文本，按页拼接，页间用分隔符标记\n50\t        page_texts: 每页的文本列表，索引对应页码（0-based）\n51\t        total_pages: 总页数\n52\t        metadata: PDF 元信息（作者、标题等，可能为空）\n53\t        truncated: 是否因超长而被截断\n54\t    \"\"\"\n55\t\n56\t    full_text: str\n57\t    page_texts: list[str]\n58\t    total_pages: int\n59\t    metadata: dict\n60\t    truncated: bool = False\n61\t\n62\t\n63\tdef _truncate_text(page_texts: list[str], max_chars: int) -> tuple[str, bool]:\n64\t    \"\"\"\n65\t    智能截断策略。\n66\t\n67\t    对于超长论文，保留：\n68\t    - 前 3 页（通常包含摘要、引言、方法概述）\n69\t    - 之后的页面按顺序填充直到达到限制\n70\t    - 最后 1 页（通常包含结论）\n71\t\n72\t    Returns:\n73\t        (截断后的全文, 是否被截断)\n74\t    \"\"\"\n75\t    # 先尝试不截断\n76\t    full = \"\\n\".join(\n77\t        f\"\\n--- Page {i+1} ---\\n{text}\" for i, text in enumerate(page_texts)\n78\t    )\n79\t    if len(full) <= max_chars:\n80\t        return full, False\n81\t\n82\t    # 需要截断：保留前 3 页 + 最后 1 页，中间按顺序填充\n83\t    keep_parts = []\n84\t    current_len = 0\n85\t    reserved_end = len(page_texts[-1]) + 50  # 最后一页 + 分隔符\n86\t\n87\t    for i, text in enumerate(page_texts):\n88\t        part = f\"\\n--- Page {i+1} ---\\n{text}\"\n89\t        if i < 3 or current_len + len(part) + reserved_end <= max_chars:\n90\t            keep_parts.append(part)\n91\t            current_len += len(part)\n92\t        elif i == len(page_texts) - 1:\n93\t            # 最后一页\n94\t            keep_parts.append(\"\\n--- [中间页面已省略] ---\\n\")\n95\t            keep_parts.append(part)\n96\t            break\n97\t        else:\n98\t            # 超出限制，跳过中间页面\n99\t            continue\n100\t\n101\t    return \"\".join(keep_parts), True\n102\t\n103\t\n104\tdef _extract_with_pymupdf(pdf_path: str) -> tuple[list[str], dict] | None:\n105\t    \"\"\"\n106\t    使用 PyMuPDF 提取 PDF 文本（主路径）。\n107\t\n108\t    Returns:\n109\t        (page_texts, metadata) 或 None（如果失败）\n110\t    \"\"\"\n111\t    try:\n112\t        import fitz\n113\t\n114\t        doc = fitz.open(pdf_path)\n115\t        try:\n116\t            page_texts = []\n117\t            for page in doc:\n118\t                text = page.get_text(\"text\")\n119\t                page_texts.append(text)\n120\t\n121\t            metadata = {}\n122\t            if doc.metadata:\n123\t                for key, value in doc.metadata.items():\n124\t                    if value:\n125\t                        metadata[key] = value\n126\t\n127\t            return page_texts, metadata\n128\t        finally:\n129\t            doc.close()\n130\t\n131\t    except Exception as e:\n132\t        logger.warning(f\"PyMuPDF extraction failed: {e}\")\n133\t        return None\n134\t\n135\t\n136\tdef _extract_with_pypdf(pdf_path: str) -> tuple[list[str], dict] | None:\n137\t    \"\"\"\n138\t    使用 pypdf 提取 PDF 文本（后备路径）。\n139\t\n140\t    借鉴 DeepTutor 的双路径策略：当 PyMuPDF 失败时自动切换到 pypdf。\n141\t\n142\t    Returns:\n143\t        (page_texts, metadata) 或 None（如果失败）\n144\t    \"\"\"\n145\t    try:\n146\t        from pypdf import PdfReader\n147\t\n148\t        reader = PdfReader(pdf_path)\n149\t        page_texts = []\n150\t        for page in reader.pages:\n151\t            text = page.extract_text() or \"\"\n152\t            page_texts.append(text)\n153\t\n154\t        metadata = {}\n155\t        if reader.metadata:\n156\t            for key, value in reader.metadata.items():\n157\t                if value:\n158\t                    # pypdf 的 metadata key 可能带 / 前缀\n159\t                    clean_key = key.lstrip(\"/\")\n160\t                    metadata[clean_key] = str(value)\n161\t\n162\t        return page_texts, metadata\n163\t\n164\t    except Exception as e:\n165\t        logger.warning(f\"pypdf extraction failed: {e}\")\n166\t        return None\n167\t\n168\t\n169\tdef extract_pdf_content(pdf_path: str) -> PDFContent:\n170\t    \"\"\"\n171\t    从 PDF 文件中提取全部文本内容。\n172\t\n173\t    双路径策略（借鉴 DeepTutor）：\n174\t    1. 优先使用 PyMuPDF（速度快，处理复杂布局更好）\n175\t    2. 如果 PyMuPDF 失败，自动切换到 pypdf\n176\t    3. 两者都失败则抛出异常\n177\t\n178\t    Args:\n179\t        pdf_path: PDF 文件的本地路径\n180\t\n181\t    Returns:\n182\t        PDFContent 包含全文、逐页文本、页数和元信息\n183\t\n184\t    Raises:\n185\t        PDFNotFoundError: 文件不存在\n186\t        PDFInvalidError: 文件不是有效的 PDF\n187\t        PDFEmptyError: PDF 无法提取任何文本\n188\t    \"\"\"\n189\t    if not os.path.exists(pdf_path):\n190\t        raise PDFNotFoundError(f\"PDF file not found: {pdf_path}\")\n191\t\n192\t    # 检查文件魔数（借鉴 DeepTutor 的 magic byte validation）\n193\t    try:\n194\t        with open(pdf_path, \"rb\") as f:\n195\t            header = f.read(5)\n196\t            if header != b\"%PDF-\":\n197\t                raise PDFInvalidError(\"File is not a valid PDF (missing %PDF- header)\")\n198\t    except (IOError, OSError) as e:\n199\t        raise PDFInvalidError(f\"Cannot read file: {e}\")\n200\t\n201\t    # 主路径：PyMuPDF\n202\t    result = _extract_with_pymupdf(pdf_path)\n203\t\n204\t    # 后备路径：pypdf\n205\t    if result is None:\n206\t        logger.info(\"Falling back to pypdf for PDF extraction\")\n207\t        result = _extract_with_pypdf(pdf_path)\n208\t\n209\t    if result is None:\n210\t        raise PDFInvalidError(\"Both PyMuPDF and pypdf failed to extract PDF content\")\n211\t\n212\t    page_texts, metadata = result\n213\t\n214\t    # 检查是否提取到了内容\n215\t    if not page_texts or all(not text.strip() for text in page_texts):\n216\t        raise PDFEmptyError(\"PDF contains no extractable text (might be scanned/image-based)\")\n217\t\n218\t    full_text, truncated = _truncate_text(page_texts, MAX_CHARS)\n219\t\n220\t    return PDFContent(\n221\t        full_text=full_text,\n222\t        page_texts=page_texts,\n223\t        total_pages=len(page_texts),\n224\t        metadata=metadata,\n225\t        truncated=truncated,\n226\t    )\n227\t"}]},"parent_tool_use_id":"call_14fbefec6f4c427bbf12da10","session_id":"29257b8f-ede7-46a4-8e0f-a743591d296a","uuid":"9bd84d80-bab5-45fd-ba75-ad0c21ed87c9","timestamp":"2026-06-09T05:10:18.616Z","subagent_type":"Explore","task_description":"Explore backend performance"}
