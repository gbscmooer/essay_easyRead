er\\n61\\t    y: number\\n62\\t    width: number\\n63\\t    height: number\\n64\\t    annotationType: AnnotationType\\n65\\t    color: string\\n66\\t    text: string\\n67\\t    groupId: string\\n68\\t  }) => {\\n69\\t    if (!paperId) return\\n70\\t    try {\\n71\\t      const ann = await createAnnotation(paperId, {\\n72\\t        page_number: data.pageNumber,\\n73\\t        x: data.x,\\n74\\t        y: data.y,\\n75\\t        width: data.width,\\n76\\t        height: data.height,\\n77\\t        annotation_type: data.annotationType,\\n78\\t        color: data.color,\\n79\\t        text: data.text,\\n80\\t        group_id: data.groupId,\\n81\\t      })\\n82\\t      setAnnotations(prev => [...prev, ann])\\n83\\t    } catch (e: any) {\\n84\\t      toast({ type: 'error', message: e?.message || '创建标注失败' })\\n85\\t    }\\n86\\t  }, [paperId])\\n87\\t\\n88\\t  const handleDeleteAnnotation = useCallback(async (id: number) => {\\n89\\t    try {\\n90\\t      // Find the annotation to check its group_id\\n91\\t      const target = annotations.find(a => a.id === id)\\n92\\t      if (target?.group_id) {\\n93\\t        // Delete the entire group\\n94\\t        await deleteAnnotationGroup(target.group_id)\\n95\\t        const gid = target.group_id\\n96\\t        setAnnotations(prev => prev.filter(a => a.group_id !== gid))\\n97\\t      } else {\\n98\\t        // Fallback: single delete (legacy annotations without group_id)\\n99\\t        await deleteAnnotation(id)\\n100\\t        setAnnotations(prev => prev.filter(a => a.id !== id))\\n101\\t      }\\n102\\t    } catch (e: any) {\\n103\\t      toast({ type: 'error', message: e?.message || '删除标注失败' })\\n104\\t    }\\n105\\t  }, [annotations])\\n106\\t\\n107\\t  const onDocumentLoadSuccess = useCallback(({ numPages: total }: { numPages: number }) => {\\n108\\t    setNumPages(total)\\n109\\t    setIsLoading(false)\\n110\\t  }, [])\\n111\\t\\n112\\t  const onDocumentLoadError = useCallback(() => {\\n113\\t    setIsLoading(false)\\n114\\t  }, [])\\n115\\t\\n116\\t  const scrollToPage = useCallback((page: number) => {\\n117\\t    const container = scrollRef.current\\n118\\t    const el = pageRefs.current.get(page)\\n119\\t    if (!container || !el) return\\n120\\t\\n121\\t    isScrollingRef.current = true\\n122\\t    if (scrollTimerRef.current) clearTimeout(scrollTimerRef.current)\\n123\\t\\n124\\t    const containerRect = container.getBoundingClientRect()\\n125\\t    const elRect = el.getBoundingClientRect()\\n126\\t    const offset = elRect.top - containerRect.top + container.scrollTop - 16\\n127\\t\\n128\\t    container.scrollTo({ top: offset, behavior: 'smooth' })\\n129\\t\\n130\\t    scrollTimerRef.current = setTimeout(() => {\\n131\\t      isScrollingRef.current = false\\n132\\t      setVisiblePage(page)\\n133\\t      onPageChange(page)\\n134\\t    }, 800)\\n135\\t  }, [onPageChange])\\n136\\t\\n137\\t  useImperativeHandle(ref, () => ({\\n138\\t    jumpToPage: (page: number) => {\\n139\\t      if (page >= 1 && page <= numPages) {\\n140\\t        scrollToPage(page)\\n141\\t      }\\n142\\t    },\\n143\\t  }), [numPages, scrollToPage])\\n144\\t\\n145\\t  useEffect(() => {\\n146\\t    const container = scrollRef.current\\n147\\t    if (!container) return\\n148\\t\\n149\\t    let scrollTimer: ReturnType<typeof setTimeout>\\n150\\t    const handleScroll = () => {\\n151\\t      isScrollingRef.current = true\\n152\\t      clearTimeout(scrollTimer)\\n153\\t      scrollTimer = setTimeout(() => {\\n154\\t        isScrollingRef.current = false\\n155\\t      }, 150)\\n156\\t    }\\n157\\t\\n158\\t    container.addEventListener('scroll', handleScroll, { passive: true })\\n159\\t    return () => {\\n160\\t      container.removeEventListener('scroll', handleScroll)\\n161\\t      clearTimeout(scrollTimer)\\n162\\t    }\\n163\\t  }, [])\\n164\\t\\n165\\t  useEffect(() => { visiblePageRef.current = visiblePage }, [visiblePage])\\n166\\t\\n167\\t  useEffect(() => {\\n168\\t    const container = scrollRef.current\\n169\\t    if (!container || numPages === 0) return\\n170\\t\\n171\\t    const observer = new IntersectionObserver(\\n172\\t      (entries) => {\\n173\\t        if (isScrollingRef.current) return\\n174\\t\\n175\\t        let maxRatio = 0\\n176\\t        let mostVisible = 1\\n177\\t        for (const entry of entries) {\\n178\\t          if (entry.intersectionRatio > maxRatio) {\\n179\\t            maxRatio = entry.intersectionRatio\\n180\\t            const pageNum = Number(entry.target.getAttribute('data-page'))\\n181\\t            if (pageNum) mostVisible = pageNum\\n182\\t          }\\n183\\t        }\\n184\\t        if (maxRatio > 0 && mostVisible !== visiblePageRef.current) {\\n185\\t          setVisiblePage(mostVisible)\\n186\\t        }\\n187\\t      },\\n188\\t      {\\n189\\t        root: container,\\n190\\t        threshold: [0, 0.25, 0.5, 0.75, 1],\\n191\\t      }\\n192\\t    )\\n193\\t\\n194\\t    pageRefs.current.forEach((el) => observer.observe(el))\\n195\\t    return () => observer.disconnect()\\n196\\t  }, [numPages])\\n197\\t\\n198\\t  useEffect(() => {\\n199\\t    const container = scrollRef.current\\n200\\t    if (!container) return\\n201\\t\\n202\\t    const handleWheel = (e: WheelEvent) => {\\n203\\t      if (!e.ctrlKey) return\\n204\\t      e.preventDefault()\\n205\\t      const delta = -e.deltaY\\n206\\t      setScale(s => {\\n207\\t        const step = uiConfig.pinch_zoom_step || 0.02\\n208\\t        const max = uiConfig.zoom_max || 3\\n209\\t        const min = uiConfig.zoom_min || 0.4\\n210\\t        if (delta > 0) return Math.min(s + step, max)\\n211\\t        if (delta < 0) return Math.max(s - step, min)\\n212\\t        return s\\n213\\t      })\\n214\\t    }\\n215\\t\\n216\\t    container.addEventListener('wheel', handleWheel, { passive: false })\\n217\\t    return () => container.removeEventListener('wheel', handleWheel)\\n218\\t  }, [uiConfig])\\n219\\t\\n220\\t  useEffect(() => {\\n221\\t    return () => {\\n222\\t      if (scrollTimerRef.current) clearTimeout(scrollTimerRef.current)\\n223\\t    }\\n224\\t  }, [])\\n225\\t\\n226\\t  const goToPage = useCallback((page: number) => {\\n227\\t    if (page >= 1 && page <= numPages) {\\n228\\t      scrollToPage(page)\\n229\\t    }\\n230\\t  }, [numPages, scrollToPage])\\n231\\t\\n232\\t  const handlePageInputKeyDown = useCallback((e: React.KeyboardEvent<HTMLInputElement>) => {\\n233\\t    if (e.key === 'Enter') {\\n234\\t      const page = parseInt(pageInput, 10)\\n235\\t      if (!isNaN(page)) goToPage(page)\\n236\\t      setPageInput('')\\n237\\t    }\\n238\\t  }, [pageInput, goToPage])\\n239\\t\\n240\\t  const zoomIn = useCallback(() => setScale(s => Math.min(s + (uiConfig.zoom_step || 0.2), uiConfig.zoom_max || 3)), [uiConfig])\\n241\\t  const zoomOut = useCallback(() => setScale(s => Math.max(s - (uiConfig.zoom_step || 0.2), uiConfig.zoom_min || 0.4)), [uiConfig])\\n242\\t  const resetZoom = useCallback(() => setScale(1.0), [])\\n243\\t\\n244\\t  return (\\n245\\t    <div className=\\\"flex flex-col h-full rounded-lg overflow-hidden relative\\\" style={{ backgroundColor: 'var(--bg-surface)' }}>\\n246\\t      {/* 文本选择弹窗 */}\\n247\\t      <SelectionPopup containerRef={scrollRef} onAnnotate={handleAnnotate} />\\n248\\t\\n249\\t      {/* PDF 内容区 — 连续滚动 */}\\n250\\t      <div ref={scrollRef} className=\\\"flex-1 overflow-auto\\\">\\n251\\t        {isLoading && (\\n252\\t          <div className=\\\"w-full h-full flex items-center justify-center\\\">\\n253\\t            <div className=\\\"w-8 h-8 border-2 rounded-full animate-spin\\\" style={{ borderColor: 'var(--border-light)', borderTopColor: 'var(--accent)' }} />\\n254\\t          </div>\\n255\\t        )}\\n256\\t        <Document\\n257\\t          file={pdfUrl}\\n258\\t          onLoadSuccess={onDocumentLoadSuccess}\\n259\\t          onLoadError={onDocumentLoadError}\\n260\\t          loading={null}\\n261\\t        >\\n262\\t          <div className=\\\"flex flex-col items-center gap-4 py-4\\\">\