{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call_4528cb0a5e424915bd05f34d","type":"tool_result","content":"1\t\"\"\"\n2\tAI 配置服务\n3\t\n4\t管理翻译和解读两套 AI 模型配置，存储在 JSON 文件中。\n5\t\"\"\"\n6\t\n7\timport os\n8\timport json\n9\timport logging\n10\tfrom typing import Optional\n11\t\n12\tlogger = logging.getLogger(__name__)\n13\t\n14\tCONFIG_PATH = os.path.join(os.path.dirname(os.path.dirname(os.path.dirname(__file__))), \"data\", \"ai_config.json\")\n15\t\n16\tDEFAULT_CONFIG = {\n17\t    \"translate\": {\n18\t        \"api_key\": \"\",\n19\t        \"base_url\": \"https://api.openai.com/v1\",\n20\t        \"model\": \"gpt-4o-mini\",\n21\t        \"system_prompt\": \"你是一个专业的学术翻译助手。将用户提供的英文论文片段翻译为中文。只输出翻译结果，不要添加任何解释。保持学术术语的准确性。\",\n22\t        \"temperature\": 0.3,\n23\t        \"max_tokens\": 2048,\n24\t    },\n25\t    \"analysis\": {\n26\t        \"api_key\": \"\",\n27\t        \"base_url\": \"https://token-plan-cn.xiaomimimo.com/anthropic\",\n28\t        \"model\": \"mimo-v2.5-pro\",\n29\t        \"temperature\": 0.1,\n30\t        \"max_tokens\": 16384,\n31\t    },\n32\t    # 解读系统提示词：内置(builtin)只读，用户可创建可编辑副本并选用替换\n33\t    \"analysis_prompt\": {\n34\t        \"active\": \"builtin\",   # \"builtin\" | \"custom:<id>\"\n35\t        \"custom\": [],          # [{id, name, content}]\n36\t    },\n37\t    \"ui\": {\n38\t        \"highlight_duration\": 3000,\n39\t        \"zoom_step\": 0.2,\n40\t        \"zoom_min\": 0.4,\n41\t        \"zoom_max\": 3.0,\n42\t        \"pinch_zoom_step\": 0.02,\n43\t        \"theme\": \"light\",\n44\t        \"font\": \"sans\",\n45\t        \"custom_font\": \"\",\n46\t        \"custom_themes\": [],\n47\t    },\n48\t    \"embedding\": {\n49\t        \"provider\": \"local\",\n50\t        \"model\": \"BAAI/bge-m3\",\n51\t        \"api_key\": \"\",\n52\t        \"base_url\": \"https://api.openai.com/v1\",\n53\t        \"batch_size\": 32,\n54\t        \"device\": \"auto\",\n55\t    },\n56\t    \"research\": {\n57\t        \"provider\": \"openalex\",       # openalex | semantic_scholar | local\n58\t        \"email\": \"\",                  # OpenAlex polite pool 邮箱（可选，更稳定）\n59\t        \"api_key\": \"\",                # Semantic Scholar API key（可选）\n60\t        \"similarity_threshold\": 0.9,  # 图谱相似边阈值（已弃用，相似边改用 kNN 稀疏化）\n61\t        \"knn_k\": 8,                   # 每篇论文最多保留 K 条最相似的边（控制图谱稀密）\n62\t        \"link_distance\": 50,          # 知识图谱节点边长基准（d3 默认 30）\n63\t    },\n64\t    \"reranker\": {\n65\t        \"enabled\": True,\n66\t        \"provider\": \"siliconflow\",\n67\t        \"model\": \"BAAI/bge-reranker-v2-m3\",\n68\t        \"api_key\": \"\",            # 空时回退到 embedding 的 api_key\n69\t        \"base_url\": \"\",           # 空时回退到 embedding 的 base_url\n70\t        \"candidate_k\": 30,        # 向量检索召回数（送入 rerank 的池子大小）\n71\t        \"top_n\": 5,               # rerank 后送入 LLM 的条数\n72\t    },\n73\t    \"similarity\": {\n74\t        # 论文级相似度计算 provider，对应 backend/services/deep_research/similarity/REGISTRY\n75\t        # 可选：bge_centroid（默认）/ bibcoupling / hybrid / facet_weighted\n76\t        \"provider\": \"bge_centroid\",\n77\t        # 每个 provider 的私有配置写在与 name 同名的子对象里：\n78\t        # facet_weighted：可解释的多维度相似度，权重会自动归一化到 1\n79\t        \"facet_weighted\": {\n80\t            \"weights\": {\n81\t                \"purpose\": 0.5,    # 研究目的\n82\t                \"method\": 0.2,     # 方法\n83\t                \"baseline\": 0.15,  # 对比基线\n84\t                \"dataset\": 0.05,   # 数据集\n85\t            },\n86\t            \"use_embedding\": True,  # purpose/method 用 embedding 余弦；False 走纯词重叠\n87\t        },\n88\t    },\n89\t    \"arxiv_expand\": {\n90\t        # 是否启用引用列表扩展（解析 seed 论文参考文献并联网下载）\n91\t        \"enabled\": True,\n92\t        # 引用解析后端：grobid（结构化，默认）| regex（正则，零依赖回退）\n93\t        \"parser\": \"grobid\",\n94\t        # GROBID 服务地址（parser=grobid 时使用），标准 Docker 端口 8070\n95\t        \"grobid_url\": \"http://localhost:8070\",\n96\t        # 按正文引用频次取 top_k（频次越高越核心）\n97\t        \"top_k\": 5,\n98\t        # 是否允许 LLM 提取没有标题的引用（仅 regex 后端、且引用无标题时才需要）\n99\t        \"use_llm_title\": True,\n100\t        # 每篇 seed 论文最多进行 LLM/arXiv/CrossRef 标题搜索的次数上限\n101\t        \"max_llm_refs\": 15,\n102\t    },\n103\t    \"findpapers\": {\n104\t        # 是否启用 findpapers 多源学术搜索引擎\n105\t        # 启用后替代 Semantic Scholar 进行相关论文搜索和 PDF 下载\n106\t        \"enabled\": False,\n107\t        # 启用的数据库列表（免费数据库默认开启，需 API key 的需额外配置）\n108\t        # 可选搜索库：arxiv, openalex, pubmed, semantic_scholar, ieee, scopus, wos\n109\t        # 注意：crossref 仅用于数据丰富（enrichment），不可作为搜索库\n110\t        \"databases\": [\"arxiv\", \"openalex\", \"pubmed\", \"semantic_scholar\"],\n111\t        # 搜索结果数量上限\n112\t        \"max_results\": 10,\n113\t    },\n114\t}\n115\t\n116\t\n117\tdef _ensure_dir():\n118\t    os.makedirs(os.path.dirname(CONFIG_PATH), exist_ok=True)\n119\t\n120\t\n121\tdef load_config() -> dict:\n122\t    \"\"\"加载配置\"\"\"\n123\t    if not os.path.exists(CONFIG_PATH):\n124\t        return _deep_copy_default()\n125\t    try:\n126\t        with open(CONFIG_PATH, \"r\", encoding=\"utf-8\") as f:\n127\t            saved = json.load(f)\n128\t        # 合并默认值（防止缺少字段）\n129\t        config = {}\n130\t        for key in DEFAULT_CONFIG:\n131\t            config[key] = {**DEFAULT_CONFIG[key], **saved.get(key, {})}\n132\t        return config\n133\t    except Exception as e:\n134\t        logger.warning(f\"Failed to load config: {e}\")\n135\t        return _deep_copy_default()\n136\t\n137\t\n138\tdef _deep_copy_default() -> dict:\n139\t    \"\"\"深拷贝默认配置\"\"\"\n140\t    import copy\n141\t    return copy.deepcopy(DEFAULT_CONFIG)\n142\t\n143\t\n144\tdef save_config(config: dict) -> None:\n145\t    \"\"\"保存 AI 配置\"\"\"\n146\t    _ensure_dir()\n147\t    with open(CONFIG_PATH, \"w\", encoding=\"utf-8\") as f:\n148\t        json.dump(config, f, ensure_ascii=False, indent=2)\n149\t    logger.info(\"AI config saved\")\n150\t\n151\t\n152\tdef get_translate_config() -> dict:\n153\t    \"\"\"获取翻译模型配置\"\"\"\n154\t    return load_config().get(\"translate\", DEFAULT_CONFIG[\"translate\"])\n155\t\n156\t\n157\tdef get_analysis_config() -> dict:\n158\t    \"\"\"获取解读模型配置\"\"\"\n159\t    cfg = load_config().get(\"analysis\", DEFAULT_CONFIG[\"analysis\"])\n160\t    # 如果解读配置没有填写 api_key，回退到环境变量中的默认值\n161\t    if not cfg.get(\"api_key\"):\n162\t        from ..config import settings\n163\t        cfg[\"api_key\"] = settings.mimo_api_key\n164\t        if not cfg.get(\"base_url\"):\n165\t            cfg[\"base_url\"] = settings.mimo_base_url\n166\t        if not cfg.get(\"model\"):\n167\t            cfg[\"model\"] = settings.mimo_model\n168\t    return cfg\n169\t\n170\t\n171\tdef get_analysis_prompt_config() -> dict:\n172\t    \"\"\"获取解读提示词配置（active + custom 列表）\"\"\"\n173\t    saved = load_config().get(\"analysis_prompt\", {})\n174\t    return {**DEFAULT_CONFIG[\"analysis_prompt\"], **saved}\n175\t\n176\t\n177\tdef get_active_analysis_prompt() -> str:\n178\t    \"\"\"解析当前生效的解读系统提示词。\n179\t\n180\t    active=\"builtin\" → 返回 ai_analyzer 内置 SYSTEM_PROMPT；\n181\t    active=\"custom:<id>\" → 返回对应自定义副本的 content；找不到则回退内置。\n182\t    \"\"\"\n183\t    from .ai_analyzer import SYSTEM_PROMPT\n184\t    cfg = get_analysis_prompt_config()\n185\t    active = cfg.get(\"active\", \"builtin\")\n186\t    if isinstance(active, str) and active.startswith(\"custom:\"):\n187\t        cid = active.split(\":\", 1)[1]\n188\t        for t in cfg.get(\"custom\", []):\n189\t            if t.get(\"id\") == cid and (t.get(\"content\") or \"\").strip():\n190\t                return t[\"content\"]\n191\t    return SYSTEM_PROMPT\n192\t\n193\t\n194\tdef get_embedding_config() -> dict:\n195\t    \"\"\"获取 Embedding 模型配置\"\"\"\n196\t    return load_config().get(\"embedding\", DEFAULT_CONFIG[\"embedding\"])\n197\t\n198\t\n199\tdef get_research_config() -> dict:\n200\t    \"\"\"获取深度研究 Provider 配置\"\"\"\n201\t    return load_config().get(\"research\", DEFAULT_CONFIG[\"research\"])\n202\t\n203\t\n204\tdef get_similarity_config() -> dict:\n205\t    \"\"\"获取论文级相似度计算 Provider 配置\"\"\"\n206\t    return load_config().get(\"similarity\", DEFAULT_CONFIG[\"similarity\"])\n207\t\n208\t\n209\tdef get_arxiv_expand_config() -> dict:\n210\t    \"\"\"获取 arXiv 引用列表扩展配置\"\"\"\n211\t    saved = load_config().get(\"arxiv_expand\", {})\n212\t    return {**DEFAULT_CONFIG[\"arxiv_expand\"], **saved}\n213\t\n214\t\n215\tdef get_findpapers_config() -> dict:\n216\t    \"\"\"获取 findpapers 多源搜索配置\"\"\"\n217\t    saved = load_config().get(\"findpapers\", {})\n218\t    return {**DEFAULT_CONFIG[\"findpapers\"], **saved}\n219\t\n220\t\n221\tdef get_reranker_config() -> dict:\n222\t    \"\"\"获取重排序模型配置。\n223\t    api_key/base_url 留空时自动回退到 embedding 的同字段（默认共用 siliconflow 账号）。\n224\t    \"\"\"\n225\t    full = load_config()\n226\t    cfg = dict(full.get(\"reranker\", DEFAULT_CONFIG[\"reranker\"]))\n227\t    if not cfg.get(\"api_key\"):\n228\t        cfg[\"api_key\"] = full.get(\"embedding\", {}).get(\"api_key\", \"\")\n229\t    if not cfg.get(\"base_url\"):\n230\t        cfg[\"base_url\"] = full.get(\"embedding\", {}).get(\"base_url\", \"\")\n231\t    return cfg\n232\t"}]},"parent_tool_use_id":"call_14fbefec6f4c427bbf12da10","session_id":"29257b8f-ede7-46a4-8e0f-a743591d296a","uuid":"614ebd50-bc04-428d-ba64-cde2496b978c","timestamp":"2026-06-09T05:10:30.313Z","subagent_type":"Explore","task_description":"Explore backend performance"}
