{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call_f120b04f830e4e47abb6f7bc","type":"tool_result","content":"1\timport { useState, useCallback, useRef } from 'react'\n2\timport { Link, useLocation, useNavigate } from 'react-router-dom'\n3\timport { TerminalPanel } from './TerminalPanel'\n4\timport { ThemeProvider } from './ThemeProvider'\n5\timport { VersionPopup } from './VersionPopup'\n6\timport { ShortcutHelp } from './ShortcutHelp'\n7\timport { ConfirmDialog } from '@/components/ConfirmDialog'\n8\timport { hasUnsavedConfig } from '@/hooks/useConfig'\n9\timport { useGlobalShortcuts, setHelpCallback } from '@/hooks/useKeyboardShortcuts'\n10\t\n11\t\n12\tinterface LayoutProps {\n13\t  children: React.ReactNode\n14\t}\n15\t\n16\t\n17\tconst primaryNav = [\n18\t  { path: '/', label: '首页' },\n19\t  { path: '/library', label: '论文库' },\n20\t  { path: '/workspace', label: '工作区' },\n21\t  { path: '/settings', label: '设置' },\n22\t]\n23\t\n24\t\n25\tfunction useCurrentPaperId(): number | null {\n26\t  const location = useLocation()\n27\t  const match = location.pathname.match(/^\\/(?:reader|code)\\/(\\d+)/)\n28\t  return match ? Number(match[1]) : null\n29\t}\n30\t\n31\tfunction useCurrentWorkspaceId(): number | null {\n32\t  const m = useLocation().pathname.match(/^\\/workspace\\/(\\d+)(?:\\/|$)/)\n33\t  return m ? Number(m[1]) : null\n34\t}\n35\t\n36\t\n37\texport function Layout({ children }: LayoutProps) {\n38\t  const location = useLocation()\n39\t  const navigate = useNavigate()\n40\t  const paperId = useCurrentPaperId()\n41\t  const wsId = useCurrentWorkspaceId()\n42\t  const [navCollapsed, setNavCollapsed] = useState(false)\n43\t  const [showVersion, setShowVersion] = useState(false)\n44\t  const [showShortcuts, setShowShortcuts] = useState(false)\n45\t  const [showUnsavedConfirm, setShowUnsavedConfirm] = useState(false)\n46\t  const pendingNavRef = useRef<string | null>(null)\n47\t  const pendingNavStateRef = useRef<unknown>(null)\n48\t\n49\t  useGlobalShortcuts(navigate)\n50\t\n51\t  // Register ? shortcut to show help\n52\t  const toggleShortcuts = useCallback(() => setShowShortcuts(v => !v), [])\n53\t  setHelpCallback(toggleShortcuts)\n54\t\n55\t  const toggleVersion = useCallback(() => setShowVersion(v => !v), [])\n56\t  const closeVersion = useCallback(() => setShowVersion(false), [])\n57\t\n58\t  // Unified handler: if on settings with unsaved config, show confirm dialog; otherwise navigate directly\n59\t  const handleNavGuard = useCallback((target: string, e: React.MouseEvent, state?: unknown) => {\n60\t    if (location.pathname.startsWith('/settings') && hasUnsavedConfig()) {\n61\t      e.preventDefault()\n62\t      pendingNavRef.current = target\n63\t      pendingNavStateRef.current = state ?? null\n64\t      setShowUnsavedConfirm(true)\n65\t    }\n66\t  }, [location.pathname])\n67\t\n68\t  return (\n69\t    <ThemeProvider>\n70\t    <div className=\"flex flex-col h-screen\" style={{ backgroundColor: 'var(--bg-base)' }}>\n71\t      {/* 一级导航栏 */}\n72\t      <nav className={`flex items-center justify-between px-6 shrink-0 transition-all duration-200 ${\n73\t        navCollapsed ? 'h-10' : 'h-14'\n74\t      }`} style={{\n75\t        backgroundColor: 'var(--bg-surface)',\n76\t        borderBottom: '1px solid var(--border)',\n77\t      }}>\n78\t        <button\n79\t          onClick={toggleVersion}\n80\t          aria-label=\"Easy Essay 首页\"\n81\t          className={`font-semibold transition-colors cursor-pointer hover:opacity-80 ${navCollapsed ? 'text-sm' : 'text-base'}`}\n82\t          style={{ color: 'var(--text-primary)', background: 'none', border: 'none' }}\n83\t        >\n84\t          <span style={{ color: 'var(--accent)' }}>&#9670;</span> Easy Essay\n85\t        </button>\n86\t\n87\t        {!navCollapsed && (\n88\t          <div className=\"flex items-center gap-1\">\n89\t            {primaryNav.map(item => (\n90\t              <Link\n91\t                key={item.path}\n92\t                to={item.path}\n93\t                onClick={(e) => handleNavGuard(item.path, e)}\n94\t                className={`px-3 py-1.5 rounded-md text-sm transition-colors ${\n95\t                  location.pathname === item.path\n96\t                    ? 'font-medium'\n97\t                    : 'hover:opacity-80'\n98\t                }`}\n99\t                style={\n100\t                  location.pathname === item.path\n101\t                    ? { color: 'var(--accent)', backgroundColor: 'var(--accent-subtle)' }\n102\t                    : { color: 'var(--text-secondary)' }\n103\t                }\n104\t              >\n105\t                {item.label}\n106\t              </Link>\n107\t            ))}\n108\t          </div>\n109\t        )}\n110\t\n111\t        <button\n112\t          onClick={() => setNavCollapsed(v => !v)}\n113\t          aria-label={navCollapsed ? '展开导航栏' : '收起导航栏'}\n114\t          aria-expanded={!navCollapsed}\n115\t          className=\"p-1.5 rounded-md transition-colors\"\n116\t          style={{ color: 'var(--text-muted)' }}\n117\t          title={navCollapsed ? '展开导航栏' : '收起导航栏'}\n118\t        >\n119\t          <svg className={`w-4 h-4 transition-transform ${navCollapsed ? 'rotate-180' : ''}`} fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\">\n120\t            <path strokeLinecap=\"round\" strokeLinejoin=\"round\" strokeWidth={1.5} d=\"M5 15l7-7 7 7\" />\n121\t          </svg>\n122\t        </button>\n123\t      </nav>\n124\t\n125\t      {/* 二级导航栏（仅在查看论文时显示，且未收起时）*/}\n126\t      {paperId && !navCollapsed && (\n127\t        <div className=\"flex items-center justify-between px-6 h-11 shrink-0\" style={{\n128\t          backgroundColor: 'var(--bg-surface)',\n129\t          borderBottom: '1px solid var(--border)',\n130\t          opacity: 0.97,\n131\t        }}>\n132\t          <div className=\"flex items-center gap-4\">\n133\t            <div className=\"flex items-center gap-1\">\n134\t              <Link\n135\t                to={`/reader/${paperId}`}\n136\t                state={location.state}\n137\t                onClick={(e) => handleNavGuard(`/reader/${paperId}`, e, location.state)}\n138\t                className={`px-3 py-1 text-xs rounded-md transition-colors ${\n139\t                  location.pathname.startsWith('/reader')\n140\t                    ? 'font-medium'\n141\t                    : ''\n142\t                }`}\n143\t                style={\n144\t                  location.pathname.startsWith('/reader')\n145\t                    ? { backgroundColor: 'var(--accent-subtle)', color: 'var(--accent)' }\n146\t                    : { color: 'var(--text-muted)' }\n147\t                }\n148\t              >\n149\t                论文分析\n150\t              </Link>\n151\t              <Link\n152\t                to={`/code/${paperId}`}\n153\t                state={location.state}\n154\t                onClick={(e) => handleNavGuard(`/code/${paperId}`, e, location.state)}\n155\t                className={`px-3 py-1 text-xs rounded-md transition-colors ${\n156\t                  location.pathname.startsWith('/code')\n157\t                    ? 'font-medium'\n158\t                    : ''\n159\t                }`}\n160\t                style={\n161\t                  location.pathname.startsWith('/code')\n162\t                    ? { backgroundColor: 'var(--accent-subtle)', color: 'var(--accent)' }\n163\t                    : { color: 'var(--text-muted)' }\n164\t                }\n165\t              >\n166\t                源码分析\n167\t              </Link>\n168\t            </div>\n169\t          </div>\n170\t          {(() => {\n171\t            const fromPath = (location.state as { from?: string } | null)?.from\n172\t            const wsMatch = fromPath?.match(/^\\/workspace\\/(\\d+)/)\n173\t            const backTo = wsMatch ? `/workspace/${wsMatch[1]}` : '/library'\n174\t            const backLabel = wsMatch ? '返回工作区' : '返回论文库'\n175\t            return (\n176\t              <Link\n177\t                to={backTo}\n178\t                onClick={(e) => handleNavGuard(backTo, e)}\n179\t                className=\"text-xs transition-colors\"\n180\t                style={{ color: 'var(--text-muted)' }}\n181\t              >\n182\t                {backLabel} &rarr;\n183\t              </Link>\n184\t            )\n185\t          })()}\n186\t        </div>\n187\t      )}\n188\t\n189\t      {/* 工作区级二级导航（在工作区页面显示，且不在论文页面时）*/}\n190\t      {wsId && !paperId && !navCollapsed && (\n191\t        <div className=\"flex items-center gap-4 px-6 h-11 shrink-0\" style={{\n192\t          backgroundColor: 'var(--bg-surface)',\n193\t          borderBottom: '1px solid var(--border)',\n194\t          opacity: 0.97,\n195\t        }}>\n196\t          <Link\n197\t            to={`/workspace/${wsId}`}\n198\t            className={`px-3 py-1 text-xs rounded-md transition-colors ${\n199\t              location.pathname === `/workspace/${wsId}`\n200\t                ? 'font-medium'\n201\t                : ''\n202\t            }`}\n203\t            style={\n204\t              location.pathname === `/workspace/${wsId}`\n205\t                ? { backgroundColor: 'var(--accent-subtle)', color: 'var(--accent)' }\n206\t                : { color: 'var(--text-muted)' }\n207\t            }\n208\t          >\n209\t            论文列表\n210\t          </Link>\n211\t          <Link\n212\t            to={`/workspace/${wsId}/research`}\n213\t            className={`px-3 py-1 text-xs rounded-md transition-colors ${\n214\t              location.pathname.includes('/research')\n215\t                ? 'font-medium'\n216\t                : ''\n217\t            }`}\n218\t            style={\n219\t              location.pathname.includes('/research')\n220\t                ? { backgroundColor: 'var(--accent-subtle)', color: 'var(--accent)' }\n221\t                : { color: 'var(--text-muted)' }\n222\t            }\n223\t          >\n224\t            深度研究 ⚡\n225\t          </Link>\n226\t        </div>\n227\t      )}\n228\t\n229\t      {/* 内容区 */}\n230\t      <main className=\"flex-1 overflow-auto\">\n231\t        {children}\n232\t      </main>\n233\t\n234\t      {/* 底部终端面板 */}\n235\t      <TerminalPanel />\n236\t\n237\t      {/* 版本信息弹窗 */}\n238\t      {showVersion && <VersionPopup onClose={closeVersion} />}\n239\t\n240\t      {/* 快捷键帮助 */}\n241\t      <ShortcutHelp open={showShortcuts} onClose={toggleShortcuts} />\n242\t\n243\t      {/* 未保存配置确认 */}\n244\t      <ConfirmDialog\n245\t        open={showUnsavedConfirm}\n246\t        title=\"未保存的更改\"\n247\t        message=\"有未保存的配置更改，确定离开吗？\"\n248\t        variant=\"warning\"\n249\t        confirmLabel=\"离开\"\n250\t        cancelLabel=\"留下\"\n251\t        onConfirm={() => {\n252\t          setShowUnsavedConfirm(false)\n253\t          const target = pendingNavRef.current\n254\t          const state = pendingNavStateRef.current\n255\t          pendingNavRef.current = null\n256\t          pendingNavStateRef.current = null\n257\t          if (target) navigate(target, state ? { state } : undefined)\n258\t        }}\n259\t        onCancel={() => {\n260\t          setShowUnsavedConfirm(false)\n261\t          pendingNavRef.current = null\n262\t          pendingNavStateRef.current = null\n263\t        }}\n264\t      />\n265\t    </div>\n266\t    </ThemeProvider>\n267\t  )\n268\t}\n269\t"}]},"parent_tool_use_id":"call_bddd82a75f2e46b98e4517cc","session_id":"29257b8f-ede7-46a4-8e0f-a743591d296a","uuid":"1a279d55-5f57-4bc7-9fb4-eac5d3b7ee2e","timestamp":"2026-06-09T05:10:16.408Z","subagent_type":"Explore","task_description":"Explore frontend performance"}
