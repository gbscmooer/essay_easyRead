{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call_3b6fa52f8be24fbe9e3a6feb","type":"tool_result","content":"1\timport { useState, useEffect, useRef, useCallback, lazy, Suspense } from 'react'\n2\timport { APP_VERSION } from './VersionPopup'\n3\t\n4\tconst RealTerminal = lazy(() =>\n5\t  import('@/features/code/Terminal').then(m => ({ default: m.Terminal }))\n6\t)\n7\t\n8\t\n9\tinterface LogEntry {\n10\t  id: string\n11\t  time: string\n12\t  level: string\n13\t  source: string\n14\t  message: string\n15\t}\n16\t\n17\t\n18\ttype TabKey = 'backend' | 'frontend' | 'bash'\n19\t\n20\t\n21\t// 前端日志捕获\n22\tconst frontendLogs: LogEntry[] = []\n23\t\n24\tlet frontendListeners: Array<(entry: LogEntry) => void> = []\n25\t\n26\tlet logIdCounter = 0\n27\tfunction nextLogId(): string {\n28\t  return `${Date.now()}-${++logIdCounter}`\n29\t}\n30\t\n31\t\n32\tfunction LogLine({ entry }: { entry: LogEntry }) {\n33\t  const levelColor = {\n34\t    DEBUG: 'var(--text-muted)',\n35\t    INFO: 'var(--text-secondary)',\n36\t    WARNING: 'var(--warning)',\n37\t    WARN: 'var(--warning)',\n38\t    ERROR: 'var(--error)',\n39\t    CRITICAL: 'var(--error)',\n40\t  }[entry.level] || 'var(--text-secondary)'\n41\t\n42\t  return (\n43\t    <div className=\"flex gap-2 px-3 py-0.5 text-xs font-mono leading-5\"\n44\t      style={{}} onMouseEnter={e => { e.currentTarget.style.backgroundColor = 'var(--bg-elevated)' }} onMouseLeave={e => { e.currentTarget.style.backgroundColor = '' }}>\n45\t      <span className=\"shrink-0\" style={{ color: 'var(--text-muted)' }}>{entry.time}</span>\n46\t      <span className=\"shrink-0 w-14\" style={{ color: levelColor }}>{entry.level}</span>\n47\t      <span className=\"shrink-0 w-16\" style={{ color: 'var(--text-muted)' }}>[{entry.source}]</span>\n48\t      <span className=\"break-all\" style={{ color: 'var(--text-secondary)' }}>{entry.message}</span>\n49\t    </div>\n50\t  )\n51\t}\n52\t\n53\t\n54\tfunction BackendTab() {\n55\t  const [logs, setLogs] = useState<LogEntry[]>([])\n56\t  const endRef = useRef<HTMLDivElement>(null)\n57\t  const autoScroll = useRef(true)\n58\t\n59\t  useEffect(() => {\n60\t    const es = new EventSource('/api/logs/stream')\n61\t\n62\t    es.onmessage = (event) => {\n63\t      try {\n64\t        const entry = { ...JSON.parse(event.data) as LogEntry, id: nextLogId() }\n65\t        setLogs(prev => [...prev.slice(-499), entry])\n66\t      } catch {\n67\t        // 忽略解析错误\n68\t      }\n69\t    }\n70\t\n71\t    es.onerror = () => {\n72\t      // 自动重连由浏览器处理\n73\t    }\n74\t\n75\t    return () => es.close()\n76\t  }, [])\n77\t\n78\t  useEffect(() => {\n79\t    if (autoScroll.current) {\n80\t      endRef.current?.scrollIntoView({ behavior: 'smooth' })\n81\t    }\n82\t  }, [logs])\n83\t\n84\t  return (\n85\t    <div\n86\t      className=\"overflow-auto h-full\"\n87\t      onScroll={(e) => {\n88\t        const el = e.currentTarget\n89\t        autoScroll.current = el.scrollHeight - el.scrollTop - el.clientHeight < 50\n90\t      }}\n91\t    >\n92\t      {logs.length === 0 ? (\n93\t        <div className=\"p-4 text-xs text-center\" style={{ color: 'var(--text-muted)' }}>等待日志...</div>\n94\t      ) : (\n95\t        logs.map((entry) => <LogLine key={entry.id} entry={entry} />)\n96\t      )}\n97\t      <div ref={endRef} />\n98\t    </div>\n99\t  )\n100\t}\n101\t\n102\t\n103\tfunction FrontendTab() {\n104\t  const [logs, setLogs] = useState<LogEntry[]>([...frontendLogs])\n105\t  const endRef = useRef<HTMLDivElement>(null)\n106\t  const autoScroll = useRef(true)\n107\t\n108\t  useEffect(() => {\n109\t    const listener = (entry: LogEntry) => {\n110\t      setLogs(prev => [...prev.slice(-499), entry])\n111\t    }\n112\t    frontendListeners.push(listener)\n113\t    return () => {\n114\t      frontendListeners = frontendListeners.filter(l => l !== listener)\n115\t    }\n116\t  }, [])\n117\t\n118\t  useEffect(() => {\n119\t    if (autoScroll.current) {\n120\t      endRef.current?.scrollIntoView({ behavior: 'smooth' })\n121\t    }\n122\t  }, [logs])\n123\t\n124\t  return (\n125\t    <div\n126\t      className=\"overflow-auto h-full\"\n127\t      onScroll={(e) => {\n128\t        const el = e.currentTarget\n129\t        autoScroll.current = el.scrollHeight - el.scrollTop - el.clientHeight < 50\n130\t      }}\n131\t    >\n132\t      {logs.length === 0 ? (\n133\t        <div className=\"p-4 text-xs text-center\" style={{ color: 'var(--text-muted)' }}>暂无前端日志</div>\n134\t      ) : (\n135\t        logs.map((entry) => <LogLine key={entry.id} entry={entry} />)\n136\t      )}\n137\t      <div ref={endRef} />\n138\t    </div>\n139\t  )\n140\t}\n141\t\n142\t\n143\tfunction BashTab() {\n144\t  return (\n145\t    <Suspense fallback={<div className=\"p-4 text-xs text-center\" style={{ color: 'var(--text-muted)' }}>加载终端...</div>}>\n146\t      <RealTerminal />\n147\t    </Suspense>\n148\t  )\n149\t}\n150\t\n151\t\n152\tconst tabs = [\n153\t  { key: 'backend' as TabKey, label: '后端日志' },\n154\t  { key: 'frontend' as TabKey, label: '前端日志' },\n155\t  { key: 'bash' as TabKey, label: '控制台' },\n156\t]\n157\t\n158\t\n159\texport function TerminalPanel() {\n160\t  const [activeTab, setActiveTab] = useState<TabKey>('backend')\n161\t  const [height, setHeight] = useState(200)\n162\t  const [collapsed, setCollapsed] = useState(true)\n163\t  const dragRef = useRef(false)\n164\t  const startY = useRef(0)\n165\t  const startHeight = useRef(0)\n166\t\n167\t  const handleMouseDown = useCallback((e: React.MouseEvent) => {\n168\t    e.preventDefault()\n169\t    dragRef.current = true\n170\t    startY.current = e.clientY\n171\t    startHeight.current = height\n172\t    document.body.style.cursor = 'row-resize'\n173\t    document.body.style.userSelect = 'none'\n174\t  }, [height])\n175\t\n176\t  useEffect(() => {\n177\t    const handleMouseMove = (e: MouseEvent) => {\n178\t      if (!dragRef.current) return\n179\t      const delta = startY.current - e.clientY\n180\t      setHeight(Math.max(100, Math.min(500, startHeight.current + delta)))\n181\t    }\n182\t\n183\t    const handleMouseUp = () => {\n184\t      if (dragRef.current) {\n185\t        dragRef.current = false\n186\t        document.body.style.cursor = ''\n187\t        document.body.style.userSelect = ''\n188\t      }\n189\t    }\n190\t\n191\t    document.addEventListener('mousemove', handleMouseMove)\n192\t    document.addEventListener('mouseup', handleMouseUp)\n193\t    return () => {\n194\t      document.removeEventListener('mousemove', handleMouseMove)\n195\t      document.removeEventListener('mouseup', handleMouseUp)\n196\t    }\n197\t  }, [])\n198\t\n199\t  // 前端日志捕获（组件内启动，卸载时恢复）\n200\t  useEffect(() => {\n201\t    const originals = {\n202\t      log: console.log,\n203\t      warn: console.warn,\n204\t      error: console.error,\n205\t    }\n206\t\n207\t    const capture = (level: string) => (...args: unknown[]) => {\n208\t      const entry: LogEntry = {\n209\t        id: nextLogId(),\n210\t        time: new Date().toLocaleTimeString('en-US', { hour12: false }),\n211\t        level,\n212\t        source: 'frontend',\n213\t        message: args.map(a => typeof a === 'string' ? a : JSON.stringify(a)).join(' '),\n214\t      }\n215\t      frontendLogs.push(entry)\n216\t      if (frontendLogs.length > 500) frontendLogs.shift()\n217\t      frontendListeners.forEach(fn => fn(entry))\n218\t      if (level === 'ERROR') originals.error(...args)\n219\t      else if (level === 'WARN') originals.warn(...args)\n220\t      else originals.log(...args)\n221\t    }\n222\t\n223\t    console.log = capture('INFO')\n224\t    console.warn = capture('WARN')\n225\t    console.error = capture('ERROR')\n226\t\n227\t    return () => {\n228\t      console.log = originals.log\n229\t      console.warn = originals.warn\n230\t      console.error = originals.error\n231\t    }\n232\t  }, [])\n233\t\n234\t  return (\n235\t    <div\n236\t      data-terminal-panel\n237\t      className=\"flex flex-col border-t\"\n238\t      style={{ backgroundColor: 'var(--bg-base)', borderColor: 'var(--border)', height: collapsed ? 32 : height }}\n239\t    >\n240\t      {/* 标题栏 */}\n241\t      <button\n242\t        className=\"flex items-center justify-between px-3 h-8 shrink-0 cursor-pointer select-none w-full text-left\"\n243\t        aria-expanded={!collapsed}\n244\t        onMouseEnter={e => { e.currentTarget.style.backgroundColor = 'var(--bg-surface)' }}\n245\t        onMouseLeave={e => { e.currentTarget.style.backgroundColor = '' }}\n246\t        onClick={() => setCollapsed(v => !v)}\n247\t      >\n248\t        <div className=\"flex items-center gap-3\">\n249\t          <svg\n250\t            className={`w-3 h-3 transition-transform ${collapsed ? '' : 'rotate-90'}`}\n251\t            style={{ color: 'var(--text-muted)' }}\n252\t            fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\"\n253\t          >\n254\t            <path strokeLinecap=\"round\" strokeLinejoin=\"round\" strokeWidth={2} d=\"M9 5l7 7-7 7\" />\n255\t          </svg>\n256\t          <span className=\"text-xs font-medium\" style={{ color: 'var(--text-muted)' }}>终端</span>\n257\t          <span className=\"text-[10px]\" style={{ color: 'var(--text-muted)' }}>v{APP_VERSION}</span>\n258\t          {!collapsed && (\n259\t            <div className=\"flex items-center gap-1\">\n260\t              {tabs.map(tab => (\n261\t                <button\n262\t                  key={tab.key}\n263\t                  onClick={(e) => { e.stopPropagation(); setActiveTab(tab.key) }}\n264\t                  className=\"px-2 py-0.5 text-xs rounded transition-colors\"\n265\t                    style={activeTab === tab.key ? { backgroundColor: 'var(--bg-elevated)', color: 'var(--text-primary)' } : { color: 'var(--text-muted)' }}\n266\t                    onMouseEnter={e => { if (activeTab !== tab.key) (e.currentTarget as HTMLElement).style.color = 'var(--text-secondary)' }}\n267\t                    onMouseLeave={e => { if (activeTab !== tab.key) (e.currentTarget as HTMLElement).style.color = 'var(--text-muted)' }}\n268\t                >\n269\t                  {tab.label}\n270\t                </button>\n271\t              ))}\n272\t            </div>\n273\t          )}\n274\t        </div>\n275\t      </button>\n276\t\n277\t      {/* 拖拽条 */}\n278\t      {!collapsed && (\n279\t        <div\n280\t          onMouseDown={handleMouseDown}\n281\t          className=\"h-2 shrink-0 cursor-row-resize flex items-center justify-center group transition-colors\"\n282\t        >\n283\t          <div className=\"w-8 h-1 rounded-full transition-colors\" style={{ backgroundColor: 'var(--border)' }} />\n284\t        </div>\n285\t      )}\n286\t\n287\t      {/* 内容区 */}\n288\t      {!collapsed && (\n289\t        <div className=\"flex-1 overflow-hidden\">\n290\t          {activeTab === 'backend' && <BackendTab />}\n291\t          {activeTab === 'frontend' && <FrontendTab />}\n292\t          {activeTab === 'bash' && <BashTab />}\n293\t        </div>\n294\t      )}\n295\t    </div>\n296\t  )\n297\t}\n298\t"}]},"parent_tool_use_id":"call_bddd82a75f2e46b98e4517cc","session_id":"29257b8f-ede7-46a4-8e0f-a743591d296a","uuid":"d84f5cde-dbc2-4f1f-a0f3-578d1f88177b","timestamp":"2026-06-09T05:10:33.838Z","subagent_type":"Explore","task_description":"Explore frontend performance"}
