{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call_e46821a8e32842dd88bb4a75","type":"tool_result","content":"1\t\"\"\"\n2\tfindpapers 多源学术搜索服务\n3\t\n4\t提供统一的论文搜索和 PDF 下载接口，基于 findpapers 库。\n5\t支持 8 个数据库：arXiv、CrossRef、IEEE、OpenAlex、PubMed、Scopus、Semantic Scholar、Web of Science。\n6\t\n7\t当 findpapers 在设置中启用时，替代 Semantic Scholar 进行：\n8\t1. 相关论文搜索（多源并行 + 自动去重）\n9\t2. PDF URL 解析（三层回退：直接 URL → 着陆页 meta 标签 → 出版商 URL 模式）\n10\t\"\"\"\n11\t\n12\timport asyncio\n13\timport logging\n14\tfrom typing import Optional\n15\t\n16\tlogger = logging.getLogger(__name__)\n17\t\n18\t# findpapers 支持的搜索数据库（crossref 仅用于 enrichment，不可搜索）\n19\t_VALID_SEARCH_DBS = {\"arxiv\", \"ieee\", \"openalex\", \"pubmed\", \"scopus\", \"semantic_scholar\", \"wos\"}\n20\t\n21\t# 停用词（构建布尔查询时过滤）\n22\t_STOP_WORDS = frozenset({\n23\t    \"a\", \"an\", \"the\", \"is\", \"are\", \"was\", \"were\", \"be\", \"been\", \"being\",\n24\t    \"in\", \"on\", \"at\", \"to\", \"for\", \"of\", \"with\", \"and\", \"or\", \"not\",\n25\t    \"it\", \"this\", \"that\", \"from\", \"by\", \"as\", \"its\", \"we\", \"our\", \"via\",\n26\t    \"towards\", \"toward\", \"than\", \"into\", \"over\", \"under\", \"about\",\n27\t})\n28\t\n29\t\n30\tdef _title_to_query(title: str) -> str:\n31\t    \"\"\"将论文标题转换为 findpapers 布尔查询。\n32\t\n33\t    例：'Last layer retraining is sufficient for robustness to spurious correlations'\n34\t    → '[retraining] AND [robustness] AND [spurious correlations]'\n35\t    \"\"\"\n36\t    import re\n37\t    words = [w for w in re.findall(r\"[a-zA-Z]+\", title)\n38\t             if w.lower() not in _STOP_WORDS and len(w) > 2]\n39\t    # 取最多 5 个关键词\n40\t    words = words[:5]\n41\t    if not words:\n42\t        return f\"[{title}]\"\n43\t    return \" AND \".join(f\"[{w}]\" for w in words)\n44\t\n45\t\n46\tdef _get_engine():\n47\t    \"\"\"创建 findpapers Engine 实例。\"\"\"\n48\t    import findpapers\n49\t    return findpapers.Engine()\n50\t\n51\t\n52\tdef _search_sync(title: str, databases: list[str], max_results: int) -> list[dict]:\n53\t    \"\"\"同步搜索（在 asyncio.to_thread 中调用）。\n54\t\n55\t    返回与 RelatedPaper 模型兼容的 dict 列表。\n56\t    \"\"\"\n57\t    import findpapers\n58\t\n59\t    engine = _get_engine()\n60\t    query = _title_to_query(title)\n61\t    valid_dbs = [db for db in databases if db.strip().lower() in _VALID_SEARCH_DBS]\n62\t    if not valid_dbs:\n63\t        valid_dbs = [\"arxiv\", \"openalex\"]\n64\t\n65\t    try:\n66\t        result = engine.search(\n67\t            query,\n68\t            databases=valid_dbs,\n69\t            max_papers_per_database=max_results,\n70\t            num_workers=min(len(valid_dbs), 4),\n71\t            show_progress=False,\n72\t        )\n73\t    except Exception as e:\n74\t        logger.warning(f\"findpapers search failed: {e}\")\n75\t        return []\n76\t\n77\t    papers = []\n78\t    for paper in (result.papers if result else []):\n79\t        # 跳过与查询完全相同的论文\n80\t        if paper.title and paper.title.strip().lower() == title.strip().lower():\n81\t            continue\n82\t\n83\t        # 构建 URL：优先 arXiv > DOI > 其他\n84\t        url = \"\"\n85\t        if paper.pdf_url and \"arxiv.org\" in paper.pdf_url:\n86\t            url = paper.pdf_url.replace(\"/pdf/\", \"/abs/\").replace(\".pdf\", \"\")\n87\t        elif paper.doi:\n88\t            url = f\"https://doi.org/{paper.doi}\"\n89\t        elif hasattr(paper, \"url\") and paper.url:\n90\t            url = paper.url\n91\t\n92\t        # 作者列表\n93\t        authors_list = paper.authors or []\n94\t        # findpapers 返回 Author 对象，需要转 str\n95\t        author_names = [str(a) for a in authors_list if a]\n96\t        if len(author_names) > 3:\n97\t            authors = \", \".join(author_names[:3]) + \" et al.\"\n98\t        else:\n99\t            authors = \", \".join(author_names) if author_names else \"\"\n100\t\n101\t        # venue：findpapers 的 paper.source 是 Source 对象，取其 title（刊物名）\n102\t        src = getattr(paper, \"source\", None)\n103\t        venue = (getattr(src, \"title\", \"\") or \"\") if src is not None else \"\"\n104\t\n105\t        papers.append({\n106\t            \"title\": paper.title or \"\",\n107\t            \"authors\": authors,\n108\t            \"venue\": venue,\n109\t            \"year\": paper.publication_date.year if getattr(paper, \"publication_date\", None) else 0,\n110\t            \"doi\": paper.doi or \"\",\n111\t            \"url\": url,\n112\t            \"citation_count\": (paper.citations if isinstance(getattr(paper, \"citations\", None), int) else 0),\n113\t            \"relevance\": \"\",\n114\t        })\n115\t\n116\t        if len(papers) >= max_results:\n117\t            break\n118\t\n119\t    return papers\n120\t\n121\t\n122\tdef _resolve_pdf_sync(title: str, databases: list[str]) -> Optional[str]:\n123\t    \"\"\"同步解析 PDF URL（在 asyncio.to_thread 中调用）。\n124\t\n125\t    通过 findpapers 搜索论文并获取可下载的 PDF URL。\n126\t    利用 findpapers 的三层回退机制：直接 URL → 着陆页 → 出版商模式。\n127\t    \"\"\"\n128\t    import findpapers\n129\t\n130\t    engine = _get_engine()\n131\t    query = _title_to_query(title)\n132\t    valid_dbs = [db for db in databases if db.strip().lower() in _VALID_SEARCH_DBS]\n133\t    if not valid_dbs:\n134\t        valid_dbs = [\"arxiv\", \"openalex\"]\n135\t\n136\t    try:\n137\t        result = engine.search(\n138\t            query,\n139\t            databases=valid_dbs,\n140\t            max_papers_per_database=3,\n141\t            num_workers=min(len(valid_dbs), 4),\n142\t            show_progress=False,\n143\t        )\n144\t    except Exception as e:\n145\t        logger.warning(f\"findpapers PDF resolve search failed: {e}\")\n146\t        return None\n147\t\n148\t    if not result or not result.papers:\n149\t        return None\n150\t\n151\t    # 找到标题最匹配的论文\n152\t    best = None\n153\t    best_score = 0.0\n154\t    title_lower = title.strip().lower()\n155\t    for paper in result.papers:\n156\t        if not paper.title:\n157\t            continue\n158\t        p_title = paper.title.strip().lower()\n159\t        # 简单匹配：前 40 字符相同\n160\t        if p_title[:40] == title_lower[:40]:\n161\t            # 检查 PDF URL\n162\t            if paper.pdf_url:\n163\t                return paper.pdf_url\n164\t            best = paper\n165\t            best_score = 1.0\n166\t\n167\t    # 如果没有精确匹配，用第一个有 PDF URL 的\n168\t    if best is None:\n169\t        for paper in result.papers:\n170\t            if paper.pdf_url:\n171\t                return paper.pdf_url\n172\t\n173\t    # 尝试通过 download runner 解析 URL\n174\t    if best and best.doi:\n175\t        try:\n176\t            from findpapers.runners.download_runner import DownloadRunner\n177\t            runner = DownloadRunner(engine)\n178\t            pdf_url = runner._resolve_url(best)\n179\t            if pdf_url:\n180\t                return pdf_url\n181\t        except Exception as e:\n182\t            logger.debug(f\"findpapers download runner failed: {e}\")\n183\t\n184\t    return None\n185\t\n186\t\n187\tasync def search_related_papers(title: str, config: dict) -> list[dict]:\n188\t    \"\"\"异步搜索相关论文（findpapers 版）。\n189\t\n190\t    Args:\n191\t        title: 论文标题\n192\t        config: findpapers 配置 dict（enabled, databases, max_results）\n193\t\n194\t    Returns:\n195\t        RelatedPaper 兼容的 dict 列表\n196\t    \"\"\"\n197\t    databases = config.get(\"databases\", [\"arxiv\", \"crossref\", \"openalex\", \"pubmed\"])\n198\t    max_results = config.get(\"max_results\", 10)\n199\t\n200\t    return await asyncio.to_thread(\n201\t        _search_sync, title, databases, max_results\n202\t    )\n203\t\n204\t\n205\tasync def resolve_pdf_url(title: str, config: dict) -> Optional[str]:\n206\t    \"\"\"异步解析论文 PDF URL（findpapers 版）。\n207\t\n208\t    Args:\n209\t        title: 论文标题\n210\t        config: findpapers 配置 dict\n211\t\n212\t    Returns:\n213\t        PDF URL 或 None\n214\t    \"\"\"\n215\t    databases = config.get(\"databases\", [\"arxiv\", \"crossref\", \"openalex\", \"pubmed\"])\n216\t\n217\t    return await asyncio.to_thread(\n218\t        _resolve_pdf_sync, title, databases\n219\t    )\n220\t"}]},"parent_tool_use_id":"call_14fbefec6f4c427bbf12da10","session_id":"29257b8f-ede7-46a4-8e0f-a743591d296a","uuid":"3d3a4e08-f903-48bd-9077-09ea6aac67ea","timestamp":"2026-06-09T05:10:32.734Z","subagent_type":"Explore","task_description":"Explore backend performance"}
