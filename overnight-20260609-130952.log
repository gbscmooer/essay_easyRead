{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call_2df5834498c14fa4af7795c4","type":"tool_result","content":"1\timport type { GraphNode } from '@/types'\n2\timport { Link } from 'react-router-dom'\n3\t\n4\tinterface NodeDetailProps {\n5\t  node: GraphNode | null\n6\t  onClose: () => void\n7\t}\n8\t\n9\texport function NodeDetail({ node, onClose }: NodeDetailProps) {\n10\t  if (!node) return null\n11\t\n12\t  return (\n13\t    <div className=\"fixed inset-0 z-50 flex justify-end\" onClick={onClose}>\n14\t      <div className=\"absolute inset-0 bg-black/30\" />\n15\t      <div\n16\t        className=\"relative w-80 h-full overflow-y-auto p-5 space-y-4\"\n17\t        style={{ backgroundColor: 'var(--bg-surface)', borderLeft: '1px solid var(--border)' }}\n18\t        onClick={e => e.stopPropagation()}\n19\t      >\n20\t        <div className=\"flex items-center justify-between\">\n21\t          <h3 className=\"text-sm font-semibold\" style={{ color: 'var(--text-primary)' }}>节点详情</h3>\n22\t          <button\n23\t            onClick={onClose}\n24\t            className=\"text-xs px-2 py-1 rounded transition-colors\"\n25\t            style={{ color: 'var(--text-muted)' }}\n26\t          >\n27\t            关闭\n28\t          </button>\n29\t        </div>\n30\t\n31\t        <div className=\"space-y-3\">\n32\t          <div>\n33\t            <span className=\"text-[10px] uppercase tracking-wider\" style={{ color: 'var(--text-muted)' }}>类型</span>\n34\t            <p className=\"text-sm\" style={{ color: 'var(--text-secondary)' }}>{node.kind}</p>\n35\t          </div>\n36\t\n37\t          <div>\n38\t            <span className=\"text-[10px] uppercase tracking-wider\" style={{ color: 'var(--text-muted)' }}>标签</span>\n39\t            <p className=\"text-sm font-medium\" style={{ color: 'var(--text-primary)' }}>{node.label}</p>\n40\t          </div>\n41\t\n42\t          {node.meta.paper_id && (\n43\t            <div>\n44\t              <span className=\"text-[10px] uppercase tracking-wider\" style={{ color: 'var(--text-muted)' }}>论文 ID</span>\n45\t              <p className=\"text-sm\" style={{ color: 'var(--text-secondary)' }}>#{node.meta.paper_id}</p>\n46\t            </div>\n47\t          )}\n48\t\n49\t          {node.meta.year && (\n50\t            <div>\n51\t              <span className=\"text-[10px] uppercase tracking-wider\" style={{ color: 'var(--text-muted)' }}>年份</span>\n52\t              <p className=\"text-sm\" style={{ color: 'var(--text-secondary)' }}>{node.meta.year}</p>\n53\t            </div>\n54\t          )}\n55\t\n56\t          {node.meta.venue && (\n57\t            <div>\n58\t              <span className=\"text-[10px] uppercase tracking-wider\" style={{ color: 'var(--text-muted)' }}>会议/期刊</span>\n59\t              <p className=\"text-sm\" style={{ color: 'var(--text-secondary)' }}>{node.meta.venue}</p>\n60\t            </div>\n61\t          )}\n62\t\n63\t          {node.meta.source && (\n64\t            <div>\n65\t              <span className=\"text-[10px] uppercase tracking-wider\" style={{ color: 'var(--text-muted)' }}>来源</span>\n66\t              <p className=\"text-sm\" style={{ color: 'var(--text-secondary)' }}>\n67\t                {node.meta.source === 'uploaded' ? '用户上传' : '联网扩展'}\n68\t              </p>\n69\t            </div>\n70\t          )}\n71\t\n72\t          {typeof node.meta.importance === 'number' && (\n73\t            <div>\n74\t              <span className=\"text-[10px] uppercase tracking-wider\" style={{ color: 'var(--text-muted)' }}>影响力 (PageRank)</span>\n75\t              <div className=\"flex items-center gap-2 mt-1\">\n76\t                <div className=\"flex-1 h-1.5 rounded-full overflow-hidden\" style={{ backgroundColor: 'var(--border)' }}>\n77\t                  <div className=\"h-full rounded-full\" style={{ width: `${Math.round(node.meta.importance * 100)}%`, backgroundColor: 'var(--accent)' }} />\n78\t                </div>\n79\t                <span className=\"text-xs tabular-nums\" style={{ color: 'var(--text-secondary)' }}>\n80\t                  {(node.meta.importance * 100).toFixed(0)}%\n81\t                </span>\n82\t              </div>\n83\t            </div>\n84\t          )}\n85\t\n86\t          {node.meta.cluster_label && (\n87\t            <div>\n88\t              <span className=\"text-[10px] uppercase tracking-wider\" style={{ color: 'var(--text-muted)' }}>研究子方向</span>\n89\t              <p className=\"text-sm\" style={{ color: 'var(--text-secondary)' }}>{node.meta.cluster_label}</p>\n90\t            </div>\n91\t          )}\n92\t\n93\t          {node.meta.paper_id && (\n94\t            <Link\n95\t              to={`/reader/${node.meta.paper_id}`}\n96\t              className=\"block w-full text-center py-2 text-xs font-medium rounded-lg transition-colors mt-4\"\n97\t              style={{ backgroundColor: 'var(--accent-subtle)', color: 'var(--accent)' }}\n98\t            >\n99\t              查看论文分析 &rarr;\n100\t            </Link>\n101\t          )}\n102\t        </div>\n103\t      </div>\n104\t    </div>\n105\t  )\n106\t}\n107\t"}]},"parent_tool_use_id":"call_bddd82a75f2e46b98e4517cc","session_id":"29257b8f-ede7-46a4-8e0f-a743591d296a","uuid":"c1766c1c-907d-4daf-9c0d-03f16cbd9f75","timestamp":"2026-06-09T05:10:53.507Z","subagent_type":"Explore","task_description":"Explore frontend performance"}
