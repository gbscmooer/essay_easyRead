{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call_499135ccc6f549659ab39b66","type":"tool_result","content":"1\timport { useEffect, useState, useCallback, useRef } from 'react'\n2\timport { useParams, useNavigate, useLocation } from 'react-router-dom'\n3\timport type { Paper } from '@/types'\n4\timport { listPapers, deletePaper } from '@/api/papers'\n5\timport { useAnalysis } from '@/hooks/useAnalysis'\n6\timport { toast } from '@/hooks/useToast'\n7\timport { useUIConfig } from '@/hooks/useConfig'\n8\timport { Sidebar } from '@/components/Sidebar'\n9\timport { PdfViewer } from '@/features/viewer/PdfViewer'\n10\timport type { PdfViewerHandle } from '@/features/viewer/PdfViewer'\n11\timport { AnalysisPanel } from '@/features/analysis/AnalysisPanel'\n12\t\n13\t\n14\tconst MIN_PANEL_PCT = 20\n15\tconst MAX_PANEL_PCT = 60\n16\tconst DEFAULT_PANEL_PCT = 35\n17\t\n18\t\n19\texport default function ReaderPage() {\n20\t  const { id } = useParams<{ id: string }>()\n21\t  const navigate = useNavigate()\n22\t  const location = useLocation()\n23\t  const uiConfig = useUIConfig()\n24\t  const paperId = id ? Number(id) : undefined\n25\t  const autoAnalyzeRef = useRef((location.state as { autoAnalyze?: boolean })?.autoAnalyze ?? false)\n26\t\n27\t  const [papers, setPapers] = useState<Paper[]>([])\n28\t  const [papersLoading, setPapersLoading] = useState(true)\n29\t  const [activePage, setActivePage] = useState<number | null>(null)\n30\t  const [sidebarOpen, setSidebarOpen] = useState(false)\n31\t  const [panelOpen, setPanelOpen] = useState(true)\n32\t  const [panelPct, setPanelPct] = useState(DEFAULT_PANEL_PCT)\n33\t  const [focusMode, setFocusMode] = useState(false)\n34\t  const draggingRef = useRef(false)\n35\t  const containerRef = useRef<HTMLDivElement>(null)\n36\t  const pdfViewerRef = useRef<PdfViewerHandle>(null)\n37\t  const onPageChangeNoop = useCallback(() => {}, [])\n38\t  const activeTimerRef = useRef<ReturnType<typeof setTimeout>>()\n39\t\n40\t  const {\n41\t    analysis,\n42\t    status,\n43\t    progressMessage,\n44\t    progress,\n45\t    relatedStatus,\n46\t    partialResult,\n47\t    error,\n48\t    reparse,\n49\t    startAnalysis,\n50\t  } = useAnalysis(paperId)\n51\t\n52\t  useEffect(() => {\n53\t    setPapersLoading(true)\n54\t    listPapers({ per_page: 100 })\n55\t      .then(res => setPapers(res.papers))\n56\t      .catch(() => { toast({ type: 'error', message: '加载论文列表失败' }) })\n57\t      .finally(() => setPapersLoading(false))\n58\t  }, [])\n59\t\n60\t  // Auto-start analysis for freshly uploaded papers\n61\t  useEffect(() => {\n62\t    if (autoAnalyzeRef.current && status === 'idle' && paperId) {\n63\t      autoAnalyzeRef.current = false\n64\t      startAnalysis()\n65\t    }\n66\t  }, [status, paperId, startAnalysis])\n67\t\n68\t  // Focus mode: toggle data attribute + browser fullscreen\n69\t  useEffect(() => {\n70\t    document.documentElement.dataset.focusMode = focusMode ? 'true' : 'false'\n71\t\n72\t    if (focusMode) {\n73\t      document.documentElement.requestFullscreen?.().catch(() => {})\n74\t    } else if (document.fullscreenElement) {\n75\t      document.exitFullscreen?.().catch(() => {})\n76\t    }\n77\t\n78\t    return () => {\n79\t      document.documentElement.dataset.focusMode = 'false'\n80\t    }\n81\t  }, [focusMode])\n82\t\n83\t  // Listen for fullscreen exit (e.g. user presses Esc natively)\n84\t  useEffect(() => {\n85\t    const handleFullscreenChange = () => {\n86\t      if (!document.fullscreenElement && focusMode) {\n87\t        setFocusMode(false)\n88\t      }\n89\t    }\n90\t    document.addEventListener('fullscreenchange', handleFullscreenChange)\n91\t    return () => document.removeEventListener('fullscreenchange', handleFullscreenChange)\n92\t  }, [focusMode])\n93\t\n94\t  // Escape 退出专注模式\n95\t  useEffect(() => {\n96\t    if (!focusMode) return\n97\t    const handleKeyDown = (e: KeyboardEvent) => {\n98\t      if (e.key === 'Escape') setFocusMode(false)\n99\t    }\n100\t    document.addEventListener('keydown', handleKeyDown)\n101\t    return () => document.removeEventListener('keydown', handleKeyDown)\n102\t  }, [focusMode])\n103\t\n104\t  // 拖拽逻辑\n105\t  const handleMouseDown = useCallback((e: React.MouseEvent) => {\n106\t    e.preventDefault()\n107\t    draggingRef.current = true\n108\t    document.body.style.cursor = 'col-resize'\n109\t    document.body.style.userSelect = 'none'\n110\t  }, [])\n111\t\n112\t  const handleTouchStart = useCallback((e: React.TouchEvent) => {\n113\t    e.preventDefault()\n114\t    draggingRef.current = true\n115\t    document.body.style.cursor = 'col-resize'\n116\t    document.body.style.userSelect = 'none'\n117\t  }, [])\n118\t\n119\t  useEffect(() => {\n120\t    const calcPct = (clientX: number) => {\n121\t      if (!containerRef.current) return\n122\t      const rect = containerRef.current.getBoundingClientRect()\n123\t      const x = clientX - rect.left\n124\t      const pct = ((rect.width - x) / rect.width) * 100\n125\t      setPanelPct(Math.min(MAX_PANEL_PCT, Math.max(MIN_PANEL_PCT, pct)))\n126\t    }\n127\t\n128\t    const handleMouseMove = (e: MouseEvent) => {\n129\t      if (!draggingRef.current) return\n130\t      calcPct(e.clientX)\n131\t    }\n132\t\n133\t    const handleTouchMove = (e: TouchEvent) => {\n134\t      if (!draggingRef.current) return\n135\t      calcPct(e.touches[0].clientX)\n136\t    }\n137\t\n138\t    const handleUp = () => {\n139\t      if (draggingRef.current) {\n140\t        draggingRef.current = false\n141\t        document.body.style.cursor = ''\n142\t        document.body.style.userSelect = ''\n143\t      }\n144\t    }\n145\t\n146\t    document.addEventListener('mousemove', handleMouseMove)\n147\t    document.addEventListener('mouseup', handleUp)\n148\t    document.addEventListener('touchmove', handleTouchMove, { passive: false })\n149\t    document.addEventListener('touchend', handleUp)\n150\t    return () => {\n151\t      document.removeEventListener('mousemove', handleMouseMove)\n152\t      document.removeEventListener('mouseup', handleUp)\n153\t      document.removeEventListener('touchmove', handleTouchMove)\n154\t      document.removeEventListener('touchend', handleUp)\n155\t    }\n156\t  }, [])\n157\t\n158\t  useEffect(() => {\n159\t    return () => {\n160\t      if (activeTimerRef.current) clearTimeout(activeTimerRef.current)\n161\t    }\n162\t  }, [])\n163\t\n164\t  const handleOutlineJump = useCallback((page: number) => {\n165\t    pdfViewerRef.current?.jumpToPage(page)\n166\t    setActivePage(page)\n167\t    if (activeTimerRef.current) clearTimeout(activeTimerRef.current)\n168\t    activeTimerRef.current = setTimeout(() => setActivePage(null), uiConfig.highlight_duration)\n169\t  }, [uiConfig.highlight_duration])\n170\t\n171\t  const handleSelect = useCallback((id: number) => {\n172\t    navigate(`/reader/${id}`)\n173\t    setActivePage(null)\n174\t    setSidebarOpen(false)\n175\t  }, [navigate])\n176\t\n177\t  const handleDelete = useCallback(async (id: number) => {\n178\t    try {\n179\t      await deletePaper(id)\n180\t      setPapers(prev => {\n181\t        const remaining = prev.filter(p => p.id !== id)\n182\t        if (id === paperId) {\n183\t          if (remaining.length > 0) {\n184\t            navigate(`/reader/${remaining[0].id}`)\n185\t          } else {\n186\t            navigate('/')\n187\t          }\n188\t        }\n189\t        return remaining\n190\t      })\n191\t    } catch {\n192\t      toast({ type: 'error', message: '删除失败，请重试' })\n193\t    }\n194\t  }, [paperId, navigate])\n195\t\n196\t  const pdfUrl = paperId ? `/api/papers/${paperId}/pdf` : ''\n197\t\n198\t  return (\n199\t    <div ref={containerRef} className=\"flex h-full relative\">\n200\t      {/* Sidebar overlay */}\n201\t      {sidebarOpen && !focusMode && (\n202\t        <div\n203\t          className=\"fixed inset-0 bg-black/40 z-30 lg:hidden\"\n204\t          onClick={() => setSidebarOpen(false)}\n205\t        />\n206\t      )}\n207\t\n208\t      {/* 左侧 Sidebar */}\n209\t      {!focusMode && (\n210\t        <div className={`\n211\t          fixed lg:static inset-y-0 left-0 z-40 overflow-hidden\n212\t          transform transition-all duration-200 ease-in-out\n213\t          ${sidebarOpen ? 'translate-x-0 w-64' : '-translate-x-full lg:translate-x-0 w-0 lg:w-0'}\n214\t        `}>\n215\t          {papersLoading && papers.length === 0 ? (\n216\t            <div className=\"flex flex-col w-64 h-full items-center justify-center\" style={{\n217\t              backgroundColor: 'var(--bg-surface)',\n218\t              borderRight: '1px solid var(--border)',\n219\t            }}>\n220\t              <div className=\"w-5 h-5 border-2 rounded-full animate-spin\" style={{ borderColor: 'var(--border)', borderTopColor: 'var(--accent)' }} role=\"status\">\n221\t                <span className=\"sr-only\">加载中</span>\n222\t              </div>\n223\t            </div>\n224\t          ) : (\n225\t          <Sidebar\n226\t            papers={papers}\n227\t            activeId={paperId ?? null}\n228\t            onSelect={handleSelect}\n229\t            onDelete={handleDelete}\n230\t          />\n231\t          )}\n232\t        </div>\n233\t      )}\n234\t\n235\t      {/* 中间 PDF 阅读区 */}\n236\t      <div className=\"flex-1 flex flex-col min-w-0 relative\">\n237\t        {/* 顶部工具栏 */}\n238\t        {!focusMode && (\n239\t          <div className=\"flex items-center justify-between px-3 py-1.5 shrink-0\" style={{\n240\t            backgroundColor: 'var(--bg-surface)',\n241\t            borderBottom: '1px solid var(--border)',\n242\t          }}>\n243\t            <button\n244\t              onClick={() => setSidebarOpen(v => !v)}\n245\t              aria-label=\"切换侧边栏\"\n246\t              aria-expanded={sidebarOpen}\n247\t              className=\"p-1.5 rounded-md transition-colors\"\n248\t              style={{ color: 'var(--text-muted)' }}\n249\t              title={sidebarOpen ? '收起论文列表' : '展开论文列表'}\n250\t            >\n251\t              <svg className=\"w-5 h-5\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\">\n252\t                <path strokeLinecap=\"round\" strokeLinejoin=\"round\" strokeWidth={1.5}\n253\t                  d={sidebarOpen\n254\t                    ? \"M11 19l-7-7 7-7m8 14l-7-7 7-7\"\n255\t                    : \"M13 5l7 7-7 7M5 5l7 7-7 7\"}\n256\t                />\n257\t              </svg>\n258\t            </button>\n259\t\n260\t            <div />\n261\t\n262\t            <div className=\"flex items-center gap-1\">\n263\t              {/* 专注模式按钮 — 放大镜图标 */}\n264\t              <button\n265\t                onClick={() => setFocusMode(true)}\n266\t                className=\"p-1.5 rounded-md transition-colors\"\n267\t                style={{ color: 'var(--text-muted)' }}\n268\t                title=\"专注模式\"\n269\t              >\n270\t                <svg className=\"w-5 h-5\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\">\n271\t                  <path strokeLinecap=\"round\" strokeLinejoin=\"round\" strokeWidth={1.5}\n272\t                    d=\"M21 21l-5.197-5.197m0 0A7.5 7.5 0 105.196 5.196a7.5 7.5 0 0010.607 10.607zM10.5 7.5v6m3-3h-6\"\n273\t                  />\n274\t                </svg>\n275\t              </button>\n276\t\n277\t              <button\n278\t                onClick={() => setPanelOpen(v => !v)}\n279\t                aria-label=\"切换分析面板\"\n280\t                aria-expanded={panelOpen}\n281\t                className=\"p-1.5 rounded-md transition-colors\"\n282\t                style={{ color: 'var(--text-muted)' }}\n283\t                title={panelOpen ? '收起分析面板' : '展开分析面板'}\n284\t              >\n285\t                <svg className=\"w-5 h-5\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\">\n286\t                  <path strokeLinecap=\"round\" strokeLinejoin=\"round\" strokeWidth={1.5}\n287\t                    d={panelOpen\n288\t                      ? \"M13 5l7 7-7 7M5 5l7 7-7 7\"\n289\t                      : \"M11 19l-7-7 7-7m8 14l-7-7 7-7\"}\n290\t                  />\n291\t                </svg>\n292\t              </button>\n293\t            </div>\n294\t          </div>\n295\t        )}\n296\t\n297\t        {/* PDF 渲染区 */}\n298\t        <div className={`flex-1 overflow-hidden ${focusMode ? '' : 'p-2'}`}>\n299\t          {paperId && (\n300\t            <PdfViewer\n301\t              ref={pdfViewerRef}\n302\t              pdfUrl={pdfUrl}\n303\t              paperId={paperId}\n304\t              activePage={activePage}\n305\t              onPageChange={onPageChangeNoop}\n306\t            />\n307\t          )}\n308\t        </div>\n309\t      </div>\n310\t\n311\t      {/* 可拖拽分割条 */}\n312\t      {panelOpen && !focusMode && (\n313\t        <div\n314\t          onMouseDown={handleMouseDown}\n315\t          onTouchStart={handleTouchStart}\n316\t          className=\"w-1 shrink-0 cursor-col-resize transition-colors relative group z-10\"\n317\t          style={{ backgroundColor: 'var(--border)' }}\n318\t        >\n319\t          <div className=\"absolute inset-y-0 -left-1 -right-1\" />\n320\t        </div>\n321\t      )}\n322\t\n323\t      {/* 右侧 AI 分析面板 */}\n324\t      {!focusMode && (\n325\t        <div\n326\t          className=\"overflow-auto transition-[width] duration-100 ease-out shrink-0\"\n327\t          style={{ width: panelOpen ? `${panelPct}%` : 0, backgroundColor: 'var(--bg-surface)' }}\n328\t        >\n329\t          {panelOpen && (\n330\t            <div className=\"h-full overflow-auto\">\n331\t              {error && status === 'failed' ? (\n332\t                <div className=\"flex flex-col items-center justify-center h-full gap-4 p-6\">\n333\t                  <p className=\"text-sm text-center\" style={{ color: 'var(--error)' }}>{error}</p>\n334\t                  <button\n335\t                    onClick={reparse}\n336\t                    className=\"px-4 py-2 text-sm rounded-lg transition-colors\"\n337\t                    style={{ backgroundColor: 'var(--bg-surface)', color: 'var(--text-secondary)', border: '1px solid var(--border)' }}\n338\t                  >\n339\t                    重试\n340\t                  </button>\n341\t                </div>\n342\t              ) : (\n343\t                <AnalysisPanel\n344\t                  result={analysis}\n345\t                  partialResult={partialResult}\n346\t                  status={status}\n347\t                  progressMessage={progressMessage}\n348\t                  progress={progress}\n349\t                  relatedStatus={relatedStatus}\n350\t                  onJumpToPage={handleOutlineJump}\n351\t                  paperId={paperId}\n352\t                  onStartAnalysis={startAnalysis}\n353\t                  onReanalyze={reparse}\n354\t                />\n355\t              )}\n356\t            </div>\n357\t          )}\n358\t        </div>\n359\t      )}\n360\t\n361\t      {/* 专注模式退出按钮 */}\n362\t      {focusMode && (\n363\t        <button\n364\t          onClick={() => setFocusMode(false)}\n365\t          className=\"fixed top-4 right-4 z-[9999] p-2 rounded-full shadow-lg transition-all opacity-60 hover:opacity-100\"\n366\t          style={{\n367\t            backgroundColor: 'var(--bg-elevated)',\n368\t            border: '1px solid var(--border)',\n369\t            color: 'var(--text-secondary)',\n370\t          }}\n371\t          title=\"退出专注模式 (Esc)\"\n372\t        >\n373\t          <svg className=\"w-5 h-5\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\">\n374\t            <path strokeLinecap=\"round\" strokeLinejoin=\"round\" strokeWidth={1.5}\n375\t              d=\"M9 9V4.5M9 9H4.5M9 9L3.75 3.75M9 15v4.5M9 15H4.5M9 15l-5.25 5.25M15 9h4.5M15 9V4.5M15 9l5.25-5.25M15 15h4.5M15 15v4.5m0-4.5l5.25 5.25\"\n376\t            />\n377\t          </svg>\n378\t        </button>\n379\t      )}\n380\t    </div>\n381\t  )\n382\t}\n383\t"}]},"parent_tool_use_id":"call_bddd82a75f2e46b98e4517cc","session_id":"29