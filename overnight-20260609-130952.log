{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call_3a219795bde34ebeb8ec7481","type":"tool_result","content":"1\timport { useState, useEffect } from 'react'\n2\t\n3\texport interface Toast {\n4\t  id: number\n5\t  type: 'success' | 'error' | 'warning' | 'info'\n6\t  message: string\n7\t  duration?: number\n8\t}\n9\t\n10\ttype ToastInput = Omit<Toast, 'id'>\n11\t\n12\tconst listeners = new Set<(toasts: Toast[]) => void>()\n13\tlet globalToasts: Toast[] = []\n14\tlet nextId = 1\n15\t\n16\tfunction notify() {\n17\t  listeners.forEach(fn => fn([...globalToasts]))\n18\t}\n19\t\n20\texport function toast(input: ToastInput | string) {\n21\t  const t: Toast = typeof input === 'string'\n22\t    ? { id: nextId++, type: 'info', message: input }\n23\t    : { id: nextId++, ...input }\n24\t\n25\t  globalToasts = [...globalToasts, t]\n26\t  notify()\n27\t\n28\t  const duration = t.duration ?? (t.type === 'error' ? 5000 : 3000)\n29\t  if (duration > 0) {\n30\t    setTimeout(() => dismiss(t.id), duration)"}]},"parent_tool_use_id":null,"session_id":"29257b8f-ede7-46a4-8e0f-a743591d296a","uuid":"5bc73115-f45a-4c1b-af9d-94f4472e8e49","timestamp":"2026-06-09T05:13:17.472Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/katisarrow/essay_read/frontend/src/hooks/useToast.ts","content":"import { useState, useEffect } from 'react'\n\nexport interface Toast {\n  id: number\n  type: 'success' | 'error' | 'warning' | 'info'\n  message: string\n  duration?: number\n}\n\ntype ToastInput = Omit<Toast, 'id'>\n\nconst listeners = new Set<(toasts: Toast[]) => void>()\nlet globalToasts: Toast[] = []\nlet nextId = 1\n\nfunction notify() {\n  listeners.forEach(fn => fn([...globalToasts]))\n}\n\nexport function toast(input: ToastInput | string) {\n  const t: Toast = typeof input === 'string'\n    ? { id: nextId++, type: 'info', message: input }\n    : { id: nextId++, ...input }\n\n  globalToasts = [...globalToasts, t]\n  notify()\n\n  const duration = t.duration ?? (t.type === 'error' ? 5000 : 3000)\n  if (duration > 0) {\n    setTimeout(() => dismiss(t.id), duration)","numLines":30,"startLine":1,"totalLines":54}}}
