{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call_3ab99de51d934d05a080cc76","type":"tool_result","content":"1\timport { useEffect, useRef, useState } from 'react'\n2\timport mermaid from 'mermaid'\n3\t\n4\t\n5\t/** 仅剥离事件处理器，保留 SVG 全部结构（包括 foreignObject 文字） */\n6\tfunction stripEventHandlers(svg: string): string {\n7\t  return svg\n8\t    .replace(/\\bon\\w+\\s*=\\s*[\"'][^\"']*[\"']/gi, '')\n9\t    .replace(/\\bon\\w+\\s*=\\s*\\{[^}]*\\}/gi, '')\n10\t}\n11\t\n12\t\n13\tinterface FlowChartProps {\n14\t  chart: string\n15\t}\n16\t\n17\tlet mermaidInitialized = false\n18\t\n19\tfunction initMermaid() {\n20\t  if (!mermaidInitialized) {\n21\t    mermaid.initialize({\n22\t      startOnLoad: false,\n23\t      theme: 'dark',\n24\t      themeVariables: {\n25\t        primaryColor: '#3b82f6',\n26\t        primaryTextColor: '#e5e7eb',\n27\t        primaryBorderColor: '#6b7280',\n28\t        lineColor: '#6b7280',\n29\t        secondaryColor: '#1f2937',\n30\t        tertiaryColor: '#111827',\n31\t        background: '#1f2937',\n32\t        mainBkg: '#1f2937',\n33\t        nodeBorder: '#6b7280',\n34\t        clusterBkg: '#111827',\n35\t        clusterBorder: '#374151',\n36\t        edgeLabelBackground: '#1f2937',\n37\t      },\n38\t    })\n39\t    mermaidInitialized = true\n40\t  }\n41\t}\n42\t\n43\t/**\n44\t * 清洗 Mermaid 输入，修复常见语法问题\n45\t */\n46\tfunction sanitizeMermaid(input: string): string {\n47\t  if (!input) return input\n48\t\n49\t  let chart = input.trim()\n50\t\n51\t  // 确保以 graph TD 或 graph LR 开头\n52\t  if (!chart.startsWith('graph ') && !chart.startsWith('flowchart ')) {\n53\t    chart = 'graph TD\\n' + chart\n54\t  }\n55\t\n56\t  // 处理节点标签中的特殊字符\n57\t  // 将 node[label] 中的括号、引号等特殊字符替换为安全字符\n58\t  chart = chart.replace(/\\[([^\\]]*)\\]/g, (_match, label: string) => {\n59\t    // 清洗标签内容\n60\t    let clean = label\n61\t      .replace(/[(){}（）【】《》<>]/g, '')  // 移除括号\n62\t      .replace(/[\"\"\"']/g, '')                // 移除引号\n63\t      .replace(/\\s+/g, ' ')                  // 合并空格\n64\t      .trim()\n65\t    if (!clean) clean = 'Node'\n66\t    return `[${clean}]`\n67\t  })\n68\t\n69\t  // 修复常见问题：\n70\t  // 1. 确保每行连接符前后有空格\n71\t  chart = chart.replace(/(\\w)-->/g, '$1 -->')\n72\t\n73\t  // 2. 移除行尾多余分号\n74\t  chart = chart.replace(/;\\s*$/gm, '')\n75\t\n76\t  // 3. 确保 graph 声明后有换行\n77\t  chart = chart.replace(/^(graph\\s+\\w+)\\s+(?!\\n)/, '$1\\n')\n78\t\n79\t  return chart\n80\t}\n81\t\n82\texport function FlowChart({ chart }: FlowChartProps) {\n83\t  const containerRef = useRef<HTMLDivElement>(null)\n84\t  const [svg, setSvg] = useState<string>('')\n85\t  const [error, setError] = useState<string | null>(null)\n86\t\n87\t  useEffect(() => {\n88\t    if (!chart || !containerRef.current) return\n89\t\n90\t    initMermaid()\n91\t\n92\t    const sanitized = sanitizeMermaid(chart)\n93\t    const id = `mermaid-${Date.now()}-${Math.random().toString(36).slice(2, 8)}`\n94\t\n95\t    mermaid.render(id, sanitized).then(\n96\t      ({ svg: renderedSvg }) => {\n97\t        setSvg(renderedSvg)\n98\t        setError(null)\n99\t      },\n100\t      (err) => {\n101\t        // 如果清洗后仍然失败，尝试最简化的图表\n102\t        const fallback = 'graph TD\\n    A[Input] --> B[Process]\\n    B --> C[Output]'\n103\t        mermaid.render(id + '-fallback', fallback).then(\n104\t          ({ svg: fallbackSvg }) => {\n105\t            setSvg(fallbackSvg)\n106\t            setError(null)\n107\t          },\n108\t          () => {\n109\t            setError(err?.message || '流程图语法错误')\n110\t            setSvg('')\n111\t          }\n112\t        )\n113\t      }\n114\t    )\n115\t  }, [chart])\n116\t\n117\t  if (error) {\n118\t    return (\n119\t      <div className=\"rounded-lg p-4 overflow-auto\" style={{ backgroundColor: 'var(--bg-elevated)' }}>\n120\t        <p className=\"text-sm mb-2\" style={{ color: 'var(--error)' }}>流程图渲染失败</p>\n121\t        <pre className=\"text-xs whitespace-pre-wrap\" style={{ color: 'var(--text-secondary)' }}>{chart}</pre>\n122\t      </div>\n123\t    )\n124\t  }\n125\t\n126\t  return (\n127\t    <div ref={containerRef} className=\"mermaid rounded-lg p-4 overflow-auto flex justify-center\" style={{ backgroundColor: 'var(--bg-elevated)' }}>\n128\t      {svg ? (\n129\t        <div dangerouslySetInnerHTML={{ __html: stripEventHandlers(svg) }} />\n130\t      ) : (\n131\t        <div className=\"flex items-center justify-center py-8\">\n132\t          <div className=\"w-6 h-6 border-2 rounded-full animate-spin\" style={{ borderColor: 'var(--border-light)', borderTopColor: 'var(--accent)' }} />\n133\t        </div>\n134\t      )}\n135\t    </div>\n136\t  )\n137\t}\n138\t"}]},"parent_tool_use_id":null,"session_id":"29257b8f-ede7-46a4-8e0f-a743591d296a","uuid":"db28859d-2a4b-4a9a-9aca-deb7b8e0dc57","timestamp":"2026-06-09T05:13:11.638Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/katisarrow/essay_read/frontend/src/features/analysis/FlowChart.tsx","content":"import { useEffect, useRef, useState } from 'react'\nimport mermaid from 'mermaid'\n\n\n/** 仅剥离事件处理器，保留 SVG 全部结构（包括 foreignObject 文字） */\nfunction stripEventHandlers(svg: string): string {\n  return svg\n    .replace(/\\bon\\w+\\s*=\\s*[\"'][^\"']*[\"']/gi, '')\n    .replace(/\\bon\\w+\\s*=\\s*\\{[^}]*\\}/gi, '')\n}\n\n\ninterface FlowChartProps {\n  chart: string\n}\n\nlet mermaidInitialized = false\n\nfunction initMermaid() {\n  if (!mermaidInitialized) {\n    mermaid.initialize({\n      startOnLoad: false,\n      theme: 'dark',\n      themeVariables: {\n        primaryColor: '#3b82f6',\n        primaryTextColor: '#e5e7eb',\n        primaryBorderColor: '#6b7280',\n        lineColor: '#6b7280',\n        secondaryColor: '#1f2937',\n        tertiaryColor: '#111827',\n        background: '#1f2937',\n        mainBkg: '#1f2937',\n        nodeBorder: '#6b7280',\n        clusterBkg: '#111827',\n        clusterBorder: '#374151',\n        edgeLabelBackground: '#1f2937',\n      },\n    })\n    mermaidInitialized = true\n  }\n}\n\n/**\n * 清洗 Mermaid 输入，修复常见语法问题\n */\nfunction sanitizeMermaid(input: string): string {\n  if (!input) return input\n\n  let chart = input.trim()\n\n  // 确保以 graph TD 或 graph LR 开头\n  if (!chart.startsWith('graph ') && !chart.startsWith('flowchart ')) {\n    chart = 'graph TD\\n' + chart\n  }\n\n  // 处理节点标签中的特殊字符\n  // 将 node[label] 中的括号、引号等特殊字符替换为安全字符\n  chart = chart.replace(/\\[([^\\]]*)\\]/g, (_match, label: string) => {\n    // 清洗标签内容\n    let clean = label\n      .replace(/[(){}（）【】《》<>]/g, '')  // 移除括号\n      .replace(/[\"\"\"']/g, '')                // 移除引号\n      .replace(/\\s+/g, ' ')                  // 合并空格\n      .trim()\n    if (!clean) clean = 'Node'\n    return `[${clean}]`\n  })\n\n  // 修复常见问题：\n  // 1. 确保每行连接符前后有空格\n  chart = chart.replace(/(\\w)-->/g, '$1 -->')\n\n  // 2. 移除行尾多余分号\n  chart = chart.replace(/;\\s*$/gm, '')\n\n  // 3. 确保 graph 声明后有换行\n  chart = chart.replace(/^(graph\\s+\\w+)\\s+(?!\\n)/, '$1\\n')\n\n  return chart\n}\n\nexport function FlowChart({ chart }: FlowChartProps) {\n  const containerRef = useRef<HTMLDivElement>(null)\n  const [svg, setSvg] = useState<string>('')\n  const [error, setError] = useState<string | null>(null)\n\n  useEffect(() => {\n    if (!chart || !containerRef.current) return\n\n    initMermaid()\n\n    const sanitized = sanitizeMermaid(chart)\n    const id = `mermaid-${Date.now()}-${Math.random().toString(36).slice(2, 8)}`\n\n    mermaid.render(id, sanitized).then(\n      ({ svg: renderedSvg }) => {\n        setSvg(renderedSvg)\n        setError(null)\n      },\n      (err) => {\n        // 如果清洗后仍然失败，尝试最简化的图表\n        const fallback = 'graph TD\\n    A[Input] --> B[Process]\\n    B --> C[Output]'\n        mermaid.render(id + '-fallback', fallback).then(\n          ({ svg: fallbackSvg }) => {\n            setSvg(fallbackSvg)\n            setError(null)\n          },\n          () => {\n            setError(err?.message || '流程图语法错误')\n            setSvg('')\n          }\n        )\n      }\n    )\n  }, [chart])\n\n  if (error) {\n    return (\n      <div className=\"rounded-lg p-4 overflow-auto\" style={{ backgroundColor: 'var(--bg-elevated)' }}>\n        <p className=\"text-sm mb-2\" style={{ color: 'var(--error)' }}>流程图渲染失败</p>\n        <pre className=\"text-xs whitespace-pre-wrap\" style={{ color: 'var(--text-secondary)' }}>{chart}</pre>\n      </div>\n    )\n  }\n\n  return (\n    <div ref={containerRef} className=\"mermaid rounded-lg p-4 overflow-auto flex justify-center\" style={{ backgroundColor: 'var(--bg-elevated)' }}>\n      {svg ? (\n        <div dangerouslySetInnerHTML={{ __html: stripEventHandlers(svg) }} />\n      ) : (\n        <div className=\"flex items-center justify-center py-8\">\n          <div className=\"w-6 h-6 border-2 rounded-full animate-spin\" style={{ borderColor: 'var(--border-light)', borderTopColor: 'var(--accent)' }} />\n        </div>\n      )}\n    </div>\n  )\n}\n","numLines":138,"startLine":1,"totalLines":138}}}
