{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call_ec4cec5e33874036b90a3412","type":"tool_result","content":"1\timport { useEffect, useCallback, useRef } from 'react'\n2\t\n3\tlet helpCallback: (() => void) | null = null\n4\t\n5\texport function setHelpCallback(fn: (() => void) | null) {\n6\t  helpCallback = fn\n7\t}\n8\t\n9\texport function useGlobalShortcuts(navigate: (path: string) => void) {\n10\t  const navRef = useRef(navigate)\n11\t  navRef.current = navigate\n12\t\n13\t  const handleKeyDown = useCallback((e: KeyboardEvent) => {\n14\t    // Skip if user is typing in an input/textarea\n15\t    const target = e.target as HTMLElement\n16\t    const isInput = target.tagName === 'INPUT' || target.tagName === 'TEXTAREA' || target.isContentEditable\n17\t\n18\t    // ? for help — only when not in input\n19\t    if (e.key === '?' && !isInput) {\n20\t      e.preventDefault()\n21\t      helpCallback?.()\n22\t      return\n23\t    }\n24\t\n25\t    // / to focus search — only when not in input\n26\t    if (e.key === '/' && !isInput) {\n27\t      e.preventDefault()\n28\t      const searchInput = document.querySelector<HTMLInputElement>('[data-shortcut-search]')\n29\t      searchInput?.focus()\n30\t      return\n31\t    }\n32\t\n33\t    // mod+N to upload\n34\t    if (e.key === 'n' && (e.metaKey || e.ctrlKey) && !e.shiftKey) {\n35\t      e.preventDefault()\n36\t      navRef.current('/')\n37\t      // Focus the upload zone after navigation\n38\t      setTimeout(() => {\n39\t        const uploadInput = document.querySelector<HTMLInputElement>('[data-shortcut-upload]')\n40\t        uploadInput?.click()\n41\t      }, 100)\n42\t      return\n43\t    }\n44\t  }, [])\n45\t\n46\t  useEffect(() => {\n47\t    document.addEventListener('keydown', handleKeyDown)\n48\t    return () => document.removeEventListener('keydown', handleKeyDown)\n49\t  }, [handleKeyDown])\n50\t}\n51\t"}]},"parent_tool_use_id":"call_bddd82a75f2e46b98e4517cc","session_id":"29257b8f-ede7-46a4-8e0f-a743591d296a","uuid":"edfcaa09-6424-4bf0-8841-a1bc8835beaf","timestamp":"2026-06-09T05:10:33.813Z","subagent_type":"Explore","task_description":"Explore frontend performance"}
