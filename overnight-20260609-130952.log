{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call_0616af4fec9a431daa5b3fb8","type":"tool_result","content":"1\timport { useState, useCallback } from 'react'\n2\timport type { AnalysisResult } from '@/types'\n3\timport { textAction } from '@/api/textAction'\n4\t\n5\t\n6\tinterface InterviewTabProps {\n7\t  result: AnalysisResult\n8\t}\n9\t\n10\t\n11\texport function InterviewTab({ result }: InterviewTabProps) {\n12\t  const [expandedSet, setExpandedSet] = useState<Set<number>>(new Set())\n13\t  const [explanations, setExplanations] = useState<Record<number, string>>({})\n14\t  const [loadingExplain, setLoadingExplain] = useState<Set<number>>(new Set())\n15\t\n16\t  const toggle = (idx: number) => {\n17\t    setExpandedSet(prev => {\n18\t      const next = new Set(prev)\n19\t      if (next.has(idx)) next.delete(idx)\n20\t      else next.add(idx)\n21\t      return next\n22\t    })\n23\t  }\n24\t\n25\t  const handleExplain = useCallback(async (idx: number, q: string, a: string) => {\n26\t    if (explanations[idx]) {\n27\t      // 已有解释，直接展开\n28\t      setExpandedSet(prev => new Set(prev).add(idx))\n29\t      return\n30\t    }\n31\t\n32\t    setLoadingExplain(prev => new Set(prev).add(idx))\n33\t    try {\n34\t      const prompt = `请对以下问答进行更深入的解释，用通俗易懂的语言展开说明，补充背景知识和关键细节：\\n\\n问题：${q}\\n回答：${a}`\n35\t      const res = await textAction(prompt, 'summarize')\n36\t      setExplanations(prev => ({ ...prev, [idx]: res }))\n37\t      setExpandedSet(prev => new Set(prev).add(idx))\n38\t    } catch {\n39\t      setExplanations(prev => ({ ...prev, [idx]: '解释生成失败，请检查配置' }))\n40\t    } finally {\n41\t      setLoadingExplain(prev => {\n42\t        const next = new Set(prev)\n43\t        next.delete(idx)\n44\t        return next\n45\t      })\n46\t    }\n47\t  }, [explanations])\n48\t\n49\t  if (!result.interview_qa || result.interview_qa.length === 0) {\n50\t    return (\n51\t      <div className=\"text-center py-8\" style={{ color: 'var(--text-muted)' }}>\n52\t        <p>暂无问答数据</p>\n53\t      </div>\n54\t    )\n55\t  }\n56\t\n57\t  return (\n58\t    <div className=\"space-y-4\">\n59\t      <p className=\"text-sm\" style={{ color: 'var(--text-secondary)' }}>共 {result.interview_qa.length} 道题</p>\n60\t\n61\t      <div className=\"space-y-3\">\n62\t        {result.interview_qa.map((qa, idx) => {\n63\t          const isExpanded = expandedSet.has(idx)\n64\t          const isLoadingExplain = loadingExplain.has(idx)\n65\t          const explanation = explanations[idx]\n66\t\n67\t          return (\n68\t            <div\n69\t              key={idx}\n70\t              className=\"rounded-lg overflow-hidden\" style={{ backgroundColor: 'var(--bg-elevated)', border: '1px solid var(--border-light)' }}\n71\t            >\n72\t              {/* 问题 */}\n73\t              <button\n74\t                onClick={() => toggle(idx)}\n75\t                className=\"w-full text-left px-4 py-3 flex items-start gap-3 transition-colors\"\n76\t                onMouseEnter={e => { e.currentTarget.style.backgroundColor = 'var(--bg-surface)' }}\n77\t                onMouseLeave={e => { e.currentTarget.style.backgroundColor = '' }}\n78\t              >\n79\t                <span className=\"flex-shrink-0 w-6 h-6 flex items-center justify-center bg-blue-500/20 text-blue-400 rounded-full text-xs font-medium mt-0.5\">\n80\t                  Q{idx + 1}\n81\t                </span>\n82\t                <span className=\"text-sm leading-relaxed flex-1\" style={{ color: 'var(--text-primary)' }}>\n83\t                  {qa.q}\n84\t                </span>\n85\t                <svg\n86\t                  className={`w-4 h-4 shrink-0 mt-1 transition-transform ${isExpanded ? 'rotate-180' : ''}`}\n87\t                  style={{ color: 'var(--text-muted)' }}\n88\t                  fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\"\n89\t                >\n90\t                  <path strokeLinecap=\"round\" strokeLinejoin=\"round\" strokeWidth={2} d=\"M19 9l-7 7-7-7\" />\n91\t                </svg>\n92\t              </button>\n93\t\n94\t              {/* 答案区域 */}\n95\t              {isExpanded && (\n96\t                <div className=\"px-4 pb-4 space-y-3\">\n97\t                  {/* 答案 */}\n98\t                  <div className=\"pl-9\">\n99\t                    <div className=\"flex items-center gap-2 mb-1.5\">\n100\t                      <span className=\"text-xs text-green-400 font-medium\">回答</span>\n101\t                      {qa.source && (\n102\t                        <span className=\"text-xs px-2 py-0.5 rounded\" style={{ color: 'var(--text-muted)', backgroundColor: 'var(--bg-surface)' }}>\n103\t                          {qa.source}\n104\t                        </span>\n105\t                      )}\n106\t                    </div>\n107\t                    <p className=\"text-sm leading-relaxed\" style={{ color: 'var(--text-secondary)' }}>\n108\t                      {qa.a}\n109\t                    </p>\n110\t                  </div>\n111\t\n112\t                  {/* 操作按钮 */}\n113\t                  <div className=\"pl-9 flex items-center gap-2\">\n114\t                    <button\n115\t                      onClick={(e) => {\n116\t                        e.stopPropagation()\n117\t                        handleExplain(idx, qa.q, qa.a)\n118\t                      }}\n119\t                      disabled={isLoadingExplain}\n120\t                      className=\"flex items-center gap-1.5 px-3 py-1.5 text-xs rounded disabled:opacity-50 transition-colors\"\n121\t                      style={{ backgroundColor: 'var(--bg-surface)', color: 'var(--text-secondary)' }}\n122\t                      onMouseEnter={e => { (e.currentTarget as HTMLElement).style.backgroundColor = 'var(--bg-elevated)' }}\n123\t                      onMouseLeave={e => { (e.currentTarget as HTMLElement).style.backgroundColor = 'var(--bg-surface)' }}\n124\t                    >\n125\t                      {isLoadingExplain ? (\n126\t                        <>\n127\t                          <div className=\"w-3 h-3 border rounded-full animate-spin\" style={{ borderColor: 'var(--text-muted)', borderTopColor: 'var(--accent)' }} />\n128\t                          生成中...\n129\t                        </>\n130\t                      ) : (\n131\t                        '进一步解释'\n132\t                      )}\n133\t                    </button>\n134\t                  </div>\n135\t\n136\t                  {/* 解释 */}\n137\t                  {explanation && (\n138\t                    <div className=\"pl-9 bg-blue-500/5 border border-blue-500/20 rounded-lg p-3\">\n139\t                      <p className=\"text-xs text-blue-400 font-medium mb-1\">深入解释</p>\n140\t                      <p className=\"text-xs leading-relaxed whitespace-pre-wrap\" style={{ color: 'var(--text-secondary)' }}>\n141\t                        {explanation}\n142\t                      </p>\n143\t                    </div>\n144\t                  )}\n145\t                </div>\n146\t              )}\n147\t            </div>\n148\t          )\n149\t        })}\n150\t      </div>\n151\t    </div>\n152\t  )\n153\t}\n154\t"}]},"parent_tool_use_id":"call_bddd82a75f2e46b98e4517cc","session_id":"29257b8f-ede7-46a4-8e0f-a743591d296a","uuid":"c4570057-71ce-41b5-b9c5-94521dcbf13c","timestamp":"2026-06-09T05:10:38.828Z","subagent_type":"Explore","task_description":"Explore frontend performance"}
