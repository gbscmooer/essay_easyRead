{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call_9249a5da9d864d93ad0e0ca5","type":"tool_result","content":"1\timport { useState, useEffect, useCallback } from 'react'\n2\timport { useParams, useNavigate, Link } from 'react-router-dom'\n3\timport { getWorkspace, updateWorkspace, addPaperToWorkspace, removePaperFromWorkspace, promotePaper, type WorkspaceDetail, type WorkspacePaper } from '@/api/workspaces'\n4\timport { listPapers } from '@/api/papers'\n5\timport type { Paper } from '@/types'\n6\timport { toast } from '@/hooks/useToast'\n7\t\n8\t\n9\texport default function WorkspaceDetailPage() {\n10\t  const { id } = useParams<{ id: string }>()\n11\t  const navigate = useNavigate()\n12\t  const workspaceId = Number(id)\n13\t\n14\t  const [workspace, setWorkspace] = useState<WorkspaceDetail | null>(null)\n15\t  const [loading, setLoading] = useState(true)\n16\t  const [editing, setEditing] = useState(false)\n17\t  const [editName, setEditName] = useState('')\n18\t  const [showAddPaper, setShowAddPaper] = useState(false)\n19\t  const [libraryPapers, setLibraryPapers] = useState<Paper[]>([])\n20\t  const [loadingPapers, setLoadingPapers] = useState(false)\n21\t  const [selectedDiscovered, setSelectedDiscovered] = useState<Set<number>>(new Set())\n22\t  const [batchLoading, setBatchLoading] = useState(false)\n23\t\n24\t  const refresh = useCallback(() => {\n25\t    if (!workspaceId) return\n26\t    getWorkspace(workspaceId)\n27\t      .then(ws => { setWorkspace(ws); setEditName(ws.name) })\n28\t      .catch(() => navigate('/workspace'))\n29\t      .finally(() => setLoading(false))\n30\t  }, [workspaceId, navigate])\n31\t\n32\t  useEffect(() => { refresh() }, [refresh])\n33\t\n34\t  const handleRename = async () => {\n35\t    const name = editName.trim()\n36\t    if (!name || !workspace) return\n37\t    try {\n38\t      await updateWorkspace(workspace.id, name)\n39\t      setEditing(false)\n40\t      refresh()\n41\t    } catch {\n42\t      toast({ type: 'error', message: '重命名失败' })\n43\t    }\n44\t  }\n45\t\n46\t  const handleShowAddPaper = async () => {\n47\t    setShowAddPaper(true)\n48\t    setLoadingPapers(true)\n49\t    try {\n50\t      const res = await listPapers({ per_page: 100 })\n51\t      // 过滤掉已在工作区中的论文\n52\t      const existingIds = new Set(workspace?.papers.map(p => p.id) || [])\n53\t      setLibraryPapers(res.papers.filter(p => !existingIds.has(p.id)))\n54\t    } catch (e: any) {\n55\t      toast({ type: 'error', message: e?.message || '加载论文列表失败' })\n56\t      setShowAddPaper(false)\n57\t    } finally {\n58\t      setLoadingPapers(false)\n59\t    }\n60\t  }\n61\t\n62\t  const handleAddPaper = async (paperId: number) => {\n63\t    try {\n64\t      await addPaperToWorkspace(workspaceId, paperId)\n65\t      refresh()\n66\t      setLibraryPapers(prev => prev.filter(p => p.id !== paperId))\n67\t    } catch {\n68\t      toast({ type: 'error', message: '添加论文失败' })\n69\t    }\n70\t  }\n71\t\n72\t  const handleRemovePaper = async (paperId: number) => {\n73\t    try {\n74\t      await removePaperFromWorkspace(workspaceId, paperId)\n75\t      refresh()\n76\t    } catch {\n77\t      toast({ type: 'error', message: '移除论文失败' })\n78\t    }\n79\t  }\n80\t\n81\t  const handlePromote = async (paperId: number) => {\n82\t    try {\n83\t      await promotePaper(workspaceId, paperId)\n84\t      refresh()\n85\t    } catch {\n86\t      toast({ type: 'error', message: '升级论文失败' })\n87\t    }\n88\t  }\n89\t\n90\t  const toggleDiscovered = (paperId: number) => {\n91\t    setSelectedDiscovered(prev => {\n92\t      const next = new Set(prev)\n93\t      if (next.has(paperId)) next.delete(paperId); else next.add(paperId)\n94\t      return next\n95\t    })\n96\t  }\n97\t\n98\t  const selectAllDiscovered = () => {\n99\t    setSelectedDiscovered(new Set(discoveredPapers.map(p => p.id)))\n100\t  }\n101\t\n102\t  const deselectAllDiscovered = () => {\n103\t    setSelectedDiscovered(new Set())\n104\t  }\n105\t\n106\t  const handleBatchPromote = async () => {\n107\t    if (selectedDiscovered.size === 0) return\n108\t    setBatchLoading(true)\n109\t    try {\n110\t      const ids = Array.from(selectedDiscovered)\n111\t      // allSettled：部分失败时已成功的不回滚，仍要刷新列表 + 如实汇报失败数\n112\t      const results = await Promise.allSettled(ids.map(id => promotePaper(workspaceId, id)))\n113\t      const failed = results.filter(r => r.status === 'rejected').length\n114\t      setSelectedDiscovered(new Set())\n115\t      refresh()\n116\t      if (failed === 0) toast({ type: 'success', message: `已移入 ${ids.length} 篇论文` })\n117\t      else toast({ type: 'error', message: `${ids.length - failed} 篇已移入，${failed} 篇失败` })\n118\t    } finally {\n119\t      setBatchLoading(false)\n120\t    }\n121\t  }\n122\t\n123\t  const handleBatchRemove = async () => {\n124\t    if (selectedDiscovered.size === 0) return\n125\t    if (!confirm(`确定从工作区移除选中的 ${selectedDiscovered.size} 篇论文？`)) return\n126\t    setBatchLoading(true)\n127\t    try {\n128\t      const ids = Array.from(selectedDiscovered)\n129\t      const results = await Promise.allSettled(ids.map(id => removePaperFromWorkspace(workspaceId, id)))\n130\t      const failed = results.filter(r => r.status === 'rejected').length\n131\t      setSelectedDiscovered(new Set())\n132\t      refresh()\n133\t      if (failed === 0) toast({ type: 'success', message: `已移除 ${ids.length} 篇论文` })\n134\t      else toast({ type: 'error', message: `${ids.length - failed} 篇已移除，${failed} 篇失败` })\n135\t    } finally {\n136\t      setBatchLoading(false)\n137\t    }\n138\t  }\n139\t\n140\t  const l1Papers = (workspace?.papers ?? []).filter(p => (p.level ?? 1) === 1)\n141\t  const discoveredPapers = (workspace?.papers ?? []).filter(p => (p.level ?? 1) >= 2)\n142\t\n143\t  if (loading || !workspace) {\n144\t    return (\n145\t      <div className=\"flex items-center justify-center h-64\">\n146\t        <div className=\"w-6 h-6 border-2 rounded-full animate-spin\" style={{ borderColor: 'var(--border-light)', borderTopColor: 'var(--accent)' }}  role=\"status\"><span className=\"sr-only\">加载中</span></div>\n147\t      </div>\n148\t    )\n149\t  }\n150\t\n151\t  return (\n152\t    <div className=\"max-w-3xl mx-auto px-6 py-8\">\n153\t      {/* 返回按钮 */}\n154\t      <Link\n155\t        to=\"/workspace\"\n156\t        className=\"inline-flex items-center gap-1.5 text-sm transition-colors mb-4\"\n157\t        style={{ color: 'var(--text-muted)' }}\n158\t        onMouseEnter={e => { (e.currentTarget as HTMLElement).style.color = 'var(--text-secondary)' }}\n159\t        onMouseLeave={e => { (e.currentTarget as HTMLElement).style.color = 'var(--text-muted)' }}\n160\t      >\n161\t        <svg className=\"w-4 h-4\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\">\n162\t          <path strokeLinecap=\"round\" strokeLinejoin=\"round\" strokeWidth={2} d=\"M15 19l-7-7 7-7\" />\n163\t        </svg>\n164\t        返回工作区\n165\t      </Link>\n166\t\n167\t      {/* 标题 */}\n168\t      <div className=\"mb-6\">\n169\t        {editing ? (\n170\t          <div className=\"flex items-center gap-2\">\n171\t            <input\n172\t              type=\"text\"\n173\t              value={editName}\n174\t              onChange={e => setEditName(e.target.value)}\n175\t              onKeyDown={e => e.key === 'Enter' && handleRename()}\n176\t              className=\"flex-1 px-3 py-1.5 text-lg rounded-lg focus:outline-none\"\n177\t              style={{\n178\t                backgroundColor: 'var(--bg-elevated)',\n179\t                border: '1px solid var(--border)',\n180\t                color: 'var(--text-primary)',\n181\t              }}\n182\t              autoFocus\n183\t            />\n184\t            <button onClick={handleRename} className=\"px-3 py-1.5 text-sm rounded-lg transition-colors\" style={{ backgroundColor: 'var(--accent)', color: 'var(--bg-base)' }}>保存</button>\n185\t            <button onClick={() => { setEditing(false); setEditName(workspace.name) }} className=\"px-3 py-1.5 text-sm transition-colors\" style={{ color: 'var(--text-muted)' }}>取消</button>\n186\t          </div>\n187\t        ) : (\n188\t          <div className=\"flex items-center gap-3\">\n189\t            <h1\n190\t              className=\"text-xl font-bold cursor-pointer transition-colors\"\n191\t              style={{ color: 'var(--text-primary)' }}\n192\t              role=\"button\"\n193\t              tabIndex={0}\n194\t              onMouseEnter={e => { (e.currentTarget as HTMLElement).style.color = 'var(--accent)' }}\n195\t              onMouseLeave={e => { (e.currentTarget as HTMLElement).style.color = 'var(--text-primary)' }}\n196\t              onClick={() => setEditing(true)}\n197\t              onKeyDown={e => { if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); setEditing(true) } }}\n198\t            >\n199\t              {workspace.name}\n200\t            </h1>\n201\t            <button\n202\t              onClick={() => setEditing(true)}\n203\t              className=\"text-xs transition-colors\"\n204\t              style={{ color: 'var(--text-muted)' }}\n205\t              onMouseEnter={e => { (e.currentTarget as HTMLElement).style.color = 'var(--text-secondary)' }}\n206\t              onMouseLeave={e => { (e.currentTarget as HTMLElement).style.color = 'var(--text-muted)' }}\n207\t            >\n208\t              重命名\n209\t            </button>\n210\t          </div>\n211\t        )}\n212\t        <p className=\"text-sm mt-1\" style={{ color: 'var(--text-muted)' }}>\n213\t          {l1Papers.length} 篇本地论文\n214\t          {discoveredPapers.length > 0 && ` · ${discoveredPapers.length} 篇深度研究发现`}\n215\t        </p>\n216\t      </div>\n217\t\n218\t      {/* 添加论文 + 深度研究入口 */}\n219\t      <div className=\"flex items-center gap-3 mb-4\">\n220\t        <button\n221\t          onClick={handleShowAddPaper}\n222\t          className=\"px-4 py-2 text-sm rounded-lg transition-colors shrink-0\"\n223\t          style={{\n224\t            backgroundColor: 'var(--bg-elevated)',\n225\t            border: '1px solid var(--border)',\n226\t            color: 'var(--text-secondary)',\n227\t          }}\n228\t        >\n229\t          + 从论文库添加\n230\t        </button>\n231\t\n232\t        <button\n233\t          onClick={() => navigate(`/workspace/${workspaceId}/research`)}\n234\t          disabled={workspace.papers.length === 0}\n235\t          className=\"flex-1 group relative overflow-hidden px-6 py-3 rounded-xl border-2 transition-all disabled:opacity-50 disabled:cursor-not-allowed\"\n236\t          style={{\n237\t            borderColor: 'var(--accent)',\n238\t            background: 'linear-gradient(135deg, var(--accent-subtle), transparent)',\n239\t            color: 'var(--accent)',\n240\t          }}\n241\t          onMouseEnter={e => {\n242\t            if (workspace.papers.length === 0) return\n243\t            e.currentTarget.style.boxShadow = '0 4px 16px rgba(0,0,0,0.12)'\n244\t            e.currentTarget.style.transform = 'translateY(-1px)'\n245\t          }}\n246\t          onMouseLeave={e => {\n247\t            e.currentTarget.style.boxShadow = 'none'\n248\t            e.currentTarget.style.transform = 'none'\n249\t          }}\n250\t        >\n251\t          <div className=\"flex items-center justify-between\">\n252\t            <div className=\"flex items-center gap-3\">\n253\t              <span className=\"text-2xl\">⚡</span>\n254\t              <div className=\"text-left\">\n255\t                <div className=\"text-base font-semibold leading-tight\">深度研究</div>\n256\t                <div className=\"text-[11px] mt-0.5 opacity-80\">\n257\t                  跨论文构建知识图谱 · RAG 问答\n258\t                </div>\n259\t              </div>\n260\t            </div>\n261\t            <span className=\"text-xl opacity-60 group-hover:translate-x-1 transition-transform\">→</span>\n262\t          </div>\n263\t        </button>\n264\t      </div>\n265\t\n266\t      {/* 添加论文面板 */}\n267\t      {showAddPaper && (\n268\t        <div className=\"mb-6 rounded-lg p-4\" style={{ backgroundColor: 'var(--bg-elevated)', border: '1px solid var(--border-light)' }}>\n269\t          <div className=\"flex items-center justify-between mb-3\">\n270\t            <h3 className=\"text-sm font-medium\" style={{ color: 'var(--text-secondary)' }}>选择论文添加到工作区</h3>\n271\t            <button onClick={() => setShowAddPaper(false)} className=\"text-xs\" style={{ color: 'var(--text-muted)' }} onMouseEnter={e => { (e.currentTarget as HTMLElement).style.color = 'var(--text-secondary)' }} onMouseLeave={e => { (e.currentTarget as HTMLElement).style.color = 'var(--text-muted)' }}>关闭</button>\n272\t          </div>\n273\t          {loadingPapers ? (\n274\t            <div className=\"flex justify-center py-4\">\n275\t              <div className=\"w-5 h-5 border-2 rounded-full animate-spin\" style={{ borderColor: 'var(--border-light)', borderTopColor: 'var(--accent)' }}  role=\"status\"><span className=\"sr-only\">加载中</span></div>\n276\t            </div>\n277\t          ) : libraryPapers.length === 0 ? (\n278\t            <p className=\"text-xs text-center py-4\" style={{ color: 'var(--text-muted)' }}>没有可添加的论文</p>\n279\t          ) : (\n280\t            <div className=\"max-h-60 overflow-auto space-y-2\">\n281\t              {libraryPapers.map(paper => (\n282\t                <div key={paper.id} className=\"flex items-center justify-between px-3 py-2 rounded transition-colors\" style={{ backgroundColor: 'var(--bg-surface)' }} onMouseEnter={e => { e.currentTarget.style.backgroundColor = 'var(--bg-elevated)' }} onMouseLeave={e => { e.currentTarget.style.backgroundColor = 'var(--bg-surface)' }}>\n283\t                  <div className=\"min-w-0 flex-1\">\n284\t                    <p className=\"text-sm truncate\" style={{ color: 'var(--text-secondary)' }}>{paper.title || paper.filename}</p>\n285\t                    {paper.venue && <p className=\"text-xs\" style={{ color: 'var(--text-muted)' }}>{paper.venue} {paper.year || ''}</p>}\n286\t                  </div>\n287\t                  <button\n288\t                    onClick={() => handleAddPaper(paper.id)}\n289\t                    className=\"ml-3 px-2 py-1 text-xs rounded transition-colors shrink-0\"\n290\t                    style={{ backgroundColor: 'var(--accent-subtle)', color: 'var(--accent)' }}\n291\t                  >\n292\t                    添加\n293\t                  </button>\n294\t                </div>\n295\t              ))}\n296\t            </div>\n297\t          )}\n298\t        </div>\n299\t      )}\n300\t\n301\t      {/* 本地论文 (L1) */}\n302\t      {l1Papers.length === 0 && discoveredPapers.length === 0 ? (\n303\t        <div className=\"text-center py-12\">\n304\t          <p style={{ color: 'var(--text-muted)' }}>工作区暂无论文</p>\n305\t          <p className=\"text-xs mt-1 mb-4\" style={{ color: 'var(--text-muted)', opacity: 0.7 }}>点击\"从论文库添加\"将论文加入工作区</p>\n306\t          <button\n307\t            onClick={handleShowAddPaper}\n308\t            className=\"px-4 py-2 text-sm rounded-lg transition-colors\"\n309\t            style={{ backgroundColor: 'var(--accent)', color: 'var(--bg-base)' }}\n310\t          >\n311\t            + 从论文库添加\n312\t          </button>\n313\t        </div>\n314\t      ) : (\n315\t        <>\n316\t          {l1Papers.length > 0 && (\n317\t            <div className=\"space-y-3\">\n318\t              {l1Papers.map(paper => (\n319\t                <PaperCard\n320\t                  key={paper.id}\n321\t                  paper={paper}\n322\t                  workspaceId={workspaceId}\n323\t                  variant=\"local\"\n324\t                  onNavigate={() => navigate(`/reader/${paper.id}`, { state: { from: `/workspace/${workspaceId}` } })}\n325\t                  onRemove={() => handleRemovePaper(paper.id)}\n326\t                />\n327\t              ))}\n328\t            </div>\n329\t          )}\n330\t\n331\t          {/* 深度研究发现 (L2+) */}\n332\t          {discoveredPapers.length > 0 && (\n333\t            <div className=\"mt-8\">\n334\t              <div className=\"flex items-center justify-between mb-3\">\n335\t                <div className=\"flex items-center gap-2\">\n336\t                  <h2 className=\"text-sm font-semibold\" style={{ color: 'var(--text-secondary)' }}>\n337\t                    通过深度研究搜索到的相关论文\n338\t                  </h2>\n339\t                  <span className=\"text-[10px] px-1.5 py-0.5 rounded-full\" style={{ backgroundColor: 'var(--accent-subtle)', color: 'var(--accent)' }}>\n340\t                    {discoveredPapers.length}\n341\t                  </span>\n342\t                </div>\n343\t                <div className=\"flex items-center gap-2\">\n344\t                  {selectedDiscovered.size > 0 ? (\n345\t                    <>\n346\t                      <span className=\"text-[10px]\" style={{ color: 'var(--text-muted)' }}>\n347\t                        已选 {selectedDiscovered.size} 篇\n348\t                      </span>\n349\t                      <button\n350\t                        onClick={handleBatchPromote}\n351\t                        disabled={batchLoading}\n352\t                        className=\"px-2.5 py-1 text-xs rounded-md transition-colors disabled:opacity-50\"\n353\t                        style={{ backgroundColor: 'var(--accent)', color: 'var(--bg-base)' }}\n354\t                      >\n355\t                        {batchLoading ? '移入中…' : '批量移入工作区'}\n356\t                      </button>\n357\t                      <button\n358\t                        onClick={handleBatchRemove}\n359\t                        disabled={batchLoading}\n360\t                        className=\"px-2.5 py-1 text-xs rounded-md border transition-colors disabled:opacity-50\"\n361\t                        style={{ borderColor: 'var(--error)', color: 'var(--error)' }}\n362\t                      >\n363\t                        {batchLoading ? '移除中…' : '批量移除'}\n364\t                      </button>\n365\t                      <button\n366\t                        onClick={deselectAllDiscovered}\n367\t                        className=\"text-xs transition-colors\"\n368\t                        style={{ color: 'var(--text-muted)' }}\n369\t                      >\n370\t                        取消选择\n371\t                      </button>\n372\t                    </>\n373\t                  ) : (\n374\t                    <button\n375\t                      onClick={selectAllDiscovered}\n376\t                      className=\"text-xs transition-colors\"\n377\t                      style={{ color: 'var(--text-muted)' }}\n378\t                    >\n379\t                      全选\n380\t                    </button>\n381\t                  )}\n382\t                </div>\n383\t              </div>\n384\t              <p className=\"text-xs mb-3\" style={{ color: 'var(--text-muted)' }}>\n385\t                这些论文已索引、可参与跨论文检索；点击\"移入工作区\"可将其升级为本地正式论文（参与下一轮研究的 seed）。\n386\t              </p>\n387\t              <div className=\"space-y-3\">\n388\t                {discoveredPapers.map(paper => (\n389\t                  <PaperCard\n390\t                    key={paper.id}\n391\t                    paper={paper}\n392\t                    workspaceId={workspaceId}\n393\t                    variant=\"discovered\"\n394\t                    selected={selectedDiscovered.has(paper.id)}\n395\t                    onToggleSelect={() => toggleDiscovered(paper.id)}\n396\t                    onNavigate={() => navigate(`/reader/${paper.id}`, { state: { from: `/workspace/${workspaceId}` } })}\n397\t                    onRemove={() => handleRemovePaper(paper.id)}\n398\t                    onPromote={() => handlePromote(paper.id)}\n399\t                  />\n400\t                ))}\n401\t              </div>\n402\t            </div>\n403\t          )}\n404\t        </>\n405\t      )}\n406\t    </div>\n407\t  )\n408\t}\n409\t\n410\t\n411\tinterface PaperCardProps {\n412\t  paper: WorkspacePaper\n413\t  workspaceId: number\n414\t  variant: 'local' | 'discovered'\n415\t  selected?: boolean\n416\t  onToggleSelect?: () => void\n417\t  onNavigate: () => void\n418\t  onRemove: () => void\n419\t  onPromote?: () => void\n420\t}\n421\t\n422\tfunction PaperCard({ paper, workspaceId, variant, selected, onToggleSelect, onNavigate, onRemove, onPromote }: PaperCardProps) {\n423\t  const isDiscovered = variant === 'discovered'\n424\t  return (\n425\t    <div\n426\t      className=\"rounded-lg p-4 group transition-all cursor-pointer border\"\n427\t      style={{\n428\t        backgroundColor: isDiscovered ? 'transparent' : 'var(--bg-surface)',\n429\t        borderColor: selected ? 'var(--accent)' : 'var(--border)',\n430\t        borderStyle: isDiscovered ? 'dashed' : 'solid',\n431\t        boxShadow: selected ? '0 0 0 1px var(--accent)' : 'none',\n432\t      }}\n433\t      role=\"button\"\n434\t      tabIndex={0}\n435\t      onClick={onNavigate}\n436\t      onKeyDown={e => { if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); onNavigate() } }}\n437\t      onMouseEnter={e => {\n438\t        if (!selected) e.currentTarget.style.borderColor = 'var(--border-light)'\n439\t        e.currentTarget.style.boxShadow = selected ? '0 0 0 1px var(--accent)' : '0 2px 8px rgba(0,0,0,0.08)'\n440\t      }}\n441\t      onMouseLeave={e => {\n442\t        if (!selected) e.currentTarget.style.borderColor = 'var(--border)'\n443\t        e.currentTarget.style.boxShadow = selected ? '0 0 0 1px var(--accent)' : 'none'\n444\t      }}\n445\t    >\n446\t      <div className=\"flex items-start justify-between\">\n447\t        {/* Checkbox for discovered papers */}\n448\t        {isDiscovered && onToggleSelect && (\n449\t          <div\n450\t            className=\"shrink-0 mr-3 mt-0.5\"\n451\t            onClick={e => { e.stopPropagation(); onToggleSelect() }}\n452\t          >\n453\t            <div\n454\t              className=\"w-4 h-4 rounded border flex items-center justify-center transition-colors\"\n455\t              style={{\n456\t                borderColor: selected ? 'var(--accent)' : 'var(--border)',\n457\t                backgroundColor: selected ? 'var(--accent)' : 'transparent',\n458\t              }}\n459\t            >\n460\t              {selected && (\n461\t                <svg className=\"w-3 h-3\" fill=\"none\" stroke=\"var(--bg-base)\" viewBox=\"0 0 24 24\" strokeWidth={3}>\n462\t                  <path strokeLinecap=\"round\" strokeLinejoin=\"round\" d=\"M5 13l4 4L19 7\" />\n463\t                </svg>\n464\t              )}\n465\t            </div>\n466\t          </div>\n467\t        )}\n468\t        <div className=\"min-w-0 flex-1\">\n469\t          <p className=\"text-sm font-medium transition-colors\" style={{ color: 'var(--text-primary)' }}>\n470\t            {paper.title || paper.filename}\n471\t          </p>\n472\t          <div className=\"flex items-center gap-3 mt-1 flex-wrap\">\n473\t            {paper.venue && <span className=\"text-xs\" style={{ color: 'var(--text-muted)' }}>{paper.venue} {paper.year || ''}</span>}\n474\t            <span className={`text-xs px-1.5 py-0.5 rounded ${\n475\t              paper.status === 'done' ? 'bg-green-500/10 text-green-400' :\n476\t              paper.status === 'indexed' ? 'bg-amber-500/10 text-amber-400' :\n477\t              paper.status === 'failed' ? 'bg-red-500/10 text-red-400' :\n478\t              'var(--bg-surface)'\n479\t            }`}>\n480\t              {paper.status === 'done' ? '已解析' :\n481\t               paper.status === 'indexed' ? '未解析·已索引' :\n482\t               paper.status === 'failed' ? '失败' : '待解析'}\n483\t            </span>\n484\t            {isDiscovered && (\n485\t              <span\n486\t                className=\"text-[10px] px-1.5 py-0.5 rounded border\"\n487\t                style={{ borderColor: 'var(--border)', color: 'var(--text-muted)' }}\n488\t                title=\"联网扩展下载的论文（未经 LLM 深度解析）\"\n489\t              >\n490\t                L{paper.level} · 扩展\n491\t              </span>\n492\t            )}\n493\t          </div>\n494\t          <div className=\"flex items-center gap-2 mt-2\">\n495\t            <Link\n496\t              to={`/reader/${paper.id}`}\n497\t              state={{ from: `/workspace/${workspaceId}` }}\n498\t              onClick={e => e.stopPropagation()}\n499\t              className=\"text-xs text-blue-400 hover:text-blue-300 transition-colors\"\n500\t            >\n501\t              论文分析\n502\t            </Link>\n503\t            {paper.code_url && (\n504\t              <Link\n505\t                to={`/code/${paper.id}`}\n506\t                state={{ from: `/workspace/${workspaceId}` }}\n507\t                onClick={e => e.stopPropagation()}\n508\t                className=\"text-xs transition-colors\"\n509\t              style={{ color: 'var(--text-muted)' }}\n510\t              onMouseEnter={e => { (e.currentTarget as HTMLElement).style.color = 'var(--text-secondary)' }}\n511\t              onMouseLeave={e => { (e.currentTarget as HTMLElement).style.color = 'var(--text-muted)' }}\n512\t              >\n513\t                源码分析\n514\t              </Link>\n515\t            )}\n516\t          </div>\n517\t        </div>\n518\t        <div className=\"flex items-center gap-2 ml-3 shrink-0\">\n519\t          {isDiscovered && onPromote && (\n520\t            <button\n521\t              onClick={(e) => { e.stopPropagation(); onPromote() }}\n522\t              className=\"px-2.5 py-1 text-xs rounded-md border transition-colors\"\n523\t              style={{ borderColor: 'var(--accent)', color: 'var(--accent)', backgroundColor: 'var(--accent-subtle)' }}\n524\t              title=\"把这篇论文升级为本地正式论文：下一次研究会把它当作 seed 进行扩展\"\n525\t            >\n526\t              移入工作区\n527\t            </button>\n528\t          )}\n529\t          <button\n530\t            onClick={(e) => {\n531\t              e.stopPropagation()\n532\t              if (confirm('确定从工作区移除此论文？')) onRemove()\n533\t            }}\n534\t            className=\"opacity-0 group-hover:opacity-100 focus:opacity-100 px-2 py-1 text-xs transition-all\"\n535\t            style={{ color: 'var(--text-muted)' }}\n536\t            onMouseEnter={e => { (e.currentTarget as HTMLElement).style.color = 'var(--error)' }}\n537\t            onMouseLeave={e => { (e.currentTarget as HTMLElement).style.color = 'var(--text-muted)' }}\n538\t          >\n539\t            移除\n540\t          </button>\n541\t        </div>\n542\t      </div>\n543\t    </div>\n544\t  )\n545\t}\n546\t"}]},"parent_tool_use_id":"call_bddd82a75f2e46b98e4517cc","session_id":"29257b8f-ede7-46a4-8e0f-a743591d296a","uuid":"c816fa7a-8488-4f30-bcc8-d3842642e5a9","timestamp":"2026-06-09T05:10:21.640Z","subagent_type":"Explore","task_description":"Explore frontend performance"}
