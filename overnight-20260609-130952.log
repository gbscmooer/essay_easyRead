{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call_c0cde57a53bf495e84a52b59","type":"tool_result","content":"1\t/**\n2\t * useAnalysis Hook\n3\t *\n4\t * 管理论文解析的完整生命周期：上传 → 流式接收 → 完成。\n5\t * 组合了 papers API 和 useStreaming。\n6\t *\n7\t * 重要：useStreaming 在组件顶层无条件调用，传入 activePaperId state。\n8\t * uploadAndAnalyze 上传成功后 setState(activePaperId) 触发 SSE 连接。\n9\t */\n10\t\n11\timport { useState, useEffect, useCallback } from 'react'\n12\timport type { Paper, AnalysisResult, AnalysisStatus } from '@/types'\n13\timport { uploadPaper, getPaper, getAnalysis, reparsePaper, startAnalysisJob } from '@/api/papers'\n14\timport { useStreaming } from './useStreaming'\n15\timport { toast } from '@/hooks/useToast'\n16\t\n17\t\n18\tinterface UseAnalysisReturn {\n19\t  /** 当前论文记录 */\n20\t  paper: Paper | null\n21\t  /** 完整解析结果（解析完成后有值） */\n22\t  analysis: AnalysisResult | null\n23\t  /** 解析状态 */\n24\t  status: AnalysisStatus\n25\t  /** 进度消息 */\n26\t  progressMessage: string\n27\t  /** 后端计算的进度百分比（0-100），无 progress 事件时为 -1 */\n28\t  progress: number\n29\t  /** 相关论文模块的独立状态 */\n30\t  relatedStatus: 'idle' | 'loading' | 'ok' | 'failed'\n31\t  /** 部分解析结果（流式接收中） */\n32\t  partialResult: Partial<AnalysisResult>\n33\t  /** 错误信息 */\n34\t  error: string | null\n35\t  /** 上传并开始解析 */\n36\t  uploadAndAnalyze: (file: File) => Promise<void>\n37\t  /** 重新解析 */\n38\t  reparse: () => Promise<void>\n39\t  /** 开始分析（从 idle 状态触发） */\n40\t  startAnalysis: () => void\n41\t}\n42\t\n43\t\n44\t/**\n45\t * 论文解析的完整流程管理。\n46\t *\n47\t * @param initialPaperId 初始论文 ID（ReaderPage 加载已有论文时传入）\n48\t * @returns 解析状态和操作方法\n49\t */\n50\texport function useAnalysis(initialPaperId?: number): UseAnalysisReturn {\n51\t  const [activePaperId, setActivePaperId] = useState<number | null>(initialPaperId ?? null)\n52\t  const [paper, setPaper] = useState<Paper | null>(null)\n53\t  const [analysis, setAnalysis] = useState<AnalysisResult | null>(null)\n54\t  const [shouldConnect, setShouldConnect] = useState(false)\n55\t  const [localError, setLocalError] = useState<string | null>(null)\n56\t\n57\t  // 顶层无条件调用 useStreaming\n58\t  const {\n59\t    status: streamStatus,\n60\t    partialResult,\n61\t    error: streamError,\n62\t    progressMessage,\n63\t    progress,\n64\t    relatedStatus,\n65\t  } = useStreaming(activePaperId, shouldConnect)\n66\t\n67\t  // 初始加载：如果传入 initialPaperId，加载论文信息\n68\t  useEffect(() => {\n69\t    if (initialPaperId === undefined) return\n70\t\n71\t    let cancelled = false\n72\t    setActivePaperId(initialPaperId)\n73\t\n74\t    getPaper(initialPaperId).then(p => {\n75\t      if (cancelled) return\n76\t      setPaper(p)\n77\t      // 如果已经完成，直接获取完整结果\n78\t      if (p.status === 'done') {\n79\t        setShouldConnect(true)\n80\t        getAnalysis(initialPaperId).then(result => {\n81\t          if (!cancelled) setAnalysis(result)\n82\t        }).catch(() => {\n83\t          toast({ type: 'error', message: '加载分析结果失败' })\n84\t        })\n85\t      } else if (p.status === 'failed') {\n86\t        // 失败状态也连接，以便显示错误\n87\t        setShouldConnect(true)\n88\t      } else if (p.status === 'extracting' || p.status === 'analyzing') {\n89\t        // 正在处理中，自动连接 SSE 显示进度\n90\t        setShouldConnect(true)\n91\t      } else {\n92\t        // pending：等待用户点击\"开始分析\"\n93\t        setShouldConnect(false)\n94\t      }\n95\t    }).catch(() => {\n96\t      toast({ type: 'error', message: '加载论文信息失败' })\n97\t    })\n98\t\n99\t    return () => { cancelled = true }\n100\t  }, [initialPaperId])\n101\t\n102\t  // 当 SSE 完成时，获取完整结果\n103\t  useEffect(() => {\n104\t    if (streamStatus === 'done' && activePaperId !== null) {\n105\t      getAnalysis(activePaperId).then(result => {\n106\t        setAnalysis(result)\n107\t      }).catch(() => {\n108\t        toast({ type: 'error', message: '加载完整分析失败' })\n109\t      })\n110\t    }\n111\t  }, [streamStatus, activePaperId])\n112\t\n113\t  // 上传并开始解析\n114\t  const uploadAndAnalyze = useCallback(async (file: File) => {\n115\t    setAnalysis(null)\n116\t    setPaper(null)\n117\t    try {\n118\t      const uploaded = await uploadPaper(file)\n119\t      setPaper(uploaded)\n120\t      setActivePaperId(uploaded.id)\n121\t      // 先在后台启动分析（与 SSE 解耦），再连接流获取实时进度\n122\t      startAnalysisJob(uploaded.id).catch((e: any) => {\n123\t        setShouldConnect(false)\n124\t        setLocalError(e?.message || '启动分析任务失败')\n125\t        toast({ type: 'error', message: e?.message || '启动分析任务失败' })\n126\t      })\n127\t      setShouldConnect(true)\n128\t    } catch (err) {\n129\t      // 重新抛出异常，以便调用方处理\n130\t      throw err\n131\t    }\n132\t  }, [])\n133\t\n134\t  // 重新解析\n135\t  const reparse = useCallback(async () => {\n136\t    if (activePaperId === null) return\n137\t    setAnalysis(null)\n138\t    setLocalError(null)\n139\t    setShouldConnect(false)\n140\t    try {\n141\t      const updated = await reparsePaper(activePaperId)\n142\t      setPaper(updated)\n143\t      await startAnalysisJob(activePaperId)\n144\t      setShouldConnect(true)\n145\t    } catch {\n146\t      setShouldConnect(false)\n147\t      setLocalError('重新解析失败，请检查网络连接后重试')\n148\t    }\n149\t  }, [activePaperId])\n150\t\n151\t  // 开始分析（从 idle 状态触发）\n152\t  const startAnalysis = useCallback(() => {\n153\t    if (activePaperId === null) return\n154\t    // 后台启动分析任务，再连接 SSE 显示进度\n155\t    startAnalysisJob(activePaperId).catch((e: any) => {\n156\t      setShouldConnect(false)\n157\t      setLocalError(e?.message || '启动分析任务失败')\n158\t      toast({ type: 'error', message: e?.message || '启动分析任务失败' })\n159\t    })\n160\t    setShouldConnect(true)\n161\t  }, [activePaperId])\n162\t\n163\t  // 合并状态：\n164\t  // - 如果已有完整分析结果，直接显示 done\n165\t  // - 如果 paper 已完成但结果未加载，也显示 done\n166\t  // - 如果未连接且 paper 待分析，显示 idle（等待用户点击\"开始分析\"）\n167\t  // - 否则使用 streamStatus（正在分析中）\n168\t  const status: AnalysisStatus = analysis\n169\t    ? 'done'\n170\t    : paper?.status === 'done'\n171\t    ? 'done'\n172\t    : !shouldConnect\n173\t    ? 'idle'\n174\t    : streamStatus\n175\t\n176\t  const error = localError || streamError || paper?.error_message || null\n177\t\n178\t  // 相关论文是主体完成后才异步返回的，用流式 partialResult 覆盖已加载结果，实现实时更新\n179\t  const displayAnalysis: AnalysisResult | null = analysis\n180\t    ? (partialResult.related_papers !== undefined\n181\t        ? { ...analysis, related_papers: partialResult.related_papers }\n182\t        : analysis)\n183\t    : null\n184\t\n185\t  return {\n186\t    paper,\n187\t    analysis: displayAnalysis,\n188\t    status,\n189\t    progressMessage,\n190\t    progress,\n191\t    relatedStatus,\n192\t    partialResult,\n193\t    error,\n194\t    uploadAndAnalyze,\n195\t    reparse,\n196\t    startAnalysis,\n197\t  }\n198\t}\n199\t"}]},"parent_tool_use_id":"call_bddd82a75f2e46b98e4517cc","session_id":"29257b8f-ede7-46a4-8e0f-a743591d296a","uuid":"a31b50be-7c58-4e64-bd16-6c11a49643d5","timestamp":"2026-06-09T05:10:32.300Z","subagent_type":"Explore","task_description":"Explore frontend performance"}
