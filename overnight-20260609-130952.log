{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call_26437cfac8404e269d16b949","type":"tool_result","content":"1\timport { useState, useEffect, useRef } from 'react'\n2\timport type { GraphNode, GraphEdge, ResearchStage, ResearchStatus } from '@/types'\n3\t\n4\tinterface PaperAdded { paper_id: number; title: string; source_paper_id: number; total_expanded: number }\n5\tinterface EmbedProgress { done: number; total: number }\n6\tinterface GraphReady { nodes: GraphNode[]; edges: GraphEdge[]; stats: Record<string, unknown> }\n7\t\n8\texport function useResearchStream(runId: number | null) {\n9\t  const [status, setStatus] = useState<ResearchStatus | 'idle'>('idle')\n10\t  const [stage, setStage] = useState<ResearchStage | null>(null)\n11\t  const [progressMessage, setMsg] = useState('')\n12\t  const [papersAdded, setPapersAdded] = useState<PaperAdded[]>([])\n13\t  const [embed, setEmbed] = useState<EmbedProgress>({ done: 0, total: 0 })\n14\t  const [graph, setGraph] = useState<GraphReady | null>(null)\n15\t  const [error, setError] = useState<string | null>(null)\n16\t  const esRef = useRef<EventSource | null>(null)\n17\t\n18\t  useEffect(() => {\n19\t    if (runId === null) return\n20\t    const es = new EventSource(`/api/research/runs/${runId}/stream`)\n21\t    esRef.current = es\n22\t\n23\t    setStatus('running'); setError(null)\n24\t\n25\t    es.addEventListener('status', (e: MessageEvent) => {\n26\t      try { setMsg(JSON.parse(e.data).message || '') } catch { /* noop */ }\n27\t    })\n28\t    es.addEventListener('stage_start', (e: MessageEvent) => {\n29\t      try { setStage(JSON.parse(e.data).stage as ResearchStage) } catch { /* noop */ }\n30\t    })\n31\t    es.addEventListener('stage_done', (e: MessageEvent) => {\n32\t      try {\n33\t        const data = JSON.parse(e.data)\n34\t        setMsg(`${data.stage} 完成`)\n35\t      } catch { /* noop */ }\n36\t    })\n37\t    es.addEventListener('paper_added', (e: MessageEvent) => {\n38\t      try { setPapersAdded(prev => [...prev, JSON.parse(e.data) as PaperAdded]) } catch { /* noop */ }\n39\t    })\n40\t    es.addEventListener('embed_progress', (e: MessageEvent) => {\n41\t      try { setEmbed(JSON.parse(e.data) as EmbedProgress) } catch { /* noop */ }\n42\t    })\n43\t    es.addEventListener('graph_ready', (e: MessageEvent) => {\n44\t      try { setGraph(JSON.parse(e.data) as GraphReady) } catch { /* noop */ }\n45\t    })\n46\t    es.addEventListener('done', () => { setStatus('done'); es.close() })\n47\t    es.addEventListener('error', (e: MessageEvent) => {\n48\t      try { setError(JSON.parse(e.data).message || '失败') } catch { setError('连接错误') }\n49\t      setStatus('failed'); es.close()\n50\t    })\n51\t\n52\t    return () => { es.close(); esRef.current = null }\n53\t  }, [runId])\n54\t\n55\t  return { status, stage, progressMessage, papersAdded, embed, graph, error }\n56\t}\n57\t"}]},"parent_tool_use_id":"call_bddd82a75f2e46b98e4517cc","session_id":"29257b8f-ede7-46a4-8e0f-a743591d296a","uuid":"57f41f9c-5432-44d2-9f83-b5a9570aa412","timestamp":"2026-06-09T05:10:32.505Z","subagent_type":"Explore","task_description":"Explore frontend performance"}
