{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call_47445fca72494511a6e8bb5c","type":"tool_result","content":"1\timport logging\n2\tfrom fastapi import APIRouter, HTTPException\n3\tfrom pydantic import BaseModel, Field\n4\tfrom sqlmodel import Session, create_engine, select\n5\tfrom datetime import datetime, timezone\n6\tfrom typing import Optional\n7\t\n8\tfrom ..models.annotation import Annotation\n9\tfrom ..models.paper import Paper\n10\tfrom ..config import settings\n11\t\n12\tlogger = logging.getLogger(__name__)\n13\t\n14\trouter = APIRouter(prefix=\"/api/annotations\", tags=[\"annotations\"])\n15\t\n16\t_engine = None\n17\t\n18\t\n19\tdef _get_engine():\n20\t    global _engine\n21\t    if _engine is None:\n22\t        _engine = create_engine(settings.resolved_database_url, connect_args={\"check_same_thread\": False})\n23\t    return _engine\n24\t\n25\t\n26\tclass AnnotationCreate(BaseModel):\n27\t    page_number: int = Field(..., ge=1)\n28\t    x: float = Field(..., ge=0, le=1)\n29\t    y: float = Field(..., ge=0, le=1)\n30\t    width: float = Field(..., ge=0, le=1)\n31\t    height: float = Field(..., ge=0, le=1)\n32\t    annotation_type: str = Field(\"highlight\", max_length=20)\n33\t    color: str = Field(\"#fde047\", pattern=r\"^#[0-9a-fA-F]{6}$\")\n34\t    text: str = Field(\"\", max_length=5000)\n35\t    group_id: Optional[str] = Field(None, max_length=64)\n36\t\n37\t\n38\tclass AnnotationResponse(BaseModel):\n39\t    id: int\n40\t    paper_id: int\n41\t    page_number: int\n42\t    x: float\n43\t    y: float\n44\t    width: float\n45\t    height: float\n46\t    annotation_type: str\n47\t    color: str\n48\t    text: str\n49\t    group_id: Optional[str] = None\n50\t    created_at: datetime\n51\t\n52\t\n53\t@router.get(\"/paper/{paper_id}\", response_model=list[AnnotationResponse])\n54\tasync def list_annotations(paper_id: int):\n55\t    engine = _get_engine()\n56\t    with Session(engine) as session:\n57\t        annotations = session.exec(\n58\t            select(Annotation)\n59\t            .where(Annotation.paper_id == paper_id)\n60\t            .order_by(Annotation.page_number, Annotation.y)\n61\t        ).all()\n62\t        return [\n63\t            AnnotationResponse(\n64\t                id=a.id, paper_id=a.paper_id, page_number=a.page_number,\n65\t                x=a.x, y=a.y, width=a.width, height=a.height,\n66\t                annotation_type=a.annotation_type, color=a.color,\n67\t                text=a.text, group_id=a.group_id, created_at=a.created_at,\n68\t            )\n69\t            for a in annotations\n70\t        ]\n71\t\n72\t\n73\t@router.post(\"/paper/{paper_id}\", response_model=AnnotationResponse)\n74\tasync def create_annotation(paper_id: int, req: AnnotationCreate):\n75\t    engine = _get_engine()\n76\t    with Session(engine) as session:\n77\t        paper = session.get(Paper, paper_id)\n78\t        if not paper:\n79\t            raise HTTPException(status_code=404, detail={\"detail\": \"论文不存在\", \"code\": \"NOT_FOUND\"})\n80\t        annotation = Annotation(\n81\t            paper_id=paper_id,\n82\t            page_number=req.page_number,\n83\t            x=req.x, y=req.y,\n84\t            width=req.width, height=req.height,\n85\t            annotation_type=req.annotation_type,\n86\t            color=req.color,\n87\t            text=req.text,\n88\t            group_id=req.group_id,\n89\t        )\n90\t        session.add(annotation)\n91\t        session.commit()\n92\t        session.refresh(annotation)\n93\t        return AnnotationResponse(\n94\t            id=annotation.id, paper_id=annotation.paper_id,\n95\t            page_number=annotation.page_number,\n96\t            x=annotation.x, y=annotation.y,\n97\t            width=annotation.width, height=annotation.height,\n98\t            annotation_type=annotation.annotation_type,\n99\t            color=annotation.color, text=annotation.text,\n100\t            group_id=annotation.group_id, created_at=annotation.created_at,\n101\t        )\n102\t\n103\t\n104\t@router.delete(\"/group/{group_id}\")\n105\tasync def delete_annotation_group(group_id: str):\n106\t    \"\"\"Delete all annotations sharing the same group_id (created in one action).\"\"\"\n107\t    engine = _get_engine()\n108\t    with Session(engine) as session:\n109\t        annotations = session.exec(\n110\t            select(Annotation).where(Annotation.group_id == group_id)\n111\t        ).all()\n112\t        if not annotations:\n113\t            raise HTTPException(status_code=404, detail={\"detail\": \"标注组不存在\", \"code\": \"NOT_FOUND\"})\n114\t        for ann in annotations:\n115\t            session.delete(ann)\n116\t        session.commit()\n117\t    return {\"message\": f\"已删除 {len(annotations)} 条标注\"}\n118\t\n119\t\n120\t@router.delete(\"/{annotation_id}\")\n121\tasync def delete_annotation(annotation_id: int):\n122\t    engine = _get_engine()\n123\t    with Session(engine) as session:\n124\t        annotation = session.get(Annotation, annotation_id)\n125\t        if not annotation:\n126\t            raise HTTPException(status_code=404, detail={\"detail\": \"标注不存在\", \"code\": \"NOT_FOUND\"})\n127\t        session.delete(annotation)\n128\t        session.commit()\n129\t    return {\"message\": \"标注已删除\"}\n130\t"}]},"parent_tool_use_id":"call_14fbefec6f4c427bbf12da10","session_id":"29257b8f-ede7-46a4-8e0f-a743591d296a","uuid":"ca5d80a6-76f0-459e-9372-d5b56f268898","timestamp":"2026-06-09T05:10:23.383Z","subagent_type":"Explore","task_description":"Explore backend performance"}
