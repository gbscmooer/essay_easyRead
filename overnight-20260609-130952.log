{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call_d3fa80e5e2db48e985726bcc","type":"tool_result","content":"1\timport { useState, useEffect, useRef, useMemo } from 'react'\n2\timport hljs from 'highlight.js/lib/core'\n3\timport python from 'highlight.js/lib/languages/python'\n4\timport javascript from 'highlight.js/lib/languages/javascript'\n5\timport typescript from 'highlight.js/lib/languages/typescript'\n6\timport cpp from 'highlight.js/lib/languages/cpp'\n7\timport java from 'highlight.js/lib/languages/java'\n8\timport bash from 'highlight.js/lib/languages/bash'\n9\timport json from 'highlight.js/lib/languages/json'\n10\timport yaml from 'highlight.js/lib/languages/yaml'\n11\timport markdownLang from 'highlight.js/lib/languages/markdown'\n12\timport xml from 'highlight.js/lib/languages/xml'\n13\timport css from 'highlight.js/lib/languages/css'\n14\timport ReactMarkdown from 'react-markdown'\n15\timport remarkGfm from 'remark-gfm'\n16\t\n17\timport { getCodeFile, type NotebookCellData, type NotebookOutput } from '@/api/code'\n18\timport { useThemeMode } from '@/theme/useTheme'\n19\t\n20\t// 注册常用语言\n21\thljs.registerLanguage('python', python)\n22\thljs.registerLanguage('javascript', javascript)\n23\thljs.registerLanguage('typescript', typescript)\n24\thljs.registerLanguage('cpp', cpp)\n25\thljs.registerLanguage('java', java)\n26\thljs.registerLanguage('bash', bash)\n27\thljs.registerLanguage('json', json)\n28\thljs.registerLanguage('yaml', yaml)\n29\thljs.registerLanguage('markdown', markdownLang)\n30\thljs.registerLanguage('xml', xml)\n31\thljs.registerLanguage('html', xml)\n32\thljs.registerLanguage('css', css)\n33\t\n34\t\n35\tinterface CodeViewerProps {\n36\t  paperId: number\n37\t  filePath: string | null\n38\t  scrollToLine?: number | null\n39\t}\n40\t\n41\t\n42\tfunction getLanguage(filename: string): string {\n43\t  const ext = filename.split('.').pop()?.toLowerCase() || ''\n44\t  const langMap: Record<string, string> = {\n45\t    py: 'python', js: 'javascript', jsx: 'javascript',\n46\t    ts: 'typescript', tsx: 'typescript',\n47\t    cpp: 'cpp', cc: 'cpp', c: 'cpp', h: 'cpp', hpp: 'cpp',\n48\t    java: 'java', sh: 'bash', bash: 'bash',\n49\t    json: 'json', yaml: 'yaml', yml: 'yaml', toml: 'yaml',\n50\t    md: 'markdown', html: 'html', xml: 'xml', css: 'css',\n51\t  }\n52\t  return langMap[ext] || 'plaintext'\n53\t}\n54\t\n55\t\n56\tfunction isMarkdown(filename: string): boolean {\n57\t  return filename.endsWith('.md') || filename.endsWith('.markdown')\n58\t}\n59\t\n60\t\n61\tfunction isNotebook(filename: string): boolean {\n62\t  return filename.endsWith('.ipynb')\n63\t}\n64\t\n65\t\n66\tinterface NotebookCell {\n67\t  cell_type: 'code' | 'markdown' | 'raw'\n68\t  source: string | string[]\n69\t  outputs?: Array<{\n70\t    output_type: string\n71\t    text?: string | string[]\n72\t    data?: Record<string, string | string[]>\n73\t    ename?: string\n74\t    evalue?: string\n75\t    execution_count?: number | null\n76\t  }>\n77\t  execution_count?: number | null\n78\t}\n79\t\n80\t\n81\tfunction parseNotebook(content: string): NotebookCell[] | null {\n82\t  try {\n83\t    const nb = JSON.parse(content)\n84\t    const cells = nb.cells || []\n85\t    return cells.map((cell: Record<string, unknown>) => ({\n86\t      ...cell,\n87\t      source: Array.isArray(cell.source) ? cell.source.join('') : String(cell.source || ''),\n88\t      outputs: (cell.outputs as Array<Record<string, unknown>>)?.map((out: Record<string, unknown>) => ({\n89\t        ...out,\n90\t        text: Array.isArray(out.text) ? (out.text as string[]).join('') : out.text,\n91\t        data: out.data ? Object.fromEntries(\n92\t          Object.entries(out.data as Record<string, unknown>).map(([k, v]) => [k, Array.isArray(v) ? (v as string[]).join('') : v])\n93\t        ) : undefined,\n94\t      })),\n95\t    }))\n96\t  } catch {\n97\t    return null\n98\t  }\n99\t}\n100\t\n101\t\n102\tfunction NotebookRenderer({ cells }: { cells: NotebookCell[] }) {\n103\t  return (\n104\t    <div className=\"space-y-2 p-4\">\n105\t      {cells.map((cell, idx) => (\n106\t        <NotebookCellView key={idx} cell={cell} index={idx} />\n107\t      ))}\n108\t    </div>\n109\t  )\n110\t}\n111\t\n112\t\n113\tfunction NotebookOutputView({ output }: { output: NotebookOutput }) {\n114\t  if (output.output_type === 'stream') {\n115\t    return (\n116\t      <pre className=\"p-4 overflow-x-auto text-sm whitespace-pre-wrap\" style={{ backgroundColor: 'var(--bg-surface)', opacity: 0.5, color: 'var(--text-secondary)' }}>\n117\t        {output.text || ''}\n118\t      </pre>\n119\t    )\n120\t  }\n121\t\n122\t  if (output.output_type === 'execute_result' || output.output_type === 'display_data') {\n123\t    const data = output.data || {}\n124\t    const imageKey = Object.keys(data).find(k => k.startsWith('image/'))\n125\t    if (imageKey) {\n126\t      const src = data[imageKey].startsWith('data:')\n127\t        ? data[imageKey]\n128\t        : `data:${imageKey};base64,${data[imageKey]}`\n129\t      return (\n130\t        <div className=\"p-4\" style={{ backgroundColor: 'var(--bg-surface)', opacity: 0.5 }}>\n131\t          <img src={src} alt=\"notebook output\" className=\"max-w-full mx-auto\" />\n132\t        </div>\n133\t      )\n134\t    }\n135\t    if (data['text/plain']) {\n136\t      return (\n137\t        <pre className=\"p-4 overflow-x-auto text-sm whitespace-pre-wrap\" style={{ backgroundColor: 'var(--bg-surface)', opacity: 0.5, color: 'var(--text-secondary)' }}>\n138\t          {data['text/plain']}\n139\t        </pre>\n140\t      )\n141\t    }\n142\t    if (output.text) {\n143\t      return (\n144\t        <pre className=\"p-4 overflow-x-auto text-sm whitespace-pre-wrap\" style={{ backgroundColor: 'var(--bg-surface)', opacity: 0.5, color: 'var(--text-secondary)' }}>\n145\t          {output.text}\n146\t        </pre>\n147\t      )\n148\t    }\n149\t    return null\n150\t  }\n151\t\n152\t  if (output.output_type === 'error') {\n153\t    return (\n154\t      <pre className=\"p-4 overflow-x-auto bg-red-900/20 text-sm text-red-300 whitespace-pre-wrap\">\n155\t        {output.ename}: {output.evalue}\n156\t      </pre>\n157\t    )\n158\t  }\n159\t\n160\t  return null\n161\t}\n162\t\n163\t\n164\tfunction NotebookCellView({ cell, index }: { cell: NotebookCell; index: number }) {\n165\t  const codeRef = useRef<HTMLElement>(null)\n166\t  const mode = useThemeMode()\n167\t  const proseClass = mode === 'dark' ? 'prose prose-invert' : 'prose'\n168\t  const source = Array.isArray(cell.source) ? cell.source.join('') : cell.source\n169\t\n170\t  useEffect(() => {\n171\t    if (cell.cell_type === 'code' && codeRef.current) {\n172\t      codeRef.current.removeAttribute('data-highlighted')\n173\t      try {\n174\t        hljs.highlightElement(codeRef.current)\n175\t      } catch {\n176\t        // ignore\n177\t      }\n178\t    }\n179\t  }, [cell.cell_type, source])\n180\t\n181\t  if (cell.cell_type === 'markdown') {\n182\t    return (\n183\t      <div className=\"border rounded-lg overflow-hidden\" style={{ borderColor: 'var(--border-light)', opacity: 0.5 }}>\n184\t        <div className=\"px-3 py-1 text-xs border-b\" style={{ backgroundColor: 'var(--bg-elevated)', color: 'var(--text-muted)', borderColor: 'var(--border-light)', opacity: 0.5 }}>\n185\t          Markdown\n186\t        </div>\n187\t        <div className={`p-4 ${proseClass} prose-sm max-w-none`}>\n188\t          <ReactMarkdown remarkPlugins={[remarkGfm]}>{source}</ReactMarkdown>\n189\t        </div>\n190\t      </div>\n191\t    )\n192\t  }\n193\t\n194\t  if (cell.cell_type === 'code') {\n195\t    const execLabel = cell.execution_count != null ? `[${cell.execution_count}]` : `[${index}]`\n196\t    const hasOutput = cell.outputs && cell.outputs.length > 0\n197\t\n198\t    return (\n199\t      <div className=\"border rounded-lg overflow-hidden\" style={{ borderColor: 'var(--border-light)', opacity: 0.5 }}>\n200\t        <div className=\"px-3 py-1 text-xs border-b\" style={{ backgroundColor: 'var(--accent-subtle)', color: 'var(--accent)', borderColor: 'var(--border-light)' }}>\n201\t          In {execLabel}\n202\t        </div>\n203\t        <pre className=\"p-4 overflow-x-auto\" style={{ backgroundColor: 'var(--code-bg)' }}>\n204\t          <code ref={codeRef} className=\"language-python text-sm leading-5\">\n205\t            {source}\n206\t          </code>\n207\t        </pre>\n208\t        {hasOutput && (\n209\t          <>\n210\t            <div className=\"px-3 py-1 text-xs border-t border-b\" style={{ backgroundColor: 'var(--success-subtle)', color: 'var(--success)', borderColor: 'var(--border-light)' }}>\n211\t              Out {execLabel}\n212\t            </div>\n213\t            {cell.outputs!.map((output, oIdx) => (\n214\t              <NotebookOutputView key={oIdx} output={output as NotebookOutput} />\n215\t            ))}\n216\t          </>\n217\t        )}\n218\t      </div>\n219\t    )\n220\t  }\n221\t\n222\t  return null\n223\t}\n224\t\n225\t\n226\texport function CodeViewer({ paperId, filePath, scrollToLine }: CodeViewerProps) {\n227\t  const [content, setContent] = useState<string | null>(null)\n228\t  const [apiCells, setApiCells] = useState<NotebookCellData[] | null>(null)\n229\t  const [loading, setLoading] = useState(false)\n230\t  const [error, setError] = useState<string | null>(null)\n231\t  const codeRef = useRef<HTMLElement>(null)\n232\t  const containerRef = useRef<HTMLDivElement>(null)\n233\t  const [highlightLine, setHighlightLine] = useState<number | null>(null)\n234\t  const highlightTimerRef = useRef<ReturnType<typeof setTimeout>>()\n235\t  const mode = useThemeMode()\n236\t  const proseClass = mode === 'dark' ? 'prose prose-invert' : 'prose'\n237\t\n238\t  // Hooks must be called before any early returns\n239\t  const notebookCells = useMemo(\n240\t    () => apiCells ?? ((filePath && content && isNotebook(filePath)) ? parseNotebook(content) : null),\n241\t    [apiCells, content, filePath]\n242\t  )\n243\t\n244\t  useEffect(() => {\n245\t    setHighlightLine(null)\n246\t    if (!filePath) {\n247\t      setContent(null)\n248\t      return\n249\t    }\n250\t\n251\t    const controller = new AbortController()\n252\t    setLoading(true)\n253\t    setError(null)\n254\t    setApiCells(null)\n255\t    getCodeFile(paperId, filePath, controller.signal)\n256\t      .then(res => {\n257\t        if (!controller.signal.aborted) {\n258\t          setContent(res.content)\n259\t          setApiCells(res.cells ?? null)\n260\t        }\n261\t      })\n262\t      .catch(err => { if (err.name !== 'AbortError') setError('文件加载失败') })\n263\t      .finally(() => { if (!controller.signal.aborted) setLoading(false) })\n264\t\n265\t    return () => controller.abort()\n266\t  }, [paperId, filePath])\n267\t\n268\t  useEffect(() => {\n269\t    if (codeRef.current && content && filePath && !isMarkdown(filePath) && !isNotebook(filePath)) {\n270\t      codeRef.current.removeAttribute('data-highlighted')\n271\t      try {\n272\t        hljs.highlightElement(codeRef.current)\n273\t      } catch {\n274\t        // ignore\n275\t      }\n276\t    }\n277\t  }, [content, filePath])\n278\t\n279\t  useEffect(() => {\n280\t    if (scrollToLine == null || !containerRef.current) return\n281\t\n282\t    if (highlightTimerRef.current) clearTimeout(highlightTimerRef.current)\n283\t\n284\t    const lineEl = containerRef.current.querySelector(`#line-${scrollToLine}`)\n285\t    if (lineEl) {\n286\t      lineEl.scrollIntoView({ behavior: 'smooth', block: 'center' })\n287\t      setHighlightLine(scrollToLine)\n288\t      highlightTimerRef.current = setTimeout(() => setHighlightLine(null), 3000)\n289\t    }\n290\t\n291\t    return () => {\n292\t      if (highlightTimerRef.current) clearTimeout(highlightTimerRef.current)\n293\t    }\n294\t  }, [scrollToLine])\n295\t\n296\t  if (!filePath) {\n297\t    return (\n298\t      <div className=\"flex items-center justify-center h-full text-sm\" style={{ color: 'var(--text-muted)' }}>\n299\t        选择文件查看代码\n300\t      </div>\n301\t    )\n302\t  }\n303\t\n304\t  if (loading) {\n305\t    return (\n306\t      <div className=\"flex items-center justify-center h-full\">\n307\t        <div className=\"w-6 h-6 border-2 rounded-full animate-spin\" style={{ borderColor: 'var(--border-light)', borderTopColor: 'var(--accent)' }} />\n308\t      </div>\n309\t    )\n310\t  }\n311\t\n312\t  if (error) {\n313\t    return (\n314\t      <div className=\"flex items-center justify-center h-full text-red-400 text-sm\">\n315\t        {error}\n316\t      </div>\n317\t    )\n318\t  }\n319\t\n320\t  const lines = (content || '').split('\\n')\n321\t  const language = getLanguage(filePath)\n322\t\n323\t  return (\n324\t    <div ref={containerRef} className=\"h-full overflow-auto\" style={{ backgroundColor: 'var(--code-bg)' }}>\n325\t      {/* 文件路径 */}\n326\t      <div className=\"sticky top-0 z-10 px-4 py-2 border-b backdrop-blur-sm\" style={{ backgroundColor: 'var(--bg-surface)', opacity: 0.9, borderColor: 'var(--border)' }}>\n327\t        <span className=\"text-xs font-mono\" style={{ color: 'var(--text-secondary)' }}>{filePath}</span>\n328\t      </div>\n329\t\n330\t      {/* Jupyter Notebook 渲染 */}\n331\t      {notebookCells ? (\n332\t        <NotebookRenderer cells={notebookCells} />\n333\t      ) : isMarkdown(filePath) ? (\n334\t        /* Markdown 渲染 */\n335\t        <div className={`p-6 ${proseClass} prose-sm max-w-none`}>\n336\t          <ReactMarkdown remarkPlugins={[remarkGfm]}>{content || ''}</ReactMarkdown>\n337\t        </div>\n338\t      ) : (\n339\t        /* 普通代码渲染 */\n340\t        <div className=\"flex\">\n341\t          {/* 行号 */}\n342\t          <div className=\"shrink-0 select-none text-right pr-4 pt-4 pb-4 border-r\" style={{ borderColor: 'var(--border)' }}>\n343\t            {lines.map((_, i) => (\n344\t              <div\n345\t                key={i}\n346\t                id={`line-${i + 1}`}\n347\t                className={`text-xs leading-5 px-2 ${\n348\t                  highlightLine === i + 1 ? '' : ''\n349\t                }`}\n350\t                style={highlightLine === i + 1 ? { color: 'var(--accent)', backgroundColor: 'var(--accent-subtle)' } : { color: 'var(--text-muted)' }}\n351\t              >\n352\t                {i + 1}\n353\t              </div>\n354\t            ))}\n355\t          </div>\n356\t\n357\t          {/* 代码 */}\n358\t          <pre className=\"flex-1 p-4 overflow-x-auto\">\n359\t            <code\n360\t              ref={codeRef}\n361\t              className={`language-${language} text-sm leading-5`}\n362\t            >\n363\t              {content}\n364\t            </code>\n365\t          </pre>\n366\t        </div>\n367\t      )}\n368\t    </div>\n369\t  )\n370\t}\n371\t"}]},"parent_tool_use_id":"call_bddd82a75f2e46b98e4517cc","session_id":"29257b8f-ede7-46a4-8e0f-a743591d296a","uuid":"3d78b1de-7d7e-49a7-b531-68cad1f013a7","timestamp":"2026-06-09T05:10:58.383Z","subagent_type":"Explore","task_description":"Explore frontend performance"}
