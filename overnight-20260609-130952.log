{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call_476ece88047a409abdef9159","type":"tool_result","content":"1\t\"\"\"\n2\tPaper 数据库模型\n3\t\n4\tSQLModel 模型，映射到 SQLite 的 papers 表。\n5\t存储论文的元信息和解析状态，解析结果存储在 AnalysisResult 中。\n6\t\"\"\"\n7\t\n8\tfrom datetime import datetime, timezone\n9\tfrom typing import Optional\n10\tfrom sqlmodel import SQLModel, Field\n11\t\n12\t\n13\tclass Paper(SQLModel, table=True):\n14\t    \"\"\"\n15\t    论文记录表\n16\t\n17\t    一条记录对应一篇上传过的论文。\n18\t    pdf_path 存储上传后的本地文件路径。\n19\t    status 跟踪解析进度：pending → extracting → analyzing → done / failed。\n20\t    \"\"\"\n21\t\n22\t    __tablename__ = \"papers\"\n23\t\n24\t    id: Optional[int] = Field(default=None, primary_key=True)\n25\t\n26\t    # 文件信息\n27\t    filename: str  # 原始文件名，如 \"attention_is_all_you_need.pdf\"\n28\t    pdf_path: str  # 服务器存储路径，如 \"uploads/abc123.pdf\"\n29\t    file_size: int  # 文件大小（字节）\n30\t\n31\t    # 元信息（解析后填充）\n32\t    title: Optional[str] = None  # AI 提取的论文标题\n33\t    authors: Optional[str] = None  # 作者列表（逗号分隔），自动索引或解读填充\n34\t    venue: Optional[str] = None  # 会议/期刊，如 \"CVPR\", \"NeurIPS\"\n35\t    year: Optional[int] = None  # 发表年份\n36\t    category: Optional[str] = None  # arXiv 学科分类，如 \"cs.LG\"（自动索引提取）\n37\t\n38\t    # 自动索引：上传即提取的纯文本（供全局字面搜索）+ 索引状态\n39\t    full_text: Optional[str] = None  # PyMuPDF 提取的全文（截断 ~300k）\n40\t    index_status: str = \"none\"  # none | indexing | indexed | failed\n41\t\n42\t    # 状态\n43\t    # pending | extracting | analyzing | done | failed\n44\t    # indexed: 深度研究扩展下载的论文，只跑了 PDF 提取 + chunk + embed，没跑 LLM 分析（level=2 专用）\n45\t    status: str = \"pending\"\n46\t    error_message: Optional[str] = None  # 失败时的错误信息\n47\t\n48\t    # 代码仓库\n49\t    code_url: Optional[str] = None  # AI 提取的 GitHub/GitLab URL\n50\t    code_status: str = \"none\"  # none | cloning | ready | failed\n51\t    code_path: Optional[str] = None  # 本地 clone 路径\n52\t    code_summary: Optional[str] = None  # AI 生成的 README 摘要\n53\t\n54\t    # 深度研究扩展字段\n55\t    source: str = \"uploaded\"               # uploaded | expanded\n56\t    level: int = 1                         # 1 = 用户手动加入工作区; 2 = 联网扩展下载; 3+ = 多跳扩展\n57\t    parent_paper_id: Optional[int] = None  # 仅 expanded：seed 论文 id\n58\t    external_id: Optional[str] = None      # S2 paperId 或 arXivId，用于去重\n59\t\n60\t    # 时间戳 — 在 database.py 的 CRUD 中手动设置\n61\t    created_at: datetime = Field(default_factory=lambda: datetime.now(timezone.utc))\n62\t    updated_at: datetime = Field(default_factory=lambda: datetime.now(timezone.utc))\n63\t"}]},"parent_tool_use_id":"call_14fbefec6f4c427bbf12da10","session_id":"29257b8f-ede7-46a4-8e0f-a743591d296a","uuid":"2a69d491-c605-4b57-8e75-27ac1448050a","timestamp":"2026-06-09T05:10:24.933Z","subagent_type":"Explore","task_description":"Explore backend performance"}
