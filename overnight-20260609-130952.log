{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call_0e2d3f6e4834477f9db6f2c4","type":"tool_result","content":"1\t\"\"\"\n2\tAPI 请求/响应 Schema\n3\t\n4\tPydantic 模型，用于 FastAPI 的请求验证和响应序列化。\n5\t与数据库模型分离，API 层面的字段可以与 DB 不同。\n6\t\"\"\"\n7\t\n8\tfrom datetime import datetime\n9\tfrom typing import Optional\n10\tfrom pydantic import BaseModel, Field\n11\tfrom .analysis import MethodModel, ExperimentModel, CodeMapping, InterviewQA, OutlineItem, RelatedPaper, FigureAnalysis\n12\t\n13\t\n14\t# ============================================================\n15\t# Paper 相关 Schema\n16\t# ============================================================\n17\t\n18\t\n19\tclass PaperCreate(BaseModel):\n20\t    \"\"\"\n21\t    创建论文记录的请求体\n22\t\n23\t    实际上论文记录在文件上传时自动创建，此 schema 用于\n24\t    内部流程中传递文件信息。\n25\t    \"\"\"\n26\t\n27\t    filename: str\n28\t    file_size: int\n29\t\n30\t\n31\tclass PaperResponse(BaseModel):\n32\t    \"\"\"\n33\t    单篇论文的 API 响应\n34\t\n35\t    包含论文元信息和解析状态，但不包含完整解析结果\n36\t    （完整结果通过 AnalysisResponse 返回）。\n37\t    \"\"\"\n38\t\n39\t    id: int\n40\t    filename: str\n41\t    title: Optional[str] = None\n42\t    authors: Optional[str] = None       # 作者列表（逗号分隔），自动索引/解读填充\n43\t    venue: Optional[str] = None\n44\t    year: Optional[int] = None\n45\t    category: Optional[str] = None      # arXiv 学科分类，如 \"cs.LG\"\n46\t    status: str  # pending | extracting | analyzing | done | failed | indexed\n47\t    index_status: str = \"none\"          # none | indexing | indexed | failed（自动索引）\n48\t    error_message: Optional[str] = None\n49\t    code_url: Optional[str] = None\n50\t    code_status: str = \"none\"\n51\t    source: str = \"uploaded\"   # uploaded | expanded\n52\t    level: int = 1             # 1=用户手动加; 2+=联网扩展下载\n53\t    created_at: datetime\n54\t    updated_at: datetime\n55\t\n56\t\n57\tclass PaperListResponse(BaseModel):\n58\t    \"\"\"\n59\t    论文列表的 API 响应\n60\t\n61\t    用于论文库页面，支持分页和筛选。\n62\t    \"\"\"\n63\t\n64\t    papers: list[PaperResponse]\n65\t    total: int  # 总数（用于分页）\n66\t\n67\t\n68\t# ============================================================\n69\t# Analysis 相关 Schema\n70\t# ============================================================\n71\t\n72\t\n73\tclass AnalysisResponse(BaseModel):\n74\t    \"\"\"\n75\t    完整解析结果的 API 响应\n76\t\n77\t    包含一篇论文的全部结构化分析数据。\n78\t    嵌套字段使用强类型模型，与前端 TypeScript 类型一一对应。\n79\t    \"\"\"\n80\t\n81\t    paper_id: int\n82\t    title: str\n83\t    authors: str = \"\"\n84\t    venue: str\n85\t    year: int\n86\t    one_sentence: str\n87\t    problem: str\n88\t    key_contributions: list[str]\n89\t    outline: list[OutlineItem] = []\n90\t    method: MethodModel  # 强类型，非 dict\n91\t    experiments: ExperimentModel  # 强类型，非 dict\n92\t    code_mapping: list[CodeMapping]  # 强类型列表\n93\t    interview_qa: list[InterviewQA]  # 强类型列表\n94\t    limitations: str\n95\t    related_papers: list[RelatedPaper]\n96\t    mermaid_chart: Optional[str] = None\n97\t\n98\t\n99\t# ============================================================\n100\t# Streaming 事件 Schema\n101\t# ============================================================\n102\t\n103\t\n104\tclass StreamEvent(BaseModel):\n105\t    \"\"\"\n106\t    SSE 流式事件\n107\t\n108\t    用于分析过程中的实时进度推送。\n109\t    通过 Server-Sent Events (SSE) 发送到前端。\n110\t\n111\t    event 类型：\n112\t    - \"status\": 进度状态更新（如 \"正在提取文本\"）\n113\t    - \"field\": 某个字段解析完成，包含字段名和值\n114\t    - \"done\": 全部解析完成\n115\t    - \"error\": 解析失败\n116\t\n117\t    field_name: 当 event=\"field\" 时，表示完成了哪个字段\n118\t    data: 事件数据，结构取决于 event 类型\n119\t    \"\"\"\n120\t\n121\t    event: str  # \"status\" | \"field\" | \"done\" | \"error\"\n122\t    field_name: Optional[str] = None  # 如 \"title\", \"method\", \"experiments\"\n123\t    data: dict = {}  # 事件负载\n124\t\n125\t\n126\t# ============================================================\n127\t# 通用 Schema\n128\t# ============================================================\n129\t\n130\t\n131\tclass ErrorResponse(BaseModel):\n132\t    \"\"\"\n133\t    统一错误响应\n134\t\n135\t    所有 API 错误都使用此格式返回。\n136\t    \"\"\"\n137\t\n138\t    detail: str  # 错误描述\n139\t    code: str  # 错误码，如 \"FILE_TOO_LARGE\", \"PARSING_FAILED\"\n140\t\n141\t\n142\t# ============================================================\n143\t# Code Analysis 相关 Schema\n144\t# ============================================================\n145\t\n146\t\n147\tclass CodeAnalysisResponse(BaseModel):\n148\t    \"\"\"代码分析结果响应\"\"\"\n149\t\n150\t    paper_id: int\n151\t    file_tree: dict = {}\n152\t    data_flow: Optional[str] = None\n153\t    dependency_graph: list[dict] = []\n154\t    paper_code_mapping: list[dict] = []\n155\t    node_metrics: list[dict] = []\n156\t    status: str = \"pending\"\n157\t    error_message: Optional[str] = None\n158\t\n159\t\n160\tclass CodeSummaryResponse(BaseModel):\n161\t    \"\"\"代码摘要响应（侧边栏用）\"\"\"\n162\t\n163\t    code_url: Optional[str] = None\n164\t    code_status: str = \"none\"\n165\t    code_summary: Optional[str] = None\n166\t\n167\t\n168\t# ============================================================\n169\t# Research 相关 Schema\n170\t# ============================================================\n171\t\n172\tclass ResearchRunCreate(BaseModel):\n173\t    \"\"\"创建深度研究任务的请求体\"\"\"\n174\t    mode: str = Field(\"local\", pattern=r\"^(local|online)$\")\n175\t    paper_ids: Optional[list[int]] = None\n176\t    # 是否把工作区内已存在的联网扩展论文（level>=2）纳入本次图谱。\n177\t    # 关闭后只用工作区内部论文（level==1），不使用之前下载到本地的扩展论文。\n178\t    include_expanded: bool = True\n179\t    deep: int = Field(1, ge=1, le=5)\n180\t    expand_top_k: int = Field(5, ge=1, le=50)\n181\t    expand_total_limit: int = Field(50, ge=1, le=500)\n182\t    rebuild: bool = False\n183\t    similarity_threshold: float = Field(0.78, ge=0, le=1)\n184\t    enable_shared_method: bool = False\n185\t\n186\t\n187\tclass ResearchRunResponse(BaseModel):\n188\t    \"\"\"深度研究任务的响应\"\"\"\n189\t    id: int\n190\t    workspace_id: int\n191\t    mode: str\n192\t    status: str\n193\t    current_stage: Optional[str] = None\n194\t    error_message: Optional[str] = None\n195\t    params: dict\n196\t    paper_count: int\n197\t    expanded_count: int\n198\t    chunk_count: int\n199\t    embed_done: int\n200\t    embed_total: int\n201\t    node_count: int\n202\t    edge_count: int\n203\t    created_at: datetime\n204\t    updated_at: datetime\n205\t\n206\t\n207\tclass ResearchGraphResponse(BaseModel):\n208\t    \"\"\"工作区图谱快照响应\"\"\"\n209\t    workspace_id: int\n210\t    run_id: int\n211\t    nodes: list[dict]\n212\t    edges: list[dict]\n213\t    stats: dict\n214\t    updated_at: datetime\n215\t\n216\t\n217\tclass RagQueryRequest(BaseModel):\n218\t    \"\"\"RAG 跨论文问答请求\"\"\"\n219\t    question: str = Field(..., min_length=1, max_length=2000)\n220\t    top_k: int = Field(5, ge=1, le=20)\n221\t    paper_ids: Optional[list[int]] = None\n222\t\n223\t\n224\tclass RagCitation(BaseModel):\n225\t    \"\"\"RAG 回答中的引用来源\"\"\"\n226\t    paper_id: int\n227\t    paper_title: str\n228\t    section_name: str\n229\t    snippet: str\n230\t    score: float\n231\t\n232\t\n233\tclass RagQueryResponse(BaseModel):\n234\t    \"\"\"RAG 问答响应\"\"\"\n235\t    answer: str\n236\t    citations: list[RagCitation]\n237\t"}]},"parent_tool_use_id":"call_14fbefec6f4c427bbf12da10","session_id":"29257b8f-ede7-46a4-8e0f-a743591d296a","uuid":"395fa354-401a-44d8-9839-38e928c6b9b5","timestamp":"2026-06-09T05:10:33.184Z","subagent_type":"Explore","task_description":"Explore backend performance"}
