{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call_313b3a5b9b244af2baa457dc","type":"tool_result","content":"1\t\"\"\"\n2\tSemantic Scholar API 服务\n3\t\n4\t通过 Semantic Scholar 搜索真实的相关论文，替代 AI 生成的幻觉数据。\n5\t免费使用，无需 API key，速率限制约 1 req/sec。\n6\t\n7\tAPI 文档: https://api.semanticscholar.org/api-docs/\n8\t\"\"\"\n9\t\n10\timport asyncio\n11\timport json\n12\timport logging\n13\timport time\n14\tfrom typing import Optional\n15\t\n16\timport httpx\n17\t\n18\tlogger = logging.getLogger(__name__)\n19\t\n20\tS2_BASE = \"https://api.semanticscholar.org/graph/v1\"\n21\tS2_FIELDS = \"title,authors,venue,year,citationCount,externalIds,url,openAccessPdf\"\n22\t\n23\t# 速率限制\n24\t_last_request_time = 0.0\n25\t_rate_lock = asyncio.Lock()\n26\t\n27\t# 共享 httpx 客户端（避免每次请求创建新连接）\n28\t_http_client: httpx.AsyncClient | None = None\n29\t\n30\t# 有 API key 时 S2 给专属 1 RPS；无 key 走共享池，保守用 1.5s\n31\t_RATE_WITH_KEY = 1.1    # seconds\n32\t_RATE_NO_KEY   = 1.5    # seconds\n33\t\n34\t\n35\tdef _get_http_client() -> httpx.AsyncClient:\n36\t    global _http_client\n37\t    if _http_client is None:\n38\t        _http_client = httpx.AsyncClient(timeout=30.0)\n39\t    return _http_client\n40\t\n41\t\n42\tdef _s2_api_key() -> str:\n43\t    \"\"\"从 ai_config 读取 Semantic Scholar API key（可能为空）。\"\"\"\n44\t    try:\n45\t        from .ai_config import get_research_config\n46\t        return get_research_config().get(\"api_key\", \"\") or \"\"\n47\t    except Exception:\n48\t        return \"\"\n49\t\n50\t\n51\tasync def _rate_limited_get(url: str, params: dict, timeout: float = 15.0) -> dict:\n52\t    \"\"\"带速率限制和重试的 GET 请求。\n53\t\n54\t    有 API key 时通过 x-api-key header 发送，享受专属 1 RPS 配额；\n55\t    无 key 时间隔 1.5s，走共享池保守请求。\n56\t    \"\"\"\n57\t    global _last_request_time\n58\t    client = _get_http_client()\n59\t    response = None\n60\t\n61\t    api_key = _s2_api_key()\n62\t    min_interval = _RATE_WITH_KEY if api_key else _RATE_NO_KEY\n63\t    headers = {\"x-api-key\": api_key} if api_key else {}\n64\t\n65\t    for attempt in range(3):\n66\t        async with _rate_lock:\n67\t            now = time.monotonic()\n68\t            elapsed = now - _last_request_time\n69\t            if elapsed < min_interval:\n70\t                await asyncio.sleep(min_interval - elapsed)\n71\t            _last_request_time = time.monotonic()\n72\t\n73\t        response = await client.get(url, params=params, headers=headers)\n74\t        if response.status_code == 429:\n75\t            wait = 3.0 * (attempt + 1)\n76\t            logger.warning(f\"Semantic Scholar 429, retry {attempt+1}/3 in {wait}s...\")\n77\t            await asyncio.sleep(wait)\n78\t            continue\n79\t        response.raise_for_status()\n80\t        return response.json()\n81\t\n82\t    raise httpx.HTTPStatusError(\"Rate limited after 3 retries\", request=None, response=response)\n83\t\n84\t\n85\tdef _map_s2_paper(s2_paper: dict) -> dict:\n86\t    \"\"\"将 S2 API 响应映射为 RelatedPaper 格式\"\"\"\n87\t    # 作者列表：取前 3 个，超过加 \"et al.\"\n88\t    authors_raw = s2_paper.get(\"authors\") or []\n89\t    author_names = [a.get(\"name\", \"\") for a in authors_raw if a.get(\"name\")]\n90\t    if len(author_names) > 3:\n91\t        authors = \", \".join(author_names[:3]) + \" et al.\"\n92\t    else:\n93\t        authors = \", \".join(author_names)\n94\t\n95\t    # DOI 和 URL\n96\t    external_ids = s2_paper.get(\"externalIds\") or {}\n97\t    doi = external_ids.get(\"DOI\") or \"\"\n98\t\n99\t    paper_url = s2_paper.get(\"url\") or \"\"\n100\t    if not paper_url and doi:\n101\t        paper_url = f\"https://doi.org/{doi}\"\n102\t\n103\t    # 优先用 arXiv URL\n104\t    arxiv_id = external_ids.get(\"ArXiv\")\n105\t    if arxiv_id and not paper_url:\n106\t        paper_url = f\"https://arxiv.org/abs/{arxiv_id}\"\n107\t\n108\t    return {\n109\t        \"title\": s2_paper.get(\"title\") or \"\",\n110\t        \"authors\": authors,\n111\t        \"venue\": s2_paper.get(\"venue\") or \"\",\n112\t        \"year\": s2_paper.get(\"year\") or 0,\n113\t        \"doi\": doi,\n114\t        \"url\": paper_url,\n115\t        \"citation_count\": s2_paper.get(\"citationCount\") or 0,\n116\t        \"relevance\": \"\",  # 后续由 AI 填充\n117\t    }\n118\t\n119\t\n120\tasync def search_related_papers(title: str, limit: int = 10) -> list[dict]:\n121\t    \"\"\"\n122\t    通过 Semantic Scholar 搜索与给定标题相关的论文。\n123\t\n124\t    Args:\n125\t        title: 论文标题\n126\t        limit: 返回结果数量（默认 10）\n127\t\n128\t    Returns:\n129\t        RelatedPaper 格式的字典列表\n130\t    \"\"\"\n131\t    if not title or not title.strip():\n132\t        return []\n133\t\n134\t    try:\n135\t        data = await _rate_limited_get(\n136\t            f\"{S2_BASE}/paper/search\",\n137\t            params={\n138\t                \"query\": title,\n139\t                \"fields\": S2_FIELDS,\n140\t                \"limit\": limit,\n141\t            },\n142\t        )\n143\t\n144\t        papers = data.get(\"data\") or []\n145\t        if not papers:\n146\t            logger.info(f\"No Semantic Scholar results for: {title}\")\n147\t            return []\n148\t\n149\t        results = []\n150\t        for p in papers:\n151\t            mapped = _map_s2_paper(p)\n152\t            # 过滤掉标题为空或与查询完全相同的结果\n153\t            if mapped[\"title\"] and mapped[\"title\"].lower() != title.lower():\n154\t                results.append(mapped)\n155\t\n156\t        logger.info(f\"Found {len(results)} related papers via Semantic Scholar\")\n157\t        return results[:limit]\n158\t\n159\t    except httpx.HTTPStatusError as e:\n160\t        logger.warning(f\"Semantic Scholar HTTP error: {e.response.status_code}\")\n161\t        return []\n162\t    except Exception as e:\n163\t        logger.warning(f\"Semantic Scholar search failed: {e}\")\n164\t        return []\n165\t\n166\t\n167\tasync def generate_relevance_descriptions(\n168\t    paper_title: str,\n169\t    paper_one_sentence: str,\n170\t    related_papers: list[dict],\n171\t    api_key: str,\n172\t    base_url: str,\n173\t    model: str,\n174\t) -> list[dict]:\n175\t    \"\"\"\n176\t    用 AI 为每篇相关论文生成一句关联性说明。\n177\t\n178\t    Args:\n179\t        paper_title: 当前论文标题\n180\t        paper_one_sentence: 当前论文一句话描述\n181\t        related_papers: S2 搜索结果列表\n182\t        api_key/base_url/model: AI 模型配置\n183\t\n184\t    Returns:\n185\t        填充了 relevance 字段的 related_papers 列表\n186\t    \"\"\"\n187\t    if not related_papers or not api_key:\n188\t        return related_papers\n189\t\n190\t    # 构建论文列表描述\n191\t    papers_desc = \"\\n\".join(\n192\t        f'{i+1}. \"{p[\"title\"]}\" by {p[\"authors\"]} ({p[\"year\"]})'\n193\t        for i, p in enumerate(related_papers)\n194\t    )\n195\t\n196\t    prompt = (\n197\t        f'论文：\"{paper_title}\" — {paper_one_sentence}\\n\\n'\n198\t        f\"以下是与该论文相关的论文，请为每篇写一句中文的关联性说明（说明它与当前论文的关系）。\\n\"\n199\t        f\"只输出 JSON 数组，不要其他文字。\\n\\n\"\n200\t        f\"相关论文：\\n{papers_desc}\\n\\n\"\n201\t        f'期望输出格式：[\"说明1\", \"说明2\", ...]'\n202\t    )\n203\t\n204\t    try:\n205\t        from .ai_analyzer import _create_client\n206\t\n207\t        client = _create_client(api_key, base_url)\n208\t        try:\n209\t            message = await client.messages.create(\n210\t                model=model,\n211\t                max_tokens=1024,\n212\t                system=\"你是一个学术论文分析助手。只输出 JSON 数组，不要其他文字。\",\n213\t                messages=[{\"role\": \"user\", \"content\": prompt}],\n214\t                temperature=0.3,\n215\t            )\n216\t        finally:\n217\t            await client.close()\n218\t\n219\t        from .ai_analyzer import _extract_text\n220\t        content = _extract_text(message).strip()\n221\t        # 提取可能包裹在 ```json ``` 中的内容\n222\t        if \"```\" in content:\n223\t            start = content.find(\"[\")\n224\t            end = content.rfind(\"]\") + 1\n225\t            if start >= 0 and end > start:\n226\t                content = content[start:end]\n227\t\n228\t        descriptions = json.loads(content)\n229\t        if isinstance(descriptions, list):\n230\t            for i, desc in enumerate(descriptions):\n231\t                if i < len(related_papers) and isinstance(desc, str):\n232\t                    related_papers[i][\"relevance\"] = desc\n233\t\n234\t    except Exception as e:\n235\t        logger.warning(f\"Failed to generate relevance descriptions: {e}\")\n236\t        # relevance 保持空字符串，不影响使用\n237\t\n238\t    return related_papers\n239\t\n240\t\n241\t# ============================================================\n242\t# Deep Research 扩展：论文 ID 解析 + 引用列表\n243\t# ============================================================\n244\t\n245\tS2_REF_FIELDS = \"title,year,citationCount,externalIds,openAccessPdf,authors\"\n246\t\n247\t\n248\tasync def find_s2_paper_id(title: str, doi: str = \"\", arxiv_id: str = \"\") -> Optional[str]:\n249\t    \"\"\"通过 DOI/arXivId/标题 解析 S2 paperId\"\"\"\n250\t    if doi:\n251\t        try:\n252\t            data = await _rate_limited_get(f\"{S2_BASE}/paper/DOI:{doi}\", params={\"fields\": \"paperId\"})\n253\t            return data.get(\"paperId\")\n254\t        except Exception:\n255\t            pass\n256\t    if arxiv_id:\n257\t        try:\n258\t            data = await _rate_limited_get(f\"{S2_BASE}/paper/arXiv:{arxiv_id}\", params={\"fields\": \"paperId\"})\n259\t            return data.get(\"paperId\")\n260\t        except Exception:\n261\t            pass\n262\t    if title:\n263\t        try:\n264\t            data = await _rate_limited_get(f\"{S2_BASE}/paper/search\",\n265\t                params={\"query\": title, \"fields\": \"paperId,title\", \"limit\": 1})\n266\t            arr = data.get(\"data\") or []\n267\t            if arr:\n268\t                return arr[0].get(\"paperId\")\n269\t        except Exception:\n270\t            pass\n271\t    return None\n272\t\n273\t\n274\tasync def get_paper_references(s2_paper_id: str, limit: int = 50) -> list[dict]:\n275\t    \"\"\"返回结构化 references 列表，包含 openAccessPdf 信息\"\"\"\n276\t    data = await _rate_limited_get(\n277\t        f\"{S2_BASE}/paper/{s2_paper_id}/references\",\n278\t        params={\"fields\": f\"citedPaper.{S2_REF_FIELDS}\", \"limit\": limit},\n279\t    )\n280\t    results = []\n281\t    for item in data.get(\"data\") or []:\n282\t        cited = item.get(\"citedPaper\") or {}\n283\t        if not cited.get(\"title\"):\n284\t            continue\n285\t        ext = cited.get(\"externalIds\") or {}\n286\t        oa = cited.get(\"openAccessPdf\") or {}\n287\t        results.append({\n288\t            \"s2_id\": cited.get(\"paperId\"),\n289\t            \"title\": cited.get(\"title\"),\n290\t            \"year\": cited.get(\"year\"),\n291\t            \"citation_count\": cited.get(\"citationCount\") or 0,\n292\t            \"doi\": ext.get(\"DOI\"),\n293\t            \"arxiv_id\": ext.get(\"ArXiv\"),\n294\t            \"pdf_url\": oa.get(\"url\"),\n295\t        })\n296\t    return results\n297\t"}]},"parent_tool_use_id":"call_14fbefec6f4c427bbf12da10","session_id":"29257b8f-ede7-46a4-8e0f-a743591d296a","uuid":"a549c071-d0d6-4e18-b520-73d22bfda093","timestamp":"2026-06-09T05:10:30.056Z","subagent_type":"Explore","task_description":"Explore backend performance"}
